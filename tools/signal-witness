#!/usr/bin/env python3
"""signal-witness — does a trap run when it should, asked many times?

A corpus case asks once. The races a shell's signals have are rare on a
quiet 16-cpu box and common on four cpus or one (sh05 found
wolf-lang#691 only under `taskset -c 0-3`), so this asks the same
question thousands of times and counts. For SHELL:

  reap    a trap is set; ROUNDS times, a child (the program
          `/bin/kill`, which ends the moment it has sent) signals the
          shell while the shell is waiting for that child, and the very
          next command asks whether the action has run. XCU 2.12: the
          action runs when the foreground command completes. A miss
          means the poll after the reap answered "nothing came" for a
          signal that had (the barrier `settle` hid that until wolf
          0.2.29; now `[os.signal.poll]` promises it). Seen red: trunk
          `1315587` on wolf 0.2.28 with the barrier's call removed
          misses 3 to 12 of 5,000 on four cpus or sixteen, none on
          one (`notes/sh14-evidence/logs/red-barrier.log`).
  self    the same, the signal sent by the shell to itself with the
          `kill` built-in (`os_signal_send` to its own pid): the action
          must have run before the next command, ROUNDS times.
  ignored the shell is started with SIGUSR1 and SIGTERM ignored (this
          tool sets them so; no shell in between). XCU `trap`: such a
          signal cannot be trapped or reset. The trap is recorded and
          listed, both signals are sent, the trap is reset and USR1 is
          sent again: no action may run and the shell must live.
          `ignored-i` asks the same of `SHELL -i` reading commands from
          a pipe (dash holds the rule there too, black-box). `default`
          is the control: started with the defaults, the same script
          runs the action and then dies of SIGTERM.

The shell is started with every signal at its default and nothing
blocked, and it prints its own SigBlk and SigIgn (linux; read with
`read`, not by a child: while a shell starts a program its mask is
briefly full, and a child that looked then would report that), so a
row is not decided by what the witness inherited. Signals go only to the shell
this tool started (from its own child).

usage: tools/signal-witness [--rounds N] SHELL
Run it also as `taskset -c 0-3 tools/signal-witness SHELL` and
`taskset -c 0 …`. Exits 1 when any row fails.
"""

import os
import signal
import subprocess
import sys
import tempfile

REAP = r'''
if [ -r /proc/$$/status ]; then
  while read k v; do
    case $k in SigBlk:|SigIgn:) printf '%s %s ' "$k" "$v" >&2;; esac
  done < /proc/$$/status
fi
trap 'got=1' USR2
i=0 miss=0
while [ $i -lt ROUNDS ]; do
  got=0
  /bin/kill -USR2 $$
  if [ $got = 0 ]; then miss=$((miss+1)); fi
  i=$((i+1))
done
echo "$miss $i"
'''

SELF = REAP.replace("/bin/kill -USR2 $$", "kill -USR2 $$")

IGNORED = r'''trap 'echo trapped' USR1
trap
/bin/kill -USR1 $$
/bin/kill -TERM $$
echo alive
trap - USR1
/bin/kill -USR1 $$
echo still
'''


def _defaults():
    for n in range(1, signal.NSIG):
        if n in (signal.SIGKILL, signal.SIGSTOP):
            continue
        try:
            signal.signal(n, signal.SIG_DFL)
        except (OSError, ValueError):
            pass
    signal.pthread_sigmask(signal.SIG_SETMASK, [])


def _two_ignored():
    _defaults()
    signal.signal(signal.SIGUSR1, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)


def main(argv):
    rounds = 5000
    if argv[:1] == ["--rounds"] and len(argv) >= 2:
        rounds = int(argv[1])
        argv = argv[2:]
    if len(argv) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    shell = os.path.abspath(argv[0])
    base = {"PATH": "/usr/bin:/bin", "HOME": "/", "LC_ALL": "C"}
    ok = True
    with tempfile.TemporaryDirectory(prefix="signal-witness.") as cwd:
        r = subprocess.run([shell, "-c", REAP.replace("ROUNDS", str(rounds))],
                           cwd=cwd, env=base, capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, preexec_fn=_defaults,
                           timeout=600)
        words = r.stdout.split()
        good = r.returncode == 0 and words == ["0", str(rounds)]
        print(f"signal-witness: reap    {'ok  ' if good else 'FAIL'} "
              f"{words[0] if words else '?'} misses of {rounds} "
              f"(exit {r.returncode}; shell {r.stderr.strip()!r})")
        ok = ok and good

        r = subprocess.run([shell, "-c", SELF.replace("ROUNDS", str(rounds))],
                           cwd=cwd, env=base, capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, preexec_fn=_defaults,
                           timeout=600)
        words = r.stdout.split()
        good = r.returncode == 0 and words == ["0", str(rounds)]
        print(f"signal-witness: self    {'ok  ' if good else 'FAIL'} "
              f"{words[0] if words else '?'} misses of {rounds} (exit {r.returncode})")
        ok = ok and good

        want = "trap -- 'echo trapped' USR1\nalive\nstill\n"
        r = subprocess.run([shell, "-c", IGNORED], cwd=cwd, env=base,
                           capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, preexec_fn=_two_ignored,
                           timeout=60)
        good = r.returncode == 0 and r.stdout == want
        print(f"signal-witness: ignored {'ok  ' if good else 'FAIL'} "
              f"exit {r.returncode}, wrote {r.stdout!r}")
        ok = ok and good

        r = subprocess.run([shell, "-i"], input=IGNORED, cwd=cwd, env=base,
                           capture_output=True, text=True,
                           preexec_fn=_two_ignored, timeout=60)
        good = r.returncode == 0 and r.stdout == want
        print(f"signal-witness: ignored-i {'ok  ' if good else 'FAIL'} "
              f"exit {r.returncode}, wrote {r.stdout!r}")
        ok = ok and good

        r = subprocess.run([shell, "-c", IGNORED], cwd=cwd, env=base,
                           capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, preexec_fn=_defaults,
                           timeout=60)
        good = (r.returncode == -signal.SIGTERM
                and r.stdout == "trap -- 'echo trapped' USR1\ntrapped\n")
        print(f"signal-witness: default {'ok  ' if good else 'FAIL'} "
              f"returncode {r.returncode} (want {-signal.SIGTERM}), wrote {r.stdout!r}")
        ok = ok and good
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
