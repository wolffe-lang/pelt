#!/bin/sh
# build — compile pelt on one tier or both.
#
# The program is `src/pelt.lu` (marked `//! member: false`) over the
# module `src/sh/`. Usage: tools/build [--native|--release|--all|--static]
#   --native   the fast default backend  -> target/native/pelt
#   --release  LLVM with the mid-end on  -> target/release/pelt
#   --all      both (the default)
#   --static   the release tier linked with `cc -static` (linux)
#                                        -> target/static/pelt
#              the shape PAX runs as pid 1 (`pax/tools/mkpelt`): wolf
#              has no `--static`, so a `cc` that adds the flag is put
#              first on PATH for the link. Not part of --all.
# Every build denies warnings.
set -eu
PELT_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export PELT_ROOT
cd "$PELT_ROOT"
. tools/lib-toolchain.sh

tiers="native release"
case "${1:-}" in
--native) tiers=native ;;
--release) tiers=release ;;
--all | "") ;;
--static) tiers=static ;;
*)
    echo "build: unknown option $1" >&2
    exit 2
    ;;
esac

for tier in $tiers; do
    mkdir -p "target/$tier"
    if [ "$tier" = static ]; then
        real=$(command -v cc)
        mkdir -p target/static/bin
        printf '#!/bin/sh\nexec %s -static "$@"\n' "$real" >target/static/bin/cc
        chmod +x target/static/bin/cc
        PATH="$PELT_ROOT/target/static/bin:$PATH" \
            "$WOLF" build --release --no-cache --deny-warnings src/pelt.lu -o target/static/pelt
    elif [ "$tier" = release ]; then
        "$WOLF" build --release --deny-warnings src/pelt.lu -o "target/$tier/pelt"
    else
        "$WOLF" build --deny-warnings src/pelt.lu -o "target/$tier/pelt"
    fi
    echo "build: target/$tier/pelt"
done
