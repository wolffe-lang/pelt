#!/usr/bin/env python3
"""gen-width — write src/sh/width.lu, the cells a code point takes on a
terminal, from Unicode's character database (as data: Python's
`unicodedata`, whose version is printed into the file).

  0  general category Mn, Me or Cf (but U+00AD SOFT HYPHEN, which is
     shown), and the Hangul medial vowels and final consonants
     U+1160..U+11FF and U+D7B0..U+D7FF (they join the syllable before)
  2  East Asian Width W or F, and the unassigned rest of planes 2 and 3
     (U+20000..U+3FFFD, which EastAsianWidth.txt defaults to W)
  1  everything else

Control characters are the editor's business (it shows them as ^X), so
the table says 1 for them; the editor never asks.

The answer is a balanced tree of comparisons over the merged ranges, so
nothing is built at run time.

usage: tools/gen-width [--check]   (--check: exit 1 if the file differs)
"""

import os
import sys
import unicodedata

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "src", "sh", "width.lu")


def width(cp):
    if 0x1160 <= cp <= 0x11FF or 0xD7B0 <= cp <= 0xD7FF:
        return 0
    if 0xD800 <= cp <= 0xDFFF:
        return 1
    c = chr(cp)
    cat = unicodedata.category(c)
    if cat in ("Mn", "Me") or (cat == "Cf" and cp != 0x00AD):
        return 0
    if unicodedata.east_asian_width(c) in ("W", "F"):
        return 2
    if 0x20000 <= cp <= 0x3FFFD:
        return 2
    return 1


def ranges():
    """[(lo, hi, w)] covering 0..0x10FFFF, adjacent equal widths merged."""
    out = []
    lo, cur = 0, width(0)
    for cp in range(1, 0x110000):
        w = width(cp)
        if w != cur:
            out.append((lo, cp - 1, cur))
            lo, cur = cp, w
    out.append((lo, 0x10FFFF, cur))
    return out


def tree(rs, depth):
    pad = "    " * depth
    if len(rs) == 1:
        return f"{pad}return {rs[0][2]}\n"
    mid = len(rs) // 2
    split = rs[mid][0]
    return (f"{pad}if c < {split} {{\n" + tree(rs[:mid], depth + 1) +
            f"{pad}}}\n" + tree(rs[mid:], depth))


def render():
    rs = ranges()
    head = f"""//! sh.width — how many cells a code point takes on a terminal.
//!
//! GENERATED by tools/gen-width from Unicode {unicodedata.unidata_version}
//! (the character database as data: general category and East Asian
//! Width). Do not edit; run the tool. {len(rs)} ranges.
//!
//! 0: Mn, Me, Cf but U+00AD, Hangul medial and final jamo; 2: East
//! Asian Width W or F and the rest of planes 2 and 3; 1: the rest.

/// The cells code point `c` takes: 0, 1 or 2.
fn cp_width(c: int) -> int {{
"""
    return head + tree(rs, 1) + "}\n"


def main(argv):
    text = render()
    if argv[:1] == ["--check"]:
        have = open(OUT, encoding="utf-8").read() if os.path.exists(OUT) else ""
        if have != text:
            print("gen-width: src/sh/width.lu is not what this Unicode gives", file=sys.stderr)
            return 1
        return 0
    with open(OUT, "w", encoding="utf-8") as fh:
        fh.write(text)
    print(f"gen-width: {OUT} (Unicode {unicodedata.unidata_version})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
