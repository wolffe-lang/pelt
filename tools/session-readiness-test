#!/usr/bin/env python3
"""A quiet pty is not a ready editor. Real-pty, causally released regressions.

No sleep margin makes a row pass: the producer releases only after the
checker observes its busy state three times, or after premature input.
"""
import importlib.machinery
import importlib.util
import inspect
import json
import os
from pathlib import Path
import runpy
import sys
import tempfile
import termios
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT/'tools'))
import lib_session as ls

PRODUCER = r'''
from pathlib import Path
import json,os,select,sys,termios,time
root=Path(sys.argv[1]); kind=sys.argv[2]
old=termios.tcgetattr(0)
raw=old[:]; raw[6]=old[6][:]
raw[3] &= ~(termios.ICANON|termios.ECHO|termios.ISIG|termios.IEXTEN)
raw[6][termios.VMIN]=1; raw[6][termios.VTIME]=0

def line():
    out=b''
    while not out.endswith(b'\n'):
        d=os.read(0,1)
        if not d: raise RuntimeError('unexpected EOF')
        out+=d
    return out
try:
    # Start canonical so even a descheduled producer cannot be mistaken
    # for the next raw editor before the blocking phase is observed.
    termios.tcsetattr(0,termios.TCSANOW,old)
    os.write(2,b'$ ')
    assert line()==b'one\n'
    os.write(1,b'one\n')
    termios.tcsetattr(0,termios.TCSANOW,old)
    (root/'busy').write_text('canonical')
    while True:
        if select.select([0],[],[],0)[0]:
            early=True; break
        if (root/'release').exists():
            early=False; break
        time.sleep(.01)
    (root/'result.json').write_text(json.dumps({'early':early}))
    (root/'busy').unlink()
    if kind=='raw': termios.tcsetattr(0,termios.TCSANOW,raw)
    os.write(2,b'$ ')
    assert line()==b'two\n'
    os.write(1,b'two\n'); os.write(2,b'$ ')
    assert line()==b'exit\n'
finally:
    termios.tcsetattr(0,termios.TCSANOW,old)
'''


def real_pty_case(kind, aware):
    with tempfile.TemporaryDirectory(prefix='session-readiness-') as d:
        root=Path(d)
        child=root/'producer.py'; child.write_text(PRODUCER)
        keys=root/'x.keys'; keys.write_text('one\ntwo\nexit\n')
        checks=[0]
        actual_get=ls.termios.tcgetattr
        actual_prompt=getattr(ls,'tty_has_prompt',None)
        def observe_busy():
            checks[0]+=1
            if checks[0]>=3: (root/'release').write_text('ready may resume')
        def observed_get(fd):
            attrs=actual_get(fd)
            if kind=='raw' and (root/'busy').exists() and attrs[3]&termios.ICANON:
                observe_busy()
            return attrs
        def observed_prompt(screen,prompt):
            value=actual_prompt(screen,prompt)
            if kind=='canonical' and (root/'busy').exists() and not value:
                observe_busy()
            return value
        options={}
        parameters=inspect.signature(ls.run).parameters
        if aware and kind=='raw' and 'editor_ready' in parameters: options['editor_ready']='1'
        if aware and kind=='canonical' and 'tty_prompt' in parameters: options['tty_prompt']='$ '
        with patch.object(ls.termios,'tcgetattr',observed_get):
            if actual_prompt is not None:
                with patch.object(ls,'tty_has_prompt',observed_prompt):
                    transcript=ls.run([sys.executable,str(child),str(root),kind],str(keys),{},**options)
            else:
                transcript=ls.run([sys.executable,str(child),str(root),kind],str(keys),{},**options)
        result=json.loads((root/'result.json').read_text())
        assert ls.last_mode is True, ('terminal mode',transcript)
        assert any(l.startswith('exit 0 ') for l in transcript), transcript
        return result['early'], checks[0]


def check(name,condition,detail=''):
    print(('PASS ' if condition else 'FAIL ')+name+' '+detail,flush=True)
    return not condition


bad=0
for kind in ('raw','canonical'):
    early,checks=real_pty_case(kind,False)
    bad+=check('legacy-'+kind+'-control-detects-early-input',early,repr((early,checks)))
    early,checks=real_pty_case(kind,True)
    bad+=check(kind+'-ready-after-blocking-operation',not early and checks>=3,repr((early,checks)))

checker = runpy.run_path(str(ROOT/'tools/session'), run_name='readiness_checker_contract')
choose = checker.get('checker_readiness')
for name,meta,want in [
    ('generic-child', {}, (None,None)),
    ('editor-screen', {'screen':'1'}, ('0',None)),
    ('dumb-prompt', {'screen':'1','env':'TERM=dumb','tty_prompt':'$\\s'}, (None,'$ ')),
    ('disable-editor', {'screen':'2','editor_ready':'0-1','tty_prompt':'$\\s'}, ('0-1','$ ')),
    ('explicit-off', {'screen':'1','editor_ready':'none'}, (None,None)),
]:
    bad += check('protocol-'+name, callable(choose) and choose(meta)==want)

loader=importlib.machinery.SourceFileLoader('readiness_colour',str(ROOT/'tools/colour-witness'))
spec=importlib.util.spec_from_loader(loader.name,loader)
colour=importlib.util.module_from_spec(spec); loader.exec_module(colour)


class Process:
    def poll(self): return None


class FakeShell:
    def __init__(self):
        self.data={'tty':b''}; self.p=Process(); self.master=123; self.waited=False; self.canonical=False
    def type(self,keys):
        if keys.endswith((b'\r',b'\n')) and not keys.endswith((b'\x16\r',b'\x16\n')):
            self.data['tty']+=b'command\r\n'; self.canonical=True
        else: self.data['tty']+=b'edit'
    def until(self,condition,timeout=8):
        assert not condition(), 'busy command was treated as ready'
        self.waited=True; self.canonical=False; self.data['tty']+=b'$ '
        assert condition(), 'new editor was not recognized'


for name,keys,want in [('submitted-line',b'echo ok\r',True),('pure-edit',b'echo',False),
                       ('literal-return',b'\x16\r',False),('paste-packet',b'\x1b[200~a\nb\x1b[201~',False)]:
    sh=FakeShell()
    def attrs(_): return [0,0,0,termios.ICANON if sh.canonical else 0]
    with patch.object(colour,'settled',lambda *_:None),patch.object(colour.termios,'tcgetattr',attrs):
        colour.step(sh,keys)
    bad+=check('words-'+name+'-readiness',sh.waited==want)

class CanonicalFixture(FakeShell):
    def __init__(self):
        super().__init__()
        self.editor_expected=False; self.ready_marker=b'$ '
        self.screen=type('Frame',(),{'grid':[[' ',' ']],'r':0,'c':0})()
    def until(self,condition,timeout=8):
        assert not condition(), 'canonical operation was treated as ready'
        self.waited=True
        self.screen.grid=[list('$ ')]; self.screen.c=2
        assert self.canonical, 'the controller changed the fixture mode'
        assert condition(), 'canonical prompt was not recognized'


sh=CanonicalFixture()
with patch.object(colour,'settled',lambda *_:None):
    colour.step(sh,b'echo canonical\r')
bad+=check('words-canonical-prompt-readiness',sh.waited and sh.canonical)

# Raw is not an editor. Before a prompt the shell asks the terminal where
# the cursor is (ESC[6n), in raw mode, for up to 300 ms; only then does it
# draw the prompt and install the editor. An idle sample taken in that
# window measures the start of the prompt. This producer goes raw after a
# line and stays busy until any byte arrives, so no timing decides the row.
QUERY_PRODUCER = r'''
from pathlib import Path
import os,select,sys,termios
root=Path(sys.argv[1])
old=termios.tcgetattr(0)
raw=old[:]; raw[6]=old[6][:]
raw[3] &= ~(termios.ICANON|termios.ECHO|termios.ISIG|termios.IEXTEN)
raw[6][termios.VMIN]=1; raw[6][termios.VTIME]=0
try:
    os.write(2,b'$ ')
    got=b''
    while not got.endswith(b'\n'):
        d=os.read(0,1)
        if not d: raise RuntimeError('unexpected EOF')
        got+=d
    termios.tcsetattr(0,termios.TCSANOW,raw)
    (root/'busy').write_text('raw before the editor')
    select.select([0],[],[],30)
    (root/'busy').unlink()
    os.write(2,b'$ ')
    line=b''
    while True:
        b=os.read(0,1)
        if not b: break
        if b==b'\x0c': os.write(2,b'\x1b[H\x1b[2J$ '+line)
        elif b==b'\x15': line=b''
        elif b in (b'\r',b'\n'):
            os.write(2,b'\r\n')
            if line==b'exit': break
            line=b''; os.write(2,b'$ ')
        else: line+=b
finally:
    termios.tcsetattr(0,termios.TCSANOW,old)
'''


def idle_sample_case(acknowledged):
    from lib_shadow import Shell
    with tempfile.TemporaryDirectory(prefix='session-idle-') as d:
        root=Path(d); child=root/'producer.py'; child.write_text(QUERY_PRODUCER)
        sh=Shell(sys.executable,root,fullargv=[sys.executable,str(child),str(root)],tty_out=True)
        try:
            colour.step(sh,b'define\r')
            seen=[]
            def sample(_pid):
                seen.append((root/'busy').exists()); return {}
            pair=getattr(colour,'idle_pair',None)
            if acknowledged and callable(pair):
                with patch.object(colour,'idle_snapshot',sample),patch.object(colour.time,'sleep',lambda _s:None):
                    pair(sh)
            else:
                # the protocol before idle_pair: sample once step returns
                sample(sh.p.pid); sample(sh.p.pid)
            # let a producer still in its raw window go on to its editor
            old=len(sh.data['tty']); sh.type(b'\x0c')
            sh.until(lambda: b'\x1b[2J' in sh.data['tty'][old:])
        finally:
            restored=sh.close()
        assert restored, 'terminal mode not restored'
        return seen


seen=idle_sample_case(False)
bad+=check('legacy-idle-control-samples-before-editor',seen==[True,True],repr(seen))
seen=idle_sample_case(True)
bad+=check('idle-sample-after-editor-ack',seen==[False,False],repr(seen))

# The same raw window ends a submitted step early. Before a prompt the shell
# sets raw mode, asks where the cursor is (ESC[6n) and reads the answer;
# only then does it restore the mode, write its last pending output and the
# prompt, and install the editor. This producer runs a line that prints
# part-one, then asks, reads the answer and stays raw until the checker has
# seen that three times; then it prints part-two and the prompt, and edits.
PROMPT_QUERY_PRODUCER = r'''
from pathlib import Path
import os,sys,termios,time
root=Path(sys.argv[1])
old=termios.tcgetattr(0)
raw=old[:]; raw[6]=old[6][:]
raw[3] &= ~(termios.ICANON|termios.ECHO|termios.ISIG|termios.IEXTEN)
raw[6][termios.VMIN]=1; raw[6][termios.VTIME]=0
def ask():
    os.write(2,b'\x1b[6n')
    got=b''
    while not got.endswith(b'R'):
        d=os.read(0,1)
        if not d: raise RuntimeError('unexpected EOF')
        got+=d
    termios.tcsetattr(0,termios.TCSANOW,old)
def edit():
    termios.tcsetattr(0,termios.TCSANOW,raw)
    line=b''
    while True:
        b=os.read(0,1)
        if not b: raise RuntimeError('unexpected EOF')
        if b in (b'\r',b'\n'):
            os.write(2,b'\r\n'); termios.tcsetattr(0,termios.TCSANOW,old); return line
        if b==b'\x15': line=b''
        else: line+=b; os.write(2,b)
try:
    termios.tcsetattr(0,termios.TCSANOW,raw); ask(); os.write(2,b'$ ')
    assert edit()==b'run'
    os.write(1,b'part-one\r\n')
    termios.tcsetattr(0,termios.TCSANOW,raw)
    os.write(2,b'\x1b[6n')
    got=b''
    while not got.endswith(b'R'):
        d=os.read(0,1)
        if not d: raise RuntimeError('unexpected EOF')
        got+=d
    (root/'busy').write_text('raw while the prompt query is answered')
    while not (root/'release').exists(): time.sleep(.01)
    (root/'busy').unlink()
    termios.tcsetattr(0,termios.TCSANOW,old)
    os.write(1,b'part-two\r\n'); os.write(2,b'$ ')
    while edit()!=b'exit': os.write(2,b'$ ')
finally:
    termios.tcsetattr(0,termios.TCSANOW,old)
'''


def legacy_step(sh,keys):
    # colour.step's submitted-line rule before it knew about the query
    old=len(sh.data['tty']); sh.type(keys); colour.settled(sh)
    def ready():
        if sh.p.poll() is not None: return True
        if b'\n' not in sh.data['tty'][old:]: return False
        return not (termios.tcgetattr(sh.master)[3] & termios.ICANON)
    sh.until(ready,timeout=8)
    return sh.data['tty'][old:]


def prompt_query_case(stepper):
    from lib_shadow import Shell
    with tempfile.TemporaryDirectory(prefix='session-query-') as d:
        root=Path(d); child=root/'producer.py'; child.write_text(PROMPT_QUERY_PRODUCER)
        sh=Shell(sys.executable,root,fullargv=[sys.executable,str(child),str(root)],tty_out=True)
        seen=[0]; actual=termios.tcgetattr
        def observed(fd):
            attrs=actual(fd)
            if (root/'busy').exists() and not attrs[3]&termios.ICANON:
                seen[0]+=1
                if seen[0]>=3: (root/'release').write_text('the query may go on')
            return attrs
        try:
            with patch.object(colour.termios,'tcgetattr',observed):
                raw=stepper(sh,b'run\r')
            early=(root/'busy').exists()
            (root/'release').write_text('the query may go on')
            sh.until(lambda: b'part-two' in sh.data['tty'] and not (root/'busy').exists())
            colour.settled(sh)
        finally:
            restored=sh.close()
        assert restored, 'terminal mode not restored'
        return early, b'part-two' in raw, seen[0]


got=prompt_query_case(legacy_step)
bad+=check('legacy-step-returns-inside-prompt-query',got[0] and not got[1],repr(got))
got=prompt_query_case(colour.step)
bad+=check('step-ready-after-prompt-query',not got[0] and got[1] and got[2]>=3,repr(got))

sys.exit(1 if bad else 0)
