#!/usr/bin/env python3
"""Typed colour/reset/storage law and 80-column cost through owned ptys.
Never reads a shell implementation. Signals use terminal input bytes only;
window changes are TIOCSWINSZ on this fixture's own terminal.
"""
from pathlib import Path
import fcntl, json, os, re, statistics, struct, subprocess, sys, tempfile, termios, time
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT/'tools'))
from lib_shadow import Shell, idle_snapshot

RESET = b'\x1b[0m'
SGR = re.compile(rb'\x1b\[([0-9;]*)m')

def settled(sh, duration=.06):
    end = time.monotonic()+duration
    while time.monotonic() < end: sh.pump(.001)

def step(sh, keys):
    old = len(sh.data['tty']); sh.type(keys); settled(sh)
    return sh.data['tty'][old:]

def ready(binary, home, args=(), env=None, tty_out=True, cols=80, thp=False):
    sh = Shell(binary, home, ['-o', 'highlight', *args], tty_out=tty_out,
               cols=cols, env_overrides=env, disable_thp=thp)
    # A prompt can be printed before raw mode is installed. Wait for an editor
    # acknowledgement, not just the prompt's bytes, before measuring keys.
    settled(sh)
    if (env or {}).get('TERM') != 'dumb':
        old = len(sh.data['tty']); sh.type(b'\x0c')
        sh.until(lambda: b'\x1b[2J' in sh.data['tty'][old:]); settled(sh)
    return sh

def assert_resets(raw):
    style = b'0'
    for token in re.finditer(rb'\x1b\[([0-9;]*)([A-Za-z])', raw):
        value, command = token.groups()
        if command == b'm': style = value
        elif command in (b'A', b'B', b'C', b'D', b'H', b'J', b'K'):
            assert style in (b'', b'0'), ('style before motion/erase', token.group(), style, raw)

def palette(binary, home):
    cases = [
        ('unknown', b'e', b'\x1b[0;91me'),
        ('command', b'echo', b'\x1b[0mecho'),
        ('argument', b'echo argument', b'\x1b[0;36margument'),
        ('reserved', b'if true; then echo x; fi', b'\x1b[0mif'),
        ('quote', b"echo 'hello'", b"\x1b[0;33m'hello'"),
        ('open-quote', b"echo 'hello", b"\x1b[0;91m'\x1b[0;33mhello"),
        ('variable', b'echo $HOME', b'\x1b[0;96m$HOME'),
        ('redirection', b'echo > output', b'\x1b[0;36;1moutput'),
        ('comment', b'echo word # comment', b'\x1b[0;31m# comment'),
        ('operator', b'echo | cat', b'\x1b[0;32m|'),
        ('bang', b'!!', b'\x1b[0;36m!!'),
    ]
    for term in ('xterm-256color', 'linux'):
        sh = ready(binary, home, env={'TERM':term})
        try:
            for name, keys, want in cases:
                raw = step(sh, b'\x15'+keys)
                assert want in raw, (term, name, want, raw)
                assert_resets(raw)
                print('ok colour-'+name, term, flush=True)
            step(sh, b'\x15echo $(echo changed > colour-side-effect)')
            assert not (home/'colour-side-effect').exists(), 'classifier executed substitution'
            print('ok colour-nonexecuting', term, flush=True)
            step(sh,b'\x15echo )')
            raw=step(sh,b'\r')
            assert b'echo \x1b[0;91m)\x1b[0m\r\n     \x1b[0;91m^\x1b[0m\r\npelt:' in raw,raw
            print('ok colour-enter-caret',term,flush=True)
        finally: assert sh.close(), 'mode not restored'

    for name, env, want in [
        ('indexed',{'TERM':'xterm-256color','PELT_COLORS':'argument=idx244'},b'\x1b[0;38;5;244mword'),
        ('rgb',{'TERM':'xterm-256color','COLORTERM':'truecolor','PELT_COLORS':'argument=#123456'},b'\x1b[0;38;2;18;52;86mword'),
        ('fallback',{'TERM':'linux','COLORTERM':'truecolor','PELT_COLORS':'argument=#ff0000'},b'\x1b[0;91mword'),
        ('malformed',{'TERM':'xterm-256color','PELT_COLORS':'command=green:argument=idx999'},b'\x1b[0;36mword'),
    ]:
        sh=ready(binary,home,env=env)
        try:
            raw=step(sh,b'echo word')
            assert want in raw,(name,raw)
            if name=='malformed':
                assert b"PELT_COLORS: invalid entry 'argument'; using defaults" in sh.data['tty']
                assert b'\x1b[0;32mecho' not in raw,raw
            print('ok colour-theme-'+name,flush=True)
        finally: assert sh.close()

def gates(binary,home):
    for name,args,env,tty in [('posix',['--posix'],{},True),('stdout-pipe',[],{},False),('dumb',[],{'TERM':'dumb'},True)]:
        sh=ready(binary,home,args,env,tty)
        try:
            raw=step(sh,b'echo gate\r')
            assert not SGR.search(raw),(name,raw)
            print('ok colour-gate-'+name,flush=True)
        finally:assert sh.close()
    for argv,data in [([str(binary),'-o','highlight','-c','echo gate'],None),([str(binary),'-o','highlight'],b'echo gate\n')]:
        p=subprocess.run(argv,input=data,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=10)
        assert p.returncode==0 and p.stdout==b'gate\n' and not SGR.search(p.stderr),(argv,p)
    sh=ready(binary,home,['-o','friendly','-o','suggest'])
    try:
        step(sh,b'echo prefix_suffix\r')
        raw=step(sh,b'echo prefix')
        assert b'\x1b[0;36mprefix' in raw and b'\x1b[0;90m_suffix'+RESET in raw,raw
        raw=step(sh,b'\r')
        assert b'\r\nprefix\r\n' in raw and b'prefix_suffix\r\n' not in raw,raw
        step(sh,b'set +o highlight\r')
        raw=step(sh,b'echo prefix')
        assert not SGR.search(raw),raw
        print('ok colour-shadow-and-toggle',flush=True)
    finally:assert sh.close()

def screen_storage(binary,home):
    sh=ready(binary,home,['-o','friendly','-o','histsearch','-o','suggest'],{'COLUMNS':None},cols=80)
    try:
        step(sh,b'echo alpha\r');step(sh,b'echo beta\r')
        raw=step(sh,b'echo al\x12')
        assert b'history: echo al' in raw and b'> echo alpha' in raw,raw
        assert_resets(raw)
        raw=step(sh,b'\x07')
        assert b'\x1b[J' in raw,raw
        step(sh,b'\x15echo '+b'x'*40)
        old=len(sh.data['tty'])
        sh.screen.resize(16,24)
        fcntl.ioctl(sh.master,termios.TIOCSWINSZ,struct.pack('HHHH',24,16,0,0));settled(sh,.2)
        raw=sh.data['tty'][old:]
        assert b'\x1b[J' in raw and b'\x1b[0;36m' in raw,('colour-resize-narrow',raw)
        assert_resets(raw)
        old=len(sh.data['tty']);sh.screen.resize(80,24)
        fcntl.ioctl(sh.master,termios.TIOCSWINSZ,struct.pack('HHHH',24,80,0,0));settled(sh,.2)
        raw=sh.data['tty'][old:]
        assert b'\x1b[J' in raw and b'\x1b[0;36m' in raw,('colour-resize-wide',raw)
        # The old wrapped rows are gone after the widened repaint.
        snapshot=sh.screen.snapshot(0)
        rows=[row for row in snapshot if row.startswith('|')]
        assert sum('x' in row for row in rows) == 1,('colour-resize-stale-row',snapshot)
        step(sh,b'\x15echo clean\x15\x19\r')
        step(sh,b'echo undo\x15\x1f\r')
        print('ok colour-resize and pager/style/storage interactions',flush=True)
    finally:assert sh.close()
    for history in home.glob('history-*'):
        assert b'\x1b' not in history.read_bytes(),('colour in persistent history',history)
    print('ok colour-history contains no escapes; selfcheck reads buffer/undo/kill-ring directly',flush=True)

def cost(binary,home):
    sh=ready(binary,home,env={'TERM':'xterm-256color'},cols=80,thp=sys.platform.startswith('linux'))
    try:
        if sys.platform.startswith('linux'):
            a=idle_snapshot(sh.p.pid);time.sleep(10);b=idle_snapshot(sh.p.pid)
            print('colour idle before',json.dumps(a,sort_keys=True),flush=True)
            print('colour idle after',json.dumps(b,sort_keys=True),flush=True)
            for k in ['contexts','cpu_ticks','minor_faults','major_faults','statm_resident_pages']:
                assert a[k]==b[k],(k,a[k],b[k])
            assert a['status']['THP_enabled']==b['status']['THP_enabled']=='0'
            assert a['smaps_rollup']['Anonymous']==b['smaps_rollup']['Anonymous']
            print('ok colour idle-10s: zero wakeups, unchanged RSS, child THP disabled',flush=True)
        else:print('SKIP colour idle counters: Linux /proc only',flush=True)
        # 79 characters before the measured key, 80 after it. No PATH scan
        # occurs here: the census was completed before the ready bell.
        base=b'echo '+b'x'*74
        step(sh,base)
        samples=[]
        for i in range(101):
            old=len(sh.data['tty']);start=time.perf_counter_ns();sh.type(b'x')
            want=b'\x1b[0;36m'+b'x'*75+RESET
            sh.until(lambda:want in sh.data['tty'][old:])
            samples.append((time.perf_counter_ns()-start)/1e6)
            old=len(sh.data['tty']);sh.type(b'\x7f')
            sh.until(lambda:b'\x1b[0;36m'+b'x'*74+RESET in sh.data['tty'][old:])
        med=statistics.median(samples[1:]);p99=sorted(samples[1:])[98]
        print(f'colour 80-column line: median {med:.6f}ms p99 {p99:.6f}ms; 100 keys after warmup',flush=True)
        if '--strict-cost' in sys.argv:assert med<1 and p99<1,(med,p99)
        else:assert med<5.5 and p99<20,(med,p99) # CI scheduling envelope, not the release claim.
    finally:assert sh.close()

if __name__=='__main__':
    binary=Path(sys.argv[1]).resolve()
    with tempfile.TemporaryDirectory(prefix='sh30-witness-') as d:
        home=Path(d)
        palette(binary,home);gates(binary,home);screen_storage(binary,home)
        if '--raw-only' not in sys.argv:cost(binary,home)
