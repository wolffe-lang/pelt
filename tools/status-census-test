#!/usr/bin/env python3
"""Durable corpus observation contracts; finite fixtures, no performance take."""
import importlib.util
import json
from pathlib import Path
import shutil
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
SPEC = importlib.util.spec_from_file_location("status_probe_contract", ROOT / "tools/lib_status_probe.py")
try:
    LIB = importlib.util.module_from_spec(SPEC)
    SPEC.loader.exec_module(LIB)
    LOAD_ERROR = None
except (OSError, ImportError) as exc:
    LIB, LOAD_ERROR = None, str(exc)


class Contract(unittest.TestCase):
    def require(self):
        self.assertIsNotNone(LIB, "durable diagnostics unavailable: " + str(LOAD_ERROR))
        return LIB

    def test_anchor_drift_stops_builder_by_name(self):
        lib = self.require()
        with tempfile.TemporaryDirectory() as directory:
            source = Path(directory) / "source"
            shutil.copytree(ROOT / "src", source / "src")
            path = source / "src/sh/exec.lu"
            old = "    if sh.count_routes {\n        sh.route_total += 1\n    }"
            self.assertEqual(path.read_text().count(old), 1)
            path.write_text(path.read_text().replace(old, "    if sh.count_routes {\n    }\n    sh.route_total += 1"))
            output = Path(directory) / "generated"
            with self.assertRaisesRegex(ValueError, "anchor-drift:counter-total"):
                lib.generate(source, output)
            self.assertFalse((output / "probe.json").exists())

    def test_exact_diff_and_tampering(self):
        lib = self.require()
        with tempfile.TemporaryDirectory() as directory:
            output = Path(directory) / "generated"
            manifest = lib.generate(ROOT, output)
            self.assertEqual(manifest["diff_files"], ["src/sh/exec.lu", "src/sh/main.lu"])
            self.assertEqual(manifest["hunks"]["src/sh/exec.lu"], 2)
            self.assertGreater(manifest["hunks"]["src/sh/main.lu"], 0)
            self.assertTrue(lib.verify(output / "probe.json")["diff_sha256"])
            path = output / "src/sh/arith.lu"
            path.write_text(path.read_text() + "\n// undeclared edit\n")
            with self.assertRaisesRegex(ValueError, "probe-source-drift"):
                lib.verify(output / "probe.json")

    def test_manifest_cannot_relabel_the_committed_interpreter(self):
        lib = self.require()
        with tempfile.TemporaryDirectory() as directory:
            output = Path(directory) / "generated"
            manifest = lib.generate(ROOT, output)
            manifest["source_commit"] = "0" * 40
            (output / "probe.json").write_text(json.dumps(manifest))
            with self.assertRaisesRegex(ValueError, "probe-source-commit-drift"):
                lib.verify(output / "probe.json")

    def test_missing_counter_and_stdout_mismatch_are_independent(self):
        lib = self.require()
        normal = {"exit": 7, "stdout": b"replaced", "err": b"", "raw_returncode": 7}
        probe = dict(normal)
        result = lib.compare(normal, probe, {"state": "missing", "reason": "counter-missing"})
        self.assertTrue(result["behavior"]["match"])
        self.assertEqual(result["counter"]["state"], "missing")
        self.assertIn("counter-missing", result["failures"])
        probe["stdout"] = b"wrong"
        result = lib.compare(normal, probe, {"state": "missing", "reason": "counter-missing"})
        self.assertFalse(result["behavior"]["match"])
        self.assertIn("stdout", result["behavior"]["different_fields"])
        self.assertIn("behavior-mismatch", result["failures"])
        self.assertIn("counter-missing", result["failures"])

    def test_raw_capture_is_opt_in_and_keeps_bytes(self):
        spec = importlib.util.spec_from_file_location("case_capture_contract", ROOT / "tools/lib_cases.py")
        cases = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(cases)
        with tempfile.TemporaryDirectory() as directory:
            home = Path(directory)
            script = home / "case.sh"
            script.write_text("# finite runner fixture\n")
            cases.ENV.update(HOME=str(home), SHELL="/bin/sh")
            command = [sys.executable, "-c", "import os;os.write(1,b'\\xff');os.write(2,b'diagnostic');raise SystemExit(7)"]
            legacy = cases.run(command, str(script), {})
            self.assertEqual(set(legacy), {"stdout", "exit", "stderr", "err", "line"})
            captured = cases.run(command, str(script), {}, diagnostics=home / "raw")
            detail = json.loads((home / "raw/outcome.json").read_text())
            self.assertEqual(detail["raw_returncode"], 7)
            self.assertEqual((home / "raw/stdout.raw").read_bytes(), b"\xff")
            self.assertEqual((home / "raw/stderr.raw").read_bytes(), b"diagnostic")
            self.assertEqual(captured["raw_returncode"], 7)
            self.assertIsNone(detail["wall_ns"])

    def test_signal_exit_timeout_controls_are_distinct(self):
        lib = self.require()
        normal = {"exit": 143, "stdout": b"", "err": b"", "raw_returncode": -15}
        probe = dict(normal, raw_returncode=143)
        result = lib.compare(normal, probe, {"state": "valid", "done": 0, "total": 1})
        self.assertIn("termination-mismatch", result["failures"])
        result = lib.compare(None, probe, {"state": "missing", "reason": "counter-missing"})
        self.assertIn("normal-timeout", result["failures"])
        self.assertIsNone(result["behavior"]["match"])

    def test_counter_frames_and_four_corruption_controls(self):
        lib = self.require()
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "counter"
            def frame(total, done, pid=41):
                return f"PREFIX 1 abc {pid} {total} {done} {1+total+done}\n"
            good = frame(0, 0) + frame(1, 0) + frame(1, 1) + frame(2, 1)
            path.write_text(good)
            got = lib.read_counter(path, "abc", 41)
            self.assertEqual((got["done"], got["total"], got["data_write_calls"]), (1, 2, 4))
            for name, text in [("truncated", good[:-1]), ("duplicate", good + frame(2, 1)),
                               ("child-prefix", good + frame(3, 1, 42)),
                               ("invalid-counts", good + frame(2, 3))]:
                with self.subTest(control=name):
                    path.write_text(text)
                    self.assertEqual(lib.read_counter(path, "abc", 41)["state"], "invalid")

    def test_census_cli_keeps_independent_classes_and_diff_digest(self):
        lib = self.require()
        import subprocess
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            generated = root / "generated"
            manifest = lib.generate(ROOT, generated)
            normal = root / "normal"
            normal.write_text("#!" + sys.executable + "\nimport os\nos.write(1,b'replaced')\nraise SystemExit(7)\n")
            normal.chmod(0o755)
            body = '''import os,sys
from pathlib import Path
args=sys.argv[1:]
path=Path(args[args.index('--counter-sink')+1]);nonce=args[args.index('--counter-sink')+2]
frames=''.join(f'PREFIX 1 {nonce} {os.getpid()} {t} {d} {1+t+d}\\n' for t,d in ((0,0),(1,0),(1,1),(2,1)))
MODE
os.write(1,OUTPUT)
raise SystemExit(7)
'''
            for name, action, emitted, expected in (("good", "path.write_text(frames)", "b'replaced'", []),
                    ("missing", "pass", "b'replaced'", ["counter-missing"]),
                    ("both", "pass", "b'wrong'", ["counter-missing", "behavior-mismatch"]),
                    ("malformed", "path.write_text(frames[:-1])", "b'replaced'", ["counter-invalid"])):
                with self.subTest(control=name):
                    probe = generated / "probe"
                    probe.write_text("#!" + sys.executable + "\n" + body.replace("MODE", action).replace("OUTPUT", emitted))
                    probe.chmod(0o755)
                    manifest["probe_sha256"] = lib.digest(probe.read_bytes())
                    (generated / "probe.json").write_text(json.dumps(manifest))
                    output = root / (name + ".json")
                    result = subprocess.run([sys.executable, "-I", str(ROOT / "tools/status-census"), "--pelt", str(normal),
                        "--selfcheck", str(probe), "--probe-manifest", str(generated / "probe.json"),
                        "--exec-fixture", "--output", str(output)], capture_output=True)
                    self.assertEqual(result.returncode, int(bool(expected)), result.stderr.decode())
                    data = json.loads(output.read_text()); row = data["cases"][0]
                    self.assertEqual(row["probe_diff"]["diff_sha256"], manifest["diff_sha256"])
                    self.assertEqual(set(row["failures"]), set(expected))
                    self.assertEqual(row["case"], "probe/exec-prefix")
                    self.assertIsNone(row["probe"]["wall_ns"])
                    self.assertEqual((root / row["artifacts"] / "normal/stdout.raw").read_bytes(), b"replaced")
                    self.assertIn("probe includes observation writes", data["timing"])

    def test_failed_publication_cannot_promote_an_old_valid_prefix(self):
        lib = self.require()
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "counter"
            path.write_text("PREFIX 1 abc 41 0 0 1\n")
            Path(str(path) + ".failed").write_text("preserved failed prefix")
            counter = lib.read_counter(path, "abc", 41)
            self.assertEqual(counter["state"], "invalid")
            self.assertEqual(counter["reason"], "counter-write-failed")
            self.assertEqual(Path(str(path) + ".failed").read_text(), "preserved failed prefix")

    def test_no_ordinary_source_or_pin_overlay(self):
        lib = self.require()
        with tempfile.TemporaryDirectory() as directory:
            output = Path(directory) / "generated"
            lib.generate(ROOT, output)
            self.assertEqual((output / "src/sh/state.lu").read_bytes(), (ROOT / "src/sh/state.lu").read_bytes())
            self.assertEqual((output / "src/pelt.lu").read_bytes(), (ROOT / "src/pelt.lu").read_bytes())
            self.assertNotIn("fs_sync", (output / "src/sh/main.lu").read_text().split("fn corpus_counter_config", 1)[1])


if __name__ == "__main__":
    unittest.main(verbosity=2)
