#!/usr/bin/env python3
"""Friendly prompt raw-byte, storage, refresh, gate and strict cost laws."""
from pathlib import Path
import fcntl,importlib.machinery,importlib.util,json,os,statistics,struct,subprocess,sys,tempfile,termios,time
ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'tools'))
from lib_shadow import Shell,idle_snapshot
loader=importlib.machinery.SourceFileLoader('prompt_colour',str(ROOT/'tools/colour-witness'))
spec=importlib.util.spec_from_loader(loader.name,loader);colour=importlib.util.module_from_spec(spec);loader.exec_module(colour)
step=colour.step
MARK=b'# ' if os.geteuid()==0 else b'> '
def ready(binary,home,cols=80,env=None,args=(),thp=False):
    values={'PS1':None,'USER':'tester','HOSTNAME':'box.example','COLUMNS':None,'TERM':'xterm-256color'}
    values.update(env or {})
    marker=MARK if values['PS1'] is None and '--posix' not in args and values['TERM']!='dumb' else (values['PS1'] or '$ ').encode()
    sh=Shell(binary,home,['-o','friendly',*args],tty_out=True,cols=cols,env_overrides=values,ready_marker=marker,disable_thp=thp)
    colour.settled(sh);step(sh,b'\x0c')
    return sh

def home_aliases(binary,base):
    """Native regression: HOME's spelling need not be the kernel cwd spelling."""
    physical=base/'physical';physical.mkdir()
    (physical/'alpha/beta/日本語').mkdir(parents=True)
    home=base/'home';home.symlink_to(physical,target_is_directory=True)
    alias=base/'alias';alias.symlink_to(physical,target_is_directory=True)
    outside=base/'outside';outside.mkdir()
    (physical/'away').symlink_to(outside,target_is_directory=True)
    neighbor=base/'physical-neighbor';neighbor.mkdir()
    sh=ready(binary,home)
    def expect(raw,path,name):
        wanted=b'tester@box '+path.encode()+b'\x1b[0m'+MARK
        assert wanted in raw,(name,wanted,raw)
    try:
        raw=step(sh,b'printf "HOME=%s\\n" "$HOME"; pwd; pwd -P\r')
        expected=str(physical.resolve()).encode()+b'\r\n'
        assert raw.count(expected)>=2,('prompt-home-physical-pwd',raw)
        print('prompt-home-paths HOME='+str(home)+' pwd='+str(physical.resolve())+' pwd-P='+str(physical.resolve()),flush=True)
        expect(raw,'~','prompt-symlink-HOME')
        raw=step(sh,b'cd alpha/beta/'+ '日本語'.encode()+b'\r')
        expect(raw,'~/a/b/日本語','prompt-symlink-HOME-child')
        raw=step(sh,b'cd "$HOME/away"\r')
        expect(raw,'~/away','prompt-logical-HOME-preferred')
        raw=step(sh,b'pwd; pwd -P\r')
        assert str(home/'away').encode()+b'\r\n' in raw and str(outside.resolve()).encode()+b'\r\n' in raw,('prompt-logical-pwd',raw)
        raw=step(sh,('cd "'+str(alias)+'/alpha/beta/日本語"\r').encode())
        expect(raw,'~/a/b/日本語','prompt-physical-HOME-via-other-alias')
        raw=step(sh,b'HOME="$HOME/"; cd -P "$HOME"\r')
        expect(raw,'~','prompt-symlink-HOME-trailing-slash')
        raw=step(sh,('cd "'+str(neighbor)+'"\r').encode())
        assert b'tester@box ~' not in raw,('prompt-HOME-component-boundary',raw)
        raw=step(sh,b'cd "$HOME"; HOME="$HOME/missing"\r')
        assert b'tester@box ~' not in raw,('prompt-missing-HOME',raw)
        raw=step(sh,b'unset HOME\r')
        assert b'tester@box ~' not in raw,('prompt-unset-HOME',raw)
    finally:assert sh.close()
    sh=ready(binary,home,env={'PWD':str(home)})
    try:
        expect(sh.data['tty'],'~','prompt-inherited-logical-PWD')
        raw=step(sh,b'pwd\r')
        assert str(home).encode()+b'\r\n' in raw,('prompt-inherited-pwd-kept',raw)
    finally:assert sh.close()
    print('ok prompt-symlink-HOME/logical-PWD/physical-fallback/boundary/missing',flush=True)

def laws(binary,home):
    (home/'alpha/beta/日本語').mkdir(parents=True)
    for cols in (24,39,40,80,200):
        sh=ready(binary,home,cols)
        try:
            assert b'tester@box ~\x1b[0m'+MARK in sh.data['tty'],('prompt-home',cols,sh.data['tty'])
            raw=step(sh,b'cd alpha/beta/'+ '日本語'.encode()+b'\r')
            assert '~/a/b/日本語'.encode() in raw,('prompt-path',cols,raw)
            raw=step(sh,b'false\r');assert b'[\x1b[1m1\x1b[0m]' in raw,('prompt-status',raw)
            raw=step(sh,b'echo $?\r');assert b'\r\n1\r\n' in raw,('prompt-preserves-status',raw)
            step(sh,b"prompt_right() { printf RIGHT; printf x >> \"$HOME/calls\"; }\r")
            count=(home/'calls').read_bytes()
            raw=step(sh,b'echo kept')
            assert (home/'calls').read_bytes()==count,('prompt-right-per-key-execution',raw)
            if cols>=40:assert b'RIGHT' in sh.data['tty'],('prompt-right-absent',raw)
            else:assert b'RIGHT' not in raw,('prompt-right-narrow',raw)
            raw=step(sh,b'\r');assert b'\r\nkept\r\n' in raw,('prompt-right-storage',raw)
            colour.assert_resets(raw)
            step(sh,b'echo '+b'x'*(cols+10))
            assert not sh.screen.snapshot(0)[-2].endswith('RIGHT'),sh.screen.snapshot(0)
            step(sh,b'\x03')
            print('ok prompt-home/path/status/right-storage/one-call',cols,flush=True)
        finally:assert sh.close()
    sh=ready(binary,home)
    try:
        step(sh,b"prompt_right() { PS1='SUBSHELL '; printf RIGHT; }\r")
        raw=step(sh,b'echo isolated\r');assert b'tester@box ~' in raw and b'SUBSHELL ' not in raw,('prompt-PS1-subshell-isolation',raw)
        step(sh,b'echo draft')
        step(sh,b'\x01')
        for cols in (39,80,200,40,80):
            sh.screen.resize(cols,24);fcntl.ioctl(sh.master,termios.TIOCSWINSZ,struct.pack('HHHH',24,cols,0,0));colour.settled(sh,.2)
        raw=step(sh,b'\x05\r');assert b'\r\ndraft\r\n' in raw,('prompt-resize-cursor',raw)
        step(sh,b'echo draft');step(sh,b'\x17');step(sh,b'\x19');raw=step(sh,b'\r');assert b'\r\ndraft\r\n' in raw,raw
        step(sh,b'echo ');raw=step(sh,b'\t');assert b'completions' in raw,raw
        step(sh,b'\x1b');colour.settled(sh,.2);raw=step(sh,b'pager-kept\r');assert b'\r\npager-kept\r\n' in raw,raw
        step(sh,b'set -o histsearch\r');step(sh,b'echo original');step(sh,b'\x12');step(sh,b'\x07');raw=step(sh,b'\r');assert b'\r\noriginal\r\n' in raw,raw
        step(sh,b"prompt_right() { printf '\\033[31mBAD\\nLINE'; }\r")
        raw=step(sh,b'\x0c');assert b'^[[31mBAD^JLINE' in raw and b'\x1b[31mBAD' not in raw,raw
        step(sh,b"PS1='EXPLICIT '; prompt_right() { echo BAD > marker; }\r")
        raw=step(sh,b'echo explicit\r');assert b'EXPLICIT ' in raw and b'tester@box' not in raw,('prompt-PS1-precedence',raw)
        assert not (home/'marker').exists(),'explicit PS1 ran prompt_right'
        print('ok prompt-resize/pagers/kill/control-escaping/PS1-assignment',flush=True)
    finally:assert sh.close()
    for history in home.glob('history-*'):
        text=history.read_bytes();assert b'\x1b' not in text and b'tester@box ~' not in text,('prompt-history-storage',text)
    for ps1 in ('$ ','EXPLICIT ', ''):
        # Empty PS1 still gets an editor acknowledgement; use initial CPR bytes.
        marker=ps1.encode() if ps1 else b'\x1b[6n'
        sh=Shell(binary,home,['-o','friendly'],tty_out=True,env_overrides={'PS1':ps1,'HOSTNAME':'box','USER':'tester'},ready_marker=marker)
        try:
            colour.settled(sh);raw=step(sh,b'echo explicit\r')
            assert b'tester@box' not in raw and b'\r\nexplicit\r\n' in raw,('prompt-PS1-precedence',ps1,raw)
        finally:assert sh.close()
    for args,env in [(['--posix'],{}),([],{"TERM":"dumb"})]:
        sh=ready(binary,home,args=args,env=env)
        try:
            raw=step(sh,b'echo gate\r');assert b'tester@box' not in raw and b'\x1b[0m' not in raw,('prompt-gate',raw)
        finally:assert sh.close()
    for argv,data in [([str(binary),'-o','friendly','-c','echo gate'],None),([str(binary),'-o','friendly'],b'echo gate\n')]:
        p=subprocess.run(argv,input=data,capture_output=True,timeout=10)
        assert p.returncode==0 and p.stdout==b'gate\n' and p.stderr==b'',('prompt-noninteractive',p)
    print('ok prompt-PS1-precedence/environment/empty/gates/history',flush=True)

def passwd_name(uid):
    """The name /etc/passwd gives `uid` (its first entry with that third field), or None."""
    try:
        with open('/etc/passwd',encoding='utf-8',errors='replace') as fh:
            for line in fh:
                f=line.rstrip('\n').split(':')
                if len(f)>=3 and f[2]==str(uid) and f[0]:return f[0]
    except OSError:pass
    return None

def identity(binary,home):
    """pelt#115: the prompt's user and host when the environment does not name them. The user is
    $USER, else $LOGNAME, else the effective uid's passwd entry, else ?; the host is $HOSTNAME,
    else the kernel's node name, else /etc/hostname, else the `hostname` probe, else ?. PATH names
    an empty directory, so no `hostname` program answers."""
    empty=home/'nobin';empty.mkdir()
    linux=sys.platform.startswith('linux')
    name=passwd_name(os.geteuid())
    node=os.uname().nodename.split('.')[0]
    if linux:
        import pwd
        assert name and name==pwd.getpwuid(os.geteuid()).pw_name,('prompt-identity-passwd-entry',name)
        assert node,'prompt-identity-node-name'
    # macOS has no /proc and keeps accounts outside /etc/passwd: there the fallbacks end at `?`
    user=name or '?'
    host=node if linux else '?'
    bare={'USER':None,'LOGNAME':None,'HOSTNAME':None,'PATH':str(empty),'TERM':'linux'}
    rows=[
        ('prompt-user-passwd',{**bare,'HOSTNAME':'box'},user+'@box '),
        ('prompt-user-USER',{**bare,'USER':'envuser','LOGNAME':'envlog','HOSTNAME':'box'},'envuser@box '),
        ('prompt-user-LOGNAME',{**bare,'LOGNAME':'envlog','HOSTNAME':'box'},'envlog@box '),
        ('prompt-host-node',{**bare,'USER':'tester'},'tester@'+host+' '),
        ('prompt-host-HOSTNAME',{**bare,'USER':'tester','HOSTNAME':'envhost.example'},'tester@envhost '),
        ('prompt-identity-bare',{**bare,'HOME':'/'},user+'@'+host+' '),
    ]
    bad=[]
    for row,env,want in rows:
        sh=ready(binary,home,env=env)
        try:
            raw=sh.data['tty']
            ok=b'\x1b[0m'+want.encode() in raw
            print(('ok ' if ok else 'FAIL ')+row+' want '+repr(want)+('' if ok else ' got '+repr(raw[-200:])),flush=True)
            if not ok:bad.append(row)
        finally:assert sh.close()
    assert not bad,bad
    print('ok prompt-identity user',repr(user),'host',repr(host),flush=True)

def vcs(binary,home):
    bindir=home/'bin';bindir.mkdir()
    den=bindir/'den'
    # A POSIX sh script, not Python: the first prompt's probe has 50 ms,
    # and a Python start alone outran it on macOS runners (pelt#93: nightly
    # runs 42066187159 and 42678757228, `prompt-vcs-real-probe`).
    den.write_text('#!/bin/sh\n'
                   '[ $# -eq 2 ] && [ "$1" = status ] && [ "$2" = --porcelain ] || exit 2\n'
                   'printf x >> calls\n'
                   'read -r mode < mode\n'
                   'case $mode in\n'
                   'slow) sleep 0.2 ;;\n'
                   'dirty) printf \'?? file\\n\' ;;\n'
                   'bad) printf \'\\377\' ;;\n'
                   'esac\n')
    den.chmod(0o755);(home/'mode').write_text('dirty')
    warm=subprocess.run([str(den),'status','--porcelain'],cwd=home,capture_output=True,timeout=10)
    assert warm.returncode==0 and warm.stdout==b'?? file\n';(home/'calls').write_text('')
    sh=ready(binary,home,env={'PATH':str(bindir)+':/usr/bin:/bin'})
    try:
        assert b'[vcs:1]' in sh.data['tty'],('prompt-vcs-real-probe',sh.data['tty'])
        calls=(home/'calls').read_text();raw=step(sh,b'echo editing');assert (home/'calls').read_text()==calls,'vcs per-key probe'
        (home/'mode').write_text('slow')
        raw=step(sh,b'\r');colour.settled(sh,.15);raw=sh.data['tty'][-1500:]
        assert b'\x1b[0;2m [vcs:1]\x1b[0m' in raw,('prompt-vcs-deadline',raw)
        (home/'mode').write_text('bad');raw=step(sh,b'true\r');assert b'\x1b[0;2m [vcs:1]' in raw,('prompt-vcs-invalid',raw)
        (home/'mode').write_text('clean');raw=step(sh,b'true\r');assert b'[vcs:clean]' in raw,('prompt-vcs-clean',raw)
        other=home/'other';other.mkdir();(other/'mode').write_text('slow')
        raw=step(sh,b'cd other\r');colour.settled(sh,.15)
        # Last prompt is a new directory, not the previous clean cache.
        raw=sh.data['tty'].split(b'\x1b[0mtester@box ')[-1]
        assert b'[vcs:' not in raw,('prompt-vcs-directory',raw)
        print('ok prompt-vcs-real-probe/deadline/invalid/clean/directory/zero-key-probes',flush=True)
    finally:assert sh.close()

def cost(binary,home):
    metrics=[]
    for right in (False,True):
        sh=ready(binary,home,thp=sys.platform.startswith('linux'))
        try:
            if right:step(sh,b'prompt_right() { printf RIGHT; }\r')
            step(sh,b'echo ')
            timings=[]
            for _ in range(110):
                old=len(sh.data['tty']);start=time.perf_counter_ns();sh.type(b'x')
                want=b'RIGHT\x1b[0m' if right else b'\x1b[0;36mx\x1b[0m'
                sh.until(lambda: want in sh.data['tty'][old:]);timings.append((time.perf_counter_ns()-start)/1e6)
                step(sh,b'\x7f')
            timings=sorted(timings[10:]);median=statistics.median(timings);p99=timings[98]
            metrics.append((median,p99));print('prompt-cost',right,'median_ms',median,'p99_ms',p99,flush=True)
            if '--strict-cost' in sys.argv:assert median<1 and p99<1,('prompt-cost',right,median,p99)
            step(sh,b'\x07');colour.settled(sh,.2)
            if sys.platform.startswith('linux'):
                a=idle_snapshot(sh.p.pid);time.sleep(10);b=idle_snapshot(sh.p.pid)
                print('prompt-idle',right,json.dumps([a,b]),flush=True)
                for key in ('contexts','cpu_ticks','minor_faults','major_faults'):assert a[key]==b[key],(key,a,b)
                for key in ('Rss','Anonymous','AnonHugePages'):assert a['smaps_rollup'][key]==b['smaps_rollup'][key],(key,a,b)
            else:print('SKIP prompt-idle Linux proc counters unavailable',flush=True)
        finally:assert sh.close()
    print('prompt-cost-delta median_ms',metrics[1][0]-metrics[0][0],'p99_ms',metrics[1][1]-metrics[0][1],flush=True)
    def long_ready(binary,home,**kw):
        sh=ready(binary,home,thp=kw.get('thp',False))
        step(sh,b'prompt_right() { printf RIGHT; }\r')
        return sh
    colour.ready=long_ready
    colour.cost(binary,home)

