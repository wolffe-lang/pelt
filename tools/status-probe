#!/usr/bin/env python3
"""Build only the mechanically instrumented corpus probe, never ordinary pelt."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import lib_status_probe as lp


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--generate-only", action="store_true")
    parser.add_argument("--tier", choices=("native", "release"), default="native")
    parser.add_argument("--wolf")
    parser.add_argument("--std")
    args = parser.parse_args()
    source, output = Path(args.source).resolve(), Path(args.output).resolve()
    if not lp.revision(source):
        raise ValueError("probe-source-not-committed")
    dirty = subprocess.run(["git", "-C", str(source), "status", "--porcelain", "--untracked-files=no"], check=True, capture_output=True).stdout
    if dirty:
        raise ValueError("probe-source-dirty")
    manifest = lp.generate(source, output)
    diff = (output / "generated.diff").read_text()
    print(diff, end="", flush=True)
    print("DIFF " + json.dumps({key: manifest[key] for key in ("diff_sha256", "diff_files", "hunks")}, sort_keys=True), flush=True)
    if not args.generate_only:
        if not args.wolf or not args.std:
            raise ValueError("probe-build-requires-pinned-wolf-and-std")
        command = [str(Path(args.wolf).resolve()), "build"]
        if args.tier == "release":
            command.append("--release")
        command += ["--no-cache", "--deny-warnings", str(output / "src/selfcheck.lu"), "-o", str(output / "probe")]
        env = dict(os.environ, WOLF_STD=str(Path(args.std).resolve()))
        subprocess.run(command, cwd=source, env=env, check=True)
        manifest.update(tier=args.tier, probe_sha256=lp.digest((output / "probe").read_bytes()),
                        wolf_sha256=lp.digest(Path(args.wolf).read_bytes()),
                        std_rev=(Path(args.std) / "STD-REV").read_text().strip())
        (output / "probe.json").write_text(json.dumps(manifest, indent=2) + "\n")
    lp.verify(output / "probe.json")
    print("PASS status-probe source=" + manifest["source_commit"] + " diff=" + manifest["diff_sha256"], flush=True)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print("FAIL status-probe " + str(exc), file=sys.stderr)
        raise SystemExit(1)
