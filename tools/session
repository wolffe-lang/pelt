#!/usr/bin/env python3
"""session — pelt typed at through a pseudo-terminal, against the
recorded oracle (tools/lib_session.py says what a case and a transcript
are).

Every case under tests/session/ is typed into pelt one line at a time,
each line once pelt shows the prompt dash showed at that point, and the
transcript is compared line for line with the one tools/session-record
wrote from `dash -i +m`: the output of every step, whether anything but
the prompt reached standard error, every prompt string, and the exit
status and the step it came at.

A case with a `<name>.screen` file (and `screen=N` in its meta) is also
judged on the screen: what a terminal shows of each step from N on
(tools/lib_session.py's `Screen`), against the recorded rows and
cursor. And every pelt session must leave the terminal's modes as it
found them (ICANON, ECHO, ISIG, IEXTEN, IXON): a shell that exits with its terminal
raw fails, whatever its transcript says.

A case marked `pending=` needs a primitive pelt does not have yet. It
still RUNS and is reported as PEND-ok or PEND-fail without deciding the
exit status; every such case must be named in tests/session/PENDING.md
or the run fails.

Exit 0 when every non-pending case matches, 1 when one does not, 2 when
the harness cannot run.

usage: tools/session [--bin DIR] [case ...]   (default target/release)
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib_session as ls  # noqa: E402


def die(msg):
    print(f"session: {msg}", file=sys.stderr)
    sys.exit(2)


def show_diff(got, want):
    n = max(len(got), len(want))
    for i in range(n):
        g = got[i] if i < len(got) else "<none>"
        w = want[i] if i < len(want) else "<none>"
        mark = "  " if g == w else "! "
        print(f"     {mark}pelt {g}")
        if g != w:
            print(f"       dash {w}")


def show_screens(bad):
    for i, have, want in bad:
        print(f"     screen after step {i}:")
        show_diff(have, want)


def main(argv):
    sys.stdout.reconfigure(line_buffering=True)
    bindir = os.path.join(ls.ROOT, "target", "release")
    if argv[:1] == ["--bin"]:
        if len(argv) < 2:
            die("--bin needs a directory")
        bindir = os.path.abspath(argv[1])
        argv = argv[2:]
    pelt = os.path.join(bindir, "pelt")
    if not os.access(pelt, os.X_OK):
        die(f"no pelt at {pelt} (run tools/build)")
    try:
        listed = open(os.path.join(ls.SESS, "PENDING.md"), encoding="utf-8").read()
    except OSError:
        die("tests/session/PENDING.md is missing")
    all_cases = ls.cases(argv or None)
    if not all_cases:
        die("no cases found")
    print(f"session: pelt = {pelt}")
    passed = failed = pend = pend_ok = 0
    full_wait = ls.PROMPT_WAIT
    unlisted = []
    for name, keys in all_cases:
        trp = keys[:-5] + ".tr"
        if not os.path.exists(trp):
            die(f"{name}: no recorded transcript (run tools/session-record on the oracle host)")
        meta = ls.read_meta(keys[:-5] + ".meta")
        want = open(trp, encoding="utf-8").read().split("\n")[:-1]
        # a pending case is expected to miss its prompts: do not spend
        # the full wait on each step of it
        ls.PROMPT_WAIT = 2.0 if "pending" in meta else full_wait
        # a case judged on standard output alone (its oracle draws its
        # own line, so the prompt the transcript shows mid-line is not
        # one pelt writes) is paced by quiet, as it was recorded
        pace = None if meta.get("compare") == "stdout" else ls.parse_tr(want)
        got = ls.run(ls.argv_for(pelt, meta, True), keys, meta, pace)
        if meta.get("compare") == "stdout":
            ok = ls.stdout_and_exit(got) == ls.stdout_and_exit(want)
        else:
            ok = got == want
        bad_screen = []
        scp = keys[:-5] + ".screen"
        if "screen" in meta and os.path.exists(scp):
            want_scr = ls.read_screen(scp)
            if not want_scr:
                die(f"{name}: {name}.screen holds no step")
            for i in sorted(want_scr):
                have = ls.last_screens[i] if i < len(ls.last_screens) else ["<none>"]
                if have != want_scr[i]:
                    bad_screen.append((i, have, want_scr[i]))
            ok = ok and not bad_screen
        elif "screen" in meta:
            die(f"{name}: screen={meta['screen']} but no {name}.screen")
        if ls.last_mode is False:
            ok = False
            print(f"     ({name}: pelt left the terminal's modes changed)")
        if ls.last_sig:
            print(f"     ({name}: pelt {ls.last_sig})")
        if "pending" in meta:
            pend += 1
            pend_ok += ok
            if f"`{name}`" not in listed:
                unlisted.append(name)
            print(f"PEND-{'ok  ' if ok else 'fail'} {name} (waits on {meta['pending']})")
            if not ok:
                show_diff(got, want)
                show_screens(bad_screen)
            continue
        if ok:
            passed += 1
            print(f"ok   {name}")
            continue
        failed += 1
        print(f"FAIL {name}")
        show_diff(got, want)
        show_screens(bad_screen)
    print(f"session: pass {passed}  fail {failed}  pending {pend} ({pend_ok})")
    if unlisted:
        for u in unlisted:
            print(f"UNLISTED {u}: pending but not named in tests/session/PENDING.md")
        return 1
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
