#!/bin/sh
# check-test — the unit tests (`*_test.lu`), which `wolf test` runs on the
# checked machine; `target/<tier>/pelt --self-test` runs the same table
# checks on a compiled tier (sh20).
set -eu
PELT_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export PELT_ROOT
cd "$PELT_ROOT"
. tools/lib-toolchain.sh
cd src
"$WOLF" test
