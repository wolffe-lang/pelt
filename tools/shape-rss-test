#!/usr/bin/env python3
"""Contract tests for shape-rss's one-process instrument (no shell source)."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import sys
import tempfile
import time
import unittest
from unittest.mock import patch

TOOLS = Path(__file__).resolve().parent
sys.path.insert(0, str(TOOLS))
loader = importlib.machinery.SourceFileLoader('shape_rss', str(TOOLS / 'shape-rss'))
spec = importlib.util.spec_from_loader(loader.name, loader)
shape = importlib.util.module_from_spec(spec)
loader.exec_module(shape)


class Samples(unittest.TestCase):
    def test_anonymous_plus_swap(self):
        rows, out, ok = shape.parse_samples('__shape_memory=100,4\n__shape_memory=108,8\n20\n')
        self.assertEqual((rows, out, ok), ([104, 116], '20', True))

    def test_readings_fail_closed(self):
        for raw in ('', '__shape_memory=missing,0\n', '__shape_memory=-1,0\n',
                    '__shape_memory=1,2\n' * 3, '__shape_memory=1,2,3\n',
                    '__shape_memory=1,2\n', '__shape_memory=1,kB\n' * 2):
            with self.subTest(raw=raw):
                self.assertFalse(shape.parse_samples(raw)[2])

    def test_fixed_input_and_checkpoint_without_per_turn_work(self):
        for kind in ('loop', 'script', 'jobs', 'monitor'):
            with self.subTest(kind=kind):
                script = shape.file_script(kind, ':', 7)
                self.assertIn('__shape_sample', script)
                self.assertNotIn('/usr/bin/time', script)
                if kind in ('loop', 'monitor'):
                    self.assertIn('i=0\n{\n', script)
                    self.assertIn('while [ $i -lt 7 ]', script)
                    self.assertIn('while [ $i -lt 14 ]', script)
                    self.assertNotIn('if [ $i -eq', script)
                    self.assertEqual(script.count('\n__shape_sample\n'), 2)
                else:
                    self.assertEqual(script.splitlines().count(':'), 14)

    def test_only_observed_job_notices_are_accepted_for_background_wait(self):
        # Actual pelt bytes captured on macOS: 38 per completed job.
        notice = b'[1] + Done'.ljust(33, b' ') + b'true\n'
        self.assertEqual(len(notice), 38)
        self.assertEqual(shape.typed_stderr(notice, 'true & wait'), (1, b''))
        self.assertEqual(shape.typed_stderr(notice, ':'), (0, notice))
        self.assertEqual(shape.typed_stderr(notice + b'pelt: error\n', 'true & wait'),
                         (1, b'pelt: error\n'))

    def test_notice_lookalikes_remain_errors(self):
        notice = b'[1] + Done'.ljust(33, b' ') + b'true\n'
        for bad in (notice[:-1], notice.replace(b'true', b'false'),
                    notice.replace(b'Done', b'Done(1)'),
                    notice.replace(b'[1]', b'[0]'), notice.replace(b' + ', b' ? '),
                    b' ' + notice, b'pelt: failure\n'):
            with self.subTest(bad=bad):
                self.assertEqual(shape.typed_stderr(bad, 'true & wait'), (0, bad))

    def test_monitor_samples_before_exec(self):
        script = shape.file_script('monitor', ':', 2)
        self.assertLess(script.rindex('__shape_sample'), script.index('exec true'))

    def test_bounds_unchanged(self):
        overrides = {row[0]: row[3:] for row in shape.SHAPES if len(row) > 4}
        self.assertEqual(overrides, {'jobs-set-m': (3000, 160, 64),
                                    'jobs-loop': (100000, 16),
                                    'fork-background-subshell': (10000, 100, 1280)})


def assert_hang_time(test, phases, platform):
    """The enclosing test budget is separate from the row's 10 s deadline."""
    # Existing Darwin tree cleanup scans ps up to 200 times: measured here
    # at 8.165 s (18.651 s total), versus Linux cleanup .020 s/total 10.391 s.
    # Hosted macOS took 28.065 s total; 40 s leaves ~12 s (42%) margin for
    # its slower process-table probes. Python import precedes this timer.
    # This does NOT extend shape-rss's unchanged 10-second prompt deadline.
    budget = 40 if platform == 'darwin' else 25
    test.assertLess(phases['total'], budget,
                    f'{platform} hang phases (seconds): {json.dumps(phases, sort_keys=True)}')


def timed_hang(shell, path):
    """Observe the real tool without replacing IO, probes, cleanup or clocks."""
    from lib_shape_trace import ShapeTrace
    phases = {'startup': 0, 'prompt_wait': 0, 'snapshot': 0,
              'cleanup': 0, 'wait': 0, 'trace_finish': 0}
    start = time.monotonic()

    def measure(name, function, *args, **kwargs):
        begin = time.monotonic()
        try:
            return function(*args, **kwargs)
        finally:
            phases[name] += time.monotonic() - begin

    class TimedTrace(ShapeTrace):
        def attach(self, p):
            super().attach(p)
            phases['startup'] = time.monotonic() - start
            original_wait = p.wait
            p.wait = lambda *a, **kw: measure('wait', original_wait, *a, **kw)

        def failure(self, *args, **kwargs):
            last_write = self.data.get('last_write', {}).get('mono', start + phases['startup'])
            phases['prompt_wait'] = time.monotonic() - last_write
            return measure('snapshot', super().failure, *args, **kwargs)

        def finish(self, p):
            return measure('trace_finish', super().finish, p)

    original_end_tree = shape.lr.end_tree
    with patch.object(shape.lr, 'end_tree',
                      side_effect=lambda *a, **kw: measure('cleanup', original_end_tree, *a, **kw)):
        result = shape.run_typed(shell, 'sleep 60', 1, trace=TimedTrace(path, 'planted-hang'))
    phases['total'] = time.monotonic() - start
    phases['other'] = phases['total'] - sum(v for k, v in phases.items() if k != 'total')
    path.with_name('hang-timing.json').write_text(json.dumps(phases, indent=2) + '\n')
    print(f'planted-hang phases {sys.platform}: {json.dumps(phases, sort_keys=True)}', flush=True)
    return result, phases


class TraceContracts(unittest.TestCase):
    def test_hosted_macos_cleanup_budget(self):
        # Hosted macOS reported 28.064869542 s for the enclosing hang test.
        # This regression fixture must not reinterpret it as a row deadline.
        phases = {'total': 28.064869542}
        assert_hang_time(self, phases, 'darwin')

    def test_total_budgets_remain_bounded_and_platform_specific(self):
        assert_hang_time(self, {'total': 39.9}, 'darwin')
        with self.assertRaises(AssertionError):
            assert_hang_time(self, {'total': 40}, 'darwin')
        assert_hang_time(self, {'total': 24.9}, 'linux')
        with self.assertRaises(AssertionError):
            assert_hang_time(self, {'total': 25}, 'linux')

    def test_total_budget_failure_reports_phases(self):
        phases = {'total': 100, 'startup': 1, 'prompt_wait': 10,
                  'snapshot': 2, 'cleanup': 85, 'wait': 1, 'trace_finish': 1}
        with self.assertRaises(AssertionError) as error:
            assert_hang_time(self, phases, 'darwin')
        for phase in phases:
            self.assertIn(phase, str(error.exception))

    def test_io_is_forwarded_and_ring_is_bounded(self):
        from lib_shape_trace import ShapeTrace
        r, w = os.pipe()
        try:
            with tempfile.TemporaryDirectory() as cwd:
                path = Path(cwd) / 'trace.json'
                trace = ShapeTrace(path, 'unit', capacity=3)
                self.assertEqual(trace.write(w, b'abc\n'), 4)
                self.assertEqual(trace.select([r], 0), [r])
                self.assertEqual(trace.read(r, 4), b'abc\n')
                self.assertEqual(trace.data['last_write']['written'], 4)
                for i in range(8):
                    trace.event('bounded', index=i)
                trace.emit('unit')
                data = json.loads(path.read_text())
                self.assertEqual([e['index'] for e in data['events']], [5, 6, 7])
                self.assertEqual(data['deadline_seconds'], 10)
        finally:
            os.close(r)
            os.close(w)

    @unittest.skipUnless(os.environ.get('PELT_TEST_SHELL'), 'set PELT_TEST_SHELL for live hang trace')
    def test_planted_hang_fails_and_leaves_pre_cleanup_trace(self):
        shell = os.path.abspath(os.environ['PELT_TEST_SHELL'])
        with tempfile.TemporaryDirectory() as cwd:
            path = Path(os.environ.get('PELT_SHAPE_TEST_TRACES', cwd)) / 'hang.json'
            path.unlink(missing_ok=True)
            (rows, ok, why), phases = timed_hang(shell, path)
            message = f'{why}; hang phases (seconds): {json.dumps(phases, sort_keys=True)}'
            self.assertFalse(ok, message)
            self.assertEqual(rows, [-1, -1], message)
            self.assertGreaterEqual(phases['prompt_wait'], 9.5, message)
            assert_hang_time(self, phases, sys.platform)
            data = json.loads(path.read_text())
            self.assertEqual(data['deadline_seconds'], 10, message)
            before = data['before_cleanup']
            self.assertIsNone(before['poll'], message)
            self.assertEqual(before['turn'], 1, message)
            self.assertGreaterEqual(before['child_count'], 1, message)
            self.assertIn('deadline', before['reason'], message)
            self.assertIn('sleep 60', data['last_write']['data'], message)
            self.assertTrue(any(e['kind'] == 'select' and e['prompt_deadline_wall'] is not None
                                for e in data['events'] if e['kind'] == 'select'), message)

    @unittest.skipUnless(os.environ.get('PELT_TEST_SHELL'), 'set PELT_TEST_SHELL for live exit trace')
    def test_exit_is_distinguished_from_deadline(self):
        from lib_shape_trace import ShapeTrace
        shell = os.path.abspath(os.environ['PELT_TEST_SHELL'])
        with tempfile.TemporaryDirectory() as cwd:
            path = Path(os.environ.get('PELT_SHAPE_TEST_TRACES', cwd)) / 'exit.json'
            path.unlink(missing_ok=True)
            start = time.monotonic()
            _, ok, why = shape.run_typed(shell, 'exit 7', 1, trace=ShapeTrace(path, 'exit'))
            self.assertFalse(ok)
            self.assertLess(time.monotonic()-start, 9)
            data = json.loads(path.read_text())
            reason = data['before_cleanup']['reason']
            self.assertNotIn('deadline', reason)
            self.assertTrue('exit' in reason or 'EOF' in reason, why)


class Processes(unittest.TestCase):
    def test_file_shapes_in_one_process(self):
        for kind in ('loop', 'script', 'jobs', 'monitor'):
            with self.subTest(kind=kind), tempfile.TemporaryDirectory() as cwd:
                rows, ok, why = shape.run_file('/bin/sh', kind, ':', 8, cwd)
                self.assertTrue(ok, why)
                self.assertEqual(len(rows), 2)
                self.assertTrue(all(kb > 0 for kb in rows))

    def test_bad_exit_stdout_stderr(self):
        for body in ('exit 3', 'echo unexpected', 'echo unexpected >&2'):
            with self.subTest(body=body), tempfile.TemporaryDirectory() as cwd:
                self.assertFalse(shape.run_file('/bin/sh', 'loop', body, 2, cwd)[1])

    def test_sampler_failure(self):
        with tempfile.TemporaryDirectory() as cwd, patch.object(shape, 'sampler', return_value='__shape_sample() { :; }\n'):
            self.assertFalse(shape.run_file('/bin/sh', 'loop', ':', 2, cwd)[1])

    def test_macos_handshake(self):
        with tempfile.TemporaryDirectory() as cwd, patch.object(shape.sys, 'platform', 'darwin'), patch.object(shape, 'rss_of', side_effect=[111, 222]):
            rows, ok, why = shape.run_file('/bin/sh', 'loop', ':', 2, cwd)
            self.assertTrue(ok, why)
            self.assertEqual(rows, [111, 222])

    @unittest.skipUnless(sys.platform.startswith('linux'), 'timeout tree witness runs in the Linux container')
    def test_timeout_reaps_its_child_by_pid(self):
        with tempfile.TemporaryDirectory() as cwd, patch.object(shape, 'TIMEOUT_SECONDS', 1):
            rows, ok, _ = shape.run_file('/bin/sh', 'loop', 'sleep 60 & echo $! > child.pid; wait', 2, cwd)
            self.assertFalse(ok)
            self.assertEqual(rows, [-1, -1])
            pid = int((Path(cwd) / 'child.pid').read_text())
            with self.assertRaises(ProcessLookupError):
                os.kill(pid, 0)

    @unittest.skipUnless(os.environ.get('PELT_TEST_SHELL'), 'set PELT_TEST_SHELL for pelt e2e rows')
    def test_pelt_file_and_typed_shapes(self):
        shell = os.path.abspath(os.environ['PELT_TEST_SHELL'])
        for kind in ('loop', 'script', 'jobs', 'monitor', 'typed'):
            with self.subTest(kind=kind), tempfile.TemporaryDirectory() as cwd:
                if kind == 'typed':
                    rows, ok, why = shape.run_typed(shell, 'true & wait', 8)
                    self.assertIn('notices=16', why)
                else:
                    rows, ok, why = shape.run_file(shell, kind, ':', 8, cwd)
                self.assertTrue(ok, why)
                self.assertTrue(all(kb > 0 for kb in rows))

    @unittest.skipUnless(os.environ.get('PELT_TEST_SHELL'), 'set PELT_TEST_SHELL for pelt e2e rows')
    def test_pelt_monitor_retains_both_halves_until_after_samples(self):
        shell = os.path.abspath(os.environ['PELT_TEST_SHELL'])
        # Observe the table only AFTER both samples: jobs prints/frees it.
        # If the middle sample had notified/cleared the first half, this
        # would print three completed jobs, not all six.
        script = shape.file_script('monitor', 'env true & wait $!', 3)
        script = script.replace('exec true\n', 'jobs\nexec true\n')
        with tempfile.TemporaryDirectory() as cwd:
            (Path(cwd) / 'shape.sh').write_text(script)
            rc, raw, nerr = shape.run_paused(shell, cwd)
        self.assertEqual(rc, 0, raw)
        self.assertEqual(nerr, 0)
        rows, out, valid = shape.parse_samples(raw)
        self.assertTrue(valid, raw)
        self.assertTrue(all(kb > 0 for kb in rows))
        jobs = [line for line in out.splitlines() if 'Done' in line and line.endswith('env true')]
        self.assertEqual(len(jobs), 6, out)

    @unittest.skipUnless(os.environ.get('PELT_TEST_SHELL'), 'set PELT_TEST_SHELL for pelt e2e rows')
    def test_pelt_typed_wrong_output_and_stderr(self):
        shell = os.path.abspath(os.environ['PELT_TEST_SHELL'])
        for body in ('echo unexpected', 'echo unexpected >&2'):
            with self.subTest(body=body):
                self.assertFalse(shape.run_typed(shell, body, 2)[1])

    @unittest.skipUnless(sys.platform.startswith('linux'), 'smaps_rollup is Linux-only')
    def test_real_retained_buffer_crosses_unchanged_bound(self):
        # Real shell variables, not synthetic sampler output. Unique names
        # retain independent 4 KiB buffers across both checkpoints.
        body = 'eval "SH35_$i=\\\"' + 'x' * 4096 + '\\\""'
        with tempfile.TemporaryDirectory() as cwd:
            rows, ok, why = shape.run_file('/bin/sh', 'loop', body, 1000, cwd)
            self.assertTrue(ok, why)
            self.assertGreater(rows[1] - rows[0], 1000 * 100 // 1024 + 1024)


