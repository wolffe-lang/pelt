#!/usr/bin/env python3
"""oracle-record — write each case's expectation from the oracle.

Runs every case (or the named areas) under `dash` and under
`bash --posix`, and writes <name>.out and <name>.meta from the oracle
the case names (dash unless `oracle=bash`), recording whether the
second opinion agrees. Keys a person wrote in the meta (pending, why,
args, stdin, mode, oracle) are kept.

The oracle is a program we RUN, never a source we read (ruling #43).
Run it where the oracle of record runs: tests/diff/ORACLE names dash and
bash by package and by the sha256 of the programs the corpus runs, and
this refuses (exit 2) unless this host's are exactly those
(tools/lib_oracle.py; tools/oracle-container runs it in the image that
carries them).

usage: tools/oracle-record [--check] [--json FILE] [area ...]
  --check  write nothing; name every case whose recorded standard output,
           exit status or standard-error presence no longer matches the
           oracle (DRIFT, with the old and new lines), and every case
           whose second-opinion flag would change (FLAG); exit 1 if any
  --json   with --check, the same findings as JSON in FILE
"""

import difflib
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib_cases as lc  # noqa: E402
import lib_oracle  # noqa: E402

KEEP = ("mode", "args", "stdin", "oracle", "pending", "why")


def version(cmd):
    out = subprocess.run(cmd, capture_output=True, text=True)
    return (out.stdout or out.stderr).splitlines()[0] if (out.stdout or out.stderr) else ""


def text(data):
    return data.decode("utf-8", "replace") if data is not None else ""


def main(argv):
    check = False
    report = None
    while argv[:1] in (["--check"], ["--json"]):
        if argv[0] == "--check":
            check = True
            argv = argv[1:]
        else:
            report = argv[1]
            argv = argv[2:]
    try:
        lib_oracle.check_host()
    except lib_oracle.Refused as exc:
        print(f"oracle-record: REFUSED: {exc}", file=sys.stderr)
        return 2
    changed = 0
    flags = 0
    findings = []
    for area, name, script in lc.cases(argv or None):
        mpath = script[:-3] + ".meta"
        opath = script[:-3] + ".out"
        old = lc.read_meta(mpath) if os.path.exists(mpath) else {}
        meta = {k: old[k] for k in KEEP if k in old}
        d = lc.run(["dash"], script, meta)
        b = lc.run(["bash", "--posix"], script, meta)
        if d is None or b is None:
            print(f"TIMEOUT {area}/{name} (ended {lc.LAST['ended']} processes)")
            changed += 1
            continue
        primary, second = (b, d) if meta.get("oracle") == "bash" else (d, b)
        meta["exit"] = str(primary["exit"])
        meta["stderr"] = "yes" if primary["stderr"] else "no"
        if meta.get("mode") == "parse":
            meta["line"] = str(primary["line"])
        same = (second["stdout"] == primary["stdout"]
                and second["exit"] == primary["exit"])
        flag = "bash" if meta.get("oracle") != "bash" else "dash"
        meta[flag] = "agree" if same else "differs"
        if check:
            have = open(opath, "rb").read() if os.path.exists(opath) else None
            drift = []
            if have != primary["stdout"]:
                drift.append("stdout")
            if old.get("exit") != meta["exit"]:
                drift.append("exit")
            if old.get("stderr") != meta["stderr"]:
                drift.append("stderr")
            if meta.get("mode") == "parse" and old.get("line") != meta.get("line"):
                drift.append("line")
            item = {"case": f"{area}/{name}", "drift": drift,
                    "exit": [old.get("exit"), meta["exit"]], "stderr": [old.get("stderr"), meta["stderr"]],
                    "stdout": [text(have) if have is not None else None, text(primary["stdout"])],
                    "flag": [f"{flag}={old[flag]}" if flag in old else None, f"{flag}={meta[flag]}"]}
            if drift:
                changed += 1
                print(f"DRIFT {area}/{name}: {', '.join(drift)}")
                if "stdout" in drift:
                    for line in difflib.unified_diff(text(have).splitlines(), text(primary["stdout"]).splitlines(),
                                                     "recorded", "oracle", lineterm="", n=1):
                        print("    " + line)
                for key in ("exit", "stderr", "line"):
                    if key in drift:
                        print(f"    {key}: {old.get(key)} -> {meta.get(key)}")
            if item["flag"][0] != item["flag"][1]:
                flags += 1
                print(f"FLAG {area}/{name}: {item['flag'][0] or '(no ' + flag + '=)'} -> {item['flag'][1]}")
            if drift or item["flag"][0] != item["flag"][1]:
                findings.append(item)
            continue
        with open(opath, "wb") as fh:
            fh.write(primary["stdout"])
        lc.write_meta(mpath, meta)
        print(f"recorded {area}/{name}: exit {meta['exit']}"
              f"{' (bash differs)' if not same else ''}")
    if check:
        if report:
            with open(report, "w", encoding="utf-8") as fh:
                json.dump(findings, fh, indent=1)
                fh.write("\n")
        print(f"oracle-record: {changed} drifted, {flags} second-opinion flags would change")
        return 1 if changed or flags else 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
