#!/usr/bin/env python3
"""Words raw-byte and cross-process persistence laws, owned fresh-HOME ptys."""
from pathlib import Path
import importlib.machinery, importlib.util, os, subprocess, sys, tempfile
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'tools'))
from lib_shadow import Shell
loader=importlib.machinery.SourceFileLoader('colour',str(ROOT/'tools/colour-witness'))
spec=importlib.util.spec_from_loader(loader.name,loader)
colour=importlib.util.module_from_spec(spec)
sys.modules[loader.name]=colour
loader.exec_module(colour)
step=colour.step

def shell(binary,home,args=(),**kw):
    return colour.ready(binary,home,['-o','friendly',*args],**kw)

def abbreviations(binary,home):
    sh=shell(binary,home)
    try:
        step(sh,b"abbr add zz 'echo expanded'\r")
        raw=step(sh,b'zz ')
        assert b'expanded' in raw,('abbr-space',raw)
        raw=step(sh,b'argument\r'); assert b'\r\nexpanded argument\r\n' in raw,raw
        step(sh,b"abbr add qq \"echo 'two words'\"\r")
        raw=step(sh,b'qq \r');assert b'\r\ntwo words\r\n' in raw,raw
        step(sh,b"abbr add empty ''\r")
        step(sh,b'empty ');raw=step(sh,b'echo empty-ok\r');assert b'\r\nempty-ok\r\n' in raw,raw
        step(sh,b'zz ');step(sh,b'\x1f');raw=step(sh,b'\x01echo \x05\r');assert b'\r\nzz\r\n' in raw,raw
        step(sh,b'zz ');step(sh,b'\x03');raw=step(sh,b'echo cancel-ok\r');assert b'\r\ncancel-ok\r\n' in raw,raw
        for typed in [b"echo zz ",b"echo 'zz' "]:
            raw=step(sh,typed+b'\r');assert b'\r\nzz\r\n' in raw,raw
        raw=event_step(sh,b'zz\r');assert b'\r\nexpanded\r\n' in raw,raw
        raw=event_step(sh,b'echo before; zz after\r');assert b'\r\nbefore\r\nexpanded after\r\n' in raw,raw
        print('ok abbr space/Enter/quoted/empty/undo/cancel/command-position',flush=True)
    finally:assert sh.close()
    file=home/'.pelt/abbr';assert file.exists() and b'\x1b' not in file.read_bytes()
    assert file.stat().st_mode & 0o777 == 0o600
    file.write_bytes(file.read_bytes()+b'malformed\ninvalid name\techo BAD\nbad\tbad\tbad\n')
    sh=shell(binary,home)
    try:
        raw=step(sh,b'zz second\r');assert b'\r\nexpanded second\r\n' in raw,raw
        step(sh,b'abbr erase zz\r')
        raw=step(sh,b'abbr list\r');assert b'zz\t' not in raw and b'qq\t' in raw,raw
        before=file.read_bytes()
        collision=home/'.pelt'/('abbr.new.'+str(sh.p.pid));collision.write_text('untouched')
        raw=step(sh,b"abbr add nope 'echo NO'\r")
        assert b'cannot replace abbreviation file' in raw,raw
        assert file.read_bytes()==before and collision.read_text()=='untouched'
        collision.unlink()
        print('ok abbr persistence/atomic/malformed/erase/exclusive-temp',flush=True)
    finally:assert sh.close()
    # A script's text is not edited, even when the option is explicitly on.
    file.write_text('zz\techo EXPANDED\n')
    env=dict(os.environ,HOME=str(home))
    for argv,data in [([str(binary),'-o','friendly','-c','echo zz'],None),([str(binary),'-o','friendly'],b'echo zz\n')]:
        p=subprocess.run(argv,input=data,env=env,capture_output=True,timeout=10)
        assert p.returncode==0 and p.stdout==b'zz\n',('abbr-script-gate',p)
    script=home/'isolation.sh';script.write_text('zz\n')
    for argv,data in [([str(binary),'-o','friendly','-c','zz'],None),([str(binary),'-o','friendly',str(script)],None),([str(binary),'-o','friendly'],b'zz\n')]:
        p=subprocess.run(argv,input=data,env=env,capture_output=True,timeout=10)
        assert p.returncode==127 and p.stdout==b'',('abbr-script-gate',p)
    print('ok abbr-script-gate',flush=True)

def event_step(sh,keys):
    raw=step(sh,keys)
    colour.assert_resets(raw)
    return raw.replace(b"\r\r\n",b"\r\n")

def events(binary,home):
    sh=shell(binary,home)
    try:
        raw=event_step(sh,b'!!\r')
        assert b'pelt: history: no previous word or command' in raw,raw
        assert any('!!' in row for row in sh.screen.snapshot(0)),sh.screen.snapshot(0)
        event_step(sh,b'\x15echo first last\r')
        raw=event_step(sh,b'!!\r');assert b'\r\necho first last\r\nfirst last\r\n' in raw,raw
        event_step(sh,b"echo one 'two three' # ignored comment\r")
        raw=event_step(sh,b'echo !$\r');assert b"\r\necho 'two three'\r\ntwo three\r\n" in raw,raw
        raw=event_step(sh,b"echo '!!'\r");assert b'\r\n!!\r\n' in raw,raw
        event_step(sh,b'echo old last\r')
        raw=event_step(sh,b'echo "!!"\r');assert b'\r\necho "echo old last"\r\necho old last\r\n' in raw,raw
        raw=event_step(sh,b'echo \\!! # !!\r');assert b'\r\n!!\r\n' in raw,raw
        raw=event_step(sh,b'echo !1 !name !-1 !\r');assert b'\r\n!1 !name !-1 !\r\n' in raw,raw
        event_step(sh,b'!!');event_step(sh,b'\x03');raw=event_step(sh,b'echo after-cancel\r');assert b'\r\nafter-cancel\r\n' in raw,raw
        event_step(sh,b"abbr add zz 'echo !$'\r")
        event_step(sh,b'echo before ORDER\r')
        raw=event_step(sh,b'zz \r');assert b'\r\necho ORDER \r\nORDER\r\n' in raw,raw
        event_step(sh,b'set +o histexpand\r')
        raw=event_step(sh,b'echo !! !$\r');assert b'\r\n!! !$\r\n' in raw,raw
        print('ok events echo/last-word/quotes/comments/literals/cancel/abbr-order/toggle',flush=True)
    finally:assert sh.close()
    entries=[p.read_bytes() for p in home.glob('history-*')]
    assert any(b"echo 'two three'\n" in p for p in entries),entries
    assert all(b'\x1b' not in p for p in entries),entries
    print('ok events expanded-history-no-style-bytes',flush=True)
    env=dict(os.environ,HOME=str(home))
    for argv,data in [([str(binary),'-o','friendly','-o','histexpand','-c','echo !! !$'],None),([str(binary),'-o','friendly','-o','histexpand'],b'echo !! !$\n')]:
        p=subprocess.run(argv,input=data,env=env,capture_output=True,timeout=10)
        assert p.returncode==0 and p.stdout==b'!! !$\n',('event-script-gate',p)
    print('ok event-script-gate',flush=True)

def completion(binary,home):
    for name in ['alpha','beta','delta','epsilon','gamma','zeta']:
        (home/name).write_text(name+'\n')
    for cols in [24,40,80,120]:
        sh=shell(binary,home,cols=cols,env={'COLUMNS':None})
        try:
            step(sh,b'echo ')
            raw=step(sh,b'\t')
            assert b'completions ' in raw and b'bytes)' in raw,(cols,raw)
            colour.assert_resets(raw)
            # The marker changes; the command line and persistent history do not.
            raw=step(sh,b'\t');assert b'> alpha' in raw,raw
            assert not any(row.startswith('| $ echo alpha') for row in sh.screen.snapshot(0)),sh.screen.snapshot(0)
            raw=step(sh,b'\x1b[Z');assert b'> zeta' in raw,raw
            raw=step(sh,b'\x1b[B');assert b'> alpha' in raw,raw
            raw=event_step(sh,b'\r');assert b'\r\nalpha\r\n' not in raw,raw
            raw=event_step(sh,b'\r');assert b'\r\nalpha\r\n' in raw,raw
            step(sh,b'echo ');step(sh,b'\t');step(sh,b'\t')
            step(sh,b'\x1b');colour.settled(sh,.2)
            raw=event_step(sh,b'kept\r');assert b'\r\nkept\r\n' in raw,raw
            print('ok completion columns/navigation/accept-not-execute/escape',cols,flush=True)
        finally:assert sh.close()
    sh=shell(binary,home,cols=80,env={'COLUMNS':None})
    try:
        step(sh,b'echo ');step(sh,b'\t');step(sh,b'\t')
        import fcntl, struct, termios
        for cols,rows in [(80,6),(80,24),(16,24),(80,24)]:
            sh.screen.resize(cols,rows)
            fcntl.ioctl(sh.master,termios.TIOCSWINSZ,struct.pack('HHHH',rows,cols,0,0))
            colour.settled(sh,.2)
            assert any('completions' in r for r in sh.screen.snapshot(0)),sh.screen.snapshot(0)
        raw=step(sh,b'\x07');colour.assert_resets(raw)
        raw=event_step(sh,b'after-resize\r');assert b'\r\nafter-resize\r\n' in raw,raw
        print('ok completion resize/restored-line',flush=True)
    finally:assert sh.close()


def help_probe(binary,home):
    fast=home/'probe';slow=home/'slow'
    fast.write_text('#!/bin/sh\nprintf x >> probes\nprintf "  --alpha  First choice\\n  --beta  Second choice\\n"\n')
    slow.write_text('#!/usr/bin/python3\nimport time\nopen("slow-probes","a").write("x")\ntime.sleep(.2)\nprint("  --slow  Too late")\n')
    fast.chmod(0o755);slow.chmod(0o755)
    # A newly created executable's first launch can exceed 50ms on macOS
    # before its code runs (measured 142.5ms vs 3.2-3.6ms thereafter).
    # Warm only these owned fixtures, then remove their markers so the
    # no-execution and once-per-prompt assertions still start from zero.
    # The application's 50ms deadline is unchanged: a cold program may
    # correctly produce no completions and is not our positive fixture.
    for fixture,marker in [(fast,'probes'),(slow,'slow-probes')]:
        warm=subprocess.run([str(fixture),'--help'],cwd=home,capture_output=True,timeout=10)
        assert warm.returncode==0,(fixture,warm)
        assert (home/marker).read_text()=='x',(fixture,'fixture did not run')
        (home/marker).unlink()
    sh=shell(binary,home)
    try:
        step(sh,b'./probe --')
        assert not (home/'probes').exists(),'highlight executed help'
        raw=step(sh,b'\t');assert b'First choice' in raw and b'Second choice' in raw,raw
        step(sh,b'\x07');step(sh,b'\t');step(sh,b'\x07')
        assert (home/'probes').read_text()=='x','uncached help'
        step(sh,b'\x15./slow --');raw=step(sh,b'\t')
        assert b'Too late' not in raw,raw
        step(sh,b'\t');assert (home/'slow-probes').read_text()=='x','uncached timeout'
        print('ok explicit-help-only/description/cache/timeout',flush=True)
    finally:assert sh.close()

if __name__=='__main__':
    binary=Path(sys.argv[1]).resolve()
    with tempfile.TemporaryDirectory(prefix='sh31-words-') as temp:
        abbreviations(binary,Path(temp))
    with tempfile.TemporaryDirectory(prefix="sh31-events-") as temp:
        events(binary,Path(temp))
    with tempfile.TemporaryDirectory(prefix="sh31-pager-") as temp:
        completion(binary,Path(temp))
    with tempfile.TemporaryDirectory(prefix="sh31-help-") as temp:
        help_probe(binary,Path(temp))
    if '--raw-only' not in sys.argv:
        original_ready=colour.ready
        def words_ready(binary,home,**kw):
            sh=original_ready(binary,home,args=['-o','friendly'],**kw)
            event_step(sh,b'echo COST_READY\r')
            raw=event_step(sh,b'!!\r')
            assert b'echo COST_READY' in raw
            return sh
        colour.ready=words_ready
        with tempfile.TemporaryDirectory(prefix="sh31-cost-") as temp:
            colour.cost(binary,Path(temp))
