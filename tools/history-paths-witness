#!/usr/bin/env python3
"""History while a command runs and variable-path lookup on owned ptys.

No reference implementation source; fresh HOME/SHELL and explicit executable.
Usage: tools/history-paths-witness PELT [history|paths|ROW]
"""
from pathlib import Path
import os
import subprocess
import sys
import tempfile
import termios
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib_shadow import Shell


def settle(sh, duration=.12):
    end = time.monotonic() + duration
    while time.monotonic() < end:
        sh.pump(.002)


def start(binary, home, history=None, extra=None):
    env = dict(SHELL='/bin/sh', HISTFILE=str(history or home/'history'))
    env.update(extra or {})
    sh = Shell(binary, home, ['-o', 'friendly', '+o', 'suggest', '+o', 'highlight'],
               tty_out=True, cols=200, env_overrides=env)
    settle(sh)
    sh.type(b'\x0c')
    settle(sh)
    return sh


def command(sh, text):
    before = len(sh.data['tty'])
    sh.type(text + b'\r')
    sh.until(lambda: b'$ ' in sh.data['tty'][before:] or sh.p.poll() is not None)
    settle(sh)
    return sh.data['tty'][before:].replace(b'\r\r\n', b'\r\n')


def history_running(binary, home):
    history = home/'history'
    sh = start(binary, home, history)
    try:
        sh.type(b'read sh40_pending\r')
        settle(sh)
        got = history.read_bytes()
        assert b'read sh40_pending\n' in got, ('history-running', got)
        sh.type(b'done\r')
        settle(sh)
    finally:
        # Let a blocked read finish even when the assertion failed.
        sh.type(b'done\r')
        settle(sh)
        sh.close()
    sh = start(binary, home, history)
    try:
        raw = command(sh, b'fc -ln')
        assert b'read sh40_pending' in raw, raw
        command(sh, b'set -o histsearch')
        sh.type(b'\x12sh40_pending')
        settle(sh)
        assert any('read sh40_pending' in row for row in sh.screen.snapshot(0)), sh.screen.snapshot(0)
        sh.type(b'\x07\x15')
    finally:
        sh.close()


def history_exec(binary, home):
    history = home/'history'
    sh = start(binary, home, history)
    try:
        sh.type(b'exec /usr/bin/true\r')
        sh.until(lambda: sh.p.poll() is not None)
        assert sh.p.returncode == 0, sh.p.returncode
        assert b'exec /usr/bin/true\n' in history.read_bytes(), history.read_bytes()
    finally:
        sh.close()


def history_fc(binary, home):
    history = home/'history'
    sh = start(binary, home, history)
    try:
        command(sh, b'echo fc-before')
        command(sh, b'fc -s')
        got = history.read_bytes()
        assert b'fc -s\n' not in got and got.count(b'echo fc-before\n') == 2, got
    finally:
        sh.close()


def history_fc_peer(binary, home):
    history = home/'history'
    sh = start(binary, home, history)
    try:
        command(sh, b'echo fc-before')
        sh.type(b'read sh40_pending; fc -s\r')
        # The peer appends after this shell's own line, which is written
        # before the command runs.
        sh.until(lambda: b'read sh40_pending; fc -s\n' in history.read_bytes())
        with history.open('ab') as out:
            out.write(b'echo peer-appended\n')
        # The retraction happens before `fc -s` reruns `echo fc-before`,
        # and the prompt only after that: wait for it, not for a fixed time
        # that a slow sync of the replacement file can outlast.
        command(sh, b'done')
        got = history.read_bytes()
        assert b'echo peer-appended\n' in got, got
        assert b'read sh40_pending; fc -s\n' not in got, got
    finally:
        sh.type(b'done\r')
        settle(sh)
        sh.close()


# Each file sync the shell requests is made this slow (tools/sync-delay.c).
SYNC_MS = 500


def sync_shim(home):
    """Compile the sync interposer into this row's own directory."""
    source = Path(__file__).resolve().parent/'sync-delay.c'
    if sys.platform == 'darwin':
        lib, flags = home/'sync-delay.dylib', ['-dynamiclib']
    else:
        lib, flags = home/'sync-delay.so', ['-shared', '-fPIC']
    tail = [] if sys.platform == 'darwin' else ['-ldl']
    subprocess.run([os.environ.get('CC', 'cc'), *flags, '-O2', '-o', str(lib), str(source), *tail],
                   check=True)
    return lib


def syncs(log):
    try:
        return log.read_text().count('BEGIN ')
    except FileNotFoundError:
        return 0


def slow_shell(binary, home):
    """A shell whose every file sync takes SYNC_MS, its editor installed."""
    history = home/'history'
    log = home/'sync.log'
    preload = 'DYLD_INSERT_LIBRARIES' if sys.platform == 'darwin' else 'LD_PRELOAD'
    env = {'SHELL': '/bin/sh', 'HISTFILE': str(history), preload: str(sync_shim(home)),
           'PELT_SYNC_DELAY_MS': str(SYNC_MS), 'PELT_SYNC_LOG': str(log)}
    # Job control on (an interactive shell's default): the job gets a
    # process group of its own and the terminal with it.
    argv = [str(binary), '-i', '-m', '+o', 'friendly', '+o', 'suggest', '+o', 'histsearch',
            '+o', 'highlight']
    sh = Shell(binary, home, tty_out=True, cols=200, env_overrides=env, fullargv=argv)
    old = len(sh.data['tty'])
    sh.type(b'\x0c')
    sh.until(lambda: b'\x1b[2J' in sh.data['tty'][old:])
    settle(sh)
    return sh, history, log


def slow_sync_launch(binary, home):
    """`sleep 5` typed at a shell whose every file sync takes SYNC_MS.

    Answers what was seen: how long the job took to own the terminal
    after Enter, the syncs requested by then and by the next prompt,
    whether the line was in the file when the job started, and `jobs`
    after Ctrl-Z."""
    sh, history, log = slow_shell(binary, home)
    seen = {}
    try:
        before = syncs(log)
        start = time.monotonic()
        sh.type(b'sleep 5\r')
        owner = sh.p.pid
        while owner == sh.p.pid and time.monotonic() - start < 5:
            sh.pump(.001)
            owner = os.tcgetpgrp(sh.master)
        seen['launch_ms'] = (time.monotonic() - start) * 1000
        seen['job_owned_terminal'] = owner != sh.p.pid
        seen['syncs_before_launch'] = syncs(log) - before
        seen['line_saved_at_launch'] = b'sleep 5\n' in history.read_bytes()
        mark = len(sh.data['tty'])
        sh.type(b'\x1a')
        sh.until(lambda: b'$ ' in sh.data['tty'][mark:] or sh.p.poll() is not None)
        sh.until(lambda: not termios.tcgetattr(sh.master)[3] & termios.ICANON
                 or sh.p.poll() is not None)
        seen['syncs_by_prompt'] = syncs(log) - before
        seen['jobs'] = command(sh, b'jobs')
        command(sh, b'kill -9 %1')
    finally:
        sh.close()
    print('  measured slow-sync launch ' + repr(seen), flush=True)
    return seen


def history_launch_unsynced(binary, home):
    seen = slow_sync_launch(binary, home)
    assert seen['job_owned_terminal'], seen
    # Durability is the prompt's: the launch requests no sync and waits for none.
    assert seen['syncs_before_launch'] == 0, seen
    assert seen['launch_ms'] < SYNC_MS, seen
    assert seen['line_saved_at_launch'], seen
    # So Ctrl-Z reaches the job's group, not the shell's.
    assert b'Stopped' in seen['jobs'] and b'sleep 5' in seen['jobs'], seen


def history_prompt_unsynced(binary, home):
    """Between a command's output and the next prompt no sync is asked
    for or waited on: the prompt comes back as fast as with no file."""
    sh, history, log = slow_shell(binary, home)
    seen = []
    try:
        for k in range(3):
            before = syncs(log)
            old = len(sh.data['tty'])
            mark = f'\nprompt-{k}\r\n'.encode()
            sh.type(f'echo prompt-{k}\r'.encode())
            t_out = t_next = stop = None
            end = time.monotonic() + 10
            while time.monotonic() < end:
                sh.pump(.0005)
                now = time.monotonic()
                at = sh.data['tty'].find(mark, old)
                if t_out is None and at >= 0:
                    t_out, stop = now, at + len(mark)
                if t_out is not None and len(sh.data['tty']) > stop:
                    t_next = now
                    break
            sh.until(lambda: b'$ ' in sh.data['tty'][old:] or sh.p.poll() is not None)
            sh.until(lambda: not termios.tcgetattr(sh.master)[3] & termios.ICANON
                     or sh.p.poll() is not None)
            seen.append({'next_byte_ms': None if t_next is None else round((t_next - t_out) * 1000, 2),
                         'syncs': syncs(log) - before})
    finally:
        sh.close()
    print('  measured prompt after output ' + repr(seen), flush=True)
    assert all(x['next_byte_ms'] is not None and x['next_byte_ms'] < SYNC_MS and x['syncs'] == 0
               for x in seen), seen


def history_exit_sync(binary, home):
    """The shell's end asks for the sync the prompts no longer do."""
    sh, history, log = slow_shell(binary, home)
    try:
        command(sh, b'echo exit-sync')
        before = syncs(log)
        sh.type(b'exit\r')
        sh.until(lambda: sh.p.poll() is not None, timeout=15)
        seen = {'syncs_at_exit': syncs(log) - before, 'status': sh.p.returncode,
                'saved': b'echo exit-sync\n' in history.read_bytes()}
    finally:
        sh.close()
    print('  measured exit ' + repr(seen), flush=True)
    assert seen['syncs_at_exit'] > 0 and seen['saved'], seen


def hangup(binary, home, running):
    """The terminal goes away (its master closed, as when a window
    closes) while the shell is at a prompt or waiting on a job."""
    sh, history, log = slow_shell(binary, home)
    seen = {}
    try:
        command(sh, b'echo hangup-before')
        if running:
            sh.type(b'sleep 30\r')
            start = time.monotonic()
            while os.tcgetpgrp(sh.master) == sh.p.pid and time.monotonic() - start < 5:
                sh.pump(.001)
        before = syncs(log)
        os.close(sh.master)
        try:
            sh.p.wait(timeout=15)
        except subprocess.TimeoutExpired:
            pass
        seen = {'ended': sh.p.poll() is not None, 'status': sh.p.returncode,
                'syncs_after_hangup': syncs(log) - before,
                'saved': history.read_bytes().count(b'\n')}
    finally:
        if sh.p.poll() is None:
            sh.p.kill()
            sh.p.wait()
    print('  measured hangup ' + ('running ' if running else '') + repr(seen), flush=True)
    assert seen['ended'] and seen['syncs_after_hangup'] > 0, seen


def history_hangup_sync(binary, home):
    hangup(binary, home, False)


def history_hangup_job_sync(binary, home):
    hangup(binary, home, True)


def path_case(binary, home, typed, want, extra=None, continuation=None):
    (home/'unique-path').mkdir(exist_ok=True)
    for d in ('absolute path', 'relative path'):
        (home/d).mkdir(exist_ok=True)
        (home/d/'leaf').mkdir(exist_ok=True)
    env = dict(ABS=str(home/'absolute path'), REL='relative path')
    env.update(extra or {})
    sh = start(binary, home, extra=env)
    try:
        if continuation:
            sh.type(continuation + b'\r')
            settle(sh)
        sh.type(typed + b'\t')
        settle(sh)
        lines = sh.screen.snapshot(0)
        assert any(row.endswith(want) for row in lines if row.startswith('| ')), (typed, want, lines)
        # Cancel rather than executing a redirection or an incomplete word.
        sh.type(b'\x03')
        settle(sh)
        assert not (home/'side-effect').exists(), 'completion evaluated a substitution'
    finally:
        sh.close()


PATHS = [
    ('path-home', b'echo $HOME/uni', 'echo $HOME/unique-path/'),
    ('path-brace', b'echo ${HOME}/uni', 'echo ${HOME}/unique-path/'),
    ('path-double', b'echo "$HOME/uni', 'echo "$HOME/unique-path/'),
    ('path-absolute-space', b'echo $ABS/le', 'echo $ABS/leaf/'),
    ('path-relative-space', b'echo $REL/le', 'echo $REL/leaf/'),
    ('path-assignment', b'DEST=$HOME/uni', 'DEST=$HOME/unique-path/'),
    ('path-redirection', b': > $HOME/uni', ': > $HOME/unique-path/'),
    ('path-command', b'$HOME/uni', '$HOME/unique-path/'),
    ('path-mixed', b'echo "$HOME"/"${REL}"/le', 'echo "$HOME"/"${REL}"/leaf/'),
    ('path-single-literal', b"echo '$HOME/uni", "echo '$HOME/uni"),
    ('path-escaped-literal', b'echo \\$HOME/uni', 'echo \\$HOME/uni'),
    ('path-unset', b'echo $SH40_UNSET/uni', 'echo $SH40_UNSET/uni'),
    ('path-no-eval', b'echo $(echo side-effect > side-effect)/uni', 'echo $(echo side-effect > side-effect)/uni'),
]


def boundary_case(binary, home, typed, want):
    for name in ('shortME', 'longsuffix'):
        (home/name/'xylophone').mkdir(parents=True)
    path_case(binary, home, typed, want,
              extra={'HO': str(home/'short'), 'HOME': str(home/'long')})


def main():
    binary = Path(sys.argv[1]).resolve()
    only = sys.argv[2] if len(sys.argv) > 2 else 'all'
    rows = [('history-running', history_running), ('history-exec', history_exec), ('history-fc', history_fc), ('history-fc-peer', history_fc_peer),
            ('history-launch-unsynced', history_launch_unsynced), ('history-prompt-unsynced', history_prompt_unsynced),
            ('history-exit-sync', history_exit_sync), ('history-hangup-sync', history_hangup_sync),
            ('history-hangup-job-sync', history_hangup_job_sync)]
    for name, typed, want in PATHS:
        rows.append((name, lambda b, h, t=typed, w=want: path_case(b, h, t, w)))
    for name, typed, want in [
        ('path-boundary-double', b'echo "$HO"ME/xy', 'echo "$HO"ME/xylophone/'),
        ('path-boundary-suffix', b'echo $HOME"suffix"/xy', 'echo $HOME"suffix"/xylophone/'),
        ('path-boundary-braced', b'echo ${HO}ME', 'echo ${HO}ME/'),
    ]:
        rows.append((name, lambda b, h, t=typed, w=want: boundary_case(b, h, t, w)))
    rows.append(('path-heredoc-quoted', lambda b, h: path_case(
        b, h, b'$HOME/uni', '$HOME/uni', continuation=b"cat <<'EOF'")))
    rows.append(('path-continued-double', lambda b, h: path_case(
        b, h, b'"$HOME/uni', '"$HOME/unique-path/', continuation=b'echo \\')))
    failed = 0
    for name, row in rows:
        if only not in ('all', name, 'history' if name.startswith('history') else 'paths'):
            continue
        with tempfile.TemporaryDirectory(prefix='pelt-history-paths-') as d:
            try:
                row(binary, Path(d))
                print('PASS ' + name, flush=True)
            except Exception as e:
                print('FAIL ' + name + ' ' + repr(e), flush=True)
                failed += 1
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
