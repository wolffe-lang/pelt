#!/usr/bin/env python3
"""Load the extensionless words witness without the removed load_module API.

The macOS CI interpreter has removed that API. Hide it on older Python too,
so every host reproduces the same compatibility boundary without a binary.
Also verify that warm-up retains empty marker files for later timeout rows.
"""
import importlib.machinery
from pathlib import Path
import runpy
import tempfile
from unittest.mock import patch

ROOT = Path(__file__).resolve().parents[1]
BaseLoader = importlib.machinery.SourceFileLoader


class ModernSourceFileLoader(BaseLoader):
    def __getattribute__(self, name):
        if name == 'load_module':
            raise AttributeError('load_module is unavailable on modern Python')
        return super().__getattribute__(name)


with patch.object(importlib.machinery, 'SourceFileLoader', ModernSourceFileLoader):
    witness = runpy.run_path(str(ROOT / 'tools' / 'words-witness'),
                            run_name='words_loader_regression')

colour = witness['colour']
assert isinstance(colour.__loader__, ModernSourceFileLoader), 'loader boundary not exercised'
for name in ('step', 'ready', 'assert_resets', 'cost'):
    assert callable(getattr(colour, name)), ('colour helper missing', name)
for name in ('abbreviations', 'events', 'completion', 'help_probe'):
    assert callable(witness[name]), ('words witness missing', name)
print('ok words-loader: extensionless helpers load without load_module')

# The timeout row reads this file even when startup uses its entire budget.
# Exercise the lifecycle directly, independent of the host's scheduling.
with tempfile.TemporaryDirectory(prefix='sh31-marker-regression-') as temp:
    home = Path(temp)
    fixture = home / 'fixture'
    marker = home / 'marker'
    fixture.write_text('#!/bin/sh\nprintf x >> marker\n')
    fixture.chmod(0o755)
    for _ in range(2):
        witness['warm_help_fixture'](fixture, marker)
        assert marker.read_text() == '', 'warm-up did not leave a zero-count marker'
        # The actual probe's one append remains distinguishable from warm-up.
        with marker.open('a') as stream:
            stream.write('x')
        assert marker.read_text() == 'x'
        marker.write_text('')
print('ok words-fixture: warm-up retains an empty marker for later rows')
