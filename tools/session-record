#!/usr/bin/env python3
"""session-record — write each session case's transcript from the oracle.

Types every case (or the named ones) into `dash -i +m` through a
pseudo-terminal, pacing by quiet (tools/lib_session.py), and writes
<name>.tr; types it into `bash --posix -i +m` too and records in the
meta whether the second opinion agrees on standard output and the exit
status (its prompts and its messages are its own). When the second
opinion differs, its whole transcript is printed, indented, with a diff
of the compared view, so a reader can see how. Keys a person wrote in
the meta are kept.

The oracle is a program we RUN, never a source we read (ruling #43).
Run it where the oracle of record runs: it refuses (exit 2) unless this
host's dash and bash are exactly the ones tests/diff/ORACLE names, by
package and program digest (tools/lib_oracle.py; tools/oracle-container
--session runs it in the image that carries them).

usage: tools/session-record [--check] [--no-second] [case ...]
  --check      write nothing; exit 1 when a recorded transcript no longer
               matches what this host's oracle answers (DRIFT), or a
               second-opinion flag would change (FLAG)
  --no-second  the oracle alone: no second opinion is run, and the
               meta's `bash=` is left out (sh15 runs dash only)
"""

import difflib
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib_oracle  # noqa: E402
import lib_session as ls  # noqa: E402

KEEP = ("args", "pelt_args", "oracle_args", "env", "oracle", "compare", "pending", "why",
        "screen", "cols", "rows", "screen_by", "tr_by")


def show_second(name, who, first, other):
    """The second opinion's transcript and how its compared view differs."""
    print(f"SECOND {name}: {who} differs on standard output or the exit; its transcript, then the compared view against the oracle's:")
    for ln in other:
        print("    " + ln)
    for ln in difflib.unified_diff(ls.stdout_and_exit(first), ls.stdout_and_exit(other), "oracle", who, lineterm="", n=1):
        print("    " + ln)


def main(argv):
    sys.stdout.reconfigure(line_buffering=True)
    check = False
    second = True
    while argv[:1] in (["--check"], ["--no-second"]):
        if argv[0] == "--check":
            check = True
        else:
            second = False
        argv = argv[1:]
    try:
        lib_oracle.check_host(names=("dash", "bash") if second else ("dash",))
    except lib_oracle.Refused as exc:
        print(f"session-record: REFUSED: {exc}", file=sys.stderr)
        return 2
    drift = 0
    for name, keys in ls.cases(argv or None):
        mpath = keys[:-5] + ".meta"
        trp = keys[:-5] + ".tr"
        old = ls.read_meta(mpath)
        if old.get("tr_by") == "hand":
            # a transcript written by hand (pelt chose otherwise than
            # both oracles, said in `why=`): no oracle can record it
            print(f"kept {name}: written by hand")
            continue
        meta = {k: old[k] for k in KEEP if k in old}
        first, other = ls.ORACLE, ls.SECOND
        if meta.get("oracle") == "bash":
            first, other = ls.SECOND, ls.ORACLE
        view = ls.stdout_and_exit if meta.get("compare") == "stdout" else (lambda t: t)
        d = ls.run(ls.argv_for(first, meta, False), keys, meta)
        dash_sig = ls.last_sig
        scr1 = ls.last_screens
        # a second recording: the transcript must not depend on timing
        d2 = ls.run(ls.argv_for(first, meta, False), keys, meta)
        if view(d) != view(d2):
            print(f"UNSTABLE {name}: two {first[0]} runs differ")
            drift += 1
            continue
        spec = meta.get("screen")
        # a screen written by hand (`screen_by=hand`) is kept as it is
        record_screen = spec is not None and meta.get("screen_by") != "hand"
        judged = ls.screen_steps(spec, len(scr1)) if record_screen else []
        if record_screen and [scr1[i] for i in judged] != [ls.last_screens[i] for i in judged if i < len(ls.last_screens)]:
            print(f"UNSTABLE {name}: two {first[0]} screens differ")
            drift += 1
            continue
        same = True
        flag = "dash" if meta.get("oracle") == "bash" else "bash"
        if second:
            b = ls.run(ls.argv_for(other, meta, False), keys, meta)
            same = ls.stdout_and_exit(b) == ls.stdout_and_exit(d)
            meta[flag] = "agree" if same else "differs"
            if not same:
                show_second(name, flag, d, b)
        if check:
            have = open(trp, encoding="utf-8").read().split("\n")[:-1] if os.path.exists(trp) else None
            if have is None or view(have) != view(d):
                print(f"DRIFT {name}")
                drift += 1
            if second and old.get(flag) != meta[flag]:
                print(f"FLAG {name}: {flag + '=' + old[flag] if flag in old else '(no ' + flag + '=)'} -> {flag}={meta[flag]}")
                drift += 1
            continue
        with open(trp, "w", encoding="utf-8") as fh:
            fh.write("\n".join(d) + "\n")
        if record_screen:
            ls.write_screen(keys[:-5] + ".screen", scr1, spec)
        ls.write_meta(mpath, meta)
        sig = f" (dash {dash_sig})" if dash_sig else ""
        print(f"recorded {name}: {d[-1]}{'' if same else ' (bash differs)'}{sig}")
    if check:
        print(f"session-record: {drift} drifted")
    return 1 if drift else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
