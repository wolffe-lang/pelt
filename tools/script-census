def R(args="", setup="", env=None, stdin="", timeout=120, ignore="", mask=""):
    """One run of a script: operands, a setup snippet (ours; run by the
    image's /bin/sh in the working directory before the script), extra
    environment, standard input, the timeout in seconds, a regular
    expression (an awk ERE, matched against the path) of files the listing leaves out, and a
    regular expression whose matches in standard output are masked
    before the comparison (a date the script prints)."""
    return {"args": args, "setup": setup, "env": env or {}, "stdin": stdin,
            "timeout": timeout, "ignore": ignore, "mask": mask}


