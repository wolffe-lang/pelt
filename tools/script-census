AIDED = r"""
s#(^|[^/[:alnum:]_.-])test (! )?-([xwrLh]) #\1/usr/bin/test \2-\3 #g
s#(^|[^[:alnum:]_/"'.[-])\[ (! )?-([xwrLh]) #\1/usr/bin/[ \2-\3 #g
s#^([[:space:]]*)umask #\1: umask #
s#\(umask #(: umask #g
/^[[:space:]]*trap /s# 13( |$)# PIPE\1#
s#for ac_signal in 1 2 13 15#for ac_signal in 1 2 PIPE 15#
s#^([[:space:]]*)\[\\\\/\$\]\* \| \?:\[\\\\/\]\* ?\)#\1/* | \\\\* | '$'* | ?:/* | ?:\\\\* )#
s#^([[:space:]]*)\[\\\\/\]\* \| \?:\[\\\\/\]\* ?\)#\1/* | \\\\* | ?:/* | ?:\\\\* )#
s#^([[:space:]]*)\*\[\\\\/\]\* ?\)#\1*/* | *\\\\* )#
"""

# ---------------------------------------------------------------- engine


def die(msg):
    print(f"script-census: {msg}", file=sys.stderr)
    sys.exit(2)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for b in iter(lambda: fh.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


class Census:
    def __init__(self, root, pelt, podman, pin, aided=False):
        self.aided = aided
        self.root = os.path.abspath(root)
        self.pelt = pelt
        self.podman = shlex.split(podman)
        self.pin = pin
        self.pins = {}
        if os.path.exists(PINS):
            for line in open(PINS, encoding="utf-8"):
                if line.strip() and not line.startswith("#"):
                    k, v = line.split()
                    self.pins[k] = v
        self.seen = {}
        for d in ("dl", "tree", "run", "logs", "logs-aided"):
            os.makedirs(os.path.join(self.root, d), exist_ok=True)

    # -- inputs
    def build(self):
        for name, text in IMAGES.items():
            d = os.path.join(self.root, "img", name)
            os.makedirs(d, exist_ok=True)
            with open(os.path.join(d, "Containerfile"), "w", encoding="utf-8") as fh:
                fh.write(text)
            print(f"script-census: building sh06-{name}", flush=True)
            r = subprocess.run(self.podman + ["build", "-q", "-t", f"sh06-{name}", d])
            if r.returncode:
                die(f"image {name} did not build")

    def tree(self, key):
        """The extracted (and, for PREP rows, built) tree for a source."""
        url, want, top = SOURCES[key]
        dest = os.path.join(self.root, "tree", key)
        if os.path.exists(os.path.join(dest, ".ready")):
            return dest
        arc = os.path.join(self.root, "dl", os.path.basename(url) if key != "pfetch" else "pfetch-0.6.0.tar.gz")
        if not os.path.exists(arc):
            print(f"script-census: {url}", flush=True)
            urllib.request.urlretrieve(url, arc)
        have = sha256(arc)
        if have != want:
            die(f"REFUSED — {os.path.basename(arc)} sha256 {have}, pin wants {want}")
        tmp = dest + ".x"
        shutil.rmtree(tmp, ignore_errors=True)
        with tarfile.open(arc) as tf:
            tf.extractall(tmp, filter="tar")
        shutil.rmtree(dest, ignore_errors=True)
        os.rename(os.path.join(tmp, top), dest)
        shutil.rmtree(tmp)
        if key in PREP:
            image, cmd = PREP[key]
            hold = os.path.join(self.root, "run", f"prep-{key}")
            shutil.rmtree(hold, ignore_errors=True)
            os.makedirs(os.path.join(hold, "meta"))
            os.rename(dest, os.path.join(hold, "t"))
            print(f"script-census: preparing {key} in sh06-{image} (network off)", flush=True)
            r = subprocess.run(self.podman + ["run", "--rm", "--network", "none",
                                              "-v", f"{hold}:/s", "-w", "/s/t",
                                              f"sh06-{image}", "sh", "-c", cmd])
            os.rename(os.path.join(hold, "t"), dest)
            shutil.copy(os.path.join(hold, "meta", "build.log"),
                        os.path.join(self.root, "logs", f"prep-{key}.log"))
            shutil.rmtree(hold)
            if r.returncode:
                die(f"preparing {key} failed (logs/prep-{key}.log)")
        open(os.path.join(dest, ".ready"), "w").close()
        return dest

    # -- one run
    def run(self, s, n, r, shell, tag=None):
        """Run `s`'s n-th row under `shell` (dash|pelt) in a fresh
        container. Answers a dict: exit, out, err (bytes), files (text),
        sha (the script's digest), hung."""
        name = f"sh06-{s['id']}-{n}-{tag or shell}".replace(":", "_")
        hold = os.path.join(self.root, "run", name)
        shutil.rmtree(hold, ignore_errors=True)
        for d in ("bin", "meta", "w"):
            os.makedirs(os.path.join(hold, d))
        if s["src"]:
            subprocess.run(["cp", "-a", "--reflink=auto", self.tree(s["src"]),
                            os.path.join(hold, "t")], check=True)
        if shell == "pelt":
            shutil.copy(self.pelt, os.path.join(hold, "bin", "sh"))
        with open(os.path.join(hold, "meta", "in"), "w", encoding="utf-8") as fh:
            fh.write(r["stdin"])
        env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "HOME": "/root",
               "LC_ALL": "C", "TERM": "dumb"}
        env.update(r["env"])
        envs = " ".join(f"{k}={shlex.quote(v)}" for k, v in env.items())
        ignore = r["ignore"] or "^$"
        aid = ""
        if self.aided:
            with open(os.path.join(hold, "meta", "aided.sed"), "w", encoding="utf-8") as fh:
                fh.write(AIDED)
            aid = (f"case {shlex.quote(s['path'])} in /*|./*) "
                   f"sed -E -i -f /s/meta/aided.sed {shlex.quote(s['path'])} {s['also']} ;; esac")
        wrap = f"""#!/bin/sh
# The wrapper: ours, run by the image's own /bin/sh.
if [ {shell} = dash ]; then cp "$(command -v dash)" /s/bin/sh; fi
cd {shlex.quote(s['cwd'])} || exit 99
{r['setup']}
case {shlex.quote(s['path'])} in
/*|./*) sha256sum {shlex.quote(s['path'])} | cut -d' ' -f1 >/s/meta/sha ;;
esac
{aid}
# Every directory, link and file (by digest) in the places a script may
# write, before and after: what the run made, changed or removed.
snap() {{
    D="/s/w /s/t /etc /var /run /root /home /usr/local /srv /opt /tmp"
    {{
        find $D -xdev -type d 2>/dev/null | sed 's/^/d /'
        find $D -xdev -type l -exec sh -c 'for f; do echo "l $f -> $(readlink "$f")"; done' _ {{}} + 2>/dev/null
        find $D -xdev -type f -print0 2>/dev/null | xargs -0 sha256sum 2>/dev/null |
            sed 's/^\\([0-9a-f]*\\)  \\(.*\\)$/f \\2 \\1/'
    }} | re={shlex.quote(ignore)} awk '$2 !~ ENVIRON["re"]' | LC_ALL=C sort
}}
snap >/s/meta/before
env -i {envs} timeout -s KILL {r['timeout']} /s/bin/sh {shlex.quote(s['path'])} {r['args']} \
    >/s/meta/out 2>/s/meta/err </s/meta/in
echo $? >/s/meta/exit
cd /
snap >/s/meta/after
{{
    LC_ALL=C comm -13 /s/meta/before /s/meta/after | sed 's/^/+ /'
    LC_ALL=C comm -23 /s/meta/before /s/meta/after | sed 's/^/- /'
}} >/s/meta/files
chmod -R a+rwX /s 2>/dev/null
exit 0
"""
        with open(os.path.join(hold, "meta", "wrap.sh"), "w", encoding="utf-8") as fh:
            fh.write(wrap)
        t0 = time.time()
        try:
            subprocess.run(self.podman + ["run", "--rm", "--network", "none",
                                          "--hostname", "census", "--name", name,
                                          "-v", f"{hold}:/s", f"sh06-{s['image']}",
                                          "sh", "/s/meta/wrap.sh"],
                           timeout=r["timeout"] + 120, capture_output=True)
        except subprocess.TimeoutExpired:
            subprocess.run(self.podman + ["kill", name], capture_output=True)
            subprocess.run(self.podman + ["rm", "-f", name], capture_output=True)
        took = time.time() - t0

        def rd(f, mode="rb"):
            p = os.path.join(hold, "meta", f)
            if not os.path.exists(p):
                return b"" if mode == "rb" else ""
            with open(p, mode) as fh:
                return fh.read()
        ex = rd("exit", "r").strip()
        res = {"exit": int(ex) if ex else -1, "out": rd("out"), "err": rd("err"),
               "files": rd("files", "r"), "sha": rd("sha", "r").strip(),
               "took": took}
        if r["mask"]:
            res["out"] = re.sub(r["mask"].encode(), b"~", res["out"])
        res["hung"] = res["exit"] in (137, -1) and took >= r["timeout"]
        log = os.path.join(self.root, "logs-aided" if self.aided else "logs", name)
        os.makedirs(log, exist_ok=True)
        for f in ("out", "err", "files", "exit", "wrap.sh"):
            p = os.path.join(hold, "meta", f)
            if os.path.exists(p):
                shutil.copy(p, os.path.join(log, f))
        subprocess.run(["chmod", "-R", "u+rwX", hold], capture_output=True)
        shutil.rmtree(hold, ignore_errors=True)
        return res

    def check_pin(self, s, sha):
        if not sha or self.aided and not self.pin and s["id"] not in self.pins:
            return
        if self.pin:
            self.seen[s["id"]] = sha
        elif self.pins.get(s["id"]) != sha:
            die(f"REFUSED — {s['id']} ({s['path']}) sha256 {sha}, pin wants "
                f"{self.pins.get(s['id'], '(none)')}")

    def script(self, s):
        """Answers (verdict, dash exits, pelt exits, notes)."""
        notes = []
        verdict = "same"
        de, pe = [], []
        for n, r in enumerate(s["runs"]):
            d = self.run(s, n, r, "dash")
            self.check_pin(s, d["sha"])
            d2 = self.run(s, n, r, "dash", "dash2")
            p = self.run(s, n, r, "pelt")
            de.append(str(d["exit"]))
            pe.append("hang" if p["hung"] else str(p["exit"]))
            if d["hung"]:
                notes.append(f"run {n}: dash itself timed out")
                verdict = "unstable"
                continue
            stable = (d["out"] == d2["out"] and d["exit"] == d2["exit"]
                      and d["files"] == d2["files"])
            if p["hung"]:
                notes.append(f"run {n} [{r['args']}]: pelt killed at {r['timeout']} s")
                verdict = "hang"
                continue
            why = []
            if p["exit"] != d["exit"]:
                why.append(f"exit {p['exit']} (dash {d['exit']})")
            if stable and p["out"] != d["out"]:
                why.append("stdout")
            if bool(p["err"].strip()) != bool(d["err"].strip()):
                why.append("stderr " + ("present" if p["err"].strip() else "absent"))
            if stable and p["files"] != d["files"]:
                why.append("files")
            if why:
                notes.append(f"run {n} [{r['args']}]: " + ", ".join(why))
                if verdict == "same" or verdict == "unstable":
                    verdict = "differs"
            elif not stable:
                what = [k for k in ("out", "exit", "files") if d[k] != d2[k]]
                notes.append(f"run {n}: dash disagrees with itself ({', '.join(what)}); "
                             "exit and stderr only")
                if verdict == "same":
                    verdict = "unstable"
        return verdict, de, pe, notes


def main(argv):
    opt = {"dir": None, "pelt": None, "podman": "podman", "tsv": None}
    flags = set()
    ids = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--dir", "--pelt", "--podman", "--tsv"):
            if i + 1 >= len(argv):
                die(f"{a} needs a value")
            opt[a[2:]] = argv[i + 1]
            i += 2
        elif a in ("--build", "--pin", "--list", "--strict", "--aided"):
            flags.add(a)
            i += 1
        elif a.startswith("-"):
            die(f"unknown option {a}")
        else:
            ids.append(a)
            i += 1
    todo = [s for s in SET if not ids or s["id"] in ids or s["group"] in ids]
    if "--list" in flags:
        for s in todo:
            print(f"{s['id']}\t{s['group']}\t{s['image']}\t{s['pkg']} {s['version']}\t{len(s['runs'])} runs")
        return 0
    if not opt["dir"] or not opt["pelt"]:
        die("--dir and --pelt are required (see the header)")
    if not os.access(opt["pelt"], os.X_OK):
        die(f"no pelt at {opt['pelt']} (tools/build --static)")
    if "--aided" in flags and "--pin" in flags:
        die("--aided checks the pins; it does not write them")
    c = Census(opt["dir"], os.path.abspath(opt["pelt"]), opt["podman"], "--pin" in flags,
               "--aided" in flags)
    if "--build" in flags:
        c.build()
    print(f"script-census: pelt = {c.pelt} sha256 {sha256(c.pelt)}", flush=True)
    rows = []
    count = {}
    for s in todo:
        verdict, de, pe, notes = c.script(s)
        count[verdict] = count.get(verdict, 0) + 1
        sha = c.seen.get(s["id"]) or c.pins.get(s["id"], "")
        print(f"{verdict:<8} {s['id']}  dash {','.join(de)}  pelt {','.join(pe)}", flush=True)
        for nt in notes:
            print(f"         {nt}", flush=True)
        rows.append([s["id"], s["group"], s["pkg"], s["version"], sha, s["licence"],
                     ",".join(de), ",".join(pe), verdict, "; ".join(notes)])
    tsv = opt["tsv"] or os.path.join(c.root, "scripts-aided.tsv" if c.aided else "scripts.tsv")
    with open(tsv, "w", encoding="utf-8") as fh:
        fh.write("id\tgroup\tpackage\tversion\tsha256\tlicence\tdash_exit\tpelt_exit\tverdict\tnotes\n")
        for row in rows:
            fh.write("\t".join(row) + "\n")
    if c.pin:
        merged = dict(c.pins)
        merged.update(c.seen)
        with open(PINS, "w", encoding="utf-8") as fh:
            fh.write("# script-census pins: id, sha256 of the script file. Written by --pin.\n")
            for k in sorted(merged):
                fh.write(f"{k} {merged[k]}\n")
    total = sum(count.values())
    print("script-census: " + "  ".join(f"{k} {v}" for k, v in sorted(count.items()))
          + f"  of {total}  ({tsv})")
    if "--strict" in flags and count.get("same", 0) != total:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
