#!/usr/bin/env python3
"""edit-witness — the line editor gives the terminal back, asked from
outside.

pelt runs interactively on a fresh pseudo-terminal (tools/lib_session.py's
arrangement); a second hold on the terminal reads its modes (ICANON,
ECHO, ISIG) before pelt starts, while it edits, and after. Each scenario
types part of a line, so the editor is in the middle of one, and then:

  hup       SIGHUP from outside: pelt dies of SIGHUP (as dash does), and
            the terminal's modes are back as they were
  term      SIGTERM: an interactive shell ignores it; the line goes on
            being edited, and the modes are restored when it exits
  int       SIGINT from outside (not the key): the line is abandoned, a
            new prompt comes, `$?` is 130 (XCU sh, ASYNCHRONOUS EVENTS)
  hangup    the terminal goes away (the other side closed): pelt sees the
            end of input and exits
  editing   while a line is edited the modes ARE changed (or the other
            scenarios prove nothing)
  kill      SIGKILL: nothing can restore the modes. Reported, never a
            failure: it is what no handler can do (wolf runs none, and
            the runtime restores nothing, [os.term.mode])

Since sh15 (wolf 0.2.30's terminal surface, ruling #73):

  flags     while a line is edited IXON and IEXTEN are off (so Ctrl-S,
            Ctrl-Q, Ctrl-V and Ctrl-O reach the editor), and a command
            run from the line sees them on again, as the user set them
  idle      an idle prompt makes no context switches: the shell's, every
            thread's, counted over 10 s from outside (linux
            /proc/PID/task/*/status; macOS `top -stats csw`). sh11's
            editor read with VTIME 1 and polled: about ten a second.
            Fails above 2 in the 10 s; SKIP where neither source exists
  int-latency  `kill -INT` at an idle prompt, 20 times: the time to the
            next prompt. A timed read answered within its tenth of a
            second (median about 50 ms); a wait a signal ends answers at
            once. Fails at a median of 30 ms or more
  resize    the window changes while a line is edited: the editor draws
            the line again (bytes on the terminal within 2 s, the line
            among them), and the line still runs

Since sh16 (Tab completion, ruling #69 R3):

  tab-latency  Tab at an empty command name reads every `PATH`
            directory: the bell (several names, nothing in common) and,
            on the next Tab, the question before a list taller than the
            window; `n` draws the prompt again. 10 times each: fails at
            a median of 0.5 s or more for either (trunk before sh16
            inserted the tab: no bell at all)

Exit 0 when every scenario but `kill` holds, 1 when one does not, 2 when
the harness cannot run.

usage: tools/edit-witness PELT
"""

import fcntl
import os
import pty
import re
import select
import signal
import struct
import subprocess
import sys
import termios
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib_session as ls  # noqa: E402


class Shell:
    def __init__(self, pelt, home):
        self.master, slave = pty.openpty()
        self.hold = os.dup(slave)
        self.before = ls._lmode(slave)
        rout, wout = os.pipe()
        rerr, werr = os.pipe()
        env = {"PATH": "/usr/bin:/bin", "HOME": home, "LC_ALL": "C", "PS1": "$ "}
        self.p = subprocess.Popen([pelt, "-i"], stdin=slave, stdout=wout, stderr=werr,
                                  env=env, cwd=home, start_new_session=True,
                                  preexec_fn=ls._ctty, close_fds=True)
        os.close(slave)
        os.close(wout)
        os.close(werr)
        self.fds = {rout: "out", rerr: "err", self.master: "tty"}
        self.out = b""
        self.err = b""
        self.tty = b""

    def pump(self, secs):
        end = time.time() + secs
        while time.time() < end:
            live = [fd for fd in self.fds]
            if not live:
                time.sleep(0.05)
                continue
            r, _, _ = select.select(live, [], [], max(0.0, min(0.05, end - time.time())))
            for fd in r:
                try:
                    d = os.read(fd, 65536)
                except OSError:
                    d = b""
                if not d:
                    del self.fds[fd]
                    continue
                if self.fds[fd] == "out":
                    self.out += d
                elif self.fds[fd] == "err":
                    self.err += d
                else:
                    self.tty += d

    def wait_prompt(self, n, secs=8):
        end = time.time() + secs
        while time.time() < end:
            self.pump(0.1)
            if self.err.count(b"$ ") >= n:
                return True
        return False

    def type(self, b):
        os.write(self.master, b)

    def mode(self):
        return ls.term_lmode(self.master, self.hold)

    def flags(self):
        """IXON and IEXTEN as the terminal has them now."""
        try:
            a = termios.tcgetattr(self.master)
        except (termios.error, OSError):
            a = termios.tcgetattr(self.hold)
        return bool(a[0] & termios.IXON), bool(a[3] & termios.IEXTEN)

    def done(self, secs=3):
        """Wait for the shell to end, reading the terminal meanwhile (on
        macOS a pty's output drains only when it is read, and a shell
        putting its mode back waits for the drain)."""
        end = time.time() + secs
        while self.p.poll() is None and time.time() < end:
            self.pump(0.05)
        return self.p.poll()

    def close(self):
        if self.p.poll() is None:
            os.kill(self.p.pid, signal.SIGKILL)
            self.p.wait()
        for fd in list(self.fds):
            os.close(fd)
        try:
            os.close(self.master)
        except OSError:
            pass
        os.close(self.hold)


def ctx_switches(pid):
    """The process's context switches so far, every thread; None when
    this host has no way to say."""
    task = f"/proc/{pid}/task"
    if os.path.isdir(task):
        total = 0
        for t in os.listdir(task):
            try:
                with open(f"{task}/{t}/status", encoding="utf-8") as fh:
                    for ln in fh:
                        if ln.startswith(("voluntary_ctxt_switches:", "nonvoluntary_ctxt_switches:")):
                            total += int(ln.split()[1])
            except OSError:
                pass
        return total
    try:
        r = subprocess.run(["top", "-l", "1", "-pid", str(pid), "-stats", "pid,csw"],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    for ln in r.stdout.splitlines():
        f = ln.split()
        if len(f) >= 2 and f[0] == str(pid):
            m = re.match(r"(\d+)", f[1])
            return int(m.group(1)) if m else None
    return None


def scenario(pelt, home, name):
    sh = Shell(pelt, home)
    try:
        if not sh.wait_prompt(1):
            return False, "no first prompt"
        sh.type(b"echo par")
        sh.pump(0.5)
        editing = sh.mode()
        if name == "editing":
            ok = editing != sh.before
            sh.type(b"\x15exit\r")
            sh.done()
            return ok, f"modes before {sh.before:#x}, while editing {editing}"
        if name == "hup":
            os.kill(sh.p.pid, signal.SIGHUP)
            rc = sh.done()
            after = sh.mode()
            ok = rc == -signal.SIGHUP and after == sh.before
            return ok, f"status {rc}, modes after {after} (before {sh.before})"
        if name == "term":
            os.kill(sh.p.pid, signal.SIGTERM)
            sh.pump(0.5)
            alive = sh.p.poll() is None
            sh.type(b"t\r")
            sh.wait_prompt(2)
            sh.type(b"exit\r")
            rc = sh.done()
            after = sh.mode()
            ok = alive and sh.out == b"part\n" and rc == 0 and after == sh.before
            return ok, f"alive after TERM {alive}, output {sh.out!r}, status {rc}, modes restored {after == sh.before}"
        if name == "int":
            os.kill(sh.p.pid, signal.SIGINT)
            got = sh.wait_prompt(2, 3)
            sh.type(b"echo st=$?\r")
            sh.wait_prompt(3)
            sh.type(b"exit\r")
            rc = sh.done()
            after = sh.mode()
            ok = got and sh.out == b"st=130\n" and rc == 0 and after == sh.before
            return ok, f"new prompt {got}, output {sh.out!r}, status {rc}, modes restored {after == sh.before}"
        if name == "hangup":
            os.close(sh.master)
            del sh.fds[sh.master]
            rc = sh.done(5)
            return rc is not None, f"status {rc}"
        if name == "flags":
            before = (bool((sh.before >> 32) & termios.IXON), bool(sh.before & termios.IEXTEN))
            editing = sh.flags()
            sh.type(b"t; stty -a | tr ' ' '\\n' | grep -E '^-?(ixon|iexten)$' | sort\r")
            sh.wait_prompt(2)
            sh.type(b"exit\r")
            rc = sh.done()
            after = sh.mode()
            ok = (before == (True, True) and editing == (False, False)
                  and sh.out == b"part\niexten\nixon\n" and rc == 0 and after == sh.before)
            return ok, (f"ixon/iexten before {before}, while editing {editing}, "
                        f"a command saw {sh.out!r}, status {rc}, modes restored {after == sh.before}")
        if name == "idle":
            sh.pump(1.0)
            c0 = ctx_switches(sh.p.pid)
            if c0 is None:
                sh.type(b"\x15exit\r")
                sh.done()
                return None, "SKIP: no source of context switches on this host"
            sh.pump(10.0)
            c1 = ctx_switches(sh.p.pid)
            sh.type(b"\x15exit\r")
            rc = sh.done()
            n = c1 - c0
            return n <= 2 and rc == 0, f"{n} context switches in 10 s at an idle prompt ({n / 10:.1f}/s), status {rc}"
        if name == "int-latency":
            sh.type(b"\x15")
            sh.pump(0.3)
            times = []
            for i in range(20):
                have = sh.err.count(b"$ ")
                # a random phase against any read's own clock
                sh.pump(0.05 + (i * 37 % 100) / 1000)
                t0 = time.time()
                os.kill(sh.p.pid, signal.SIGINT)
                while sh.err.count(b"$ ") <= have and time.time() - t0 < 3:
                    sh.pump(0.001)
                times.append(time.time() - t0)
            sh.type(b"exit 0\r")
            rc = sh.done()
            after = sh.mode()
            times.sort()
            med = times[len(times) // 2]
            ok = med < 0.030 and times[-1] < 3 and rc == 0 and after == sh.before
            return ok, (f"kill -INT to the next prompt, 20 times: median {med * 1000:.1f} ms, "
                        f"max {times[-1] * 1000:.1f} ms, status {rc}, modes restored {after == sh.before}")
        if name == "resize":
            seen = len(sh.tty)
            fcntl.ioctl(sh.hold, termios.TIOCSWINSZ, struct.pack("HHHH", 24, 30, 0, 0))
            t0 = time.time()
            while b"echo par" not in sh.tty[seen:] and time.time() - t0 < 2:
                sh.pump(0.01)
            drawn = b"echo par" in sh.tty[seen:]
            took = time.time() - t0
            sh.type(b"t\r")
            sh.wait_prompt(2)
            sh.type(b"exit\r")
            rc = sh.done()
            after = sh.mode()
            ok = drawn and sh.out == b"part\n" and rc == 0 and after == sh.before
            return ok, (f"redrawn after the resize {drawn}" + (f" ({took * 1000:.1f} ms)" if drawn else "")
                        + f", output {sh.out!r}, status {rc}, modes restored {after == sh.before}")
        if name == "tab-latency":
            sh.type(b"\x15")
            sh.pump(0.3)
            firsts = []
            seconds = []

            def until(pat, seen):
                t0 = time.time()
                while pat not in sh.tty[seen:] and time.time() - t0 < 3:
                    sh.pump(0.001)
                return time.time() - t0 if pat in sh.tty[seen:] else 99.0

            for _i in range(10):
                seen = len(sh.tty)
                sh.type(b"\t")
                firsts.append(until(b"\x07", seen))
                seen = len(sh.tty)
                sh.type(b"\t")
                seconds.append(until(b"(y or n)", seen))
                seen = len(sh.tty)
                sh.type(b"n")
                until(b"$ ", seen)
            sh.type(b"\x15exit\r")
            rc = sh.done()
            after = sh.mode()
            firsts.sort()
            seconds.sort()
            m1 = firsts[len(firsts) // 2]
            m2 = seconds[len(seconds) // 2]
            ok = m1 < 0.5 and m2 < 0.5 and rc == 0 and after == sh.before
            return ok, (f"Tab at an empty command name, 10 times: the bell median {m1 * 1000:.1f} ms "
                        f"(max {firsts[-1] * 1000:.1f}), the question median {m2 * 1000:.1f} ms "
                        f"(max {seconds[-1] * 1000:.1f}), status {rc}, modes restored {after == sh.before}")
        if name == "kill":
            os.kill(sh.p.pid, signal.SIGKILL)
            rc = sh.done()
            after = sh.mode()
            return True, f"status {rc}, modes restored {after == sh.before} (nothing can restore them)"
        return False, "unknown scenario"
    finally:
        sh.close()


def timed_out(_sig, _frame):
    # where it hung, for the log
    import faulthandler
    faulthandler.dump_traceback(sys.stdout)
    raise TimeoutError()


def main(argv):
    sys.stdout.reconfigure(line_buffering=True)
    if len(argv) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    pelt = os.path.abspath(argv[0])
    if not os.access(pelt, os.X_OK):
        print(f"edit-witness: no pelt at {pelt}", file=sys.stderr)
        return 2
    import tempfile
    home = tempfile.mkdtemp(prefix="pelt-edit-witness.")
    bad = 0
    try:
        names = ("editing", "hup", "term", "int", "hangup", "kill",
                 "flags", "idle", "int-latency", "resize", "tab-latency")
        skipped = 0
        for name in names:
            # a scenario that hangs is a failure with a name, not a job
            # timeout with none
            signal.signal(signal.SIGALRM, timed_out)
            signal.alarm(60)
            try:
                ok, why = scenario(pelt, home, name)
            except TimeoutError:
                ok, why = False, "no answer in 60 s"
            signal.alarm(0)
            if ok is None:
                print(f"SKIP {name}: {why}")
                skipped += 1
                continue
            print(f"{'ok  ' if ok else 'FAIL'} {name}: {why}")
            bad += not ok
    finally:
        import shutil
        shutil.rmtree(home, ignore_errors=True)
    print(f"edit-witness: {len(names) - bad - skipped} ok, {bad} failed, {skipped} skipped")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
