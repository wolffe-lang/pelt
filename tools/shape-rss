#!/usr/bin/env python3
"""shape-rss — does a shell's memory stay flat, construct by construct?

tools/loop-rss holds a loop of simple commands flat. This holds the
other shapes a long script or a long session repeats (pelt#19): a
pipeline, a command substitution, a subshell, a function call, an
arithmetic assignment, a long script of one line repeated, and lines
typed at the prompt. Each shape runs through N then 2N turns in ONE
process (N is -n, or
the row's own where a small leak needs more turns to cross the 1 MiB),
and memory at 2N may be at most BOUND_B bytes a turn (plus 1 MiB of
allocator steps) above N, as tools/loop-rss's bound reads.

  loop    `while [ $i -lt 2N ]; do BODY; i=$((i+1)); done`
  script  a fixed script of 2N lines, each LINE, then `echo done`
  typed   LINE typed 2N times through a pseudo-terminal (lib_session.py)

All shapes checkpoint at N and 2N. Linux: the shell itself reads
/proc/self/smaps_rollup Anonymous + Swap, using only built-ins (no
child or file-backed pages). macOS: the same shell pauses at a checkpoint
while the harness reads `ps -o rss=`; no cross-process subtraction.
Missing or malformed samples fail, never silently select another metric.

Every run must also answer what the shape counts (`echo $i`, `done`),
with nothing on standard error, or the shape fails whatever its memory.
Each loop and script prelude defines `f() { :; }` and
`g() { local v; v=$1; return 0; }`.

usage: tools/shape-rss [-n N] [-b BOUND_B] [--only NAME[,NAME…]] [--list] SHELL
Exits 1 when any shape grows past its bound or answers wrongly.
"""

import os
import pty
import select
import subprocess
import sys
import tempfile
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib_session as ls  # noqa: E402

PRELUDE = "f() { :; }\ng() { local v; v=$1; return 0; }\n"

# (name, kind, text[, N]): N, when given, is the row's own turn count
# (its bound scales with it); every other row takes -n
SHAPES = [
    ("baseline", "loop", ":"),
    # A monitored loop retains notices until the complete command ends.
    # Dash is ~0-16 B/job; allow 160 B/job plus 64 KiB arena granularity.
    # Sample before notices/exec, inside the same complete command.
    # Keep R-sh24-2's stricter bound; never count file-backed pages on Linux.
    ("jobs-set-m", "monitor", "env true & wait $!", 3000, 160, 64),
    ("compound-brace-redir", "loop", "{ true; } >/dev/null"),
    ("compound-if-redir", "loop", "if true; then :; fi >/dev/null"),
    ("compound-while-redir", "loop", "while false; do :; done >/dev/null"),
    # sh24: jobs has no loop counter in this script; its own list must
    # not allocate a fresh header per call. A stricter per-row bound.
    ("jobs-loop", "jobs", "jobs", 100000, 16),
    ("pipeline", "loop", "true | true"),
    ("pipeline-program", "loop", "echo x | cat >/dev/null"),
    ("substitution", "loop", "x=$(true)"),
    ("substitution-output", "loop", "x=$(echo y)"),
    ("backquote", "loop", "x=`true`"),
    ("substitution-pipeline", "loop", "x=$(echo a | cat)"),
    ("subshell", "loop", "( true )"),
    ("call", "loop", "f a b"),
    ("call-local", "loop", "g a b"),
    ("arith-assign", "loop", ": $((j=j+1))"),
    ("case", "loop", "case a in a) :;; esac"),
    ("for", "loop", "for j in 1; do :; done"),
    ("script-simple", "script", "true"),
    ("script-pipeline", "script", "true | true"),
    ("script-substitution", "script", "x=$(true)"),
    ("script-call", "script", "f"),
    ("typed-pipeline", "typed", "true | true"),
    ("typed-and", "typed", "true && true"),
    ("typed-brace", "typed", "{ true; }"),
    ("typed-if", "typed", "if true; then :; fi"),
    ("typed-substitution", "typed", "x=$(true)"),
    # sh18: with job control (on in an interactive shell) every program
    # is a job of its own, and an ended job leaves the table
    ("typed-program", "typed", "env true"),
    ("typed-pipeline-program", "typed", "echo x | cat >/dev/null"),
    # sh19 (pelt#33): a built-in the fast path does not serve runs the
    # lean ordinary path (no list made a turn), the command after `&`
    # starts on the fast path, `wait $!`'s job is forgotten at the next
    # one, and a job's notice and text keep nothing but the text. At
    # trunk `cc2fdc9` these kept 600 to 2,300 B a turn
    # (notes/sh19-evidence/logs/base-bgshapes.log). One row starts a
    # program (`env true`, 30,000 spawns: two minutes on a macOS runner);
    # the rest are built-ins, which take the same paths
    ("builtin-wait", "loop", "wait"),
    ("builtin-export", "loop", "export X"),
    ("builtin-kill", "loop", "kill -0 $$"),
    ("background-wait", "loop", "env true & wait"),
    ("background-builtin-wait", "loop", "true & wait"),
    ("background-wait-pid", "loop", "true & wait $!"),
    ("script-background-wait", "script", "true & wait"),
    ("typed-background-wait", "typed", "true & wait"),
    # sh22 (pelt#39): the built-ins the lean path did not reach (a
    # redirection, `eval`'s parser, `cd`'s strings, `command`'s copies,
    # `umask`'s `chars()`), and a job nobody waits for (its slot, its
    # process entry, its unreaped child). At trunk `90d7c64` they kept
    # 131 to 1,700 B a turn (notes/sh22-evidence/logs/base-shapes.log).
    # A row's own N, where the trunk's leak is too small to cross the
    # bound's 1 MiB at 10,000 turns: `command true` and `umask 022` kept
    # ~150 B a turn, `true &` ~210.
    ("builtin-read-redir", "loop", "read x </dev/null"),
    ("builtin-eval", "loop", "eval :"),
    ("builtin-cd", "loop", "cd ."),
    ("builtin-command", "loop", "command true", 100000),
    ("builtin-umask", "loop", "umask 022", 100000),
    ("background-nowait", "loop", "true &", 20000),
    ("background-program-nowait", "loop", "env true &"),
    # sh20 (pelt#34, ruling #90): the shapes that fork (`src/sh/fork.lu`),
    # each a process a turn. What the parent keeps of one is what a spawned
    # program costs it (the runtime's child-table entry), and nothing of
    # the child's memory or of its exit is the parent's. Since sh20 the
    # rows above that run a list after `&` or a substitution of more than
    # one command fork too (`true & wait`, `true &`, `x=$(echo a | cat)`)
    ("fork-substitution", "loop", "x=$(true; true)"),
    ("fork-subshell", "loop", "( true; true )"),
    ("fork-background-group", "loop", "{ true; } & wait"),
    # R-sh25-1: keep 100 B/turn; add 256 KiB for measured peak-RSS spread.
    ("fork-background-subshell", "loop", "( true ) & wait", 10000, 100, 1280),
    ("fork-stage", "loop", "{ true; } | true"),
    ("script-fork-substitution", "script", "x=$(true; true)"),
    ("typed-fork-subshell", "typed", "( true; true )"),
    # a subshell with redirections of its own forks whatever its body
    # (they are its process's, `sh.exec`'s `run_paren_redir`)
    ("fork-redirected-subshell", "loop", "( true ) >/dev/null"),
]

ENV = {"PATH": "/usr/bin:/bin", "HOME": "/", "LC_ALL": "C"}


def linux_sampler():
    # One physical line also works when typed at the interactive prompt.
    # Prefix all scratch names so a shape's i, j, x and functions survive.
    # A failed open/read leaves 'missing', which the harness rejects.
    return ('__shape_sample() { __shape_a=missing; __shape_s=missing; '
            'while read __shape_k __shape_v __shape_u; do '
            'case "$__shape_k" in '
            'Anonymous:) __shape_a=$__shape_v ;; '
            'Swap:) __shape_s=$__shape_v ;; esac; '
            'done </proc/self/smaps_rollup; '
            'echo "__shape_memory=$__shape_a,$__shape_s"; }\n')


def sampler():
    if sys.platform.startswith("linux"):
        return linux_sampler()
    return '__shape_sample() { echo __shape_pause; read __shape_ack; }\n'


def parse_samples(raw):
    rows, out = [], []
    valid = True
    for line in raw.splitlines():
        if line.startswith("__shape_memory="):
            fields = line[len("__shape_memory="):].split(",")
            if len(fields) != 2 or not all(f.isascii() and f.isdigit() for f in fields):
                valid = False
            else:
                rows.append(sum(int(f) for f in fields))
        else:
            out.append(line)
    valid = valid and len(rows) == 2
    return rows if valid else [-1, -1], "\n".join(out).strip(), valid


def file_script(kind, text, n):
    script = PRELUDE + sampler()
    if kind == "monitor":
        script += "exec 2>/dev/null\nset -m\n"
    if kind in ("loop", "monitor"):
        script += (f"i=0\nwhile [ $i -lt {2 * n} ]; do\n{text}\ni=$((i+1))\n"
                   f"if [ $i -eq {n} ] || [ $i -eq {2 * n} ]; then __shape_sample; fi\n")
        # Both samples precede notices. Keep exec in the same complete
        # command, without clearing the retained table between N and 2N.
        script += "done; echo $i; exec true\n" if kind == "monitor" else "done\necho $i\n"
    else:
        # Fixed input, one process: no subtraction of a separate jobs
        # control's peak (which included unrelated file/parser storage).
        half = (text + "\n") * n + "__shape_sample\n"
        script += half + half + "echo done\n"
    return script


def run_paused(shell, cwd):
    """No procfs: the SAME shell blocks in read while ps samples its pid."""
    with subprocess.Popen([shell, "shape.sh"], cwd=cwd, env=ENV, stdin=subprocess.PIPE,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE) as p:
        streams = [p.stdout, p.stderr]
        pending, out, err = b"", b"", b""
        deadline = time.monotonic() + 600
        try:
            while streams:
                if time.monotonic() >= deadline:
                    raise subprocess.TimeoutExpired(p.args, 600)
                ready, _, _ = select.select(streams, [], [], 0.5)
                for stream in ready:
                    data = os.read(stream.fileno(), 65536)
                    if not data:
                        streams.remove(stream)
                        continue
                    if stream == p.stderr:
                        err += data
                        continue
                    pending += data
                    while b"\n" in pending:
                        line, pending = pending.split(b"\n", 1)
                        if line == b"__shape_pause":
                            kb = rss_of(p.pid)
                            out += f"__shape_memory={kb},0\n".encode()
                            p.stdin.write(b"continue\n")
                            p.stdin.flush()
                        else:
                            out += line + b"\n"
            return p.wait(timeout=10), (out + pending).decode(errors="replace"), len(err)
        finally:
            if p.poll() is None:
                p.kill()
                p.wait()


def run_file(shell, kind, text, n, cwd):
    with open(os.path.join(cwd, "shape.sh"), "w") as f:
        f.write(file_script(kind, text, n))
    try:
        if sys.platform.startswith("linux"):
            r = subprocess.run([shell, "shape.sh"], cwd=cwd, env=ENV,
                               capture_output=True, text=True, timeout=600)
            rc, raw, nerr = r.returncode, r.stdout, len(r.stderr)
        else:
            rc, raw, nerr = run_paused(shell, cwd)
    except (OSError, subprocess.TimeoutExpired) as e:
        return [-1, -1], False, str(e)
    rows, out, valid = parse_samples(raw)
    want = str(2 * n) if kind in ("loop", "monitor") else "done"
    ok = valid and rc == 0 and out == want and nerr == 0
    return rows, ok, f"exit {rc} out {out!r} stderr_bytes {nerr} samples_valid={valid}"


def rss_of(pid):
    out = subprocess.run(["ps", "-o", "rss=", "-p", str(pid)],
                         capture_output=True, text=True).stdout.strip()
    return int(out) if out else -1


def run_typed(shell, text, n):
    """Two checkpoints in one actual interactive session, plus its answer."""
    master, slave = pty.openpty()
    rout, wout = os.pipe()
    rerr, werr = os.pipe()
    p = subprocess.Popen([shell, "-i"], stdin=slave, stdout=wout, stderr=werr, env=ENV,
                         start_new_session=True, preexec_fn=ls._ctty)
    os.close(slave)
    os.close(wout)
    os.close(werr)
    got = {"out": b"", "err": b"", "errors": b""}

    def wait_prompt():
        deadline = time.time() + 10
        while time.time() < deadline:
            r, _, _ = select.select([rout, rerr, master], [], [], 0.5)
            for fd in r:
                try:
                    d = os.read(fd, 65536)
                except OSError:
                    d = b""
                if fd == rerr:
                    got["err"] += d
                elif fd == rout:
                    got["out"] += d
            if got["err"].endswith(b"$ "):
                got["errors"] += got["err"][:-2]
                got["err"] = b""
                return True
        return False

    line = (text + "; i=$((i+1))\n").encode()
    rows = []
    try:
        if not wait_prompt():
            return [-1, -1], False, "no first prompt"
        if sys.platform.startswith("linux"):
            os.write(master, linux_sampler().encode())
            if not wait_prompt():
                return [-1, -1], False, "no prompt after sampler definition"
        for k in range(1, 2 * n + 1):
            os.write(master, line)
            if not wait_prompt():
                return [-1, -1], False, f"no prompt after line {k}"
            if k == n or k == 2 * n:
                if sys.platform.startswith("linux"):
                    os.write(master, b"__shape_sample\n")
                    if not wait_prompt():
                        return [-1, -1], False, f"no prompt after sample {k}"
                else:
                    rows.append(rss_of(p.pid))
        os.write(master, b"echo $i\n")
        if not wait_prompt():
            return [-1, -1], False, "no prompt after answer"
        os.write(master, b"exit\n")
        # keep reading while the shell leaves: it puts the terminal's
        # mode back as it goes, and on macOS that waits for the pty's
        # output to be read (a run that stopped reading here timed out)
        deadline = time.time() + 30
        while p.poll() is None and time.time() < deadline:
            r, _, _ = select.select([rout, rerr, master], [], [], 0.2)
            for fd in r:
                try:
                    d = os.read(fd, 65536)
                except OSError:
                    d = b""
                if fd == rout:
                    got["out"] += d
                elif fd == rerr:
                    got["errors"] += d
        # Drain output written just before exit, even if poll already saw
        # the exit. Otherwise a late answer could be lost on a busy host.
        for fd, key in ((rout, "out"), (rerr, "errors")):
            while select.select([fd], [], [], 0)[0]:
                data = os.read(fd, 65536)
                if not data:
                    break
                got[key] += data
        if p.poll() is None:
            return [-1, -1], False, "still running 30 s after `exit`"
    finally:
        if p.poll() is None:
            p.kill()
            p.wait()
        for fd in (rout, rerr, master):
            os.close(fd)
    raw = got["out"].decode(errors="replace")
    if sys.platform.startswith("linux"):
        rows, out, valid = parse_samples(raw)
    else:
        out, valid = raw.strip(), len(rows) == 2 and all(kb >= 0 for kb in rows)
    ok = valid and p.returncode == 0 and out == str(2 * n) and not got["errors"]
    return rows if valid else [-1, -1], ok, f"exit {p.returncode} out {out!r} stderr_bytes {len(got['errors'])} samples_valid={valid}"


def main(argv):
    n = 10000
    bound_b = 100
    only = None
    while argv[:1] in (["-n"], ["-b"], ["--only"], ["--list"]):
        if argv[0] == "--list":
            for row in SHAPES:
                name, kind, text = row[:3]
                print(f"{name:24} {kind:7} {text}")
            return 0
        if argv[0] == "-n":
            n = int(argv[1])
        elif argv[0] == "-b":
            bound_b = int(argv[1])
        else:
            only = set(argv[1].split(","))
        argv = argv[2:]
    if len(argv) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    shell = os.path.abspath(argv[0])
    base_n = n
    failed = []
    for row in SHAPES:
        name, kind, text = row[:3]
        n = row[3] if len(row) > 3 else base_n
        row_bound = row[4] if len(row) > 4 else bound_b
        slack_kb = row[5] if len(row) > 5 else 1024
        limit = n * row_bound // 1024 + slack_kb
        if only is not None and name not in only:
            continue
        if kind == "typed":
            rows, ok, why = run_typed(shell, text, n)
        else:
            with tempfile.TemporaryDirectory(prefix="shape-rss.") as cwd:
                rows, ok, why = run_file(shell, kind, text, n, cwd)
        grew = rows[1] - rows[0]
        per = grew * 1024 // n
        verdict = "ok" if ok and grew <= limit else "FAIL"
        metric = "Anonymous+Swap" if sys.platform.startswith("linux") else "RSS"
        detail = f" metric={metric} bound={row_bound}B+{slack_kb}KiB"
        print(f"shape-rss: {verdict:4} {name:24} {kind:6} {n:>6} {rows[0]:>8} KB  "
              f"{2 * n:>6} {rows[1]:>8} KB  grew {grew:>7} KB ({per} B a turn)  [{text}]{detail}", flush=True)
        if not ok:
            print(f"shape-rss:      {name}: wrong answer ({why})")
        if verdict != "ok":
            failed.append(name)
    if failed:
        print(f"shape-rss: FAIL {len(failed)}: {', '.join(failed)} "
              f"(default bound {bound_b} B a turn + 1 MiB over N turns; row overrides shown above)")
        return 1
    print(f"shape-rss: ok (default bound {bound_b} B a turn + 1 MiB over N turns; row overrides shown above)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
