#!/usr/bin/env python3
"""Found but not executable: name the path, return dash's 126, hint only at a friendly prompt.
PELT_NOEXEC_DIR may name a noexec mount prepared by the enclosing container.
"""
from pathlib import Path
import os, shlex, shutil, subprocess, sys, tempfile
sys.path.insert(0,str(Path(__file__).resolve().parent))
from lib_shadow import Shell


def check(name,ok,detail):
    print(('ok ' if ok else 'FAIL ')+name+' '+str(detail),flush=True)
    return ok


def main(binary):
    binary=str(Path(binary).resolve())
    dash=shutil.which('dash')
    if not dash:raise RuntimeError('dash is required')
    ok=True
    with tempfile.TemporaryDirectory(prefix='refusal-') as temp:
        home=Path(temp)
        script=home/'setup.sh';script.write_text('#!/bin/sh\necho should-not-run\n');script.chmod(0o644)
        odd=home/"a 'file.sh";odd.write_text(script.read_text());odd.chmod(0o644)
        (home/'folder').mkdir()
        rows=[('file','./setup.sh'),('quoted',"./a 'file.sh"),('directory','./folder'),('path-file',str(script))]
        env=dict(os.environ,PATH=str(home)+':/usr/bin:/bin')
        noexec=os.environ.get('PELT_NOEXEC_DIR')
        if noexec:
            p=Path(noexec)/'refused-script.sh';p.write_text(script.read_text());p.chmod(0o755)
            rows.append(('noexec',str(p)))
        else:print('SKIP refusal-noexec reason=no-container-noexec-mount-provided',flush=True)
        for name,path in rows:
            cmd='setup.sh' if name=='path-file' else shlex.quote(path)
            oracle=subprocess.run([dash,'-c',cmd],cwd=home,env=env,capture_output=True,timeout=10)
            # dash returns 127 after an unsuccessful PATH search, even when
            # its error is Permission denied. Explicit found paths are 126.
            status=127 if name=='path-file' else 126
            ok=check('refusal-'+name+'-dash',oracle.returncode==status,(oracle.returncode,oracle.stderr)) and ok
            for prefix in ('','command ','exec '):
                got=subprocess.run([binary,'-c',prefix+cmd],cwd=home,env=env,capture_output=True,timeout=10)
                # Outside a prompt pelt retains its diagnostic location and exec prefix.
                if name=='path-file':
                    good=got.returncode==127 and b'setup.sh:' in got.stderr and b'hint:' not in got.stderr and not got.stdout
                else:
                    good=got.returncode==126 and path.encode() in got.stderr and b'permission denied' in got.stderr.lower() and b'hint:' not in got.stderr and not got.stdout
                ok=check('refusal-'+name+'-'+(prefix.strip() or 'plain'),good,(got.returncode,got.stderr)) and ok
        for args,hints in [([],False),(['-o','friendly'],True),(['--posix','-o','friendly'],False)]:
            sh=Shell(binary,home,args,tty_out=True,env_overrides={'PATH':env['PATH']})
            try:
                for name,path in rows:
                    cmd='setup.sh' if name=='path-file' else shlex.quote(path)
                    start=len(sh.data['tty']);sh.command((cmd+'\r').encode());raw=sh.data['tty'][start:]
                    good=b'setup.sh: not found\r\n' in raw if name=='path-file' else (b'pelt: '+path.encode()+b': permission denied\r\n') in raw
                    expected_hint=hints and name not in ('directory','path-file')
                    good=good and raw.count(b'pelt: hint:')==int(expected_hint)
                    if expected_hint:
                        action='sh' if name=='noexec' else 'chmod +x'
                        quoted="'"+path.replace("'","'\"'\"'")+"'"
                        good=good and ('pelt: hint: '+action+' '+quoted).encode() in raw
                    ok=check('refusal-'+name+'-prompt-'+str(args),good,raw) and ok
                    start=len(sh.data['tty']);sh.command(b'echo $?\r');raw=sh.data['tty'][start:]
                    want=b'\r\n127\r\n' if name=='path-file' else b'\r\n126\r\n'
                    ok=check('refusal-'+name+'-prompt-status',want in raw,raw) and ok
            finally:assert sh.close()
    return 0 if ok else 1

if __name__=='__main__':sys.exit(main(sys.argv[1]))
