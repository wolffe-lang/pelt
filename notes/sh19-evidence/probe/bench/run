#!/usr/bin/env python3
"""bench/run — sh19's copy of tools/bench/run (sh06), its scripts beside it:
the four census loops and one loop per in-process shape (#34).

Each script under bench/ runs N times (default 9) under each shell, in
a fresh scratch directory, from an empty environment; wall time comes
from a monotonic clock around the process and user and system time from
its `wait4` record (children included). The table gives the median and
the minimum, and pelt÷dash on the medians. Standard output must be the
same bytes under both shells or the row is refused: a faster wrong
answer is not a speed.

usage: tools/bench/run --dir SCRATCH [--runs N] [--pin CPULIST] SHELL=PATH … [script …]
  e.g. tools/bench/run --dir ~/scratch dash=/usr/bin/dash pelt=target/release/pelt
  --pin 0-3  run every process under `taskset -c 0-3`
"""
import os
import shutil
import statistics
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
SCRIPTS = ["fork", "pipeline", "param", "configure-shaped", "s-sub", "s-cmdsub", "s-cmdsub-echo",
           "s-bg-sub", "s-bg-brace", "s-stage", "s-func-pipe", "s-stage-read", "s-program"]


def once(argv, cwd):
    out = open(os.path.join(cwd, "..", "out"), "wb")
    t0 = time.monotonic()
    p = subprocess.Popen(argv, cwd=cwd, stdout=out, stdin=subprocess.DEVNULL,
                         env={"PATH": "/usr/bin:/bin", "HOME": "/home/pelt", "LC_ALL": "C"})
    _, status, ru = os.wait4(p.pid, 0)
    wall = time.monotonic() - t0
    out.close()
    p.returncode = os.waitstatus_to_exitcode(status)
    data = open(out.name, "rb").read()
    return wall, ru.ru_utime, ru.ru_stime, p.returncode, data


def main(argv):
    root = None
    runs = 9
    pin = None
    shells = []
    names = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--dir", "--runs", "--pin"):
            v = argv[i + 1]
            i += 2
            if a == "--dir":
                root = os.path.abspath(v)
            elif a == "--runs":
                runs = int(v)
            else:
                pin = v
        elif "=" in a:
            k, v = a.split("=", 1)
            shells.append((k, os.path.abspath(v)))
            i += 1
        else:
            names.append(a)
            i += 1
    if not root or len(shells) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    prefix = ["taskset", "-c", pin] if pin else []
    print(f"bench: {runs} runs each" + (f", taskset -c {pin}" if pin else ", unpinned")
          + f"; load {open('/proc/loadavg').read().split()[:3]}")
    print(f"{'script':<17}{'shell':<8}{'median s':>9}{'min s':>8}{'user s':>8}{'sys s':>8}{'ratio':>7}")
    for name in names or SCRIPTS:
        script = os.path.join(HERE, name + ".sh")
        base = None
        want = None
        for sh, path in shells:
            rows = []
            for _ in range(runs):
                w = os.path.join(root, "w")
                shutil.rmtree(w, ignore_errors=True)
                os.makedirs(w)
                rows.append(once(prefix + [path, script], w))
            if any(r[3] != 0 for r in rows):
                print(f"{name:<17}{sh:<8} REFUSED: exit {[r[3] for r in rows]}")
                continue
            if want is None:
                want = rows[0][4]
            elif rows[0][4] != want:
                print(f"{name:<17}{sh:<8} REFUSED: output differs from {shells[0][0]}'s")
                continue
            med = statistics.median(r[0] for r in rows)
            mn = min(r[0] for r in rows)
            us = statistics.median(r[1] for r in rows)
            sy = statistics.median(r[2] for r in rows)
            if base is None:
                base = med
            print(f"{name:<17}{sh:<8}{med:9.3f}{mn:8.3f}{us:8.3f}{sy:8.3f}{med / base:7.2f}")
    shutil.rmtree(os.path.join(root, "w"), ignore_errors=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
