// sh19 witness: what one empty List and one List of one str cost in the
// process root, per call, outside any region.
fn empty_lists(k: int) -> int {
    var total = 0
    var i = 0
    while i < k {
        let xs = List[str]()
        total += xs.len
        i += 1
    }
    total
}

fn one_lists(k: int, w: str) -> int {
    var total = 0
    var i = 0
    while i < k {
        var xs = List[str]()
        (mut xs).push(w)
        total += xs.len
        i += 1
    }
    total
}

fn main() {
    let args = env_args()
    let mode = args[0]
    let n = args[1].len * 100000
    var t = 0
    var i = 0
    while i < n {
        if mode == "empty" {
            t += empty_lists(1)
        } else if mode == "one" {
            t += one_lists(1, "wait")
        }
        i += 1
    }
    print("{t}")
}
