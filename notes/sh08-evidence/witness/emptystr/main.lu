//! member: false
//!
//! emptystr — lane-local witness (sh08): what `copy region` keeps in
//! the root for a value with an empty `str` in it. Runs N turns of one
//! shape, then prints the shape and N; peak RSS is read from outside
//! (`/usr/bin/time`). usage: emptystr SHAPE N
//!   none   a struct of two ints
//!   empty  a struct of an int and the empty str
//!   short  a struct of an int and a three-byte str
//!   wide   a struct of eight ints, two bools and two literal empty strs
//!   wide2  the same, one str an empty one made in the region
//!   via    a struct of an int and the empty literal, made by one
//!          function and returned through another
//!   infn   `via`, the block inside a function the loop calls
//!   infnshort  the same with a three-byte str
//!   built  a struct of an int and an empty str made in the region
//!          (`str_from_utf8` of an empty list)

struct A {
    k: int,
    n: int,
}

struct B {
    k: int,
    s: str,
}

/// Fast's shape at sh08: ints, two strs, a bool or two.
struct W {
    k: int,
    a: int,
    s: str,
    b: int,
    c: int,
    t: str,
    d: bool,
    e: int,
    f: int,
    g: bool,
    h: int,
}

fn build_w(i: int, two: bool) -> W {
    var w = W { k: i, a: 0, s: "", b: 0, c: -1, t: "", d: false, e: 0, f: 0, g: false, h: 0 }
    if two {
        w.s = str_from_utf8(List[byte]()) else "?"
    }
    w
}

fn mk() -> B {
    B { k: 0, s: "" }
}

/// As pelt's `run_fast` built its result: a default from a function,
/// then a field set.
fn via_mk(i: int) -> B {
    var r = mk()
    r.k = i
    r
}

fn build_b(i: int, shape: str) -> B {
    if shape == "via" {
        return via_mk(i)
    }
    if shape == "short" {
        return B { k: i, s: "x{i % 10}y" }
    }
    if shape == "built" {
        let s = str_from_utf8(List[byte]()) else "?"
        return B { k: i, s: s }
    }
    B { k: i, s: "" }
}

/// One turn as pelt takes one: the block inside a function the loop
/// calls, its value a struct whose `str` is empty.
fn turn(i: int, shape: str) -> int {
    let r = copy region tb {
        build_b(i, shape)
    }
    r.k + r.s.len
}

fn main() -> int {
    let args = env_args()
    let shape = if args.len > 0 then args[0] else "none"
    var n = 0
    if args.len > 1 {
        n = args[1].to_int() else 0
    }
    var sum = 0
    var i = 0
    while i < n {
        if shape == "none" {
            let r = copy region a {
                A { k: i, n: 1 }
            }
            sum += r.k
        } else if shape == "infn" || shape == "infnshort" {
            sum += turn(i, if shape == "infn" then "via" else "short")
        } else if shape == "wide" || shape == "wide2" {
            let r = copy region w {
                build_w(i, shape == "wide2")
            }
            sum += r.k + r.s.len
        } else {
            let r = copy region b {
                build_b(i, shape)
            }
            sum += r.k + r.s.len
        }
        i += 1
    }
    print("{shape} {n} {sum}")
    0
}
