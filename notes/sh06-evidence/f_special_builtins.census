unset never_set_xyz; echo "st=$?"
@unset/2 | T | unset -f removes a function, and not a variable of that name
> func/unset_f
--- builtin/c_unset_f
f=var; f() { echo func; }
unset -f f; echo "$f"; f 2>/dev/null; echo "st=$?"
g() { :; }; g=var; unset g; echo "${g-var-unset}"; g; echo "func-st=$?"
@unset/3 | T | unset of a readonly variable fails with a non-zero status
> builtin/unset_readonly
@unset/4 | T | Unsetting IFS, PATH and other shell variables works and has the specified effect
--- builtin/c_unset_shell_vars
unset IFS; x='a b'; set -- $x; echo $#
(unset PATH; echo builtin-still-works; ls >/dev/null 2>&1; echo "ls=$?") | sed 's/ls=0/ls=found-by-default-path/'
unset HOME; echo "${HOME-unset}"
unset LINENO PPID 2>/dev/null; echo survived
