@read/5 | X | read with no variable name: REPLY as an extension, or an error (recorded from dash)
! POSIX requires at least one var operand; behaviour without one is unspecified
--- read/c_no_var
echo x | { read 2>/dev/null; echo "st=$?"; }
@read/6 | T | read -d delim reads up to the delimiter; -d '' reads up to a NUL (new in 2024)
! POSIX.1-2024 addition; dash 0.5.13.4 has no -d; bash --posix is the oracle
--- read/c_delim oracle=bash
printf 'a,b,c' | { read -d , x; echo "[$x]"; read -d , y; echo "[$y]"; }
printf 'one\ntwo\0rest' | { read -r -d '' x; echo "[$x]"; }
@read/7 | T | read into a readonly variable or an invalid name fails
--- read/c_bad_target
readonly r=1
echo x | { read r 2>/dev/null; echo "st=$?"; } 2>/dev/null
echo x | { read 1bad 2>/dev/null; echo "st=$?"; } 2>/dev/null
@read/8 | T | read uses the shell's IFS when none is given for the command, and does not expand what it reads
--- read/c_no_expansion
echo '$HOME * ~ $(echo x)' | { read -r x; echo "$x"; }
IFS=,; echo 'a,b c' | { read x y; echo "[$x][$y]"; }
@read/9 | T | read from a descriptor other than 0 through redirection, and from a here-document
> redir/heredoc_read redir/read_fd
@getopts/1 | T | getopts walks options, setting the variable and OPTIND; returns non-zero at the end with the variable set to ?
> builtin/getopts
! dash 0.5.13.4 sets OPTARG to the empty string for an option with no argument, and restarts oddly after OPTIND=1; the page says unset, so bash --posix is the oracle for the getopts cases that show OPTARG
--- getopts/c_basic oracle=bash
set -- -a -b arg -c rest
while getopts ab:c o; do echo "$o ${OPTARG-none} $OPTIND"; done
echo "end: $o $OPTIND"; shift $((OPTIND-1)); echo "$@"
@getopts/2 | T | Grouped options, an option-argument in the same word, and -- to end options
--- getopts/c_grouping oracle=bash
set -- -ab -cvalue -- -d
while getopts abc:d o; do echo "$o ${OPTARG-none}"; done; shift $((OPTIND-1)); echo "$@"
@getopts/3 | T | An unknown option: ? with a diagnostic and OPTARG unset; with a leading colon in optstring, ? with OPTARG the letter and no diagnostic
> builtin/getopts_bad
--- getopts/c_unknown oracle=bash
set -- -x
getopts a o 2>/dev/null; echo "$o ${OPTARG-unset}"
OPTIND=1; getopts :a o; echo "$o ${OPTARG-unset}"
OPTIND=1; getopts a o 2>&1 | wc -l | tr -d ' '
@getopts/4 | T | A missing option-argument: ? with a diagnostic, or : with OPTARG the letter when optstring starts with a colon
--- getopts/c_missing_arg oracle=bash
set -- -a
getopts a: o 2>/dev/null; echo "$o ${OPTARG-unset}"
OPTIND=1; getopts :a: o; echo "$o ${OPTARG-unset}"
@getopts/5 | T | getopts parses explicit operands in place of the positional parameters
--- getopts/c_explicit_args oracle=bash
set -- -z
while getopts ab: o -a -b val; do echo "$o ${OPTARG-none}"; done
@getopts/6 | T | OPTIND starts at 1; setting OPTIND=1 restarts parsing; a first non-option operand ends it
--- getopts/c_optind oracle=bash
echo "$OPTIND"
set -- -a x -b
getopts ab o; echo "$o $OPTIND"; getopts ab o; echo "st=$? $OPTIND"
OPTIND=1; getopts ab o; echo "$o $OPTIND"
set -- - -a; OPTIND=1; getopts a o; echo "st=$? $OPTIND"
@getopts/7 | T | getopts in a function uses the function's parameters; OPTIND is a shell-wide variable
--- getopts/c_in_function
f() { OPTIND=1; while getopts xy: o; do echo "f:$o ${OPTARG-}"; done; }
f -x -y v; set -- -q; OPTIND=1; getopts q o; echo "main:$o"
@wait/1 | T | wait with no operands waits for every child and returns zero
> jobs/wait_all
--- wait/c_all
(sleep 1; : > a) & (sleep 1; : > b) & (exit 3) &
wait; echo "st=$?"; ls
@wait/2 | T | wait pid returns that child's status; several operands: the status of the last
> jobs/wait_program_status jobs/wait_subshell_status signal/wait_two_jobs
--- wait/c_pid
(exit 3) & a=$!; (exit 4) & b=$!
wait $a; echo $?; wait $b; echo $?
(exit 5) & a=$!; (exit 6) & b=$!; wait $a $b; echo $?
@wait/3 | T | wait for a pid that is not a child of this shell returns 127
> jobs/wait_unknown
--- wait/c_unknown
wait 1; echo $?
(exit 3) & p=$!; wait $p; wait $p; echo "second=$?"
@wait/4 | T | wait reports a child ended by a signal with a status above 128
> signal/child_bg_wait
--- wait/c_signalled
sleep 5 & p=$!; kill -TERM $p; wait $p; echo $?
sleep 5 & p=$!; kill -KILL $p; wait $p; echo $?
@wait/5 | T | The status of a child that ended before wait is still collected, for any of the known process IDs
> signal/wait_twice signal/child_bg_unwaited
--- wait/c_already_ended
(exit 7) & p=$!; (exit 8) & q=$!; sleep 1; wait $q; echo $?; wait $p; echo $?
@wait/6 | T | wait with a job ID operand (%1, %%)
--- wait/c_job_id
(exit 3) &
wait %1; echo "st=$?"
(exit 4) & wait %%; echo "st=$?"
wait %9 2>/dev/null; echo "missing=$?"
@wait/7 | T | wait in a subshell cannot wait for the parent's children
--- wait/c_subshell
sleep 1 & p=$!
(wait $p; echo "sub=$?") 2>/dev/null
wait $p; echo "parent=$?"
@kill/1 | T | kill pid sends SIGTERM; kill -s name and kill -name and kill -number send that signal; the status of a signalled child shows it
> signal/child_bg_wait
--- kill/c_send
for how in '' '-s HUP' '-HUP' '-9' '-s KILL' '-TERM' '-15' '-s 15'; do
  sleep 5 & p=$!; kill $how $p; wait $p; echo "[$how] $?"
done
@kill/2 | T | kill -l lists signal names; kill -l number names that signal; kill -l with an exit status names the signal that caused it
--- kill/c_list
kill -l 1 2 3 9 15
kill -l 130 143 137
kill -l | tr ' ' '\n' | grep -c -E '^(HUP|INT|QUIT|KILL|TERM|USR1|USR2|PIPE|ALRM|CHLD|CONT|STOP|TSTP)$'
kill -l 999 2>/dev/null; echo "st=$?"
@kill/3 | T | kill -0 pid tests for the process without sending; a missing process fails
--- kill/c_zero
sleep 2 & p=$!
kill -0 $p; echo "alive=$?"
kill $p; wait $p 2>/dev/null
kill -0 $p 2>/dev/null; echo "dead=$?"
@kill/4 | T | kill is built in: it signals by job ID (%1), and works on the shell's own children without a search of PATH
--- kill/c_job_id
sleep 5 &
kill %1; wait; echo "st=$?"
PATH=/nonexistent; kill -0 $$; echo "builtin=$?"
@kill/5 | T | kill with a bad signal name or no operand fails
--- kill/c_bad
kill -s NOSUCH $$ 2>/dev/null; echo "st=$?"
kill 2>/dev/null; echo "st=$?"
kill -l NOSUCH 2>/dev/null; echo "st=$?"
@kill/6 | T | kill accepts several pids, a negative pid for a process group, and -- before it
--- kill/c_multiple
sleep 5 & a=$!; sleep 5 & b=$!
kill $a $b; wait $a; echo $?; wait $b; echo $?
sleep 5 & c=$!; kill -s TERM -- $c; wait $c; echo $?
@umask/1 | T | umask writes the mask as octal; umask -S symbolically; umask mode sets it for the shell and its children
--- umask/c_umask
umask 022; umask; umask -S
umask 077; : > f; ls -l f | cut -c1-10
umask 027; sh -c umask
(umask 000; umask); umask
@umask/2 | T | umask accepts a symbolic mode
--- umask/c_symbolic
umask 022; umask u=rwx,g=rx,o=; umask; umask -S
umask g+w; umask; umask a-x; umask; umask u=rwx,go=rx; umask
@umask/3 | T | umask with an invalid mode fails
--- umask/c_bad
umask 999 2>/dev/null; echo "st=$?"
umask u=q 2>/dev/null; echo "st=$?"
@ulimit/1 | T | ulimit -f reports or sets the file size limit in 512-byte blocks; unlimited is written as the word
--- ulimit/c_file_size
ulimit -f unlimited 2>/dev/null; ulimit -f
(ulimit -f 100; ulimit -f; ulimit)
@ulimit/2 | T | A file-size limit applies to children: a write past it fails
--- ulimit/c_enforced
(ulimit -f 1; trap '' XFSZ 2>/dev/null; dd if=/dev/zero of=big bs=1024 count=8 2>/dev/null; echo "dd=$?" | sed 's/dd=[1-9][0-9]*/dd=failed/')
ls -l big 2>/dev/null | wc -l | tr -d ' '
@ulimit/3 | T | ulimit -H and -S select hard and soft limits; -a reports all; -c -d -n -s -t -v name resources (new in 2024)
--- ulimit/c_resources
ulimit -S -n 64; ulimit -n; ulimit -S -n
ulimit -H -n >/dev/null; echo "H=$?"
ulimit -c 0; ulimit -c
ulimit -a >/dev/null; echo "a=$?"
ulimit -s >/dev/null; echo "s=$?"; ulimit -t >/dev/null; echo "t=$?"; ulimit -d >/dev/null; echo "d=$?"; ulimit -v >/dev/null; echo "v=$?"
@ulimit/4 | T | Raising a hard limit without privilege, or a bad operand, fails
--- ulimit/c_bad
(ulimit -H -n 32; ulimit -H -n 64 2>/dev/null; echo "raise=$?") | sed 's/raise=[1-9][0-9]*/raise=failed/'
ulimit -n abc 2>/dev/null; echo "st=$?"
@fc/1 | S | fc -l lists the history; fc -l first last selects a range; -n omits numbers; -r reverses
> session:c_hist_fc_list
@fc/2 | S | fc -s re-executes a command, optionally with old=new substituted
> session:c_hist_fc_s
@fc/3 | S | fc first last edits the commands with FCEDIT or -e editor and then runs the result
> session:c_hist_fc_edit
@fc/4 | T | fc in a non-interactive shell with no history fails without ending the shell
--- fc/c_noninteractive
fc -l >/dev/null 2>&1; echo "st=$?" | sed 's/st=[1-9][0-9]*/st=fails/;s/st=0/st=ok-or-empty/'
echo survived
@jobs/1 | S | jobs lists each job: [n], current (+) or previous (-), state, command; -l adds process IDs; -p writes only process group IDs
> session:c_jc_jobs_list
@jobs/2 | T | jobs in a non-interactive shell lists background commands and jobs -p writes their process IDs
--- jobsctl/c_jobs_script
sleep 2 & p=$!
jobs | grep -c sleep
[ "$(jobs -p)" = "$p" ] && echo pid-matches
kill $p; wait
jobs | wc -l | tr -d ' '
@jobs/3 | S | A job's state is reported as Running, Done, Done(n), Stopped (signal) as the page lists
> session:c_jc_jobs_states
@fg/1 | S | fg with no operand runs the current job in the foreground; fg %n that job; its command is written first
> session:c_jc_fg session:c_jc_fg_number
@fg/2 | T | fg and bg with job control off fail with a message
--- jobsctl/c_fg_bg_no_monitor
sleep 1 &
fg 2>/dev/null; echo "fg=$?" | sed 's/fg=[1-9][0-9]*/fg=fails/'
bg 2>/dev/null; echo "bg=$?" | sed 's/bg=[1-9][0-9]*/bg=fails/'
wait
@bg/1 | S | bg resumes a suspended job in the background and writes [n] command
> session:c_jc_bg
