//! witness (sh06): does a non-ASCII argument reach a child intact?
//!
//! pelt hands `?` for every byte above 0x7f to a program it runs
//! (the script census's `quote/high_bytes`). This asks wolf alone:
//! spawn `od -An -tx1` on a here-string-free path — `printf %s ARG` —
//! with "é" (c3 a9) and "中" (e4 b8 ad) as arguments, through
//! `os_spawn_fds` with no map, and let the child print the bytes it got.
//! Then the byte a shell must also pass and wolf cannot: 0xff. An
//! argument is a `str`, a `str` is UTF-8, so `a\377b` (legal in a POSIX
//! argument: only NUL is excluded) has no spelling for `os_spawn_fds`,
//! `os_exec`, `env_set` or any `fs_*` path.

fn main() -> int {
    var args = List[str]()
    (mut args).push("-c")
    (mut args).push("printf %s \"$1\" | od -An -tx1")
    (mut args).push("sh")
    (mut args).push("é中")
    var map = List[int]()
    let h = os_spawn_fds("/bin/sh", args, map) else |_| -1
    if h < 0 {
        print("argv_bytes: cannot spawn")
        return 2
    }
    let _st = os_wait(h) else 0
    print("the argument as wolf holds it: {"é中".len} bytes")
    var raw = List[byte]()
    (mut raw).push(97 as byte)
    (mut raw).push(255 as byte)
    (mut raw).push(98 as byte)
    let made = str_from_utf8(raw) else |_| "<no str: not UTF-8>"
    print("a, 0xff, b as an argument: {made}")
    0
}
