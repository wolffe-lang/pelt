echo "$x"
set -- "$x"; echo $#
@2.2.4/1 | T | $'...' preserves characters literally up to the terminating unescaped single quote
> quote/dollar_single
! dash 0.5.13.4 has no dollar-single-quotes; POSIX.1-2024 requires them, so bash --posix is the oracle
--- quote/c_ds_plain oracle=bash
echo $'a b' $'$HOME' $'"q"' $'*'
