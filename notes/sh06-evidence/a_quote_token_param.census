@2.5.3/7 | T | LINENO is the current line number within the script or function
> param/lineno
! dash 0.5.13.4 counts from the function's first line inside a function; bash --posix and pelt count lines of the script. The standard's words allow either; the script's line is what a diagnostic needs, so bash is the oracle
--- param/c_lineno oracle=bash

echo $LINENO
f() {
  echo $LINENO
}
f
echo $LINENO
@2.5.3/8 | T | PPID is the parent's process ID, the same in a subshell
--- env/c_ppid
case $PPID in *[!0-9]*|'') echo bad;; *) echo numeric;; esac
a=$PPID; (echo $PPID) | { read b; [ "$a" = "$b" ] && echo same; }
[ "$(sh -c 'echo $PPID')" != "$PPID" ] && echo child-differs
