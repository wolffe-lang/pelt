\hi 2>/dev/null || echo no1
'hi' 2>/dev/null || echo no2
"hi" 2>/dev/null || echo no3
@2.3.1/3 | T | Only a token in command-name position is substituted, not an argument
--- alias/c_position
alias hi='echo hello'
echo hi
hi hi
@2.3.1/4 | T | An alias is not expanded again inside its own expansion (no recursion on the same name)
--- alias/c_no_self_recursion
alias echo='echo x'
echo y
alias a=b b=a
a 2>/dev/null; echo "st=$?"
@2.3.1/5 | T | An alias value ending in a blank makes the next token subject to alias substitution
--- alias/c_trailing_blank
