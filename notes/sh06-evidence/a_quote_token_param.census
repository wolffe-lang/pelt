body
E
@2.3/7 | T | Each complete command is executed before the next is tokenized and parsed
--- parse/c_exec_before_parse
echo one
alias_free_marker=1
echo two; if
--- parse/c_exec_before_parse_cd
mkdir d; cd d
pwd | sed 's,.*/,,'
@2.3/8 | T | The token at end of input is delimited (a last line with no newline runs)
--- parse/c_no_final_newline
../sh -c 'echo last'
printf 'echo from-file' > f; ../sh f
@2.3.1/1 | T | An unquoted command-name token that names an alias is replaced by the alias value
! dash and bash --posix agree; alias takes effect for the next complete command
--- alias/c_basic
alias hi='echo hello'
hi there
@2.3.1/2 | T | A token with any quoting character is not subject to alias substitution
--- alias/c_quoted_not
