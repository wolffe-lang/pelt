--- quote/c_ds_escapes oracle=bash
printf '%s' $'\"\'\\' | od -An -tx1 | tr -d '[:space:]'; echo
printf '%s' $'\a\b\e\f\n\r\t\v' | od -An -tx1 | tr -d '[:space:]'; echo
@2.2.4/3 | T | $'\cX' yields the control character for X
--- quote/c_ds_control oracle=bash
printf '%s' $'\cA\cZ\c[' | od -An -tx1 | tr -d '[:space:]'; echo
@2.2.4/4 | T | $'\xXX' yields the byte with that hexadecimal value, ended by the first non-hex character
--- quote/c_ds_hex oracle=bash
printf '%s' $'\x41\x7aZ\x9' | od -An -tx1 | tr -d '[:space:]'; echo
