@2.11/1 | S | An interactive shell with a controlling terminal puts itself in its own process group and makes that the terminal's foreground group
> session:c_jc_shell_is_leader
@2.11/2 | S | With job control on, each foreground pipeline runs in its own process group, which is made the terminal's foreground group
> session:c_jc_foreground_group
@2.11/3 | S | With job control on, an asynchronous list becomes a background job with a job number, in its own process group
> session:c_jc_background_job session:c_jc_background_group
@2.11/4 | S | When a foreground job ends or stops, the shell makes its own group the terminal's foreground group again
> session:c_jc_terminal_back
@2.11/5 | S | A foreground job stopped by SIGTSTP becomes a suspended job with a job number, and the shell writes a message and prompts
> session:c_jc_ctrl_z
@2.11/6 | S | $? after a foreground job is stopped is the status it would have had if the signal had ended it
> session:c_jc_ctrl_z
@2.11/7 | S | fg continues a suspended job in the foreground: terminal first, then SIGCONT to its group
> session:c_jc_fg session:c_jc_fg_number
@2.11/8 | S | bg continues a suspended job in the background
> session:c_jc_bg
@2.11/9 | S | A background job that stops (SIGTTIN on reading the terminal) becomes a suspended job, reported before the next prompt
> session:c_jc_bg_ttin
@2.11/10 | S | When a background job completes, an interactive shell writes a message before the next prompt
> session:c_jc_done_message
@2.11/11 | S | With set -b the completion message is written at once
! no session case: the harness types when the shell is quiet and cannot place a message that arrives between two keys; measured by hand under dash
@2.11/12 | S | The interactive shell saves the terminal settings when a job is suspended and fg restores them
! no session case: the harness does not read the terminal's settings
@2.11/15 | S | The terminal's interrupt character reaches the foreground job and not the shell
> session:c_jc_ctrl_c_job_only session:ctrl_c_child
@2.11/13 | T | set -m in a non-interactive shell puts each asynchronous list in its own process group
--- jobsctl/c_monitor_script_pgid
set -m 2>/dev/null
sh -c 'ps -o pgid= -p $$ | tr -d " "' > bgpgid &
wait
me=$(ps -o pgid= -p $$ | tr -d ' ')
[ "$(cat bgpgid)" != "$me" ] && echo own-group
@2.11/14 | T | With job control off, a background command stays in the shell's process group
--- jobsctl/c_no_monitor_pgid
sh -c 'ps -o pgid= -p $$ | tr -d " "' > bgpgid &
wait
me=$(ps -o pgid= -p $(sh -c 'echo $PPID') | tr -d ' ')
[ "$(cat bgpgid)" = "$me" ] && echo same-group
@2.12/1 | T | With job control off, commands of an asynchronous list start with SIGINT and SIGQUIT ignored
> signal/background_ignores_int
--- signal/c_async_ignores_quit
sh -c 'kill -QUIT $$; echo survived-quit; kill -INT $$; echo survived-int' &
wait; echo "st=$?"
@2.12/2 | T | Otherwise commands inherit the signal actions the shell inherited, unless trap changed them
> signal/trap_ignore_inherited signal/trap_caught_default_in_child
--- signal/c_inherited_ignore
trap '' TERM
../sh -c 'kill -TERM $(sh -c "echo \$PPID"); echo child-ignores'
trap - TERM
../sh -c 'trap "echo child-traps" TERM; kill -TERM $(sh -c "echo \$PPID"); echo after'
@2.12/3 | T | A trapped signal that arrives while a foreground command runs is acted on after that command completes
> signal/trap_deferred_to_foreground_end
@2.12/4 | T | A trapped signal that arrives during wait makes wait return at once with a status above 128, then the trap runs
> pending/wait_interrupted
--- signal/c_wait_interrupted_term
trap 'echo trapped' TERM
sleep 5 & p=$!
( sleep 1; kill -TERM $$ ) &
wait $p; s=$?
[ $s -gt 128 ] && echo "wait-above-128"
kill $p
@2.12/5 | T | Signals for every name in signal.h can be trapped (USR1, ALRM, PIPE, CHLD, CONT, WINCH and the rest)
> pending/trap_usr1 pending/trap_ignore_usr1
--- signal/c_trap_alrm
trap 'echo got-alrm' ALRM
kill -ALRM $$; echo after
--- signal/c_trap_pipe
trap 'echo got-pipe >&2' PIPE
kill -PIPE $$; echo after
--- signal/c_trap_usr1_self
trap 'echo got-usr1' USR1
kill -USR1 $$; echo after
--- signal/c_trap_abrt_number
trap 'echo got-6' 6
kill -6 $$; echo after
--- signal/c_trap_ignore_pipe
trap '' PIPE
{ sleep 1; echo x 2>/dev/null; echo "$?" > st; } | true
cat st
--- signal/c_trap_winch_cont
trap 'echo got-winch' WINCH
trap 'echo got-cont' CONT
kill -WINCH $$; kill -CONT $$; echo after
@2.13/1 | T | A utility is run with the shell's open files, working directory and file creation mask
> redir/child_inherits_fd exec/fd3_inherited cd/child_sees_it
--- env/c_utility_environment
mkdir d; cd d; sh -c 'pwd' | sed 's,.*/,,'
exec 3>../f3; sh -c 'echo via-3 >&3'; exec 3>&-; cat ../f3
@2.13/2 | T | A utility receives the exported variables and those assigned for the command, and no others
> env/exact env/never_exported env/empty env/only_pwd
--- env/c_exported_only
a=1; export b=2; c=3 sh -c 'echo "${a-unset} ${b-unset} ${c-unset}"'
@2.13/3 | T | A utility cannot change the shell's environment
--- env/c_child_cannot_change
x=1; export x
sh -c 'x=2; cd /; umask 077'
echo "$x"; [ "$PWD" != / ] && echo cwd-kept
@2.13/4 | T | A shell script run as a utility starts with caught traps at default and ignored signals still ignored
> signal/trap_caught_default_in_child signal/trap_ignore_inherited
@2.13/5 | T | A subshell is a duplicate of the shell environment: variables (exported or not), functions, options, positional parameters
> control/subshell cmdsub/function
--- env/c_subshell_duplicate
x=1; f() { echo func; }; set -- a b; set -f
( echo "$x $# $1"; f; case $- in *f*) echo f;; esac )
echo "$(echo "$x $#"; f)"
@2.13/6 | T | In a subshell, traps that are not ignored are reset to default
> signal/trap_subshell_reset signal/trap_in_subshell signal/trap_subshell_ends_restores
--- signal/c_subshell_trap_reset
trap 'echo parent-exit' EXIT
trap 'echo caught' TERM
( trap ) | wc -l | tr -d ' '
( echo in-sub )
( kill -TERM $(sh -c 'echo $PPID'); echo not-reached ); echo "st=$?"
trap - EXIT
@2.13/7 | T | A subshell killed by a signal does not take the parent with it, and the parent sees a status above 128
> pending/subshell_signal
@2.13/8 | T | Changes made in a subshell do not affect the shell, for every subshell form: ( ), $( ), pipeline stage, &
> pipe/stage_is_subshell cmdsub/isolation
--- env/c_subshell_forms
x=0
( x=1 ); : $(x=2); x=3 | :; { x=4; } & wait
echo $x
@2.13/9 | T | exit in a subshell ends only the subshell, for every subshell form
> cmdsub/exit_inside pipe/exit_in_stage
--- env/c_exit_in_subshell_forms
( exit 1 ); : $(exit 2); exit 3 | :; { exit 4; } & wait
echo survived
@2.13/10 | T | A subshell has its own working directory and descriptors: cd and exec redirections there do not leak
--- env/c_subshell_cwd_fds
( cd /; exec > /dev/null; echo hidden ); echo visible
[ "$PWD" != / ] && echo cwd-kept
: $(cd /); echo x | cd /; [ "$PWD" != / ] && echo cwd-kept2
@2.13/11 | T | Subshells of one shell run concurrently as separate processes when asked to (& and pipeline stages)
--- env/c_subshell_concurrent
( sleep 1; echo slow ) & ( echo fast ) & wait
{ sleep 1; : > a-done; } & { [ -f a-done ] || echo b-ran-first; } ; wait
@2.14.1/1 | T | An ordinary character matches itself; a quoted or escaped special character matches itself
> glob/quoted glob/edge_quoted
--- glob/c_quoted_specials
case '*' in \*) echo star;; esac
case '?' in '?') echo q;; esac
case '[a]' in "[a]") echo bracket;; esac
case 'a\b' in a\\b) echo backslash;; esac
case ab in a\b) echo escaped-ordinary;; esac
@2.14.1/2 | T | ? matches any one character
> glob/question
--- glob/c_question
case a in ?) echo one;; esac
case ab in ?) echo no;; ??) echo two;; esac
case '' in ?) echo no;; *) echo empty-not-matched;; esac
@2.14.1/3 | T | [...] matches one character of the set; ranges, and ! for the complement
> glob/bracket glob/edge_negate
--- glob/c_bracket
for c in a b c d - ']' '!' x; do
  case $c in [abc]) echo "$c set";; [!a-cx]) echo "$c complement";; *) echo "$c none";; esac
done
case - in [a-]) echo trailing-dash;; esac
case ']' in []]) echo leading-bracket;; esac
case a in [!]]) echo not-bracket;; esac
@2.14.1/4 | T | Character classes [[:alpha:]] and the rest match by class
> glob/class glob/edge_class
--- glob/c_classes
for c in a Z 5 ' ' . _; do
  case $c in [[:alpha:]]) echo alpha;; [[:digit:]]) echo digit;; [[:space:]]) echo space;; [[:punct:]]) echo punct;; *) echo other;; esac
done
case aB3 in [[:lower:]][[:upper:]][[:alnum:]]) echo three;; esac
case f in [[:xdigit:]]) echo xdigit;; esac
case a in [![:digit:]]) echo not-digit;; esac
case 5 in [[:alpha:][:digit:]]) echo two-classes;; esac
@2.14.1/5 | T | A [ that does not open a valid bracket expression matches itself
> glob/edge_lone_open glob/edge_open_a
--- glob/c_lone_bracket
case '[' in [) echo lone;; esac
case '[a' in [a) echo open-a;; esac
case a in [a) echo no;; *) echo not-a-class;; esac
@2.14.1/6 | T | A backslash in a pattern that came from an expansion escapes the next character
> glob/edge_backslash
--- glob/c_backslash_from_expansion
p='a\*'; case 'a*' in $p) echo escaped-star;; esac
case 'ab' in $p) echo no;; *) echo not-wild;; esac
@2.14.1/7 | T | Equivalence classes and collating symbols in a bracket expression ([[=a=]], [[.a.]])
--- glob/c_equiv_collating
case a in [[=a=]]) echo equiv;; *) echo equiv-no;; esac
case a in [[.a.]]) echo coll;; *) echo coll-no;; esac
case - in [[.-.]]) echo coll-dash;; *) echo coll-dash-no;; esac
@2.14.2/1 | T | * matches any string, the null string included; several * in one pattern each match as needed
> glob/star
--- glob/c_star
case '' in *) echo empty;; esac
case abc in a*c) echo mid;; esac
case abcabc in *b*b*) echo two;; esac
case abc in *abc*) echo both-empty;; esac
case abc in a*d) echo no;; *) echo none;; esac
case a/b in *) echo slash-in-case;; esac
@2.14.3/1 | T | In pathname expansion a slash must be matched explicitly, by neither * nor ? nor a bracket expression
> glob/path glob/edge_slash
--- glob/c_slash_explicit
mkdir d; touch d/f ab
echo * ; echo */* ; echo d?f ; echo d[/]f ; echo d*f
@2.14.3/2 | T | A leading period in a file name must be matched explicitly, at the start or after a slash
> glob/hidden
--- glob/c_leading_period
mkdir d; touch .h v d/.dh d/dv
echo * ; echo .h* ; echo ?h ; echo [.]h ; echo d/* ; echo d/.d*; echo [!a]h
@2.14.3/3 | T | Matches are substituted in collating order; a pattern that matches nothing is left unchanged
> glob/sorted glob/no_match
--- glob/c_sorted_nomatch
touch b a C 1 _x
echo *
echo z* 'z*' z\*
@2.14.3/4 | T | Each pattern component is matched in its own directory; trailing slash selects directories
> glob/dirs_only
--- glob/c_components
mkdir -p d1/s d2/s d3; touch d1/s/f d2/s/g d3/x f1
echo d*/s/* ; echo */ ; echo d?/s ; echo ./d1/*/f
@2.14.3/5 | T | A directory that cannot be read or searched is not an error: the pattern is left as is
--- glob/c_unreadable
mkdir d; touch d/f; chmod 000 d
echo d/*; echo "st=$?"
chmod 755 d
@2.14.3/6 | T | A word with no unquoted pattern character is left unchanged without reading any directory
> glob/edge_test_cmd glob/edge_lone_close glob/edge_a_close glob/edge_empty glob/edge_star_open
@2.14.3/7 | T | Pattern characters produced by quoting inside an otherwise unquoted word stay literal
> glob/quoted
--- glob/c_mixed_quoting
touch 'a*b' axb
echo a'*'b a"*"b a\*b a*b
x='*'; echo a"$x"b a${x}b
@2.14.3/8 | T | Matching in parameter expansion and case is not subject to the slash and period rules
--- glob/c_no_file_rules_in_case
case .hidden in *) echo dot-matched;; esac
case a/b in a?b) echo slash-matched;; esac
x=a/b/c; echo ${x#*/} ${x%%/*} ${x##*[/]}
