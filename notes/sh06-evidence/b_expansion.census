@2.6/1 | T | Tilde, parameter, command and arithmetic expansion happen first, beginning to end; then field splitting, pathname expansion, quote removal
--- param/c_expansion_order
touch 'a b' ab
x='a* "q"'
echo $x
y='$HOME'; echo $y
z='~'; echo $z
@2.6/2 | T | Expansions within one word give one field unless split, globbed or "$@"
--- split/c_one_field
x=; set -- a"$x"b $x"" ''$x; echo $#
@2.6/3 | T | A $ followed by a blank, newline or end of word is literal
> param/dollar_alone
--- param/c_dollar_literal
echo $ a$ "$" '$' $
echo "a$ b"
@2.6/4 | T | Results of expansion are not rescanned for further expansion
--- param/c_no_rescan
x='$(echo no) `echo no` ${HOME} $((1+1)) ~'
echo $x
echo "$x"
@2.6.1/1 | T | A leading unquoted ~ up to the first slash is a tilde-prefix; alone it is replaced by HOME
> tilde/home tilde/middle
--- tilde/c_basic
HOME=/h/me
echo ~ ~/ ~/x a~ a/~ "~" \~ '~'/x
@2.6.1/2 | T | In an assignment a tilde-prefix is recognized after = and after each unquoted colon
> tilde/assign
--- tilde/c_assign_colon
HOME=/h/me
x=~; y=~/a:~/b:c~:~; echo "$x $y"
z=a=~; echo "$z"
@2.6.1/3 | T | Tilde in a word that is not an assignment is expanded only at the start of the word
--- tilde/c_not_assign
HOME=/h/me
echo x=~ a:~ --dir=~/x
@2.6.1/4 | T | The tilde replacement is not split or globbed, and a null HOME gives one empty field
--- tilde/c_quoted_result
HOME='/a b/*'; set -- ~; echo "$# $1"
HOME=; set -- ~; echo $#
@2.6.1/5 | T | ~login is replaced by that user's home directory from the user database
> tilde/user
--- tilde/c_user_root
[ ~root = "$(cd ~root 2>/dev/null && pwd -P || echo ~root)" ] && case ~root in /*) echo absolute;; *) echo unexpanded;; esac
@2.6.1/6 | T | Tilde expansion applies to the word after a redirection operator and to case words and patterns
--- tilde/c_redirect_case
HOME=$PWD
echo hi > ~/f; cat f
case $PWD in ~) echo matched;; esac
case ~ in "$PWD") echo matched2;; esac
@2.6.1/7 | T | A quoted character in the tilde-prefix prevents tilde expansion
--- tilde/c_quoted_prefix
HOME=/h/me
echo ~"" ~'x' ~\/a "~"/a
@2.6.2/1 | T | ${parameter} substitutes the value; braces delimit the name
> param/simple param/concat
--- param/c_braces
a=1; ab=2
echo ${a}b $ab ${ab}c "${a}"
@2.6.2/2 | T | An unbraced name uses the longest valid name
> param/underscore_names
--- param/c_longest_name
a=1; a_b=2; a1=3
echo $a_b $a1 $a-b $a.b $a_
@2.6.2/3 | T | The matching } skips quoted strings, escaped braces and embedded expansions
> param/nested
--- param/c_matching_brace
unset u
echo ${u:-a}b} ${u:-'}'} ${u:-"}"} ${u:-\}} ${u:-$(echo '}')} ${u:-${u:-x}y}
@2.6.2/4 | T | ${x:-word} substitutes word when x is unset or null; ${x-word} only when unset
> param/default
--- param/c_use_default
unset u; n=; s=v
echo "[${u:-w}][${n:-w}][${s:-w}][${u-w}][${n-w}][${s-w}][${u:-}][${u-}]"
@2.6.2/5 | T | ${x:=word} assigns word when x is unset or null and substitutes the final value; ${x=word} only when unset
> param/assign
--- param/c_assign_default
unset u; n=
echo "[${u:=w}][$u][${n:=w2}][$n]"
unset u; n=
echo "[${u=w}][$u][${n=w2}][$n]"
@2.6.2/6 | T | ${N:=word} on a positional or special parameter is an error
> param/assign_positional_error
@2.6.2/7 | T | ${x:?word} writes word to standard error and a non-interactive shell exits non-zero when x is unset or null
> param/error_unset param/error_null
--- param/c_error_exit
s=v; echo "${s:?no}"
n=; echo "${n?fine}ok"
(unset u; : ${u:?message here}; echo not-reached) 2>&1 | grep -c 'message here'
unset u; : ${u?}; echo not-reached
@2.6.2/8 | T | ${x:+word} substitutes word when x is set and not null; ${x+word} when set
> param/alternative
--- param/c_alternative
unset u; n=; s=v
echo "[${u:+w}][${n:+w}][${s:+w}][${u+w}][${n+w}][${s+w}]"
@2.6.2/9 | T | The word is expanded only when it is needed
--- param/c_word_lazy
s=v; unset u
echo ${s:-$(echo evaluated >&2)} ${u:+$(echo evaluated >&2)} 2>&1
: ${s:=$(echo evaluated >&2)} 2>&1
i=0; : ${s:-$((i=i+1))}; echo $i
@2.6.2/10 | T | The word undergoes tilde, parameter, command and arithmetic expansion
--- param/c_word_expanded
HOME=/h; unset u; v=val
echo ${u:-~} ${u:-$v} ${u:-$(echo c)} ${u:-$((2+3))} ${u:-`echo b`}
@2.6.2/11 | T | An unquoted ${x:-word} result is split into fields, with quoted parts of word kept together
> param/default_split
--- param/c_default_fields
unset u
set -- ${u:-a b "c d" 'e f'}; echo $#
set -- "${u:-a b}"; echo $#
@2.6.2/12 | T | ${#x} is the length of the value in characters
> param/length
--- param/c_length
x=hello; e=; unset u
echo ${#x} ${#e} ${#u} ${#HOME}
set -- abc; echo ${#1} ${#}
@2.6.2/13 | T | ${#x} of an unset parameter fails under set -u
--- param/c_length_nounset
set -u
(unset u; echo ${#u}; echo not-reached) 2>/dev/null; echo "st=$?"
@2.6.2/14 | T | ${x%pattern} removes the smallest matching suffix and ${x%%pattern} the largest
> param/trim_suffix
--- param/c_trim_suffix
x=a.b.c
echo ${x%.*} ${x%%.*} ${x%} ${x%%} ${x%z} ${x%c} ${x%%?} ${x%[a-c]}
@2.6.2/15 | T | ${x#pattern} removes the smallest matching prefix and ${x##pattern} the largest
> param/trim_prefix
--- param/c_trim_prefix
x=/one/two/three
echo ${x#*/} ${x##*/} ${x#/one} ${x#} ${x##} ${x#z} ${x#?} ${x##/*/}
@2.6.2/16 | T | Quoting characters within the braces makes pattern characters literal
> param/trim_quoted
--- param/c_trim_literal
x='*a*b'
echo "${x#*}" "${x#'*'}" "${x#"*"}" "${x#\*}" "${x##*'*'}"
@2.6.2/17 | T | The pattern word is itself expanded (variables, command substitution) before matching
> param/trim_var_pattern
--- param/c_trim_expanded_pattern
x=/usr/local/bin; p=/usr; s='*'
echo ${x#$p} ${x#"$p"} ${x##$s/} ${x##"$s"/} ${x%$(echo /bin)}
@2.6.2/18 | T | Trim forms of an unset parameter fail under set -u
--- param/c_trim_nounset
set -u
(unset u; echo ${u#a}; echo not-reached) 2>/dev/null; echo "st=$?"
(unset u; echo ${u%%a}; echo not-reached) 2>/dev/null; echo "st=$?"
@2.6.2/19 | T | A bad substitution operator is an expansion error: a non-interactive shell exits
> param/bad_substitution
@2.6.2/20 | T | Parameter expansion applies to special parameters ($?, $#, $-, $!, $0, $$) in the modifier forms
--- param/c_special_modifiers
set -- a b
echo ${#:-x} ${?:-x} ${0:+zero} ${1:-x} ${3:-three} ${3-} "${1:+one}"
false; echo ${?#0}
@2.6.3/1 | T | $(commands) runs in a subshell and is replaced by its standard output
> cmdsub/basic cmdsub/isolation cmdsub/external
--- cmdsub/c_subshell_env
x=1; y=$(x=2; echo $x); echo $x $y
z=$(cd /; pwd); [ "$PWD" != / ] && echo cwd-kept
@2.6.3/2 | T | Trailing newlines of the output are removed, all of them; others are kept
> cmdsub/trailing_newlines cmdsub/program_newlines
--- cmdsub/c_newlines
x=$(printf 'a\n\nb\n\n\n'); echo "[$x]"
y=$(printf '\n\n'); echo "[$y]"
@2.6.3/3 | T | Unquoted command substitution output is split and globbed; quoted is not
> cmdsub/in_dquotes
--- cmdsub/c_split_glob
touch f1 f2
set -- $(echo 'a  b f*'); echo $# "$@"
set -- "$(echo 'a  b f*')"; echo $# "$@"
@2.6.3/4 | T | In `...` a backslash is literal except before $ ` and backslash
> cmdsub/backquote cmdsub/program_backquote
--- cmdsub/c_backquote_backslash
echo `echo \$HOME | wc -c | tr -d ' '`
echo `echo '\$x' "\\\\" \a`
x=1; echo `echo \\$x`
@2.6.3/5 | T | Backquotes nest by escaping the inner ones
--- cmdsub/c_backquote_nested
echo `echo a \`echo b \\\`echo c\\\`\``
@2.6.3/6 | T | $(...) may hold any program: quotes, comments, case with unbalanced ), here-documents
> cmdsub/case_inside
--- cmdsub/c_any_program
echo $(case x in x) echo matched;; esac)
echo $(echo a # comment )
)
echo $(cat <<E
here )
E
)
echo "$(echo ')')" $(echo \))
@2.6.3/7 | T | The result of a command substitution is not expanded again
--- cmdsub/c_not_rescanned
echo $(echo '$HOME ~ $(echo x) `echo y`')
@2.6.3/8 | T | $(( is arithmetic when it parses as such; $( ( starts a subshell in a command substitution
--- cmdsub/c_arith_ambiguity
echo $((1+2))
echo $( (echo sub) )
echo $( (echo a); (echo b) )
@2.6.3/9 | T | The exit status of the last command substitution is the status of a command with no name
> cmdsub/status cmdsub/program_status
@2.6.3/10 | T | An exit in a command substitution ends only the substitution
> cmdsub/exit_inside
@2.6.3/11 | T | A command substitution's commands see standard input and standard error of the shell
> cmdsub/program_stderr
--- cmdsub/c_stdin_inherited
echo data | { x=$(cat); echo "[$x]"; }
@2.6.4/1 | T | $((expression)) is replaced by the value of the expression
> arith/basic
@2.6.4/2 | T | The expression is treated as if double-quoted: parameter expansion and command substitution apply, and a double quote is not special
> arith/variables arith/nested
--- arith/c_expand_first
x=3; y='x + 1'
echo $(($x * 2)) $((${x}+1)) $(($(echo 4)+1)) $((`echo 5`+1)) $(($y))
@2.6.4/3 | T | Decimal, octal (leading 0) and hexadecimal (0x) constants are recognized
> arith/hex_octal
--- arith/c_constants
echo $((10)) $((010)) $((0x10)) $((0X1f)) $((0)) $((00))
@2.6.4/4 | T | The C operators apply with C precedence: unary + - ~ !, * / %, + -, << >>, relational, equality, & ^ |, && ||, ?:, assignment
> arith/precedence arith/unary arith/shifts_bits arith/logical arith/compare arith/ternary arith/short_circuit
--- arith/c_operators
echo $((1+2*3)) $(((1+2)*3)) $((7/2)) $((7%3)) $((-7/2)) $((-7%3))
echo $((1<<4)) $((256>>4)) $((6&3)) $((6|3)) $((6^3)) $((~0)) $((!5)) $((!0))
echo $((1<2)) $((2<=2)) $((3>4)) $((3>=4)) $((1==1)) $((1!=1))
echo $((1&&0)) $((1||0)) $((0?1:2)) $((1?1:2)) $((- -1)) $((+3))
echo $((2+3<<1)) $((1|2&3)) $((1==1&&2==3||4)) $((1?2:3?4:5))
@2.6.4/5 | T | Assignment operators change the variable, and the change is in effect after the expansion
> arith/assign_ops arith/assign_var
--- arith/c_assign
x=5
echo $((x=3)) $x $((x+=2)) $((x-=1)) $((x*=3)) $((x/=2)) $((x%=4)) $x
echo $((x<<=2)) $((x>>=1)) $((x&=6)) $((x|=1)) $((x^=2)) $x
: $((y=x+1)); echo $y
@2.6.4/6 | T | A variable name in an expression is read as its value: $((x)) equals $(($x)) for an integer value, signs included
--- arith/c_variable_value
x=7; n=-3; p=+4; u=; unset w
echo $((x)) $((n)) $((p)) $((x+n)) $((u+1)) $((w+1))
@2.6.4/7 | T | Arithmetic is signed long, at least; wrap-around does not stop the shell
> arith/overflow
--- arith/c_long
echo $((2147483647+1)) $((9223372036854775807)) $((-9223372036854775807-1))
@2.6.4/8 | T | An invalid expression fails with a diagnostic; a non-interactive shell exits
> arith/syntax_error arith/illegal_value arith/divzero
--- arith/c_invalid
(echo $((1 +)); echo no) 2>/dev/null; echo "st=$?"
(x=abc; abc=; echo $((1 + 2x)); echo no) 2>/dev/null; echo "st=$?"
(echo $((1/0)); echo no) 2>/dev/null; echo "st=$?"
(echo $((1%0)); echo no) 2>/dev/null; echo "st=$?"
@2.6.4/9 | T | White space and newlines are allowed in an expression
> arith/spaces_newlines
@2.6.4/10 | T | An arithmetic expansion's result is subject to field splitting when unquoted
> split/ifs_digits
--- arith/c_result_split
IFS=0; set -- $((100+1)); echo $#
set -- "$((100+1))"; echo $#
@2.6.4/11 | X | A variable whose value is itself an expression or name is evaluated (extension recorded: dash refuses, bash recurses)
! not required by POSIX (only integer-constant values are); recorded from dash
--- arith/c_value_not_constant
x='1+1'
(echo $((x))) 2>/dev/null; echo "st=$?"
@2.6.4/12 | X | Comma is not required; ++ and -- are not required (recorded from dash)
! optional operators; dash refuses ++x as written (reads +(+x)), bash implements them
--- arith/c_incr_optional
x=5; echo $((++x)) $x
@2.6.5/1 | T | Fields from expansions not in double quotes are split at IFS characters
> split/default split/literal_not_split
--- split/c_basic
x='a b	c
d'; set -- $x; echo $#
set -- a\ b "c d"; echo $#
@2.6.5/2 | T | With IFS null no splitting occurs, and an expansion that is wholly empty is removed
> split/empty_ifs split/empty_unquoted
--- split/c_null_ifs
IFS=
x='a b'; e=
set -- $x; echo $#
set -- $e; echo $#
set -- $e"" $x$e; echo $#
@2.6.5/3 | T | IFS white space at the start and end of an expansion is ignored, and runs of it delimit once
--- split/c_whitespace_runs
x='   a    b   '
set -- $x; echo "$# [$1][$2]"
IFS='	 '; set -- $x; echo $#
@2.6.5/4 | T | Each non-white-space IFS character delimits a field; adjacent ones give empty fields
> split/colon split/leading_colon
--- split/c_nonwhite
IFS=:
x='a::b:'; set -- $x; echo "$# [$1][$2][$3]"
y=':a'; set -- $y; echo "$# [$1][$2]"
z='::'; set -- $z; echo $#
@2.6.5/5 | T | A non-white-space IFS character with adjacent IFS white space is one delimiter
> split/mixed_ifs
--- split/c_mixed
IFS=' :'
x='a : b  :  : c'; set -- $x; echo "$# [$1][$2][$3][$4]"
y=' : a'; set -- $y; echo "$# [$1][$2]"
@2.6.5/6 | T | A trailing non-white-space IFS delimiter does not produce a trailing empty field
--- split/c_trailing_delim
IFS=:
x='a:b:'; set -- $x; echo $#
y='a:b::'; set -- $y; echo $#
@2.6.5/7 | T | An expansion that is empty or all IFS white space produces zero fields
--- split/c_zero_fields
e=; w='   '
set -- $e $w; echo $#
set -- a $e b; echo $#
@2.6.5/8 | T | Only the parts of a word that came from an expansion are split; literal parts join their neighbours
> split/joined_word
--- split/c_literal_parts
x='b c'
set -- a$x'd e'; echo "$# [$1][$2]"
IFS=:; y='p:q'; set -- a:$y:z; echo "$# [$1][$2]"
@2.6.5/9 | T | Splitting applies to command substitution and arithmetic results as to parameters
> split/cmdsub
@2.6.5/10 | T | IFS is used at the time of the split, including an assignment earlier in the same list
--- split/c_ifs_changes
x='a:b c'
IFS=:; set -- $x; echo $#
IFS=' '; set -- $x; echo $#
IFS=: eval 'set -- $x'; echo $#
@2.6.5/11 | T | Assignment values and case words are not split
--- split/c_not_in_assign
x='a  b'; y=$x; echo "$y"
case $x in 'a  b') echo whole;; esac
z=$(echo 'p   q'); echo "$z"
@2.6.6/1 | T | After splitting, each field with unquoted pattern characters is matched against file names unless set -f
> glob/star glob/noglob option/noglob
@2.6.6/2 | T | A pattern produced by an expansion is used for pathname expansion
> glob/edge_var
--- glob/c_from_expansion
touch a1 a2 b1
p='a*'; echo $p "$p"
echo $(echo 'b*')
@2.6.7/1 | T | Quote characters present in the original word are removed unless themselves quoted
> quote/mixed quote/empty_args
--- quote/c_removal
echo "a"'b'\c "\"" '\' "'" \\ ""x'' "$(echo '"')"
set -- "" '' ; echo $#
@2.6.7/2 | T | Quote characters that result from an expansion are not removed
--- quote/c_removal_not_expanded
x='"a" \b'"'c'"
echo $x
