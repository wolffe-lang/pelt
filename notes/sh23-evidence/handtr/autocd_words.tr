step 0
err no
prompt "$ "
step 1 "set -o autocd"
err no
prompt "$ "
step 2 "W=$PWD; mkdir child other"
err no
prompt "$ "
step 3 "child a b; echo \"two st=$? ${PWD#\"$W\"}\""
out "two st=0 /child\n"
err no
prompt "$ "
step 4 "cd \"$W\"; ./child other; echo \"slashed st=$? ${PWD#\"$W\"}\""
out "slashed st=0 /child\n"
err no
prompt "$ "
step 5 "cd \"$W\"; child -P; echo \"option st=$? ${PWD#\"$W\"}\""
out "option st=0 /child\n"
err no
prompt "$ "
step 6 "exit"
err no
prompt ""
exit 0 at step 6
