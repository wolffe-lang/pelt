:
W=$PWD; mkdir -m 000 locked; mkdir sub
cd -- ./locked; echo "locked st=$? ${PWD#"$W"}"
cd -- locked 2>err; echo "redir st=$? ${PWD#"$W"} $([ -s err ] && echo said)"
chmod 755 locked
command ./sub; echo "command st=$? ${PWD#"$W"}"
(cd -- sub) 2>/dev/null; echo "subshell ${PWD#"$W"}"
cd -- sub 2>/dev/null | cat; echo "pipe ${PWD#"$W"}"
FOO=bar cd -- sub; echo "assign st=$? ${FOO-unset} ${PWD#"$W"}"
cd "$W"; cd -- sub >out; echo "out st=$? ${PWD#"$W"} [$(cat "$W/out")]"
cd "$W"; cd() { echo "fn cd [$#] $*"; command cd "$@"; }
cd -- sub; echo "fn st=$? ${PWD#"$W"}"
unset -f cd
exit
