:
W=$PWD; mkdir child "my dir"; d=child
cd -- child; echo "child st=$? ${PWD#"$W"}"
cd "$W"; cd -- "my dir"; echo "space st=$? ${PWD#"$W"}"
cd "$W"; cd -- $d; echo "var st=$? ${PWD#"$W"}"
cd "$W"; mkdir -p elsewhere/kid elsewhere/only kid; CDPATH=$W/elsewhere
cd -- kid >/dev/null; echo "cdpath st=$? ${PWD#"$W"}"
cd "$W"; only; echo "only st=$? ${PWD#"$W"}"
unset CDPATH
exit
