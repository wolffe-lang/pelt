step 0
err no
prompt "$ "
step 1 "set -o autocd"
err no
prompt "$ "
step 2 "W=$PWD; mkdir -p home/pax"
err no
prompt "$ "
step 3 "home/pax; echo \"rel st=$? ${PWD#\"$W\"} ${OLDPWD#\"$W\"}\""
out "rel st=0 /home/pax \n"
err no
prompt "$ "
step 4 "cd \"$W\"; \"$W/home/pax/\"; echo \"abs st=$? ${PWD#\"$W\"}\""
out "abs st=0 /home/pax\n"
err no
prompt "$ "
step 5 "..; echo \"dotdot st=$? ${PWD#\"$W\"}\""
out "dotdot st=0 /home\n"
err no
prompt "$ "
step 6 "..; echo \"dotdot st=$? ${PWD#\"$W\"}\""
out "dotdot st=0 \n"
err no
prompt "$ "
step 7 "~; echo \"tilde st=$? ${PWD#\"$HOME\"}\""
out "tilde st=0 \n"
err no
prompt "$ "
step 8 "cd \"$W\"; home/pax/; cd - >/dev/null; echo \"back st=$? ${PWD#\"$W\"}\""
out "back st=0 \n"
err no
prompt "$ "
step 9 "exit"
err no
prompt ""
exit 0 at step 9
