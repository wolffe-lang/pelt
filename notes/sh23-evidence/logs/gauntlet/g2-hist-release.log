hist-witness: write    ok   file b"echo one\nprintf '%s\\\\n' 'a\\\\b'\nfor i in 1 2\\ndo echo $i\\ndone\nexit\n", mode 600, status 0
hist-witness: read     ok   fc -l b"1\techo one\n2\tprintf '%s\\n' 'a\\b'\n3\tfor i in 1 2\n\tdo echo $i\n\tdone\n4\texit\n", Up x3 ran b'1\n2\n', said b''
