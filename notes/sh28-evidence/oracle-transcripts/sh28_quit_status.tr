step 0
err no
prompt "$ "
step 1 "exec 2>&0"
err yes
prompt ""
step 2 "trap 'echo trapped' QUIT"
err no
prompt ""
step 3 "false"
err no
prompt ""
step 4 "\\k echo forbidden\\x1c"
out "trapped\n"
err no
prompt ""
step 5 "printf 'status:%s\\n' $?:end"
out "status:1:end\n"
err no
prompt ""
step 6 "exit"
err no
prompt ""
exit 0 at step 6
