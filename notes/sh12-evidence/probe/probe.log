===== p01_list.keys  meta={}
--- dash: dash -i +m
    step 0 null
    ERR "$ "
    step 1 "echo one"
    out "one\n"
    ERR "$ "
    step 2 "echo two"
    out "two\n"
    ERR "$ "
    step 3 "fc -l"
    out "    1 echo one\n    2 echo two\n"
    ERR "$ "
    step 4 "fc -ln -1"
    out "fc -l\n"
    ERR "$ "
    step 5 "fc -l 1 2"
    out "    1 echo one\n    2 echo two\n"
    ERR "$ "
    step 6 "fc -lr"
    out "    5 fc -l 1 2\n    4 fc -ln -1\n    3 fc -l\n    2 echo two\n    1 echo one\n"
    ERR "$ "
    step 7 "fc -s"
    out "    6 fc -lr\n    5 fc -l 1 2\n    4 fc -ln -1\n    3 fc -l\n    2 echo two\n    1 echo one\n"
    ERR "fc -lr\n$ "
    step 8 "fc -s one=uno 1"
    out "uno\n"
    ERR "echo uno\n$ "
    step 9 "fc -l"
    out "    1 echo one\n    2 echo two\n    3 fc -l\n    4 fc -ln -1\n    5 fc -l 1 2\n    6 fc -lr\n    7 fc -s\n    8 fc -s one=uno 1\n    9 echo uno\n"
    ERR "$ "
    step 10 "exit"
    exit 0
--- bash: bash --posix -i +m
    step 0 null
    ERR "bash-5.3$ "
    step 1 "echo one"
    out "one\n"
    ERR "echo one\nbash-5.3$ "
    step 2 "echo two"
    out "two\n"
    ERR "echo two\nbash-5.3$ "
    step 3 "fc -l"
    out "1\techo one\n2\techo two\n"
    ERR "fc -l\nbash-5.3$ "
    step 4 "fc -ln -1"
    out "\tfc -l\n"
    ERR "fc -ln -1\nbash-5.3$ "
    step 5 "fc -l 1 2"
    out "1\techo one\n2\techo two\n"
    ERR "fc -l 1 2\nbash-5.3$ "
    step 6 "fc -lr"
    out "5\tfc -l 1 2\n4\tfc -ln -1\n3\tfc -l\n2\techo two\n1\techo one\n"
    ERR "fc -lr\nbash-5.3$ "
    step 7 "fc -s"
    out "7\tfc -lr\n6\tfc -lr\n5\tfc -l 1 2\n4\tfc -ln -1\n3\tfc -l\n2\techo two\n1\techo one\n"
    ERR "fc -s\nfc -lr\nbash-5.3$ "
    step 8 "fc -s one=uno 1"
    out "uno\n"
    ERR "fc -s one=uno 1\necho uno\nbash-5.3$ "
    step 9 "fc -l"
    out "1\techo one\n2\techo two\n3\tfc -l\n4\tfc -ln -1\n5\tfc -l 1 2\n6\tfc -lr\n7\tfc -lr\n8\techo uno\n"
    ERR "fc -l\nbash-5.3$ "
    step 10 "exit"
    ERR "exit\nexit\n"
    exit 0
