    ERR "exit\nexit\n"
    exit 0
===== p03_err.keys  meta={}
--- dash: dash -i +m
    step 0 null
    ERR "$ "
    step 1 "fc -l"
    out "    1 fc -l\n"
    ERR "$ "
    step 2 "fc -s"
    out "    1 fc -l\n"
    ERR "fc -l\n$ "
    step 3 "fc -l 5"
    out "    1 fc -l\n    2 fc -s\n"
    ERR "$ "
    step 4 "fc -l nosuch"
    ERR "dash: 4: fc: history pattern not found: nosuch\n$ "
    step 5 "echo x"
    out "x\n"
    ERR "$ "
    step 6 "fc -l nosuch"
    ERR "dash: 6: fc: history pattern not found: nosuch\n$ "
    step 7 "fc -l 99"
    out "    1 fc -l\n    2 fc -s\n    3 fc -l 5\n    4 fc -l nosuch\n    5 echo x\n    6 fc -l nosuch\n"
    ERR "$ "
    step 8 "fc -l -99"
    out "    1 fc -l\n    2 fc -s\n    3 fc -l 5\n    4 fc -l nosuch\n    5 echo x\n    6 fc -l nosuch\n    7 fc -l 99\n"
    ERR "$ "
    step 9 "fc -s zzz"
    ERR "dash: 9: fc: history pattern not found: zzz\n$ "
    step 10 "exit"
    exit 2
--- bash: bash --posix -i +m
    step 0 null
    ERR "bash-5.3$ "
    step 1 "fc -l"
    out "1\tfc -l\n"
    ERR "fc -l\nbash-5.3$ "
    step 2 "fc -s"
    out "1\tfc -l\n2\tfc -l\n"
    ERR "fc -s\nfc -l\nbash-5.3$ "
    step 3 "fc -l 5"
    out "1\tfc -l\n2\tfc -l\n"
    ERR "fc -l 5\nbash-5.3$ "
    step 4 "fc -l nosuch"
    ERR "fc -l nosuch\nbash: fc: no command found\nbash-5.3$ "
    step 5 "echo x"
    out "x\n"
    ERR "echo x\nbash-5.3$ "
    step 6 "fc -l nosuch"
    ERR "fc -l nosuch\nbash: fc: no command found\nbash-5.3$ "
    step 7 "fc -l 99"
    out "1\tfc -l\n2\tfc -l\n3\tfc -l 5\n4\tfc -l nosuch\n5\techo x\n6\tfc -l nosuch\n"
    ERR "fc -l 99\nbash-5.3$ "
    step 8 "fc -l -99"
    out "1\tfc -l\n2\tfc -l\n3\tfc -l 5\n4\tfc -l nosuch\n5\techo x\n6\tfc -l nosuch\n7\tfc -l 99\n"
    ERR "fc -l -99\nbash-5.3$ "
    step 9 "fc -s zzz"
    ERR "fc -s zzz\nbash: fc: no command found\nbash-5.3$ "
    step 10 "exit"
    ERR "exit\nexit\n"
    exit 1
===== p04_s.keys  meta={'oracle_args': '--noediting -i +m', 'env': 'PS1=$\\s FCEDIT=true', 'who': 'bash'}
--- bash: bash --posix --noediting -i +m
    step 0 null
    ERR "$ "
    step 1 "echo one"
    out "one\n"
    ERR "$ "
    step 2 "fc -s"
    out "one\n"
    ERR "echo one\n$ "
    step 3 "fc -s 1"
    out "one\n"
    ERR "echo one\n$ "
    step 4 "fc -e true"
    out "one\n"
    ERR "echo one\n$ "
    step 5 "fc -e false"
    ERR "$ "
    step 6 "fc -l"
    out "1\techo one\n2\techo one\n3\techo one\n4\techo one\n"
    ERR "$ "
    step 7 "fc -e true 1 2"
    out "one\none\n"
    ERR "echo one\necho one\n$ "
    step 8 "fc -l"
    out "1\techo one\n2\techo one\n3\techo one\n4\techo one\n5\tfc -l\n6\techo one\n7\techo one\n"
    ERR "$ "
    step 9 "fc -s -- -1 2>/dev/null"
    out "1\techo one\n2\techo one\n3\techo one\n4\techo one\n5\tfc -l\n6\techo one\n7\techo one\n8\tfc -l\n9\tfc -l\n"
    ERR "$ "
    step 10 "x=7 fc -s 1"
    out "one\n"
    ERR "echo one\n$ "
    step 11 "fc -e - one=two 1"
    out "two\n"
    ERR "echo two\n$ "
    step 12 "fc -l"
    out "1\techo one\n2\techo one\n3\techo one\n4\techo one\n5\tfc -l\n6\techo one\n7\techo one\n8\tfc -l\n9\tfc -l\n10\techo one\n11\techo two\n"
    ERR "$ "
    step 13 "fc -l 2 99"
    out "2\techo one\n3\techo one\n4\techo one\n5\tfc -l\n6\techo one\n7\techo one\n8\tfc -l\n9\tfc -l\n10\techo one\n11\techo two\n12\tfc -l\n"
    ERR "$ "
    step 14 "fc -l 99 2"
    out "1\techo one\n2\techo one\n"
    ERR "$ "
    step 15 "fc -l 0"
    out "14\tfc -l 99 2\n"
    ERR "$ "
    step 16 "fc -l -1 -3"
    out "15\tfc -l 0\n14\tfc -l 99 2\n13\tfc -l 2 99\n"
    ERR "$ "
    step 17 "fc -l 3"
    out "3\techo one\n4\techo one\n5\tfc -l\n6\techo one\n7\techo one\n8\tfc -l\n9\tfc -l\n10\techo one\n11\techo two\n12\tfc -l\n13\tfc -l 2 99\n14\tfc -l 99 2\n15\tfc -l 0\n16\tfc -l -1 -3\n"
    ERR "$ "
    step 18 "fc"
    out "3\techo one\n4\techo one\n5\tfc -l\n6\techo one\n7\techo one\n8\tfc -l\n9\tfc -l\n10\techo one\n11\techo two\n12\tfc -l\n13\tfc -l 2 99\n14\tfc -l 99 2\n15\tfc -l 0\n16\tfc -l -1 -3\n17\tfc -l 3\n"
    ERR "fc -l 3\n$ "
    step 19 "fc -l -0"
    out "19\tfc -l -0\n"
    ERR "$ "
    step 20 "fc -l +2 +3"
    ERR "bash: fc: no command found\n$ "
    step 21 "exit"
    ERR "exit\n"
    exit 1
