===== p06_multi.keys  meta={'oracle_args': '--noediting -i +m', 'env': 'PS1=$\\s PS2=>\\s'}
--- dash: dash --noediting -i +m
    step 0 null
    ERR "dash: 0: Illegal option --\n"
    exit 2
--- bash: bash --posix --noediting -i +m
    step 0 null
    ERR "$ "
    step 1 "for i in 1 2"
    ERR "> "
    step 2 "do echo $i"
    ERR "> "
    step 3 "done"
    out "1\n2\n"
    ERR "$ "
    step 4 "fc -l"
    out "1\tfor i in 1 2; do echo $i; done\n"
    ERR "$ "
    step 5 "fc -ln -1"
    out "\tfc -l\n"
    ERR "$ "
    step 6 "fc -s -2"
    out "1\tfor i in 1 2; do echo $i; done\n2\tfc -l\n3\tfc -ln -1\n4\tfc -l\n"
    ERR "fc -l\n$ "
    step 7 "HISTSIZE=3"
    ERR "$ "
    step 8 "echo a"
    out "a\n"
    ERR "$ "
    step 9 "echo b"
    out "b\n"
    ERR "$ "
    step 10 "fc -l"
    out "5\techo a\n6\techo b\n"
    ERR "$ "
    step 11 "fc -l 1"
    out "6\techo b\n7\tfc -l\n"
    ERR "$ "
    step 12 "exit"
    ERR "exit\n"
    exit 0
