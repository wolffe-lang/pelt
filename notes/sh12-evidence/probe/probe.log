===== d06.keys  meta={'env': 'PS1=$\\s PS2=>\\s', 'who': 'dash'}
--- dash: dash -i +m
    step 0 null
    ERR "$ "
    step 1 "for i in 1 2"
    ERR "> "
    step 2 "do echo $i"
    ERR "> "
    step 3 "done"
    out "1\n2\n"
    ERR "$ "
    step 4 "fc -l"
    out "    1 for i in 1 2\ndo echo $i\ndone\n"
    ERR "$ "
    step 5 "fc -ln -1"
    out "fc -l\n"
    ERR "$ "
    step 6 "fc -s -2"
    out "    1 for i in 1 2\ndo echo $i\ndone\n    2 fc -l\n    3 fc -ln -1\n"
    ERR "fc -l\n$ "
    step 7 "HISTSIZE=3"
    ERR "$ "
    step 8 "echo a"
    out "a\n"
    ERR "$ "
    step 9 "echo b"
    out "b\n"
    ERR "$ "
    step 10 "fc -l"
    out "    6 echo a\n    7 echo b\n"
    ERR "$ "
    step 11 "fc -l 1"
    out "    7 echo b\n    8 fc -l\n"
    ERR "$ "
    step 12 "exit"
    exit 0
