===== d09.keys  meta={'env': 'PS1=$\\s', 'who': 'dash bash'}
--- dash: dash -i +m
    step 0 null
    ERR "$ "
    step 1 "echo a"
    out "a\n"
    ERR "$ "
    step 2 "echo b"
    out "b\n"
    ERR "$ "
    step 3 "echo c"
    out "c\n"
    ERR "$ "
    step 4 "fc -lr 3 1"
    out "    1 echo a\n    2 echo b\n    3 echo c\n"
    ERR "$ "
    step 5 "fc -l -0"
    out "    5 fc -l -0\n    4 fc -lr 3 1\n"
    ERR "$ "
    step 6 "fc -l 2 1"
    out "    2 echo b\n    1 echo a\n"
    ERR "$ "
    step 7 "exit"
    exit 0
--- bash: bash --posix -i +m
    step 0 null
    ERR "$ "
    step 1 "echo a"
    out "a\n"
    ERR "echo a\n$ "
    step 2 "echo b"
    out "b\n"
    ERR "echo b\n$ "
    step 3 "echo c"
    out "c\n"
    ERR "echo c\n$ "
    step 4 "fc -lr 3 1"
    out "1\techo a\n"
    ERR "fc -lr 3 1\n$ "
    step 5 "fc -l -0"
    out "5\tfc -l -0\n"
    ERR "fc -l -0\n$ "
    step 6 "fc -l 2 1"
    out "2\techo b\n1\techo a\n"
    ERR "fc -l 2 1\n$ "
    step 7 "exit"
    ERR "exit\nexit\n"
    exit 0
