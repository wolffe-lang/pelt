    ],
    "out": "EMPTY\n",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_undo": {
    "steps": [
      "exec 2>&0",
      "abbr add zz 'echo NO'",
      "\\k zz ",
      "\\k \\x1f",
      "\\k \\x01echo \\x05\\r",
      "\\k \\x07\\x05\\x15",
      "exit 0"
    ],
    "out": "zz\n",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_cancel": {
    "steps": [
      "exec 2>&0",
      "abbr add zz 'echo NO'",
      "\\k zz ",
      "\\k \\x03",
      "echo CANCELED",
      "\\k \\x07\\x05\\x15",
      "exit 0"
    ],
    "out": "CANCELED\n",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_argument": {
