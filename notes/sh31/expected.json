      "exit 0"
    ],
    "out": "KEEP\n",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_erase": {
    "steps": [
      "exec 2>&0",
      "abbr add zz 'echo NO'",
      "abbr erase zz",
      "abbr list",
      "\\k \\x07\\x05\\x15",
      "exit 0"
    ],
    "out": "",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_persisted": {
