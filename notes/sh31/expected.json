{
  "sh31_abbr_space": {
    "steps": [
      "exec 2>&0",
      "abbr add zz 'echo SPACE'",
      "\\k zz ",
      "\\k \\r",
      "\\k \\x07\\x05\\x15",
      "exit 0"
    ],
    "out": "SPACE\n",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_enter": {
    "steps": [
      "exec 2>&0",
      "abbr add zz 'echo ENTER'",
      "zz",
      "\\k \\x07\\x05\\x15",
      "exit 0"
    ],
    "out": "ENTER\n",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_multi": {
    "steps": [
      "exec 2>&0",
      "abbr add zz 'echo one two'",
      "\\k zz three\\r",
      "\\k \\x07\\x05\\x15",
      "exit 0"
    ],
    "out": "one two three\n",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_quoted_value": {
