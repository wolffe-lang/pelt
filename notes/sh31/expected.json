      "abbr add zz \"echo 'two words'\"",
      "zz",
      "\\k \\x07\\x05\\x15",
      "exit 0"
    ],
    "out": "two words\n",
    "extra": {},
    "files": {},
    "visible": null
  },
  "sh31_abbr_empty": {
    "steps": [
      "exec 2>&0",
      "abbr add zz ''",
