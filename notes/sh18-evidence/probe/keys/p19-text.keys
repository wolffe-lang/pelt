x=1
true 'a b' "c$x" d\$e "f\"g" 'h"i' & sleep 0.1
true ${x} $x "${x}" $(echo y) `echo z` "$(echo w)" & sleep 0.1
true ~ ~/a *.c [ab] a?b & sleep 0.1
true >a <b >>c 2>&1 3<>d 4>|e 5<&- <<EOF2 & sleep 0.1
body
EOF2
! true & sleep 0.1
f() { true; }; f arg & sleep 0.1
for i in 1 2; do true; done & sleep 0.1
while false; do true; done & sleep 0.1
until true; do :; done & sleep 0.1
case a in a) true;; b|c) false;; esac & sleep 0.1
{ true; false; } & sleep 0.1
(true; false) & sleep 0.1
true && false || true & sleep 0.1
true | false | true & sleep 0.1
if true; then :; elif false; then :; else :; fi & sleep 0.1
true aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa bbb & sleep 0.1
true $((1+2)) "$((x*2))" & sleep 0.1
true 'tab	x' 'nl
y' & sleep 0.1
true '\' "\\" '$' '`' & sleep 0.1
true; sleep 30 & sleep 0.1
jobs
kill %1
exit
