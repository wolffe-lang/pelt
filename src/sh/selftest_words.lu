//! Editor-only words: pure parsing plus direct storage/undo assertions.

fn want_words(mut bad: List[str]) {
    want_events(mut bad)
    want_completion_words(mut bad)
    let records = abbr_records(
        "zz\techo expanded\nempty\t\nquoted\techo 'two words'\nmalformed\nno name\tx\nbad\tx\tmore\nesc\t\x1b[31m\nzz\techo latest\n",
    )
    if records.len != 3 || (records["zz"] else "") != "echo latest" || !records.has("empty") {
        (mut bad).push("abbr malformed records / empty / duplicate")
    }
    let sh = new_sh("words-test")
    let q = Query { cols: 80, rows: 24, fixed: 80, col0: 0, cpr: 0, pend: "" }
    var e = editor_state(sh, "$ ", q, default_chars())
    e.abbrs = copy records
    e.abbreviate = true
    e.friendly = true
    start_line(mut e)
    insert(mut e, cps_of("zz "))
    abbr_space(mut e)
    if cps_text(e.buf) != "echo latest " { (mut bad).push("abbr first word space") }
    emacs_undo(mut e)
    if cps_text(e.buf) != "zz " { (mut bad).push("abbr undo restores typed word and space") }
    for literal in ["echo zz ", "'zz' ", "z\\z ", "echo x # zz "] {
        set_line(mut e, cps_of(literal), cps_of(literal).len)
        abbr_space(mut e)
        if cps_text(e.buf) != literal { (mut bad).push("abbr changed quoted/nonfirst word") }
    }
    set_line(mut e, cps_of("echo x; zz "), 11)
    abbr_space(mut e)
    if cps_text(e.buf) != "echo x; echo latest " {
        (mut bad).push("abbr command position after separator")
    }
    set_line(mut e, cps_of("zz"), 2)
    abbr_expand(mut e, e.cur)
    if cps_text(e.buf) != "echo latest" { (mut bad).push("abbr Enter trigger") }
    e.abbreviate = false
    set_line(mut e, cps_of("zz "), 3)
    abbr_space(mut e)
    if cps_text(e.buf) != "zz " { (mut bad).push("abbr disabled gate") }
    if !stored_plain(e.buf) || !stored_plain(e.mem.kill) {
        (mut bad).push("abbr control in storage")
    }
}

fn want_events(mut bad: List[str]) {
    let previous = "echo one 'two three' # not a word"
    for pair in [
        ["!!", previous],
        ["echo !$", "echo 'two three'"],
        ["echo '!!'", "echo '!!'"],
        ["echo \\!! # !!", "echo \\!! # !!"],
        ["echo \"!!\"", "echo \"" + previous + "\""],
        ["echo !1 !name !-1 !", "echo !1 !name !-1 !"],
        ["echo !$ !$", "echo 'two three' 'two three'"],
    ] {
        let got = event_expand(pair[0], previous, "")
        if got.line != pair[1] || got.missing {
            (mut bad).push("event expansion: {pair[0]} => {got.line}")
        }
    }
    if !event_expand("!!", "", "").missing || !event_expand("!$", "", "").missing {
        (mut bad).push("event missing reference")
    }
    if event_last("echo one > output") != "output" { (mut bad).push("event-last-word redirection") }
    if event_expand("!!'", previous, "echo '\n").changed {
        (mut bad).push("event continued single quote")
    }
    if event_last("echo $(printf 'two words')") != "$(printf 'two words')" ||
        event_last("echo ${{value:-two words}}") != "${{value:-two words}}" ||
        event_last("echo 界") != "界" {
        (mut bad).push("event-last-word compound shell spelling")
    }
    let sh = new_sh("event-test")
    let q = Query { cols: 80, rows: 24, fixed: 80, col0: 0, cpr: 0, pend: "" }
    var e = editor_state(sh, "$ ", q, default_chars())
    e.histexpand = true
    e.prev_line = previous
    e.buf = cps_of("echo !$")
    let before = ints_txt(e.buf)
    if !event_accept(mut e) ||
        e.event_line != "echo 'two three'" ||
        ints_txt(e.buf) != before ||
        e.changes.len != 0 ||
        e.mem.kill.len != 0 {
        (mut bad).push("event touched editable storage")
    }
}

fn want_completion_words(mut bad: List[str]) {
    let parsed = help_options(
        "Usage: tool\n  -a, --alpha  First choice\n  --beta=VALUE\tSecond choice\n  --alpha  duplicate\n  --bad\x1b[31m  control\n",
        "--",
    )
    if joined(parsed.names) != "[--alpha][--beta][--bad]" {
        (mut bad).push("help option lexical extraction")
    }
    let sh = new_sh("completion-test")
    let q = Query { cols: 80, rows: 24, fixed: 80, col0: 0, cpr: 0, pend: "" }
    var e = editor_state(sh, "$ ", q, default_chars())
    e.highlight = true
    e.buf = cps_of("echo draft")
    e.cur = 7
    start_line(mut e)
    draw_from(mut e, 0)
    e.cp_rows = [
        "alpha (First choice)",
        "beta (Second choice)",
        "gamma (Third choice)",
        "delta (Fourth choice)",
        "epsilon (Fifth choice)",
        "zeta (Sixth choice)",
    ]
    let before = ints_txt(e.buf)
    let cursor = e.cur
    e.cp_at = 2
    e.out = List[byte]()
    completion_draw(mut e)
    if ints_txt(e.buf) != before || e.cur != cursor || !stored_plain(e.buf) || e.changes.len != 0 {
        (mut bad).push("completion-pager-storage: row changed edit buffer or undo")
    }
    if text(Buf { b: copy e.out }).contains("\x1b[0;36m") { (mut bad).push("completion pager inherited line syntax colour") }
    let (cols, rows, _width) = completion_shape(e)
    if cols != 3 || rows != 2 { (mut bad).push("completion 80-column adaptive layout") }
    e.cols = 24
    let (narrow, high, _w) = completion_shape(e)
    if narrow != 1 || high != 5 { (mut bad).push("completion narrow row bound") }
    for change in e.changes {
        if !stored_plain(change.line) { (mut bad).push("completion style entered undo") }
    }
    if !stored_plain(e.mem.kill) { (mut bad).push("completion style entered kill ring") }
}
