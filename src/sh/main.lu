//! sh.main — the command line: which input, which mode.
//!
//! References consulted: POSIX.1-2024 XCU `sh` (OPTIONS, OPERANDS,
//! STDIN); black-box runs of `dash` 0.5.13.4 for `-c`, `-i`, `-s`,
//! option letters in one argument (`-ec`, `-eo pipefail`), a lone `-`,
//! and the `$0` it reports.

/// The whole shell: parse the command line `args` (argv without argv[0]),
/// run what it names, and answer the exit status.
pub fn run_main(args: List[str]) -> int {
    var i = 0
    var parse_only = false
    var dump_tree = false
    var cmd_string = false
    var force_i = false
    var read_stdin = false
    var opts = List[str]()
    while i < args.len {
        let a = args[i]
        if a == "--parse" {
            dump_tree = true
            i += 1
            continue
        }
        if a == "--self-test" && i == 0 {
            // the table checks (`sh.selftest`) on the tier this binary is,
            // and `busy`'s row, which only a compiled tier can answer
            // (`wolf test` runs them on the checked machine)
            return self_test_main()
        }
        if a == "--" {
            i += 1
            break
        }
        if a == "-c" {
            cmd_string = true
            i += 1
            continue
        }
        if a == "-n" {
            parse_only = true
            i += 1
            continue
        }
        if a == "-" {
            // a lone hyphen ends the options and is dropped (XCU `sh`
            // OPERANDS): `sh -s - x` has `$1` x
            i += 1
            break
        }
        let c0 = ch(a, 0)
        if a.len > 1 && (c0 == '-' || c0 == '+') {
            // one cluster of letters (`-ec`, `-xc`, `-eo pipefail`):
            // `c`, `i` and `s` are the command line's alone (`set` has
            // none of them), an `o` takes the next operand as an
            // option's name, and the other letters go to `set`
            let on = c0 == '-'
            var o = buf()
            var taken = 0
            var k = 1
            while k < a.len {
                let c = ch(a, k)
                if on && c == 'c' {
                    cmd_string = true
                } else if on && c == 'i' {
                    force_i = true
                } else if on && c == 's' {
                    read_stdin = true
                } else if c == 'o' {
                    (mut opts).push(if on then "-o" else "+o")
                    if i + 1 + taken < args.len {
                        (mut opts).push(args[i + 1 + taken])
                        taken += 1
                    }
                } else {
                    putc(mut o, c)
                }
                k += 1
            }
            if o.b.len > 0 {
                (mut opts).push("{c0}{text(o)}")
            }
            i += 1 + taken
            continue
        }
        break
    }
    var src = ""
    var name = "pelt"
    var rest = List[str]()
    if cmd_string {
        if i >= args.len {
            eprint("pelt: -c needs a command string")
            return 2
        }
        src = args[i]
        i += 1
        if i < args.len {
            name = args[i]
            i += 1
        }
    } else if !read_stdin && i < args.len {
        name = args[i]
        i += 1
        let bytes = fs_read_bytes(name) else |_| {
            eprint("pelt: cannot open {name}")
            return 127
        }
        src = str_from_utf8(bytes) else |_| {
            eprint("pelt: {name}: not UTF-8 text")
            return 2
        }
    } else if !dump_tree && !parse_only {
        while i < args.len {
            (mut rest).push(args[i])
            i += 1
        }
        return run_input(name, rest, opts, force_i)
    } else {
        var o = buf()
        loop {
            let line = read_line() else |e| match e {
                eof => { break },
                io => { break },
                utf8 => { break },
            }
            put(mut o, line)
            putc(mut o, '\n')
        }
        src = text(o)
    }
    while i < args.len {
        (mut rest).push(args[i])
        i += 1
    }
    if dump_tree {
        return dump_all(src, name)
    }
    if parse_only {
        return check_all(src, name)
    }
    // `-c` with `-s`: the string, then standard input (unspecified by
    // POSIX; dash, black-box: `echo 'echo b' | sh -cs 'echo a'` prints
    // both)
    run_source(src, name, rest, opts, cmd_string && read_stdin)
}

/// `pelt --self-test`: each failing table check one line on standard
/// error, then `busy`'s row; 0 when none failed.
fn self_test_main() -> int {
    var bad = self_test()
    let busy = fork_busy_answer()
    if busy.len > 0 {
        (mut bad).push(busy)
    }
    for line in bad {
        eprint(line)
    }
    if bad.len > 0 {
        eprint("pelt --self-test: {bad.len} table checks failed")
        return 1
    }
    print(
        "pelt --self-test: every table check passed; a fork with a task live is busy and runs in process",
    )
    0
}

fn report(name: str, line: int, msg: str) {
    eprint("pelt: {name}: line {line}: {msg}")
}

fn dump_all(src: str, name: str) -> int {
    var a = new_ast()
    var p = new_parser(src, 1)
    var o = buf()
    loop {
        let n = parse_complete(mut p, mut a)
        if n == -1 {
            break
        }
        if n == -2 {
            print_raw(text(o))
            report(name, p.err_line, p.err)
            return 2
        }
        dump(a, n, 0, mut o)
    }
    print_raw(text(o))
    0
}

fn check_all(src: str, name: str) -> int {
    var a = new_ast()
    var p = new_parser(src, 1)
    loop {
        let n = parse_complete(mut p, mut a)
        if n == -1 {
            return 0
        }
        if n == -2 {
            report(name, p.err_line, p.err)
            return 2
        }
    }
    0
}

fn run_source(src: str, name: str, rest: List[str], opts: List[str], then_stdin: bool) -> int {
    var sh = new_sh(name)
    import_env(mut sh)
    sh.pos = copy rest
    if opts.len > 0 {
        let _st = bi_set(mut sh, opts)
        if sh.flow == F_EXIT {
            flush(mut sh)
            return sh.status
        }
    }
    jc_sync(mut sh)
    // the script's parser, reset for it (`sh.exec`'s `eval_top`)
    var p = new_parser("", 1)
    var st = eval_top(mut sh, mut p, src, 1)
    if then_stdin && sh.flow == F_NONE {
        sh.from_stdin = true
        st = run_lines(mut sh)
    }
    if sh.flow == F_EXIT {
        st = sh.status
    }
    sh.flow = F_NONE
    sh.line = 0
    st = run_exit_trap(mut sh, st)
    flush(mut sh)
    jc_leave(mut sh)
    st
}

/// The shell reading its standard input (no operand and no `-c`, or
/// `-s`): interactive when forced by `-i` or when standard input and
/// standard error are terminals (`sh.interact`).
fn run_input(name: str, rest: List[str], opts: List[str], force_i: bool) -> int {
    var sh = new_sh(name)
    import_env(mut sh)
    sh.pos = copy rest
    sh.from_stdin = true
    sh.interactive = force_i || on_terminal()
    // an interactive shell edits its lines in emacs mode (ruling #69 R2)
    // and has job control on (XCU `set -m`, `sh.jobs`)
    sh.opt_emacs = sh.interactive
    sh.opt_m = sh.interactive
    sig_apply(mut sh)
    if opts.len > 0 {
        let _st = bi_set(mut sh, opts)
        if sh.flow == F_EXIT {
            flush(mut sh)
            return sh.status
        }
    }
    jc_sync(mut sh)
    var st = run_stdin(mut sh)
    if sh.flow == F_EXIT {
        st = sh.status
    }
    sh.flow = F_NONE
    sh.line = 0
    st = run_exit_trap(mut sh, st)
    flush(mut sh)
    jc_leave(mut sh)
    st
}

/// The variables a shell starts with (XCU 2.5.3): everything in the
/// environment, exported; then the shell's own. And `SIGCHLD` at its
/// default (`sh.signal`'s `sig_start`).
fn import_env(mut sh: Sh) {
    sig_start()
    sh.pid = os_pid()
    for kv in env_vars() {
        let eq = kv.find("=") else -1
        if eq > 0 {
            let k = kv[0..eq]
            if is_name(k) {
                sh.vals[k] = kv[eq + 1..kv.len]
                sh.exported[k] = true
            }
        }
    }
    sh.vals["IFS"] = " \t\n"
    let _e = (mut sh.exported).remove("IFS") else false
    // the prompts from the environment win over the defaults (dash,
    // black-box: `env PS1=a dash -c 'echo $PS1'` prints `a`)
    if !sh.vals.has("PS1") {
        sh.vals["PS1"] = "$ "
    }
    if !sh.vals.has("PS2") {
        sh.vals["PS2"] = "> "
    }
    if !sh.vals.has("PS4") {
        sh.vals["PS4"] = "+ "
    }
    sh.vals["OPTIND"] = "1"
    // the parent's process id, once, whatever the environment said
    // (XCU 2.5.3; dash, black-box: an ordinary variable, not exported)
    let _x = (mut sh.exported).remove("PPID") else false
    let parent = os_ppid() else |_| 0
    if parent > 0 {
        sh.vals["PPID"] = "{parent}"
    } else {
        let _p = (mut sh.vals).remove("PPID") else ""
    }
    let cwd = os_cwd() else ""
    sh.phys = cwd
    if cwd.len > 0 {
        sh.vals["PWD"] = cwd
        sh.exported["PWD"] = true
    }
}
