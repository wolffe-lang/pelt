//! sh.ast — the syntax tree, as an arena.
//!
//! References consulted: POSIX.1-2024 XCU 2.9 (the shapes of commands)
//! and 2.10 (the grammar).
//!
//! **Why an arena.** wolf 0.2.24 refuses an `enum` whose variants carry
//! payloads of different shapes ("enum payload slots with conflicting
//! types across variants", c06) and a struct that holds a `List` of
//! itself at the push ("`copy` of a value nested this deep"). So every
//! node lives in one `List[Node]` and refers to its children by index.
//! The arena is the shell's for its whole life: a function body parsed
//! by `eval` or `.` stays where its definition can find it.
//!
//! **Recycled (pelt#19).** The root region frees nothing, so a tree
//! that only grew kept every line of a script and every line typed.
//! Now `top` marks the arena's live end: once a complete command has
//! run (`sh.exec`'s `eval_from`) its nodes are dead unless something
//! kept one — a function definition, a parsed command substitution —
//! which raises `pin` to cover them; `add` reuses a dead slot, its lists
//! emptied in place, and here-document bodies (`dtop`) likewise.
//!
//! One `Node` shape serves every kind; what each field means per kind:
//!
//! | kind | text | words | kids | ints |
//! |---|---|---|---|---|
//! | LIST | | | and-or lists | 1 per kid when it ends in `&` |
//! | ANDOR | | | pipelines | the operator before each later kid: 1 `&&`, 2 `\|\|` |
//! | PIPE | | | commands | [bang] |
//! | SIMPLE | | every word, assignments first | | [count of assignments] |
//! | REDIR | operator | [target word] | | [fd or -1, here-doc id or -1, delimiter quoted] |
//! | SUBSHELL, BRACE | | | [list] | |
//! | IF | | | [cond, then, cond, then, …, else?] | [has else] |
//! | WHILE, UNTIL | | | [cond, body] | |
//! | FOR | name | the word list | [body] | [has `in`] |
//! | CASE | the word | | items | |
//! | ITEM | | patterns | [body or -1] | [0 `;;` or none, 1 `;&`] |
//! | FUNC | name | | [body] | |
//!
//! Any command may carry redirections in `redirs`.

const K_LIST: int = 1

const K_ANDOR: int = 2

const K_PIPE: int = 3

const K_SIMPLE: int = 4

const K_REDIR: int = 5

const K_SUBSHELL: int = 6

const K_BRACE: int = 7

const K_IF: int = 8

const K_WHILE: int = 9

const K_UNTIL: int = 10

const K_FOR: int = 11

const K_CASE: int = 12

const K_ITEM: int = 13

const K_FUNC: int = 14

struct Node {
    kind: int,
    text: str,
    words: List[str],
    kids: List[int],
    ints: List[int],
    redirs: List[int],
    line: int,
}

struct Ast {
    nodes: List[Node],
    docs: List[str],
    /// The live ends of `nodes` and `docs`: slots past them are dead
    /// and reused (module doc).
    top: int,
    dtop: int,
    /// Every node below this is kept: something outside the tree names
    /// one of them (`keep`).
    pin: int,
    /// The aliases (XCU 2.3.1): kept with the tree, because the parser
    /// substitutes them (`sh.parse`'s `alias_at`); `alias` and `unalias`
    /// write them through the state's journal (`sh.state`'s `J_ALIAS`).
    aliases: Map[str, str],
}

fn new_ast() -> Ast {
    Ast {
        nodes: List[Node](),
        docs: List[str](),
        top: 0,
        dtop: 0,
        pin: 0,
        aliases: Map[str, str](),
    }
}

fn add(mut a: Ast, kind: int, text: str, line: int) -> int {
    let i = a.top
    a.top += 1
    if i < a.nodes.len {
        a.nodes[i].kind = kind
        a.nodes[i].text = text
        a.nodes[i].line = line
        (mut a.nodes[i].words).clear()
        (mut a.nodes[i].kids).clear()
        (mut a.nodes[i].ints).clear()
        (mut a.nodes[i].redirs).clear()
        return i
    }
    (mut a.nodes).push(Node {
        kind: kind,
        text: text,
        words: List[str](),
        kids: List[int](),
        ints: List[int](),
        redirs: List[int](),
        line: line,
    })
    i
}

/// A here-document's slot in `docs`, empty, the dead one reused.
fn doc_slot(mut a: Ast) -> int {
    let id = a.dtop
    a.dtop += 1
    if id < a.docs.len {
        a.docs[id] = ""
    } else {
        (mut a.docs).push("")
    }
    id
}

/// Something outside the tree now names nodes parsed so far: keep them.
fn keep(mut a: Ast) {
    if a.pin < a.top {
        a.pin = a.top
    }
}

/// A complete command parsed from `top` and `dtop` = the marks has run:
/// its nodes and bodies are dead again, unless something kept them.
fn recycle(mut a: Ast, top: int, dtop: int) {
    if a.pin <= top {
        a.top = top
        a.dtop = dtop
    }
}

fn kind_name(k: int) -> str {
    match k {
        1 => "list",
        2 => "andor",
        3 => "pipe",
        4 => "simple",
        5 => "redir",
        6 => "subshell",
        7 => "brace",
        8 => "if",
        9 => "while",
        10 => "until",
        11 => "for",
        12 => "case",
        13 => "item",
        14 => "func",
        _ => "?",
    }
}
