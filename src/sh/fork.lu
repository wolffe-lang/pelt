//! sh.fork — subshells as processes (wolf 0.2.34's `os_fork`,
//! `[os.proc.fork]`; ruling #90).
//!
//! References consulted: POSIX.1-2024 XCU 2.9.2 (pipelines), 2.9.3.1
//! (asynchronous AND-OR lists), 2.11 (job control), 2.12 (signals),
//! 2.13 (the shell execution environment), the `trap` and `wait` pages;
//! wolf's `spec/11-os.md` at v0.2.34 (`[os.proc.fork]`,
//! `[os.proc.fork.note]`, `[os.term.group]`) and its probe fixture
//! `fixtures/fork/subshell.lu`; black-box runs of `dash` 0.5.13.4
//! (`notes/sh20-evidence/`). No shell's source.
//!
//! **Which shapes fork** (`notes/sh20-the-fork.md` §3.2): `( list )`,
//! `$( list )`, every list after `&`, and every pipeline stage the shell
//! runs itself, the last included; except a simple command the fast path
//! finishes (a program, a pure built-in), which runs as it did before in
//! a `( cmd )`, a `$( cmd )` or a stage, since what can be seen of it is
//! the same (sh19 §6.1). Such a command that the fast path does not
//! finish forks where it would have taken the ordinary path
//! (`sh.exec`'s `run_simple`). A host that does not fork (the checked
//! machine answers `unsupported`, ruling #95 R4 C) runs every shape in
//! process as before, and so does a fork answered `busy` (a task live:
//! pelt starts none).
//!
//! **The child, before anything of the body runs:** it moves into its
//! job's process group when job control says so (`os_set_pgid` acts on
//! the caller alone, `[os.term.group]`, so the child moves itself, and
//! the parent waits for its word, a pipe it closes, before it starts the
//! next process of the job); a foreground job's leader takes the
//! terminal; every descriptor that names one of the parent's captures
//! goes to the child's pipe; the parent's handles it does not name are
//! closed (its own pipe's read end, the job table's terminal, the
//! captures' temporary files); the job table is emptied (but for one
//! simple command, whose `jobs` lists the shell's, as dash's does) and
//! job control is off; it is not interactive; caught traps go back to the default
//! and ignored ones stay ignored (2.13), and the process's dispositions
//! follow (`sh.signal`'s `sig_apply`). An asynchronous list with job
//! control off holds INT and QUIT ignored, and a command substitution
//! under job control holds TSTP and TTOU ignored, until a trap of the
//! child's own names one (dash, black-box: `notes/sh20-the-fork.md`
//! §2.1). It ends by `os_exit` with the subshell's status after its own
//! `EXIT` trap, never by the shell's exit path.

/// What `fork_begin` answers besides a child's handle.
const FORK_HERE: int = -1

const FORK_CHILD: int = -2

const FORK_FAILED: int = -3

/// `fork_shape`'s answer when the shape is to run in process.
const RUN_HERE: int = -1

/// The kinds of subshell process: waited for (`( list )`, a pipeline's
/// last stage when it is no job), a command substitution's (its output
/// read by the parent), a pipeline stage's (joins the job being built),
/// an asynchronous list's.
const FK_NONE: int = 0

const FK_WAIT: int = 1

const FK_CAP: int = 2

const FK_STAGE: int = 3

const FK_BG: int = 4

/// Whether a shape may fork: not on a host that answered `unsupported`,
/// and never from the shadow state (`sh.exec`'s fast path).
fn fork_usable(sh: Sh) -> bool {
    sh.fork_ok != 0 && !sh.shadow
}

/// The node under the lists that hold it alone: a list of one command
/// run in the foreground, an and-or list of one pipeline, a pipeline of
/// one command without `!`.
fn one_of(a: Ast, n: int) -> int {
    var m = n
    loop {
        if m < 0 {
            return -1
        }
        let k = a.nodes[m].kind
        if k == K_LIST && a.nodes[m].kids.len == 1 && a.nodes[m].ints[0] == 0 {
            m = a.nodes[m].kids[0]
        } else if k == K_ANDOR && a.nodes[m].kids.len == 1 {
            m = a.nodes[m].kids[0]
        } else if k == K_PIPE && a.nodes[m].kids.len == 1 && a.nodes[m].ints[0] == 0 {
            m = a.nodes[m].kids[0]
        } else {
            return m
        }
    }
    m
}

/// The simple command a body is, alone (`one_of`, a `!` allowed), or -1:
/// the bodies that run in process when the fast path finishes them.
fn one_simple(a: Ast, n: int) -> int {
    var m = n
    loop {
        if m < 0 {
            return -1
        }
        let k = a.nodes[m].kind
        if k == K_SIMPLE {
            return m
        }
        if k == K_LIST && a.nodes[m].kids.len == 1 && a.nodes[m].ints[0] == 0 {
            m = a.nodes[m].kids[0]
        } else if k == K_ANDOR && a.nodes[m].kids.len == 1 {
            m = a.nodes[m].kids[0]
        } else if k == K_PIPE && a.nodes[m].kids.len == 1 {
            m = a.nodes[m].kids[0]
        } else {
            return -1
        }
    }
    -1
}

/// Whether node `n` is a subshell, or a brace group that holds one
/// alone (braces in braces too): one process, whose redirections are
/// all the subshell's (dash, black box: `{ ( … ); } 2>f` says the
/// subshell's end outside `f`, and a stage, a substitution or a list
/// after `&` of that shape is one process; `{ ( … ); :; } 2>f` and a
/// function's or a loop's redirections are the shell's;
/// `notes/sh20-evidence/logs/probe/notice*`).
fn paren_alone(a: Ast, n: int) -> bool {
    var m = n
    loop {
        if m < 0 {
            return false
        }
        let k = a.nodes[m].kind
        if k == K_SUBSHELL {
            return true
        }
        if k != K_BRACE {
            return false
        }
        m = one_of(a, a.nodes[m].kids[0])
    }
    false
}

/// The body of the subshell `paren_alone` node `n` holds.
fn paren_body(a: Ast, n: int) -> int {
    var m = n
    loop {
        if m < 0 || a.nodes[m].kind == K_SUBSHELL {
            break
        }
        m = one_of(a, a.nodes[m].kids[0])
    }
    if m < 0 {
        return n
    }
    a.nodes[m].kids[0]
}

/// Whether command substitution body `n` is one `trap` command and
/// nothing else: the one substitution that keeps the shell's traps
/// (XCU `trap`: "a command substitution containing only a single trap
/// command"; dash, black-box: `signal/c_trap_cmdsub_shows_parent`).
/// Read from the tree as written: the command word `trap`, unquoted,
/// with no assignment before it.
fn lone_trap(a: Ast, n: int) -> bool {
    let s = one_simple(a, n)
    if s < 0 {
        return false
    }
    let na = a.nodes[s].ints[0]
    na == 0 && a.nodes[s].words.len >= 1 && a.nodes[s].words[0] == "trap"
}

/// The simple command a forked child may run as its last, in its own
/// place (`exec`'s way, as dash and bash run the last command of a
/// subshell): the last of a list run in the foreground, of an and-or
/// list, of a pipeline of one command without `!`, of a brace group.
fn last_simple(a: Ast, n: int) -> int {
    var m = n
    loop {
        if m < 0 {
            return -1
        }
        let k = a.nodes[m].kind
        let c = a.nodes[m].kids.len
        if k == K_SIMPLE {
            return m
        }
        if k == K_LIST && c > 0 && a.nodes[m].ints[c - 1] == 0 {
            m = a.nodes[m].kids[c - 1]
        } else if k == K_ANDOR && c > 0 {
            m = a.nodes[m].kids[c - 1]
        } else if k == K_PIPE && c == 1 && a.nodes[m].ints[0] == 0 {
            m = a.nodes[m].kids[0]
        } else if k == K_BRACE && c == 1 {
            m = a.nodes[m].kids[0]
        } else {
            return -1
        }
    }
    -1
}

/// Whether some trap has an action (a forked child that has one runs it,
/// so it cannot let a program take its place).
fn traps_act(sh: Sh) -> bool {
    if sh.traps.len == 0 {
        return false
    }
    var i = 0
    loop {
        let c = trap_cond(i)
        if c.len == 0 {
            break
        }
        let a = sh.traps[c] else ""
        if a.len > 0 {
            return true
        }
        i += 1
    }
    false
}

fn names_cap(fds: List[int]) -> bool {
    for h in fds {
        if is_cap(h) {
            return true
        }
    }
    false
}

/// Run `node` as a subshell process of kind `how` (`FK_*`): the whole node,
/// or (`slow`) the simple command `node` the fast path did not finish,
/// run the ordinary way in the child. `job` (`FK_WAIT` at the top level
/// with job control): a foreground job of its own, whose text is node
/// `text`'s. `keep`: the child keeps the shell's traps (`$(trap)`).
/// Answers the status (0 for a stage or an asynchronous list, whose child
/// is left in `stage_child` for the pipeline or the job), or `RUN_HERE`
/// when the host does not fork.
fn fork_shape(
    mut sh: Sh,
    node: int,
    how: int,
    job: bool,
    keep: bool,
    slow: bool,
    text: int,
) -> int {
    var group = -1
    var tty = -1
    var to = -1
    var close = -1
    var cr = -1
    var j = -1
    if how == FK_CAP {
        let (r, w) = os_pipe() else (-1, -1)
        if r < 0 {
            return RUN_HERE
        }
        cr = r
        to = w
        close = r
    } else if how == FK_STAGE {
        to = sh.stage_w
        close = sh.stage_r
    }
    if how == FK_STAGE || how == FK_BG {
        let bj = sh.jc_build
        if bj >= 0 && slot_pgid(sh, bj) >= 0 {
            group = slot_pgid(sh, bj)
            if group == 0 {
                tty = sh.jc_give
            }
        }
    } else if how == FK_WAIT && job {
        j = jc_begin(mut sh, true, text)
        group = 0
        tty = sh.jc_tty
    }
    let h = fork_begin(mut sh, how, group, tty, to, close, keep, !slow)
    if h == FORK_CHILD {
        var st = 0
        if slow {
            sh.exec_last = node
            st = run_slow(mut sh, node, false)
        } else {
            st = child_body(mut sh, node)
        }
        child_end(mut sh, st, keep)
        return 0
    }
    if cr >= 0 {
        fs_close(to) else |_| {}
    }
    if j >= 0 {
        jc_end_build(mut sh)
    }
    if h < 0 {
        if cr >= 0 {
            fs_close(cr) else |_| {}
        }
        if j >= 0 {
            jb_free(mut sh, j)
        }
        if h == FORK_FAILED {
            sh.status = 2
            return 2
        }
        return RUN_HERE
    }
    if how == FK_STAGE || how == FK_BG {
        sh.stage_child = h
        sh.started = true
        if sh.jc_build >= 0 {
            jb_join(mut sh, sh.jc_build, h)
        }
        return 0
    }
    if how == FK_CAP {
        // the output first, then the status: a child blocked on a full
        // pipe ends only once it is read (`sh.exec`'s `drain` closes it)
        drain(mut sh, cr)
        return reap(mut sh, h)
    }
    if j >= 0 {
        jb_join(mut sh, j, h)
        let st = jc_fg_wait(mut sh, j, text)
        if jb_state_of(sh, j) == JB_DONE {
            jb_free(mut sh, j)
        }
        return st
    }
    reap(mut sh, h)
}

/// The door (module doc): flush, fork, and in the child make the
/// subshell's process what it must be before its body runs. `group` -1
/// the shell's, 0 a new one the child leads, above 0 that group; `tty`
/// the terminal a new group's leader takes (-1 none); `to` where every
/// descriptor that names a capture goes in the child (-1: none may);
/// `close` a handle the child closes; `clear` empties the job table (not
/// for one simple command, below). Answers the child's handle in the
/// parent, `FORK_CHILD` in the child, `FORK_HERE` when the shape runs in
/// process (the host does not fork, a task is live, or a capture would
/// have nowhere to go), `FORK_FAILED` when the host refused (said).
fn fork_begin(
    mut sh: Sh,
    how: int,
    group: int,
    tty: int,
    to: int,
    close: int,
    keep: bool,
    clear: bool,
) -> int {
    if to < 0 && names_cap(sh.fds) {
        return FORK_HERE
    }
    flush(mut sh)
    var sr = -1
    var sw = -1
    if group >= 0 {
        let (r, w) = os_pipe() else (-1, -1)
        sr = r
        sw = w
    }
    var why = 0
    let (pid, h) = os_fork() else |e| match e {
        busy => {
            why = 1
            (-1, -1)
        },
        unsupported => {
            why = 2
            (-1, -1)
        },
        io => {
            why = 3
            (-1, -1)
        },
    }
    if why != 0 {
        if sr >= 0 {
            fs_close(sr) else |_| {}
            fs_close(sw) else |_| {}
        }
        if why == 2 {
            sh.fork_ok = 0
        }
        if why == 3 {
            diag(mut sh, "cannot make a process for a subshell")
            return FORK_FAILED
        }
        return FORK_HERE
    }
    sh.fork_ok = 1
    if pid == 0 {
        child_start(mut sh, how, group, tty, to, close, keep, clear, sr, sw)
        return FORK_CHILD
    }
    if sw >= 0 {
        fs_close(sw) else |_| {}
    }
    if sr >= 0 {
        // the child's word: its end of the pipe closed once it is in its
        // group, so the next process of the job can join that group
        region ww {
            let _w = fs_read_chunk(sr, 1) else |_| List[byte]()
        }
        fs_close(sr) else |_| {}
    }
    if group == 0 && tty >= 0 {
        os_term_set_foreground(tty, pid) else |_| {}
    }
    h
}

/// The child's first steps (module doc), in order.
fn child_start(
    mut sh: Sh,
    how: int,
    group: int,
    tty: int,
    to: int,
    close: int,
    keep: bool,
    clear: bool,
    sr: int,
    sw: int,
) {
    if sr >= 0 {
        fs_close(sr) else |_| {}
    }
    if group >= 0 {
        os_set_pgid(group) else |_| {}
        if group == 0 && tty >= 0 {
            let me = os_pgid() else 0
            if me > 0 {
                os_term_set_foreground(tty, me) else |_| {}
            }
        }
    }
    if sw >= 0 {
        fs_close(sw) else |_| {}
    }
    // the descriptors: the captures' go to the child's pipe, and what the
    // parent holds for others is closed
    if to >= 0 {
        var k = 0
        while k < sh.fds.len {
            if is_cap(sh.fds[k]) {
                sh.fds[k] = to
            }
            k += 1
        }
    }
    if close >= 0 && !names_handle(sh.fds, close) {
        fs_close(close) else |_| {}
    }
    if sh.jc_tty >= 3 && !names_handle(sh.fds, sh.jc_tty) {
        fs_close(sh.jc_tty) else |_| {}
    }
    while sh.pend_cap.len > 0 {
        let r = (mut sh.pend_cap).pop() else -1
        if r >= 0 {
            fs_close(r) else |_| {}
        }
    }
    (mut sh.pend_level).clear()
    (mut sh.caps).clear()
    (mut sh.cap_was).clear()
    (mut sh.cap_data).clear()
    // no job table (2.11: the parent's children are not the child's;
    // `[os.proc.fork]`'s wait tables are empty), but for one simple
    // command forked as a stage or a substitution, whose `jobs` lists the
    // shell's jobs as dash's does (black-box: `x=$(jobs)` and `jobs | …`
    // list them, `( jobs ) | …` and `$(jobs | …)` do not,
    // `jobs/subshell_jobs`); and no job control
    let was_jc = sh.jc_on
    let jign = sh.jc_ign
    if clear {
        (mut sh.jb_a).clear()
        (mut sh.jb_b).clear()
        (mut sh.jb_pgid).clear()
        (mut sh.jb_text).clear()
        (mut sh.pr_job).clear()
        (mut sh.pr_h).clear()
        (mut sh.pr_pid).clear()
        (mut sh.pr_st).clear()
        (mut sh.pr_text).clear()
        (mut sh.stash_h).clear()
        (mut sh.stash_st).clear()
        (mut sh.def_h).clear()
        (mut sh.def_st).clear()
        sh.jb_nwaited = 0
        sh.jb_free_lo = 0
        sh.jb_reap_since = 0
        sh.jb_reap_at = 0
    }
    sh.jc_on = false
    sh.jc_tty = -1
    sh.jc_orig = -1
    sh.jc_build = -1
    sh.jc_give = -1
    sh.jc_last = false
    sh.jc_hold = false
    sh.jc_child = false
    sh.chld_owed = false
    sh.exit_warned = false
    sh.exit_warned_prev = false
    // a subshell is not interactive (2.13), and nothing of the parent's
    // frames, stages or captures is the child's to put back
    sh.sub_of_i = sh.sub_of_i || sh.interactive
    sh.interactive = false
    sh.at_prompt = false
    sh.intr = false
    sh.sub = 0
    sh.fr_top = -1
    sh.nowait = false
    sh.bg_simple = false
    sh.stage_child = -1
    sh.stage_in = -1
    sh.stage_w = -1
    sh.stage_cap = 0
    sh.stage_r = -1
    sh.hash_keep = -1
    sh.fk_mode = FK_NONE
    sh.fk_keep = false
    sh.exec_last = -1
    sh.exec_here = false
    // the signals (2.12, 2.13; dash, black-box)
    if !keep {
        traps_reset(mut sh)
    }
    var hold = sh.hold_ign | sh.async_ign
    if how == FK_BG && group < 0 {
        hold = hold | m_int() | m_quit()
    }
    if how == FK_CAP && was_jc {
        hold = hold | jign
    }
    sh.hold_ign = hold
    sh.async_ign = 0
    sh.jc_ign = 0
    sig_apply(mut sh)
}

/// A forked node's body: a subshell that is the whole of it (`( ( … ) )`,
/// `( … ) | …`, `( … ) &`, `( … ) >f`), braces that hold one alone
/// (`paren_alone`) too, runs its own body here, the redirections of
/// each around it, rather than fork again.
fn child_body(mut sh: Sh, node: int) -> int {
    var m = node
    loop {
        let one = one_of(sh.ast, m)
        if one < 0 || !paren_alone(sh.ast, one) {
            break
        }
        if sh.ast.nodes[one].redirs.len > 0 {
            sh.line = sh.ast.nodes[one].line
            let rds = redirs_of(sh.ast, one)
            if !apply_redirs(mut sh, rds) {
                if sh.flow == F_NONE {
                    sh.status = 2
                }
                return sh.status
            }
        }
        m = sh.ast.nodes[one].kids[0]
    }
    sh.exec_last = last_simple(sh.ast, m)
    run(mut sh, m)
}

/// The child's end: its `EXIT` trap (not for `$(trap)`, which kept the
/// shell's), what it wrote flushed, and `os_exit` with its status: no
/// `defer`, and none of the shell's exit path (the terminal, the group).
fn child_end(mut sh: Sh, st0: int, keep: bool) {
    var st = st0
    if sh.flow == F_EXIT {
        st = sh.status
    }
    sh.flow = F_NONE
    if !keep {
        st = run_exit_trap(mut sh, st)
    }
    flush(mut sh)
    os_exit(st)
}
