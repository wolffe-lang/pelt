//! Small-fix laws below the black-box differential rows (sh33).

fn want_small_fixes(mut bad: List[str]) {
    var sh = new_sh("small-fixes")
    cap_begin(mut sh)
    let st = eval_from(mut sh, "set -n; echo should-not-run\n", 1, false)
    let out = cap_end(mut sh, false)
    if st != 0 || out != "" || !sh.opt_n {
        (mut bad).push("set-n-keeps-running")
    }
    var options = new_sh("small-options")
    let _m = option_name(mut options, "monitor", true)
    let _n = option_name(mut options, "nolog", true)
    frame_open(mut options)
    let _off = option_name(mut options, "nolog", false)
    frame_close(mut options)
    cap_begin(mut options)
    print_options(mut options, true)
    let saved = cap_end(mut options, false)
    if !saved.contains("set -o monitor\n") || !saved.contains("set -o nolog\n") {
        (mut bad).push("monitor-nolog-roundtrip")
    }
    if printf_float(12345.678, 'g', 6, false, false, false) != "12345.7" {
        (mut bad).push("printf-g-prints-literal")
    }
    if printf_float(999.5, 'g', 3, false, false, false) != "1e+03" ||
        printf_float(1.5, 'g', 4, true, false, false) != "1.500" ||
        printf_float(-0.0, 'e', 0, true, false, false) != "-0.e+00" ||
        printf_float(2.5, 'f', 0, false, false, false) != "2" {
        (mut bad).push("printf-rounding-and-alternate")
    }
    let (x, end, range_bad) = printf_hex("0x1.8p+2", 2)
    if x != 6.0 || end != 8 || range_bad {
        (mut bad).push("printf-hex-operand")
    }
}
