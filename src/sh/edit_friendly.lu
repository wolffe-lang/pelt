//! Friendly emacs keys. Inputs: bash 5.3's installed Readline manual,
//! fish 4.9.3 `bind --help`, and the recorded black-box pty sessions
//! in notes/sh28-evidence/. No shell or editor implementation sources.

struct EdChange {
    line: List[int],
    at: int,
    h: int,
    active: bool,
}

fn ring_txt(m: EdMem) -> str {
    var o = buf()
    put(mut o, ints_txt(m.kill))
    for entry in m.ring {
        put(mut o, "|")
        put(mut o, ints_txt(entry))
    }
    text(o)
}

/// Numeric arguments are state, not injected keystrokes. Overflow is
/// prevented before the multiply; the bounded count is 99,999.
fn numeric_key(mut e: Ed, k: int) -> bool {
    let meta = k >= K_ALT + 48 && k <= K_ALT + 57
    let plain = e.arg_active && k >= 48 && k <= 57
    if meta || plain {
        let digit = (if meta then k - K_ALT else k) - 48
        e.arg_active = true
        e.arg_digits = true
        e.arg_value = if e.arg_value > 9999 then 99999 else e.arg_value * 10 + digit
        return true
    }
    if k == K_ALT + 45 || e.arg_active && k == 45 && !e.arg_digits {
        e.arg_active = true
        e.arg_sign = 0 - e.arg_sign
        return true
    }
    false
}

fn reverse_emacs_key(k: int) -> int {
    if k == 2 || k == K_LEFT { return 6 }
    if k == 6 || k == K_RIGHT { return 2 }
    if k == 127 || k == 8 { return K_DEL }
    if k == K_DEL || k == 4 { return 127 }
    if k == K_ALT + 98 || k == K_WLEFT { return K_ALT + 102 }
    if k == K_ALT + 102 || k == K_WRIGHT { return K_ALT + 98 }
    if k == K_ALT + 100 { return K_ALT + 127 }
    if k == K_ALT + 127 || k == K_ALT + 8 { return K_ALT + 100 }
    if k == 16 || k == K_UP { return 14 }
    if k == 14 || k == K_DOWN { return 16 }
    k
}

/// Preserve the spelling of history words, including their quotes and
/// escapes. Operators delimit words outside quoting, as readline's
/// history extraction does. This is lexical only: never expansion.
fn history_words(line: List[int]) -> List[List[int]] {
    var words = List[List[int]]()
    var i = 0
    while i < line.len {
        while i < line.len && (is_blank(line[i]) || line[i] == 10) { i += 1 }
        if i >= line.len { break }
        let start = i
        var quote = 0
        var escaped = false
        while i < line.len {
            let c = line[i]
            if escaped {
                escaped = false
            } else if c == 92 && quote != 39 {
                escaped = true
            } else if c == quote {
                quote = 0
            } else if quote == 0 && (c == 39 || c == 34) {
                quote = c
            } else if quote == 0 && (is_blank(c) || c == 10) {
                break
            } else if quote == 0 && history_operator(c) {
                if i == start {
                    i += 1
                    while i < line.len && line[i] == c { i += 1 }
                }
                break
            }
            i += 1
        }
        (mut words).push(slice_of(line, start, i))
    }
    words
}

fn history_operator(c: int) -> bool {
    c == 59 || c == 38 || c == 124 || c == 60 || c == 62 || c == 40 || c == 41
}

fn yank_last_arg(mut e: Ed, n: int, counted: bool) {
    let again = e.last_cmd == K_ALT + 46 || e.last_cmd == K_ALT + 95
    if !again {
        e.larg_h = e.hist.len
        e.larg_word = if counted then (if n < 0 then n - 1 else n) else -1
        e.larg_dir = -1
        e.yank_a = e.cur
        e.yank_b = e.cur
    } else if counted && n < 0 {
        e.larg_dir = 0 - e.larg_dir
    }
    let h = e.larg_h + e.larg_dir
    // Readline removes the prior insertion even at the history boundary.
    // That observation corrects the original campaign's bell-and-stay guess.
    if again {
        delete(mut e, e.yank_a, e.yank_b)
        e.yank_b = e.yank_a
    }
    e.cur = e.yank_a
    if h < 0 || h >= e.hist.len {
        e.larg_h = if h < 0 then -1 else e.hist.len
        bell(mut e)
        return
    }
    e.larg_h = h
    let words = history_words(cps_of(e.hist[h]))
    let w = if e.larg_word < 0 then words.len + e.larg_word else e.larg_word
    if w < 0 || w >= words.len {
        bell(mut e)
        return
    }
    insert(mut e, copy words[w])
    e.yank_b = e.cur
}

fn yank_ring(mut e: Ed, pop: bool, n: int) {
    if e.mem.kill.len == 0 || pop && e.last_cmd != 25 && e.last_cmd != K_ALT + 121 {
        bell(mut e)
        return
    }
    if pop {
        let total = e.mem.ring.len + 1
        e.yank_index = (e.yank_index + n % total + total) % total
        delete(mut e, e.yank_a, e.yank_b)
        e.cur = e.yank_a
    } else {
        e.yank_a = e.cur
        e.yank_index = 0
    }
    let word = if e.yank_index == 0 then copy e.mem.kill else copy e.mem.ring[e.yank_index - 1]
    var i = 0
    let times = if pop then 1 else n
    while i < times {
        insert(mut e, copy word)
        i += 1
    }
    e.yank_b = e.cur
}

fn emacs_undo(mut e: Ed) {
    var i = e.changes.len
    while i > 0 {
        i -= 1
        if e.changes[i].active && e.changes[i].h == e.h {
            let saved = copy e.changes[i]
            e.changes[i].active = false
            set_line(mut e, saved.line, saved.at)
            return
        }
    }
    bell(mut e)
}

fn transpose_chars(mut e: Ed) {
    if e.buf.len < 2 || e.cur == 0 {
        bell(mut e)
        return
    }
    let end = if e.cur == e.buf.len then e.cur else nxt(e, e.cur)
    let mid = prv(e, end)
    if mid == 0 { bell(mut e); return }
    let start = prv(e, mid)
    let left = slice_of(e.buf, start, mid)
    let right = slice_of(e.buf, mid, end)
    touch(mut e)
    var ins = spliced(right, right.len, right.len, left)
    e.buf = spliced(e.buf, start, end, ins)
    e.cur = end
    draw_from(mut e, start)
}

fn transpose_words(mut e: Ed, backward: bool) {
    var end = word_fwd(e, e.cur)
    var right = word_back(e, end)
    if backward || e.cur == e.buf.len || right == 0 {
        end = e.cur
        while end > 0 && !is_wordch(e.buf[prv(e, end)]) { end = prv(e, end) }
        right = word_back(e, end)
    }
    var mid = right
    while mid > 0 && !is_wordch(e.buf[prv(e, mid)]) { mid = prv(e, mid) }
    let start = word_back(e, mid)
    if start == mid || right == end {
        bell(mut e)
        return
    }
    var ins = slice_of(e.buf, right, end)
    ins = spliced(ins, ins.len, ins.len, slice_of(e.buf, mid, right))
    ins = spliced(ins, ins.len, ins.len, slice_of(e.buf, start, mid))
    touch(mut e)
    e.buf = spliced(e.buf, start, end, ins)
    e.cur = if backward then start + end - right else end
    draw_from(mut e, start)
}

fn case_word(mut e: Ed, key: int, n: int) {
    let old = e.cur
    var count = if n < 0 then 0 - n else n
    var start = e.cur
    var end = e.cur
    if n < 0 {
        while count > 0 { start = word_back(e, start); count -= 1 }
    } else {
        while count > 0 { end = word_fwd(e, end); count -= 1 }
    }
    touch(mut e)
    var first = true
    var i = start
    while i < end {
        let c = e.buf[i]
        if !is_wordch(c) {
            first = true
        } else {
            var out = c
            if key == 117 || key == 99 && first {
                if c >= 97 && c <= 122 { out = c - 32 }
            } else if c >= 65 && c <= 90 {
                out = c + 32
            }
            e.buf[i] = out
            first = false
        }
        i += 1
    }
    e.cur = if n < 0 then old else end
    draw_from(mut e, start)
}

fn emacs_find(mut e: Ed, dir: int, n: int) {
    let c = next_key(mut e)
    if ends_line(mut e, c) { return }
    if c == 7 { bell(mut e); return }
    if !is_char_key(c) { bell(mut e); return }
    let to = find_char(e, c, if n < 0 then 0 - dir else dir, if n < 0 then 0 - n else n)
    if to < 0 { bell(mut e); return }
    e.cur = to
    place(mut e)
}

/// New commands intercept only when friendly is active. Every other
/// command keeps the original emacs dispatcher; numeric counts repeat it.
fn friendly_command(mut e: Ed, k: int, n: int, counted: bool) -> bool {
    if k == K_ALT + 46 || k == K_ALT + 95 {
        yank_last_arg(mut e, n, counted)
    } else if k == 25 || k == K_ALT + 121 {
        yank_ring(mut e, k != 25, n)
    } else if k == 20 || k == K_ALT + 116 {
        var i = 0
        let times = if k == 20 && n < 0 then 0 else (if n < 0 then 0 - n else n)
        while i < times {
            if k == 20 { transpose_chars(mut e) } else { transpose_words(mut e, n < 0) }
            i += 1
        }
    } else if k == K_ALT + 117 || k == K_ALT + 108 || k == K_ALT + 99 {
        case_word(mut e, k - K_ALT, n)
    } else if k == 31 {
        var i = 0
        while i < n { emacs_undo(mut e); i += 1 }
    } else if k == K_ALT + 114 {
        touch(mut e)
        set_line(mut e, copy e.orig, 0)
    } else if k == K_ALT + 60 || k == K_ALT + 62 {
        let h = if k == K_ALT + 60 then 0 else e.hist.len
        if h == e.hist.len || e.hist.len > 0 { show_hist(mut e, h, true) } else { bell(mut e) }
    } else if k == K_ALT + 35 {
        e.cur = 0
        if counted && e.buf.len > 0 && e.buf[0] == 35 {
            delete(mut e, 0, 1)
        } else {
            insert(mut e, cps_of("#"))
        }
        finish(mut e, ED_OK)
    } else if k == K_ALT + 92 {
        var a = e.cur
        var b = e.cur
        while a > 0 && is_blank(e.buf[prv(e, a)]) { a = prv(e, a) }
        while b < e.buf.len && is_blank(e.buf[b]) { b = nxt(e, b) }
        delete(mut e, a, b)
    } else if k == 29 || k == K_ALT + 29 {
        emacs_find(mut e, if k == 29 then 1 else -1, n)
    } else if k == 7 || k == K_ALT + 7 {
        bell(mut e)
    } else if k == 0 || k == K_ALT + 32 {
        e.mark = if counted then n else e.cur
        if e.mark < 0 { e.mark = 0 }
        if e.mark > e.buf.len { e.mark = e.buf.len }
    } else if k == 22 && counted {
        let b = next_byte(mut e)
        if ends_line_byte(mut e, b) { return true }
        let c = utf8_rest(mut e, b)
        var one = List[int]()
        (mut one).push(c)
        var i = 0
        while i < n { insert(mut e, copy one); i += 1 }
    } else if k == 24 {
        let next = next_key(mut e)
        if ends_line(mut e, next) { return true }
        if next == 21 {
            var i = 0
            while i < n { emacs_undo(mut e); i += 1 }
        } else if next == 24 {
            let saved = e.cur
            e.cur = if e.mark > e.buf.len then e.buf.len else e.mark
            e.mark = saved
            place(mut e)
        } else {
            bell(mut e)
        }
    } else {
        return false
    }
    e.last_kill = false
    e.tabs = 0
    true
}
