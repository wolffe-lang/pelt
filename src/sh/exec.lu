//! sh.exec — running the tree (XCU 2.9): simple commands and their
//! search, pipelines, lists, compound commands, functions, and the
//! subshells and command substitutions, as processes (`sh.fork`) or in
//! process.
//!
//! References consulted: POSIX.1-2024 XCU 2.8 (exit status and
//! errors), 2.9 (shell commands, command search and execution); the
//! `set` page for `-e`, `-u`, `-x`, `-f`; black-box runs of `dash`
//! 0.5.13.4. No shell's source.
//!
//! **Plumbing.** pelt starts programs with `os_spawn_fds` and a map
//! built from its descriptor table, and since wolf 0.2.34 forks for
//! every subshell, command substitution, list after `&` and pipeline
//! stage it runs itself (`sh.fork`), so the stages of a pipeline run
//! together and `$!` is always a process id. Where the host does not
//! fork (the checked machine), each of those runs in process
//! (`sh.state`), a stage to its end before the next starts
//! (`run_pipeline` says why), and `$!` of a list pelt ran itself is a
//! number no process has.
//!
//! **`exec cmd`** at the top level replaces the shell (`os_exec`,
//! `[os.proc.exec]`): the same process, its descriptor table handed over
//! as the map and the exported variables as the whole environment.
//! Inside a subshell pelt runs in process there is no process of its
//! own to replace, so the program is started, waited for, and the
//! subshell ends with its status; a forked subshell's process is
//! replaced, and so is one's by the program that is its last command
//! (`sh.fork`'s `last_simple`).
//!
//! **Memory.** A simple command runs inside `copy region`
//! (`[mem.region.copyout]`) with the state read only and copies out
//! only its status and assigned values (`run_fast`); one that must
//! write the state while it runs (a command substitution, `${x=…}`, a
//! function, most built-ins) runs the ordinary way (`run_slow`).

fn is_special_builtin(name: str) -> bool {
    name == ":" ||
        name == "." ||
        name == "break" ||
        name == "continue" ||
        name == "eval" ||
        name == "exec" ||
        name == "exit" ||
        name == "export" ||
        name == "readonly" ||
        name == "return" ||
        name == "set" ||
        name == "shift" ||
        name == "trap" ||
        name == "unset" ||
        name == "times"
}

fn is_regular_builtin(name: str) -> bool {
    name == "echo" ||
        name == "printf" ||
        name == "test" ||
        name == "[" ||
        name == "true" ||
        name == "false" ||
        name == "pwd" ||
        name == "cd" ||
        name == "command" ||
        name == "read" ||
        name == "local" ||
        name == "getopts" ||
        name == "wait" ||
        name == "umask" ||
        name == "kill" ||
        name == "fc" ||
        name == "alias" ||
        name == "unalias" ||
        name == "type" ||
        name == "hash" ||
        name == "jobs" ||
        name == "fg" ||
        name == "bg"
}

/// Every built-in by name, special and regular, in the order of the
/// two tests above (Tab completes them as command names; `sh.selftest`
/// checks each answers one of the tests).
fn builtin_names() -> List[str] {
    var o = List[str]()
    let all = ": . break continue eval exec exit export readonly return set shift trap unset times " +
        "echo printf test [ true false pwd cd command read local getopts wait umask kill fc alias unalias type hash jobs fg bg"
    for w in all.split(" ") {
        (mut o).push(w)
    }
    o
}

/// Run node `n`; answers the status, which is also left in `sh.status`.
/// A compound command's redirections are applied around it.
fn run(mut sh: Sh, n: int) -> int {
    if n < 0 || sh.flow != F_NONE {
        return sh.status
    }
    let k = sh.ast.nodes[n].kind
    if sh.ast.nodes[n].redirs.len > 0 && k != K_SIMPLE && k != K_FUNC {
        sh.line = sh.ast.nodes[n].line
        let rds = redirs_of(sh.ast, n)
        if !apply_redirs(mut sh, rds) {
            end_redirs(mut sh)
            if sh.flow == F_NONE {
                sh.status = 2
            }
            return sh.status
        }
        let st = run_node(mut sh, n, k)
        end_redirs(mut sh)
        return st
    }
    run_node(mut sh, n, k)
}

fn run_node(mut sh: Sh, n: int, k: int) -> int {
    var st = 0
    if k == K_LIST {
        st = run_list(mut sh, n)
    } else if k == K_ANDOR {
        st = run_andor(mut sh, n)
    } else if k == K_PIPE {
        st = run_pipe(mut sh, n)
    } else if k == K_SIMPLE {
        st = run_simple(mut sh, n)
        check_e(mut sh, st)
    } else if k == K_SUBSHELL {
        st = run_paren(mut sh, n)
        check_e(mut sh, st)
    } else if k == K_BRACE {
        st = run(mut sh, sh.ast.nodes[n].kids[0])
    } else if k == K_IF {
        st = run_if(mut sh, n)
    } else if k == K_WHILE || k == K_UNTIL {
        st = run_loop(mut sh, n, k == K_UNTIL)
    } else if k == K_FOR {
        st = run_for(mut sh, n)
    } else if k == K_CASE {
        st = run_case(mut sh, n)
    } else if k == K_FUNC {
        fnset(mut sh, sh.ast.nodes[n].text, sh.ast.nodes[n].kids[0])
        keep(mut sh.ast)
        st = 0
    }
    if sh.flow == F_NONE || sh.flow == F_EXIT {
        if sh.flow == F_EXIT {
            return sh.status
        }
        sh.status = st
    }
    if sh.sig_mine != 0 && (k == K_SIMPLE || k == K_PIPE || k == K_SUBSHELL) {
        // a trap's action runs after the command the signal came
        // during (XCU 2.12)
        poll_traps(mut sh)
        if sh.flow == F_EXIT {
            return sh.status
        }
    }
    st
}

/// `set -e` (XCU 2.8.1 and `set`): a failing command ends the shell
/// unless it is tested — an `if`/`while`/`until` condition, a non-final
/// part of `&&`/`||`, or under `!` — which is what `no_e` counts.
fn check_e(mut sh: Sh, st: int) {
    if st != 0 && sh.opt_e && sh.no_e == 0 && sh.flow == F_NONE {
        sh.status = st
        sh.flow = F_EXIT
        sh.abort = false
    }
}

fn run_list(mut sh: Sh, n: int) -> int {
    var st = sh.status
    var i = 0
    while i < sh.ast.nodes[n].kids.len {
        let kid = sh.ast.nodes[n].kids[i]
        if sh.ast.nodes[n].ints[i] == 1 {
            st = run_async(mut sh, kid)
        } else {
            st = run(mut sh, kid)
        }
        if sh.flow != F_NONE {
            return st
        }
        i += 1
    }
    st
}

fn run_andor(mut sh: Sh, n: int) -> int {
    let count = sh.ast.nodes[n].kids.len
    sh.no_e += 1
    var st = run(mut sh, sh.ast.nodes[n].kids[0])
    sh.no_e -= 1
    var i = 1
    while i < count {
        if sh.flow != F_NONE {
            return st
        }
        let op = sh.ast.nodes[n].ints[i - 1]
        if op == 1 && st == 0 || op == 2 && st != 0 {
            let last = i == count - 1
            if !last {
                sh.no_e += 1
            }
            st = run(mut sh, sh.ast.nodes[n].kids[i])
            if !last {
                sh.no_e -= 1
            }
        }
        i += 1
    }
    st
}

fn run_pipe(mut sh: Sh, n: int) -> int {
    let bang = sh.ast.nodes[n].ints[0] == 1
    if sh.ast.nodes[n].kids.len > 1 {
        sh.line = sh.ast.nodes[n].line
        if bang {
            sh.no_e += 1
        }
        let st = run_pipeline(mut sh, n)
        if bang {
            sh.no_e -= 1
        }
        if sh.flow != F_NONE {
            return st
        }
        if !bang {
            check_e(mut sh, st)
            return st
        }
        return if st == 0 then 1 else 0
    }
    let only = sh.ast.nodes[n].kids[0]
    if bang {
        sh.no_e += 1
        let st = run(mut sh, only)
        sh.no_e -= 1
        if sh.flow != F_NONE {
            return st
        }
        return if st == 0 then 1 else 0
    }
    run(mut sh, only)
}

fn run_if(mut sh: Sh, n: int) -> int {
    let count = sh.ast.nodes[n].kids.len
    let has_else = sh.ast.nodes[n].ints[0] == 1
    let pairs = if has_else then (count - 1) / 2 else count / 2
    var i = 0
    while i < pairs {
        sh.no_e += 1
        let c = run(mut sh, sh.ast.nodes[n].kids[2 * i])
        sh.no_e -= 1
        if sh.flow != F_NONE {
            return c
        }
        if c == 0 {
            return run(mut sh, sh.ast.nodes[n].kids[2 * i + 1])
        }
        i += 1
    }
    if has_else {
        return run(mut sh, sh.ast.nodes[n].kids[count - 1])
    }
    0
}

/// After a loop body: true when the loop must stop. `break n` and
/// `continue n` count down one enclosing loop each.
fn loop_flow(mut sh: Sh) -> bool {
    if sh.flow == F_BREAK {
        if sh.flow_n > 1 {
            sh.flow_n -= 1
        } else {
            sh.flow = F_NONE
        }
        return true
    }
    if sh.flow == F_CONTINUE {
        if sh.flow_n > 1 {
            sh.flow_n -= 1
            sh.flow = F_CONTINUE
            return true
        }
        sh.flow = F_NONE
        return false
    }
    sh.flow != F_NONE
}

fn run_loop(mut sh: Sh, n: int, until: bool) -> int {
    let cond = sh.ast.nodes[n].kids[0]
    let body = sh.ast.nodes[n].kids[1]
    var st = 0
    sh.loops += 1
    loop {
        sh.no_e += 1
        let c = run(mut sh, cond)
        sh.no_e -= 1
        if sh.flow != F_NONE {
            if loop_flow(mut sh) {
                break
            }
            continue
        }
        if (c == 0) == until {
            break
        }
        st = run(mut sh, body)
        if sh.flow != F_NONE {
            if loop_flow(mut sh) {
                break
            }
        }
    }
    sh.loops -= 1
    if sh.flow == F_NONE {
        sh.status = st
    }
    st
}

/// `for name [in word…]; do …; done`. The items, expanded once (inside
/// a region when that writes nothing), wait on the state's own stack
/// (`Sh.sstk`) and each turn reads its own in place (pelt#19).
fn run_for(mut sh: Sh, n: int) -> int {
    let name = sh.ast.nodes[n].text
    let body = sh.ast.nodes[n].kids[0]
    sh.line = sh.ast.nodes[n].line
    let base = sh.sstk.len
    if sh.ast.nodes[n].ints[0] == 1 {
        let pre = copy region fe {
            pre_words(sh, sh.ast, n)
        }
        if pre.ok {
            sh.dir_reads += pre.reads
            var at = 0
            while at < pre.enc.len {
                let z = nul_at(pre.enc, at)
                (mut sh.sstk).push(pre.enc[at..z])
                at = z + 1
            }
        } else {
            let got = expand_words(mut sh, copy sh.ast.nodes[n].words)
            if sh.flow != F_NONE {
                return sh.status
            }
            for g in got {
                (mut sh.sstk).push(g)
            }
        }
    } else {
        var k = 0
        while k < sh.pos.len {
            (mut sh.sstk).push(sh.pos[k])
            k += 1
        }
    }
    let top = sh.sstk.len
    var st = 0
    sh.loops += 1
    var k = base
    while k < top {
        let item = sh.sstk[k]
        if !set_var(mut sh, name, item) {
            fatal(mut sh, "{name}: is read-only", 2)
            break
        }
        st = run(mut sh, body)
        if sh.flow != F_NONE {
            if loop_flow(mut sh) {
                break
            }
        }
        k += 1
    }
    sh.loops -= 1
    cut_sstk(mut sh, base)
    st
}

/// `case`: which item matches is found inside a region when expanding
/// the word and the patterns writes nothing (pelt#19), else here.
fn run_case(mut sh: Sh, n: int) -> int {
    sh.line = sh.ast.nodes[n].line
    var i = case_plain(sh, n)
    if i == CASE_BAIL {
        i = copy region cm {
            case_pick(sh, sh.ast, n)
        }
    }
    if i == CASE_BAIL {
        i = case_pick_here(mut sh, n)
        if sh.flow != F_NONE {
            return sh.status
        }
    }
    if i < 0 {
        return 0
    }
    let count = sh.ast.nodes[n].kids.len
    var st = 0
    var at = i
    loop {
        let it = sh.ast.nodes[n].kids[at]
        let body = sh.ast.nodes[it].kids[0]
        st = if body >= 0 then run(mut sh, body) else 0
        if sh.flow != F_NONE {
            return st
        }
        if sh.ast.nodes[it].ints[0] == 1 && at + 1 < count {
            at += 1
            continue
        }
        break
    }
    st
}

/// `case_pick`'s answer when the expansion would write the state.
const CASE_BAIL: int = -2

/// `case_pick` for the commonest `case`: a word that is literal or one
/// parameter alone (`$x`, `${x}`, `$1`, either in double quotes) and
/// patterns that are all literal — answered from the state as it
/// stands, nothing built and no region (a `case` word is neither split
/// nor globbed, and a literal is its own expansion). `CASE_BAIL` when
/// anything is less plain than that.
fn case_plain(sh: Sh, n: int) -> int {
    let (ok, word) = plain_word(sh, sh.ast.nodes[n].text)
    if !ok {
        return CASE_BAIL
    }
    var i = 0
    while i < sh.ast.nodes[n].kids.len {
        let item = sh.ast.nodes[n].kids[i]
        var j = 0
        while j < sh.ast.nodes[item].words.len {
            let pat = sh.ast.nodes[item].words[j]
            if !plain_lit(pat) {
                return CASE_BAIL
            }
            if pmatch(pat, word) {
                return i
            }
            j += 1
        }
        i += 1
    }
    -1
}

/// Whether `w` expands to itself: no quoting, no expansion, no leading
/// `~`, no byte the expander would mark.
fn plain_lit(w: str) -> bool {
    if w.len > 0 && ch(w, 0) == '~' {
        return false
    }
    for b in w.bytes() {
        let c = b as int
        if c < 7 || c == 36 || c == 96 || c == 92 || c == 39 || c == 34 {
            return false
        }
    }
    true
}

/// A `case` word's value when it is plain (`case_plain`).
fn plain_word(sh: Sh, w: str) -> (bool, str) {
    if plain_lit(w) {
        return (true, w)
    }
    var inner = w
    if w.len >= 2 && ch(w, 0) == '"' && ch(w, w.len - 1) == '"' {
        inner = w[1..w.len - 1]
    }
    var name = ""
    if inner.len >= 4 && inner.starts_with("${{") && inner.ends_with("}}") {
        name = inner[2..inner.len - 1]
    } else if inner.len >= 2 && ch(inner, 0) == '$' {
        name = inner[1..inner.len]
    } else {
        return (false, "")
    }
    if name.len == 1 && ch(name, 0) >= '1' && ch(name, 0) <= '9' {
        let k = byte_at(name, 0) - 49
        if k < sh.pos.len {
            return (true, sh.pos[k])
        }
        return (!sh.opt_u, "")
    }
    if !is_name(name) {
        return (false, "")
    }
    let v = sh.vals[name] else {
        return (!sh.opt_u, "")
    }
    (true, v)
}

/// The first item of `case` node `n` whose pattern matches its word, or
/// -1; the word and the patterns expanded in the shadow, in order, as
/// far as the first match.
fn case_pick(sh: Sh, a: Ast, n: int) -> int {
    var t = shadow_read(sh)
    t.line = a.nodes[n].line
    let word = expand_one(mut t, a.nodes[n].text, X_TILDE)
    if t.bail || t.flow != F_NONE {
        return CASE_BAIL
    }
    var i = 0
    while i < a.nodes[n].kids.len {
        let item = a.nodes[n].kids[i]
        var j = 0
        while j < a.nodes[item].words.len {
            let pat = expand_pattern(mut t, a.nodes[item].words[j])
            if t.bail || t.flow != F_NONE {
                return CASE_BAIL
            }
            if pmatch(pat, word) {
                return i
            }
            j += 1
        }
        i += 1
    }
    -1
}

/// `case_pick` with the state written as it goes.
fn case_pick_here(mut sh: Sh, n: int) -> int {
    let word = expand_one(mut sh, sh.ast.nodes[n].text, X_TILDE)
    if sh.flow != F_NONE {
        return -1
    }
    var i = 0
    while i < sh.ast.nodes[n].kids.len {
        let item = sh.ast.nodes[n].kids[i]
        var j = 0
        while j < sh.ast.nodes[item].words.len {
            let pat = expand_pattern(mut sh, sh.ast.nodes[item].words[j])
            if sh.flow != F_NONE {
                return -1
            }
            if pmatch(pat, word) {
                return i
            }
            j += 1
        }
        i += 1
    }
    -1
}

/// `( list )`, node `n`: a process (`sh.fork`), with job control a
/// foreground job of its own (so Ctrl-Z stops it, the program it ends
/// with too; its text the body's, as dash's: `jc_subshell_stop`); or, when `list` is one simple command and no job is made,
/// in process, the command forking only if the fast path does not
/// finish it (`run_simple`).
fn run_paren(mut sh: Sh, n: int) -> int {
    let body = sh.ast.nodes[n].kids[0]
    if fork_usable(sh) {
        let job = jc_here(sh)
        if job || one_simple(sh.ast, body) < 0 {
            let st = fork_shape(mut sh, body, FK_WAIT, job, false, false, body)
            if st != RUN_HERE {
                sh.status = st
                return st
            }
        } else {
            sh.fk_mode = FK_WAIT
        }
    }
    run_subshell(mut sh, body)
}

/// `( list )` in process: run in a frame (`sh.state`), which puts the
/// environment back.
fn run_subshell(mut sh: Sh, body: int) -> int {
    frame_open(mut sh)
    traps_reset(mut sh)
    sh.sub += 1
    sh.sig_mine = interactive_set(sh)
    var st = run(mut sh, body)
    if sh.flow == F_EXIT {
        st = sh.status
    }
    sh.flow = F_NONE
    st = run_exit_trap(mut sh, st)
    sh.sub -= 1
    frame_close(mut sh)
    sig_apply(mut sh)
    sh.status = st
    pass_interrupt(mut sh)
    st
}

/// A command substitution: `node` run with its standard output captured,
/// the trailing newlines cut (XCU 2.6.3). Its status becomes `$?` of a
/// command with no command name. A process (`sh.fork`) whose output the
/// shell reads from a pipe; or, when `node` is one simple command, in
/// process, the command forking only if the fast path does not finish
/// it. `$(trap)` alone keeps the shell's traps (`lone_trap`).
fn run_cmdsub(mut sh: Sh, node: int) -> str {
    let lone = lone_trap(sh.ast, node)
    if node >= 0 && fork_usable(sh) && one_simple(sh.ast, node) < 0 {
        let saved = sh.status
        cap_begin(mut sh)
        let st = fork_shape(mut sh, node, FK_CAP, false, false, false, node)
        if st != RUN_HERE {
            let out = cap_end(mut sh, true)
            sh.status = saved
            sh.cs_status = st
            sh.cs_ran = true
            return out
        }
        let start = cap_close(mut sh)
        cap_cut(mut sh, start)
    }
    frame_open(mut sh)
    if !lone {
        traps_reset(mut sh)
    }
    let saved_status = sh.status
    sh.sub += 1
    sh.sig_mine = interactive_set(sh)
    cap_begin(mut sh)
    var st = 0
    if node >= 0 {
        if fork_usable(sh) && one_simple(sh.ast, node) >= 0 {
            sh.fk_mode = FK_CAP
            sh.fk_keep = lone
        }
        st = run(mut sh, node)
        sh.fk_mode = FK_NONE
        sh.fk_keep = false
    }
    if sh.flow == F_EXIT {
        st = sh.status
    }
    sh.flow = F_NONE
    if !lone {
        st = run_exit_trap(mut sh, st)
    }
    let out = cap_end(mut sh, true)
    sh.sub -= 1
    frame_close(mut sh)
    sig_apply(mut sh)
    sh.status = saved_status
    sh.cs_status = st
    sh.cs_ran = true
    pass_interrupt(mut sh)
    out
}

/// The `EXIT` trap, if one is set, run once as the shell (or subshell)
/// ends; answers the status the shell exits with.
fn run_exit_trap(mut sh: Sh, st: int) -> int {
    let action = sh.traps["EXIT"] else ""
    if action.len == 0 {
        return st
    }
    tdel(mut sh, "EXIT")
    sh.status = st
    let saved_flow = sh.flow
    sh.flow = F_NONE
    eval_string(mut sh, action, "trap")
    var out = st
    if sh.flow == F_EXIT {
        out = sh.status
    }
    sh.flow = saved_flow
    out
}

/// Parse and run `src` one complete command at a time, as a script, a
/// `-c` string, `eval` and `.` all are: a syntax error ends it after
/// whatever came before has already run.
fn eval_string(mut sh: Sh, src: str, what: str) -> int {
    eval_from(mut sh, src, 1)
}

/// `eval_string` for text whose first line is line `line` of a longer
/// input: what an interactive shell runs after each prompt, so its
/// diagnostics count lines from the start of the session.
fn eval_from(mut sh: Sh, src: str, line: int) -> int {
    // a parser from the state's pool, given back after; an `eval` inside
    // this one takes another (pelt#39)
    var p = (mut sh.ppool).pop() else new_parser(src, line)
    let st = eval_top(mut sh, mut p, src, line)
    (mut sh.ppool).push(take p)
    st
}

/// `eval_from` through parser `p`, reset in place for `src`: a shell's
/// outermost text — a script, a `-c` string, each line read at the
/// prompt — keeps one parser for all of it, so a line typed or read
/// builds none (pelt#19). After each complete command has run, the
/// nodes it added are dead unless kept (`sh.ast`'s `recycle`); a
/// here-document still to be read belongs to what follows.
fn eval_top(mut sh: Sh, mut p: P, src: str, line: int) -> int {
    reset_parser(mut p, src, line)
    var st = 0
    loop {
        let top = sh.ast.top
        let dtop = sh.ast.dtop
        let n = parse_complete(mut p, mut sh.ast)
        if n == -1 {
            break
        }
        if n == -2 {
            sh.line = p.err_line
            fatal(mut sh, p.err, 2)
            return 2
        }
        if !sh.opt_n {
            st = run(mut sh, n)
        }
        if sh.jc_on && !sh.interactive {
            // `set -m` in a script: the notices after each command
            jc_notify(mut sh, true)
        }
        if p.pend.len == 0 && p.want_doc == 0 {
            recycle(mut sh.ast, top, dtop)
        }
        if sh.flow != F_NONE {
            return st
        }
    }
    st
}

// ------------------------------------------------------- simple commands

fn xtrace(mut sh: Sh, names: List[str], values: List[str], fields: List[str]) {
    if !sh.opt_x {
        return
    }
    var o = buf()
    let ps4 = sh.vals["PS4"] else "+ "
    put(mut o, ps4)
    var k = 0
    while k < names.len {
        if k > 0 {
            putc(mut o, ' ')
        }
        put(mut o, names[k])
        putc(mut o, '=')
        put(mut o, values[k])
        k += 1
    }
    for f in fields {
        if k > 0 {
            putc(mut o, ' ')
        }
        put(mut o, f)
        k += 1
    }
    putc(mut o, '\n')
    write_fd(mut sh, 2, text(o))
}

fn split_assign(a: str) -> (str, str) {
    let eq = a.find("=") else 0
    (a[0..eq], a[eq + 1..a.len])
}

/// A simple command (XCU 2.9.1). The common case runs inside
/// `copy region` (`run_fast`) and only its result is kept; anything the
/// fast path cannot finish without writing the state runs the ordinary
/// way (`run_slow`), from the start.
fn run_simple(mut sh: Sh, n: int) -> int {
    sh.line = sh.ast.nodes[n].line
    if sh.jc_build < 0 {
        sh.jc_node = n
    }
    sh.cs_ran = false
    let nowait = sh.nowait
    sh.nowait = false
    let last = sh.jc_last
    sh.jc_last = false
    // the command after `&` (`run_async`) is started on the fast path,
    // not waited for, as a pipeline stage is: the ordinary path would
    // keep its scratch in the root every time (pelt#33)
    let bg = sh.bg_simple
    sh.bg_simple = false
    // a subshell's one command (`sh.fork`): forked here when the fast
    // path does not finish it; the command a forked child may let take
    // its place does not take the fast path, which would start it
    let fk = sh.fk_mode
    sh.fk_mode = FK_NONE
    let fk_keep = sh.fk_keep
    sh.fk_keep = false
    if n != sh.exec_last && fast_ok(sh) && (!nowait || stage_fast(sh) || last || bg) {
        flush(mut sh)
        let r = copy region turn {
            run_fast(sh, sh.ast, n, nowait || last, bg)
        }
        if r.kind != R_SLOW {
            return commit_fast(mut sh, r)
        }
    }
    if fk != FK_NONE && fork_usable(sh) {
        let st = fork_shape(mut sh, n, fk, false, fk_keep, true, n)
        if st != RUN_HERE {
            if fk == FK_WAIT || fk == FK_CAP {
                sh.status = st
            }
            return st
        }
    }
    run_slow(mut sh, n, nowait || last)
}

// ------------------------------------------------------ the fast path

const R_SLOW: int = 0

const R_DONE: int = 1

/// A pipeline stage's program, started on the stage's pipe and not
/// waited for: its handle is `Fast.child`.
const R_STAGE: int = 2

/// A pipeline stage's built-in: what it wrote, ready to be read by the
/// next stage, behind the handle `Fast.child`.
const R_FEED: int = 3

/// A foreground job that stopped (job control): its handle is
/// `Fast.child`, its status `Fast.stop`, its text the `J` op.
const R_STOP: int = 4

/// What a simple command run in the shadow state leaves for the real
/// one: only scalars and one `str`, so that copying it out of the
/// region costs nothing per command but what is kept
/// (`[mem.region.copyout]`: every `List` in the copied value would be a
/// fresh buffer in the root region, which frees nothing; and every
/// `str`, even an empty one, is made there anew: 16 bytes).
struct Fast {
    kind: int,
    status: int,
    /// The writes the state must make (`put_op`), in order: an
    /// assignment-only command's assignments, `local`'s, and any an
    /// expansion made (`$((j=j+1))`, `${x=…}`). From `out_at` on, what
    /// the command wrote to the open capture (a substitution's body):
    /// its text, or when the bytes are not UTF-8 (`raw`) the bytes in
    /// hex.
    enc: str,
    reads: int,
    /// The signal that ended the program, or 0: said by the real state
    /// (`commit_fast`), since the shadow writes no diagnostic.
    sig: int,
    /// R_STAGE and R_FEED: the handle.
    child: int,
    out_at: int,
    raw: bool,
    /// `return`, `break`, `continue`, `exit`: the flow they left, and
    /// `shift`'s count.
    flow: int,
    flow_n: int,
    abort: bool,
    shift: int,
    /// A foreground job of its own (job control): an end by `SIGINT` is
    /// answered as the shell's interrupt; `R_STOP`'s status as the poll
    /// spelled it (`256 + N`).
    jc: bool,
    stop: int,
}

fn slow() -> Fast {
    Fast {
        kind: R_SLOW,
        status: 0,
        enc: "",
        reads: 0,
        sig: 0,
        child: -1,
        out_at: -1,
        raw: false,
        flow: F_NONE,
        flow_n: 0,
        abort: false,
        shift: 0,
        jc: false,
        stop: 0,
    }
}

fn fast_ok(sh: Sh) -> bool {
    !sh.opt_x && !sh.shadow && caps_fast(sh)
}

/// Whether the fast path can serve the captures that are open: none
/// is, or every descriptor that names one names the innermost (a
/// substitution's body, a pipeline stage). An outer capture still named
/// would need the ordinary path's temporary files.
fn caps_fast(sh: Sh) -> bool {
    if sh.caps.len == 0 {
        return true
    }
    let inner = cap_mark(sh.caps.len)
    for h in sh.fds {
        if is_cap(h) && h != inner {
            return false
        }
    }
    true
}

/// A pipeline stage the fast path can start without waiting: its
/// capture is the innermost, and the stage's pipe is open
/// (`run_pipeline`). An asynchronous list (`&`) is not one.
fn stage_fast(sh: Sh) -> bool {
    sh.stage_w >= 0 && sh.stage_cap == sh.caps.len
}

/// The built-ins whose only effect is the flow they leave (a `return`,
/// `break`, `continue` or `exit`) and the status: the fast path hands
/// both back (`Fast.flow`).
fn is_flow_builtin(name: str) -> bool {
    name == "return" || name == "break" || name == "continue" || name == "exit"
}

/// What kind of built-in the fast path runs: none (a program), a pure
/// one, a flow one, `local` (inside a function) or `shift`.
const B_NONE: int = 0

const B_PURE: int = 1

const B_FLOW: int = 2

const B_LOCAL: int = 3

const B_SHIFT: int = 4

/// The built-ins that change nothing but their output and status.
fn is_pure_builtin(name: str) -> bool {
    name == "echo" ||
        name == "printf" ||
        name == "test" ||
        name == "[" ||
        name == "true" ||
        name == "false" ||
        name == "pwd" ||
        name == ":"
}

/// What expansion and the pure built-ins read, copied: the shadow a
/// simple command runs in inside the region. Writing to it writes
/// nothing the shell keeps: an assignment an expansion makes is
/// recorded for the real state (`defer_ok`, on the shadow's `sstk`), and anything
/// else that would have to write (`unset`, `diag`, a command
/// substitution) sets `bail` instead.
fn shadow_of(sh: Sh) -> Sh {
    var t = new_sh(sh.name)
    t.vals = copy sh.vals
    t.exported = copy sh.exported
    t.ronly = copy sh.ronly
    t.pos = copy sh.pos
    t.arg0 = sh.arg0
    t.status = sh.status
    t.opt_e = sh.opt_e
    t.opt_u = sh.opt_u
    t.opt_x = sh.opt_x
    t.opt_f = sh.opt_f
    t.opt_n = sh.opt_n
    t.opt_v = sh.opt_v
    t.opt_a = sh.opt_a
    t.opt_bigc = sh.opt_bigc
    t.opt_m = sh.opt_m
    t.opt_b = sh.opt_b
    t.fds = copy sh.fds
    t.line = sh.line
    t.interactive = sh.interactive
    t.sub_of_i = sh.sub_of_i
    t.from_stdin = sh.from_stdin
    t.last_bg = sh.last_bg
    t.phys = sh.phys
    t.id_state = sh.id_state
    t.euid = sh.euid
    t.egid = sh.egid
    t.groups = sh.groups
    t.loops = sh.loops
    t.fdepth = sh.fdepth
    t.dots = sh.dots
    t.in_trap = sh.in_trap
    t.trap_status = sh.trap_status
    t.pid = sh.pid
    t.fork_ok = sh.fork_ok
    t.shadow = true
    t.defer_ok = true
    t
}

/// A lighter shadow for an expansion that only reads (`pre_expand`,
/// `case_pick`): the variables and `$@`, with what `$-`, `$?`, `$!`,
/// `$0` and the line read; no marks, descriptors or identity, which
/// only a command reads. It refuses every write (`defer_ok` off).
fn shadow_read(sh: Sh) -> Sh {
    var t = new_sh(sh.name)
    t.vals = copy sh.vals
    t.pos = copy sh.pos
    t.arg0 = sh.arg0
    t.status = sh.status
    t.opt_e = sh.opt_e
    t.opt_u = sh.opt_u
    t.opt_x = sh.opt_x
    t.opt_f = sh.opt_f
    t.opt_n = sh.opt_n
    t.opt_v = sh.opt_v
    t.opt_a = sh.opt_a
    t.opt_bigc = sh.opt_bigc
    t.opt_m = sh.opt_m
    t.opt_b = sh.opt_b
    t.line = sh.line
    t.interactive = sh.interactive
    t.sub_of_i = sh.sub_of_i
    t.from_stdin = sh.from_stdin
    t.last_bg = sh.last_bg
    t.phys = sh.phys
    t.pid = sh.pid
    t.shadow = true
    t
}

/// The assignments the shadow's expansions made since last asked, onto
/// `enc`, in order.
fn take_deferred(mut t: Sh, mut enc: Buf) {
    var k = 0
    while k + 1 < t.sstk.len {
        put_op(mut enc, '=', t.sstk[k], t.sstk[k + 1])
        k += 2
    }
    (mut t.sstk).clear()
}

/// `enc` as the `str` a `Fast` carries: the empty literal when there is
/// nothing, so the copy out of the region has nothing to make.
fn enc_text(enc: Buf) -> str {
    if enc.b.len == 0 {
        return ""
    }
    text(enc)
}

/// One write for the real state onto `enc`: `op` (`=` assign, `L` a
/// `local` declaration, `H` a utility the command search found), the
/// name, NUL, the value, NUL.
fn put_op(mut enc: Buf, op: char, name: str, value: str) {
    putc(mut enc, op)
    put(mut enc, name)
    putb(mut enc, 0)
    put(mut enc, value)
    putb(mut enc, 0)
}

/// The simple command `n` with the state read only: expanded,
/// redirected, and run when it is a program or a pure built-in. Under a
/// capture (`caps_fast`) a built-in's output and a waited program's
/// are handed back for the capture; a pipeline stage (`nowait`) is
/// started on the stage's pipe, or its output made ready to read. `bg`
/// is the command after `&`: the in-process subshell it runs in would
/// take back what the command search finds, so nothing is written.
fn run_fast(sh: Sh, a: Ast, n: int, nowait: bool, bg: bool) -> Fast {
    var t = shadow_of(sh)
    t.line = a.nodes[n].line
    let na = a.nodes[n].ints[0]
    var assigns = List[str]()
    var rest = List[str]()
    var i = 0
    for w in a.nodes[n].words {
        if i < na {
            (mut assigns).push(w)
        } else {
            (mut rest).push(w)
        }
        i += 1
    }
    let fields = expand_command(mut t, rest)
    if t.bail || t.flow != F_NONE {
        return slow()
    }
    var enc = buf()
    if t.sstk.len > 0 {
        take_deferred(mut t, mut enc)
    }
    var bk = B_NONE
    if fields.len > 0 {
        let cmd = fields[0]
        // the map's own lookup: `std.map`'s `has` builds a list of the
        // pairs per call
        let fnode = sh.funcs[cmd] else -1
        if fnode >= 0 {
            return slow()
        }
        if is_special_builtin(cmd) || is_regular_builtin(cmd) {
            if assigns.len > 0 {
                return slow()
            }
            if bg && sh.fork_ok != 0 {
                // a built-in after `&` is a process of its own, as dash's
                // (`sh.fork`): started by the ordinary path's fork
                return slow()
            }
            if is_pure_builtin(cmd) {
                bk = B_PURE
            } else if is_flow_builtin(cmd) {
                bk = B_FLOW
            } else if cmd == "local" && sh.fdepth > 0 {
                bk = B_LOCAL
            } else if cmd == "shift" {
                bk = B_SHIFT
            } else {
                return slow()
            }
        }
    }
    var names = List[str]()
    var values = List[str]()
    var ai = 0
    for a in assigns {
        let (name, raw) = split_assign(a)
        let v = expand_one(mut t, raw, X_TILDE | X_ASSIGN)
        if t.bail || t.flow != F_NONE {
            return slow()
        }
        if is_ronly(sh, name) {
            return slow()
        }
        if t.sstk.len > 0 {
            take_deferred(mut t, mut enc)
        }
        // the next assignment's expansion sees this one (XCU 2.9.1.1:
        // in order, left to right); the shadow keeps nothing, and the
        // last one has nobody after it to see it
        ai += 1
        if ai < assigns.len {
            t.vals[name] = v
        }
        if fields.len == 0 {
            put_op(mut enc, '=', name, v)
        }
        (mut names).push(name)
        (mut values).push(v)
    }
    if a.nodes[n].redirs.len > 0 {
        let rds = redirs_of(a, n)
        if !apply_redirs(mut t, rds) || t.bail {
            close_opened(t)
            return slow()
        }
        if t.sstk.len > 0 {
            take_deferred(mut t, mut enc)
        }
    }
    var r = slow()
    r.kind = R_DONE
    r.enc = enc_text(enc)
    if fields.len == 0 {
        close_opened(t)
        r.reads = t.dir_reads
        return r
    }
    if bk == B_FLOW && fields[0] == "exit" && sh.jc_on {
        // `exit` reads the job table (stopped jobs), which the shadow
        // has none of
        close_opened(t)
        return slow()
    }
    if bk == B_FLOW || bk == B_SHIFT {
        let st = builtin(mut t, fields)
        close_opened(t)
        if t.bail || t.out.len > 0 {
            return slow()
        }
        r.status = st
        r.reads = t.dir_reads
        r.flow = t.flow
        r.flow_n = t.flow_n
        r.abort = t.abort
        r.shift = sh.pos.len - t.pos.len
        return r
    }
    if bk == B_LOCAL {
        // `local name[=value]…` (`bi_local`): each name declared, then
        // assigned, in order; anything it would refuse goes the
        // ordinary way and is said there
        var k = 1
        while k < fields.len {
            let f = fields[k]
            let eq = f.find("=") else -1
            let name = if eq >= 0 then f[0..eq] else f
            if !is_name(name) || eq >= 0 && is_ronly(sh, name) {
                close_opened(t)
                return slow()
            }
            put_op(mut enc, 'L', name, "")
            if eq >= 0 {
                put_op(mut enc, '=', name, f[eq + 1..f.len])
            }
            k += 1
        }
        close_opened(t)
        r.enc = enc_text(enc)
        r.reads = t.dir_reads
        return r
    }
    if bk == B_PURE {
        let st = builtin(mut t, fields)
        if t.bail || t.flow != F_NONE {
            close_opened(t)
            return slow()
        }
        let h = fd_get(t, 1)
        if is_cap(h) {
            // the shadow's own capture list: it began empty
            flush(mut t)
        } else if t.out.len > 0 {
            if h < 0 {
                close_opened(t)
                return slow()
            }
            var went = true
            fs_write_chunk(h, t.out) else |_| {
                went = false
            }
            if !went {
                // the ordinary path writes again and says what failed
                close_opened(t)
                return slow()
            }
        }
        close_opened(t)
        r.status = st
        r.reads = t.dir_reads
        if t.cap_data.len > 0 {
            if nowait {
                // a pure built-in may run again: when no reader can be
                // made, the ordinary path makes it and says why
                let fd = feed(t, t.cap_data)
                if fd < 0 {
                    return slow()
                }
                r.kind = R_FEED
                r.child = fd
            } else {
                set_out(mut r, t.cap_data)
            }
        }
        return r
    }
    // a program: found, and started with any capture going to a pipe of
    // its own (read here to its end) or to the stage's pipe. With job
    // control (`sh.jobs`) it is started by `os_spawn_job`: into the job
    // being built, or, run at the top level, as a foreground job of its
    // own, waited for here by the poll; a stop comes back as `R_STOP`
    // for the real state to keep. A foreground job beside a live job's
    // process, or under a trap on `CHLD`, goes the ordinary way (the
    // poll would answer for them too).
    var jgroup = -1
    var jtty = -1
    var fgjob = false
    let by_job = sh.jc_on || sh.jc_build >= 0
    if sh.jc_build >= 0 {
        let bj = sh.jc_build
        if !nowait || slot_pgid(sh, bj) < -1 {
            close_opened(t)
            return slow()
        }
        jgroup = slot_pgid(sh, bj)
        jtty = if jgroup >= 0 then sh.jc_give else -1
    } else if !nowait && jc_here(sh) {
        if jobs_live(sh) || sh.sig_mine & m_child() != 0 || sh.stash_h.len > 0 {
            close_opened(t)
            return slow()
        }
        jgroup = 0
        jtty = sh.jc_tty
        fgjob = true
    }
    let cmd = fields[0]
    var path = cmd
    if (cmd.find("/") else -1) < 0 {
        let own = own_path(names)
        if !own {
            // the table is the real state's, read here; a new find is
            // written there after (`commit_fast`'s `H`)
            path = hash_get(sh, cmd)
        }
        if path.len == 0 || own {
            path = find_in(mut t, search_path(t, names, values), cmd)
            if path.len == 0 {
                close_opened(t)
                return slow()
            }
            if !own && !bg {
                var h = buf()
                put_op(mut h, 'H', cmd, path)
                r.enc = r.enc + text(h)
            }
        }
    }
    var capped = false
    for h in t.fds {
        if is_cap(h) {
            capped = true
        }
    }
    var to = -1
    var cap_r = -1
    var cap_w = -1
    if capped {
        if nowait {
            to = sh.stage_w
        } else {
            let (pr, pw) = os_pipe() else (-1, -1)
            if pr < 0 {
                close_opened(t)
                return slow()
            }
            cap_r = pr
            cap_w = pw
            to = pw
        }
    }
    sync_env(t)
    var k = 0
    while k < names.len {
        env_set(names[k], values[k]) else |_| {}
        k += 1
    }
    var hd = -1
    if by_job {
        hd = os_spawn_job(
            path,
            fields[1..fields.len],
            map_to(t, to),
            jgroup,
            jtty,
            jc_defaults(sh),
        ) else -1
    } else {
        hd = os_spawn_fds(path, fields[1..fields.len], map_to(t, to)) else -1
    }
    if cap_w >= 0 {
        fs_close(cap_w) else |_| {}
    }
    var got = List[byte]()
    if cap_r >= 0 {
        if hd >= 0 {
            drain_to(cap_r, mut got)
        }
        fs_close(cap_r) else |_| {}
    }
    var st = 0
    var sig = 0
    var stop = 0
    if hd >= 0 && fgjob {
        let raw = fg_poll(hd)
        if jtty >= 0 {
            os_term_set_foreground(jtty, sh.jc_pgid) else |_| {}
        }
        if raw >= 256 {
            stop = raw
            st = raw_status(raw)
        } else {
            let (code, signo) = status_of(raw)
            st = code
            sig = signo
        }
    } else if hd >= 0 && !nowait {
        let (code, signo) = wait_child(hd)
        st = code
        sig = signo
    }
    env_back(t, names)
    close_opened(t)
    if hd < 0 {
        return slow()
    }
    r.status = st
    r.sig = sig
    r.reads = t.dir_reads
    r.jc = fgjob
    if nowait {
        r.kind = R_STAGE
        r.child = hd
    }
    if stop > 0 {
        // the job's text for its notice and `jobs`, in the one `str` the
        // result carries (`J`), only when it stopped
        r.kind = R_STOP
        r.child = hd
        r.stop = stop
        var jt = buf()
        put_op(mut jt, 'J', node_text(a, n), "")
        r.enc = r.enc + text(jt)
    }
    if got.len > 0 {
        set_out(mut r, got)
    }
    r
}

/// A child's descriptor map (`[os.proc.fds]`) for the shadow's table:
/// as `child_map`, with every capture marker going to `to`.
fn map_to(sh: Sh, to: int) -> List[int] {
    var map = List[int]()
    var k = 0
    while k < sh.fds.len {
        let h = sh.fds[k]
        if h == FD_CLOSED {
            if k <= 2 {
                (mut map).push(k)
                (mut map).push(-1)
            }
        } else if is_cap(h) {
            (mut map).push(k)
            (mut map).push(to)
        } else {
            (mut map).push(k)
            (mut map).push(h)
        }
        k += 1
    }
    map
}

/// Everything readable from `r`, appended to `got`.
fn drain_to(r: int, mut got: List[byte]) {
    loop {
        let c = fs_read_chunk(r, 65536) else |e| match e {
            eof => { break },
            io => { break },
        }
        for x in c {
            (mut got).push(x)
        }
    }
}

/// The capture's bytes into the result: as text when they are UTF-8,
/// else as hex (`raw`), so that the real state gets the very bytes.
fn set_out(mut r: Fast, b: List[byte]) {
    r.out_at = r.enc.len
    let s = str_from_utf8(b) else |_| {
        r.enc = r.enc + hex_of(b)
        r.raw = true
        return
    }
    r.enc = r.enc + s
}

fn hex_of(b: List[byte]) -> str {
    var o = buf()
    for x in b {
        let v = x as int
        putb(mut o, hex_digit(v / 16))
        putb(mut o, hex_digit(v % 16))
    }
    text(o)
}

fn hex_digit(d: int) -> int {
    if d < 10 then 48 + d else 87 + d
}

fn hex_val(c: int) -> int {
    if c <= 57 then c - 48 else c - 87
}

/// A line typed at the prompt, parsed and run inside the region when it
/// is one simple command the fast path can finish: then nothing of it
/// is kept, not even its parse tree (`sh.interact`).
fn run_turn_fast(sh: Sh, src: str, line: int) -> Fast {
    var a = new_ast()
    let k = simple_in(mut a, src, line)
    if k < 0 {
        return slow()
    }
    run_fast(sh, a, k, false, false)
}

/// Whether `src` is one simple command and nothing else: its node in a
/// scratch tree, or -1.
fn turn_simple(src: str, line: int) -> int {
    var a = new_ast()
    simple_in(mut a, src, line)
}

fn simple_in(mut a: Ast, src: str, line: int) -> int {
    var p = new_parser(src, line)
    let n = parse_complete(mut p, mut a)
    if n < 0 || parse_complete(mut p, mut a) != -1 {
        return -1
    }
    if a.nodes[n].kind != K_LIST || a.nodes[n].kids.len != 1 || a.nodes[n].ints[0] != 0 {
        return -1
    }
    let k = a.nodes[n].kids[0]
    if a.nodes[k].kind != K_SIMPLE {
        return -1
    }
    k
}

fn nul_at(s: str, from: int) -> int {
    var i = from
    while i < s.len && byte_at(s, i) != 0 {
        i += 1
    }
    i
}

/// Write a fast result into the state: what it wrote to the capture,
/// the signal that ended its program, its assignments, a stage's
/// handle, and its status.
fn commit_fast(mut sh: Sh, r: Fast) -> int {
    sh.dir_reads += r.reads
    var ops_end = r.enc.len
    if r.out_at >= 0 {
        ops_end = r.out_at
        // straight into the innermost capture, the only one the command
        // could name (`caps_fast`): its own redirections, which may have
        // aimed descriptor 1 elsewhere, were the shadow's
        flush(mut sh)
        var k = r.out_at
        if r.raw {
            while k + 1 < r.enc.len {
                let v = hex_val(byte_at(r.enc, k)) * 16 + hex_val(byte_at(r.enc, k + 1))
                (mut sh.cap_data).push(v as byte)
                k += 2
            }
        } else {
            while k < r.enc.len {
                (mut sh.cap_data).push(byte_at(r.enc, k) as byte)
                k += 1
            }
        }
    }
    if r.sig != 0 {
        report_signal(mut sh, r.sig)
    }
    var at = 0
    var jtext = ""
    while at < ops_end {
        let op = byte_at(r.enc, at)
        let z = nul_at(r.enc, at + 1)
        let z2 = nul_at(r.enc, z + 1)
        let name = r.enc[at + 1..z]
        if op == 74 {
            jtext = name
        } else if op == 76 {
            local_push(mut sh, name)
        } else if op == 72 {
            hash_put(mut sh, name, r.enc[z + 1..z2])
        } else if !set_var(mut sh, name, r.enc[z + 1..z2]) {
            fatal(mut sh, "{name}: is read-only", 2)
            return 2
        }
        at = z2 + 1
    }
    if r.shift > 0 {
        shift_pos(mut sh, r.shift)
    }
    if r.kind == R_STAGE {
        sh.stage_child = r.child
        sh.started = true
        if sh.jc_build >= 0 {
            jb_join(mut sh, sh.jc_build, r.child)
        }
    } else if r.kind == R_STOP {
        sh.started = true
        jb_stopped(mut sh, r.child, r.stop, jtext)
    } else if r.kind == R_FEED {
        sh.stage_in = r.child
    }
    sh.status = r.status
    if r.flow != F_NONE {
        sh.flow = r.flow
        sh.flow_n = r.flow_n
        sh.abort = r.abort
    }
    if r.jc && r.sig > 0 {
        jc_heard_int(sh, r.sig)
    }
    r.status
}

// ---------------------------------------------------- the ordinary path

fn run_slow(mut sh: Sh, n: int, nowait: bool) -> int {
    let na = sh.ast.nodes[n].ints[0]
    let nw = sh.ast.nodes[n].words.len
    if na == nw {
        return run_assign_only(mut sh, n, na)
    }
    // the words after the assignments, expanded inside a region when
    // that writes nothing (pelt#19), else here
    let pre = copy region pe {
        pre_expand(sh, sh.ast, n, na)
    }
    if pre.ok {
        sh.dir_reads += pre.reads
        if pre.count == 0 {
            return run_assign_only(mut sh, n, na)
        }
        if na == 0 && !sh.opt_x {
            let name = pre.enc[0..nul_at(pre.enc, 0)]
            let fnode = sh.funcs[name] else -1
            let bi = name != "exec" && (is_special_builtin(name) || is_regular_builtin(name))
            if sh.ast.nodes[n].redirs.len == 0 {
                // a function called with no assignment or redirection:
                // its operands become `$@` in place, no list built
                if fnode >= 0 {
                    return call_enc(mut sh, fnode, pre.enc)
                }
                // and a built-in so called: its arguments in a pooled list
                if bi {
                    return run_builtin_enc(mut sh, n, name, pre.enc)
                }
            } else if bi && fnode < 0 {
                // a built-in with redirections and no assignment: the
                // same, its redirections applied from the tree (pelt#39)
                return run_builtin_enc(mut sh, n, name, pre.enc)
            }
        }
        return run_fields(mut sh, n, na, enc_fields(pre.enc), nowait)
    }
    var rest = List[str]()
    var i = na
    while i < nw {
        (mut rest).push(sh.ast.nodes[n].words[i])
        i += 1
    }
    let fields = expand_command(mut sh, rest)
    if sh.flow != F_NONE {
        return sh.status
    }
    if fields.len == 0 {
        return run_assign_only(mut sh, n, na)
    }
    run_fields(mut sh, n, na, fields, nowait)
}

/// A built-in with no assignment, from `pre_expand`'s fields (`enc`, NUL
/// after each; `name` the first) of simple command `n`: its arguments in
/// a list taken from the state's pool and given back cleared, its
/// redirections (if any) applied in the frame `run_fields` would open,
/// straight from the tree. The ordinary path built about nine lists for
/// such a command, and every list made outside a region stays in the
/// root (46 B empty, 176 B with one element:
/// `notes/sh19-evidence/witness/listcost`), so `wait` kept ~600 B a turn
/// (pelt#33) and `read x </dev/null` ~1,700 (pelt#39: the redirection
/// sent it down the whole ordinary path). A failed redirection is
/// answered as `run_fields` answers it: a special built-in's ends a
/// non-interactive shell, a regular one's is status 2. A built-in the
/// call runs (`eval`, `.`, `command`) takes another list from the pool.
fn run_builtin_enc(mut sh: Sh, n: int, name: str, enc: str) -> int {
    var args = (mut sh.argpool).pop() else List[str]()
    (mut args).clear()
    var at = name.len + 1
    while at < enc.len {
        let z = nul_at(enc, at)
        (mut args).push(enc[at..z])
        at = z + 1
    }
    begin_frame(mut sh)
    var k = 0
    while k < sh.ast.nodes[n].redirs.len {
        let rd = rd_of(sh.ast, sh.ast.nodes[n].redirs[k])
        if !redir_one(mut sh, rd, true) {
            end_redirs(mut sh)
            (mut args).clear()
            (mut sh.argpool).push(take args)
            if is_special_builtin(name) {
                return special_redir_failed(mut sh)
            }
            if sh.flow == F_NONE {
                sh.status = 2
            }
            return sh.status
        }
        k += 1
    }
    let st = builtin_args(mut sh, name, args)
    end_redirs(mut sh)
    (mut args).clear()
    (mut sh.argpool).push(take args)
    st
}

/// The rest of `run_slow`, once the words are `fields` (at least one).
fn run_fields(mut sh: Sh, n: int, na: int, fields: List[str], nowait: bool) -> int {
    let rds = redirs_of(sh.ast, n)
    // the assignments' values, expanded in order (XCU 2.9.1 step 4),
    // each seeing the ones before it (`x=3 y=$x cmd` hands `cmd` y=3,
    // as dash): made for the expansion and put back after, since what
    // they do to the shell depends on the command
    var names = List[str]()
    var values = List[str]()
    var had = List[bool]()
    var old = List[str]()
    let many = na > 1
    var ai = 0
    while ai < na {
        let (name, raw) = split_assign(sh.ast.nodes[n].words[ai])
        let v = assign_value(mut sh, raw)
        if sh.flow != F_NONE {
            unassign(mut sh, names, had, old)
            return sh.status
        }
        (mut names).push(name)
        (mut values).push(v)
        if many {
            (mut had).push(has_var(sh, name))
            (mut old).push(value_of(sh, name))
            if !is_ronly(sh, name) {
                vset(mut sh, name, v)
            }
        }
        ai += 1
    }
    unassign(mut sh, names, had, old)
    xtrace(mut sh, names, values, fields)
    let cmd = fields[0]
    if cmd == "exec" && fields.len == 1 {
        // `exec` with redirections only: they outlive the command
        if !apply_permanent(mut sh, rds) {
            return special_redir_failed(mut sh)
        }
        if !assign_all(mut sh, names, values) {
            return 2
        }
        sh.status = 0
        return 0
    }
    if cmd == "exec" {
        return run_exec(mut sh, fields, names, values, rds)
    }
    if is_special_builtin(cmd) {
        if !assign_all(mut sh, names, values) {
            return 2
        }
        if !apply_redirs(mut sh, rds) {
            end_redirs(mut sh)
            return special_redir_failed(mut sh)
        }
        let st = builtin(mut sh, fields)
        end_redirs(mut sh)
        return st
    }
    if !apply_redirs(mut sh, rds) {
        end_redirs(mut sh)
        if sh.flow == F_NONE {
            sh.status = 2
        }
        return sh.status
    }
    var st = 0
    let fnode = sh.funcs[cmd] else -1
    if fnode >= 0 || is_regular_builtin(cmd) {
        // temporary assignments, undone after (XCU 2.9.1)
        var old = List[str]()
        var had = List[bool]()
        var k = 0
        while k < names.len {
            (mut had).push(has_var(sh, names[k]))
            (mut old).push(value_of(sh, names[k]))
            if !set_var(mut sh, names[k], values[k]) {
                end_redirs(mut sh)
                fatal(mut sh, "{names[k]}: is read-only", 2)
                return 2
            }
            k += 1
        }
        if fnode >= 0 {
            st = call_function(mut sh, fnode, fields)
        } else {
            st = builtin(mut sh, fields)
        }
        k = names.len - 1
        while k >= 0 {
            if had[k] {
                let _ok = set_var(mut sh, names[k], old[k])
            } else {
                let _ok = unset_var(mut sh, names[k])
            }
            k -= 1
        }
    } else {
        // a forked child's last command, a program, takes the child's
        // place (`sh.fork`'s `last_simple`)
        sh.exec_here = n == sh.exec_last
        st = run_external(mut sh, fields, names, values, nowait, "", true)
    }
    end_redirs(mut sh)
    st
}

/// A simple command whose words, once expanded, name no command (XCU
/// 2.9.1): its redirections performed and undone, then its assignments
/// made; when a redirection fails the assignments are not made. The
/// status is the last command substitution's, or 0.
fn run_assign_only(mut sh: Sh, n: int, na: int) -> int {
    if sh.ast.nodes[n].redirs.len > 0 {
        let rds = redirs_of(sh.ast, n)
        let ok = apply_redirs(mut sh, rds)
        end_redirs(mut sh)
        if !ok {
            if sh.flow == F_NONE {
                sh.status = 2
            }
            return sh.status
        }
    }
    var ai = 0
    while ai < na {
        let (name, raw) = split_assign(sh.ast.nodes[n].words[ai])
        let v = assign_value(mut sh, raw)
        if sh.flow != F_NONE {
            return sh.status
        }
        if !set_var(mut sh, name, v) {
            fatal(mut sh, "{name}: is read-only", 2)
            return 2
        }
        ai += 1
    }
    let st = if sh.cs_ran then sh.cs_status else 0
    sh.status = st
    st
}

/// An assignment's value (XCU 2.9.1.1 step 4). A value that is one
/// command substitution and nothing else — `$(…)`, `` `…` ``, or either
/// in double quotes, the commonest shape — is the substitution's text
/// as it stands (an assignment is neither split nor globbed), taken
/// without building the word again (pelt#19).
fn assign_value(mut sh: Sh, raw: str) -> str {
    var q = 0
    if raw.len >= 2 && ch(raw, 0) == '"' && ch(raw, raw.len - 1) == '"' {
        q = 1
    }
    let end = raw.len - q
    let c0 = ch(raw, q)
    if c0 == '$' && ch(raw, q + 1) == '(' {
        let arith = ch(raw, q + 2) == '(' && arith_end(raw, q) > 0
        if !arith {
            let (node, e) = cmdsub_at(mut sh, raw, q)
            if sh.flow != F_NONE {
                return ""
            }
            if e == end {
                return run_cmdsub(mut sh, node)
            }
        }
    } else if c0 == '`' && bq_end(raw, q) == end {
        let (node, _e) = bq_node_of(mut sh, raw, q, q == 1)
        if sh.flow != F_NONE {
            return ""
        }
        return run_cmdsub(mut sh, node)
    }
    expand_one(mut sh, raw, X_TILDE | X_ASSIGN)
}

/// The words of simple command `n` after its `na` assignments, expanded
/// (`run_fast`'s shadow) so that only the fields are kept, NUL after
/// each: not `ok` when the expansion would write the state (a command
/// substitution, an assignment, a diagnostic) or a field holds a NUL.
struct Pre {
    ok: bool,
    enc: str,
    count: int,
    reads: int,
}

fn pre_expand(sh: Sh, a: Ast, n: int, na: int) -> Pre {
    var t = shadow_read(sh)
    t.line = a.nodes[n].line
    var rest = List[str]()
    var i = na
    while i < a.nodes[n].words.len {
        (mut rest).push(a.nodes[n].words[i])
        i += 1
    }
    let fields = expand_command(mut t, rest)
    pre_of(t, fields)
}

/// `for` node `n`'s word list, expanded as `pre_expand` expands.
fn pre_words(sh: Sh, a: Ast, n: int) -> Pre {
    var t = shadow_read(sh)
    t.line = a.nodes[n].line
    let fields = expand_words(mut t, copy a.nodes[n].words)
    pre_of(t, fields)
}

fn pre_of(t: Sh, fields: List[str]) -> Pre {
    var no = Pre { ok: false, enc: "", count: 0, reads: 0 }
    if t.bail || t.flow != F_NONE {
        return no
    }
    var o = buf()
    for f in fields {
        for b in f.bytes() {
            if b as int == 0 {
                return no
            }
        }
        put(mut o, f)
        putb(mut o, 0)
    }
    Pre { ok: true, enc: text(o), count: fields.len, reads: t.dir_reads }
}

/// `pre_expand`'s fields as a list (views of `enc`).
fn enc_fields(enc: str) -> List[str] {
    var out = List[str]()
    var at = 0
    while at < enc.len {
        let z = nul_at(enc, at)
        (mut out).push(enc[at..z])
        at = z + 1
    }
    out
}

/// Put back what `run_slow` assigned for its expansion: each name's old
/// value, or no value, last first. Read-only names were never written.
fn unassign(mut sh: Sh, names: List[str], had: List[bool], old: List[str]) {
    var k = had.len - 1
    while k >= 0 {
        if !is_ronly(sh, names[k]) {
            if had[k] {
                vset(mut sh, names[k], old[k])
            } else {
                vdel(mut sh, names[k])
            }
        }
        k -= 1
    }
}

/// A special built-in's redirection failed: reported already; it ends a
/// non-interactive shell (XCU 2.8.1), with status 2 as dash.
fn special_redir_failed(mut sh: Sh) -> int {
    if sh.flow == F_NONE {
        sh.status = 2
        sh.flow = F_EXIT
        sh.flow_n = 0
        sh.abort = true
    }
    2
}

/// The assignments before a special built-in, made for good.
fn assign_all(mut sh: Sh, names: List[str], values: List[str]) -> bool {
    var k = 0
    while k < names.len {
        if !set_var(mut sh, names[k], values[k]) {
            fatal(mut sh, "{names[k]}: is read-only", 2)
            return false
        }
        k += 1
    }
    true
}

/// Call the function whose body is `body` with `fields[1..]` as `$@`.
/// The caller's parameters wait on a stack and come back in place
/// (`pos_push`, `pos_pop`): a call builds no list (pelt#19).
fn call_function(mut sh: Sh, body: int, fields: List[str]) -> int {
    let base = pos_push(mut sh)
    var i = 1
    while i < fields.len {
        (mut sh.pos).push(fields[i])
        i += 1
    }
    call_body(mut sh, body, base)
}

/// `call_function` with the fields NUL-joined in `enc` (`pre_expand`).
fn call_enc(mut sh: Sh, body: int, enc: str) -> int {
    let base = pos_push(mut sh)
    var at = nul_at(enc, 0) + 1
    while at < enc.len {
        let z = nul_at(enc, at)
        (mut sh.pos).push(enc[at..z])
        at = z + 1
    }
    call_body(mut sh, body, base)
}

fn call_body(mut sh: Sh, body: int, base: int) -> int {
    sh.fdepth += 1
    (mut sh.lframes).push(sh.lnames.len)
    let saved_loops = sh.loops
    sh.loops = 0
    var st = run(mut sh, body)
    sh.loops = saved_loops
    if sh.flow == F_RETURN {
        sh.flow = F_NONE
        st = sh.status
    }
    pop_locals(mut sh)
    sh.fdepth -= 1
    pos_pop(mut sh, base)
    if sh.flow == F_NONE {
        sh.status = st
    }
    st
}

/// Undo the `local`s of the innermost function call.
fn pop_locals(mut sh: Sh) {
    let base = (mut sh.lframes).pop() else 0
    while sh.lnames.len > base {
        let name = (mut sh.lnames).pop() else ""
        let v = (mut sh.lvals).pop() else ""
        let was = (mut sh.lset).pop() else false
        let exp = (mut sh.lexp).pop() else false
        rdel(mut sh, name)
        if was {
            vset(mut sh, name, v)
            if exp {
                xset(mut sh, name, true)
            } else {
                xdel(mut sh, name)
            }
        } else {
            vdel(mut sh, name)
            xdel(mut sh, name)
        }
    }
}

/// The default `PATH` of `command -p` (XCU `command`): one that finds
/// the standard utilities on linux and macOS. pelt's choice; wolf has no
/// `confstr` (dash's begins `/usr/sbin`, bash's `/bin`).
fn default_path() -> str {
    "/usr/bin:/bin:/usr/sbin:/sbin"
}

/// Whether a write to the table is journaled: inside a frame, unless it
/// is a simple command's pipeline stage (`Sh.hash_keep`).
fn hash_jots(sh: Sh) -> bool {
    sh.fr_top >= 0 && !(sh.fr_top == sh.hash_keep && sh.fdepth == sh.hash_keep_depth)
}

/// Forget every utility the command search found (inside a frame,
/// through the journal, so a subshell's `hash -r` ends with it).
fn hash_clear(mut sh: Sh) {
    if sh.hash.len == 0 {
        return
    }
    if hash_jots(sh) {
        for k in sh.hash.keys() {
            jot(mut sh, J_HASH, k)
        }
    }
    sh.hash = Map[str, str]()
}

/// Forget `name`.
fn hash_del(mut sh: Sh, name: str) {
    if hash_jots(sh) {
        jot(mut sh, J_HASH, name)
    }
    let _h = (mut sh.hash).remove(name) else ""
}

/// The table made right for the shell's `PATH` now: found under another
/// value (a subshell's, which put its own back), it is forgotten.
fn hash_valid(mut sh: Sh) {
    let path = sh.vals["PATH"] else ""
    if path != sh.hash_path {
        hash_clear(mut sh)
        sh.hash_path = path
    }
}

/// Where `name` (no `/`) was found before, for the `PATH` now, or "".
fn hash_get(sh: Sh, name: str) -> str {
    let path = sh.vals["PATH"] else ""
    if path != sh.hash_path {
        return ""
    }
    sh.hash[name] else ""
}

/// Remember that the search for `name` under the shell's `PATH` found
/// `path`.
fn hash_put(mut sh: Sh, name: str, path: str) {
    hash_valid(mut sh)
    if hash_jots(sh) {
        jot(mut sh, J_HASH, name)
    }
    sh.hash[name] = path
}

/// The command search through the table (XCU 2.9.1.4: a shell may
/// remember where it found a utility, and `hash` lists it): a name found
/// before is not searched for again until `PATH` changes or `hash -r`;
/// one searched for and found is remembered (dash, black-box: a run,
/// `command -v`, `type` and `hash` all remember). "" when not found.
fn hash_find(mut sh: Sh, name: str) -> str {
    let got = hash_get(sh, name)
    if got.len > 0 {
        return got
    }
    let path = find_in_path(mut sh, name)
    if path.len > 0 && !sh.shadow {
        hash_put(mut sh, name, path)
    }
    path
}

/// The command search of XCU 2.9.1.4 for a name with no `/`: the first
/// `PATH` directory holding a regular file of that name this shell may
/// execute (`sh.util`'s `may`), or "". A file it may not execute is
/// passed over and the search goes on, as dash's does (black-box: a
/// mode-0610 file of one's own before an executable one).
fn find_in_path(mut sh: Sh, name: str) -> str {
    let path = sh.vals["PATH"] else ""
    find_in(mut sh, path, name)
}

/// The `PATH` a command searches: its own assignment to `PATH` when it
/// has one (`PATH=dir cmd` searches `dir`, as dash), else the shell's.
fn search_path(sh: Sh, names: List[str], values: List[str]) -> str {
    var path = sh.vals["PATH"] else ""
    var k = 0
    while k < names.len {
        if names[k] == "PATH" {
            path = values[k]
        }
        k += 1
    }
    path
}

/// Whether a command's own assignments set `PATH`: it searches that,
/// and nothing it finds is remembered (dash, black-box).
fn own_path(names: List[str]) -> bool {
    for n in names {
        if n == "PATH" {
            return true
        }
    }
    false
}

/// `find_in_path` over the directories of `path`.
fn find_in(mut sh: Sh, path: str, name: str) -> str {
    for dir in path.split(":") {
        let d = if dir.len == 0 then "." else dir
        let full = "{d}/{name}"
        let st = stat_of(full, false)
        if st.len > 0 && st[0] == K_FILE && may(mut sh, st, 1) {
            return full
        }
        if sh.bail {
            return ""
        }
    }
    ""
}

/// `.`'s search (XCU 2.15 dot): the first `PATH` directory holding a
/// file of that name that is not a directory; it need not be
/// executable.
fn find_readable_in_path(sh: Sh, name: str) -> str {
    let path = sh.vals["PATH"] else ""
    for dir in path.split(":") {
        let d = if dir.len == 0 then "." else dir
        let full = "{d}/{name}"
        let st = stat_of(full, false)
        if st.len > 0 && st[0] != K_DIR {
            return full
        }
    }
    ""
}

/// Whether a child is handed variable `k`: exported, and set (XCU
/// 2.5.3; `export A` with no value hands nothing until `A` is assigned).
fn env_wants(sh: Sh, k: str) -> bool {
    (sh.exported[k] else false) && has_var(sh, k)
}

/// Make the process environment, which is what a spawned child is
/// given, exactly the exported variables that are set: every other
/// name in it is removed (`env_unset`, `[os.env.unset]`) — one `unset`
/// or never exported, a command's own assignment left from an earlier
/// spawn, a name the shell cannot hold (`a.b=1`, which dash drops too).
/// The lists it reads die with the region.
fn sync_env(sh: Sh) {
    region scratch {
        for kv in env_vars() {
            let eq = kv.find("=") else -1
            if eq > 0 {
                let k = kv[0..eq]
                if !env_wants(sh, k) {
                    env_unset(k) else |_| {}
                }
            }
        }
        for k in sh.exported.keys() {
            if env_wants(sh, k) {
                env_set(k, sh.vals[k] else "") else |_| {}
            }
        }
    }
}

/// After a command's own assignments `names` were handed to its child:
/// each is put back to the shell's exported value, or removed.
fn env_back(sh: Sh, names: List[str]) {
    for n in names {
        if env_wants(sh, n) {
            env_set(n, value_of(sh, n)) else |_| {}
        } else {
            env_unset(n) else |_| {}
        }
    }
}

/// The environment handed to a program that replaces the shell
/// (`os_exec` takes the whole list): the exported variables that are
/// set, and the `exec` command's own assignments `extra`.
fn exec_env(sh: Sh, extra: List[str]) -> List[str] {
    var out = List[str]()
    for k in sort_strs(sh.vals.keys()) {
        var want = env_wants(sh, k)
        for x in extra {
            if x == k {
                want = true
            }
        }
        if want {
            (mut out).push("{k}={sh.vals[k] else ""}")
        }
    }
    out
}

/// A child's descriptor map (`[os.proc.fds]`) for a table with no
/// capture in it: every open shell descriptor at its own number, and
/// 0..2 closed in the child where the table has them closed.
fn child_map(sh: Sh) -> List[int] {
    var map = List[int]()
    var k = 0
    while k < sh.fds.len {
        let h = sh.fds[k]
        if h == FD_CLOSED {
            if k <= 2 {
                (mut map).push(k)
                (mut map).push(-1)
            }
        } else {
            (mut map).push(k)
            (mut map).push(h)
        }
        k += 1
    }
    map
}

/// Wait for child `h`: its status (`128 + N` when signal N ended it)
/// and N, or 0 (`os_wait_status`, `sh.signal`'s `status_of`). A signal
/// that came for the shell while the child ran is seen by the poll that
/// follows (`[os.signal.poll]`); nothing is done here to make it so.
fn wait_child(h: int) -> (int, int) {
    let raw = os_wait_status(h) else 1
    status_of(raw)
}

/// `wait_child`, and the shell's word on standard error when a signal
/// ended the child.
fn reap(mut sh: Sh, h: int) -> int {
    let kept = stash_take(mut sh, h)
    let (st, sig) = if kept != PR_RUN then status_of(kept) else wait_child(h)
    report_signal(mut sh, sig)
    st
}

/// Everything readable from `r` into the open capture; `r` is closed.
fn drain(mut sh: Sh, r: int) {
    loop {
        let c = fs_read_chunk(r, 65536) else |e| match e {
            eof => { break },
            io => { break },
        }
        for x in c {
            (mut sh.cap_data).push(x)
        }
    }
    fs_close(r) else |_| {}
}

/// The temporary-file captures of a pipeline's children, read once they
/// have ended.
fn read_pending_caps(mut sh: Sh) {
    while sh.pend_cap.len > 0 {
        let r = (mut sh.pend_cap).pop() else -1
        let _l = (mut sh.pend_level).pop() else 0
        if r >= 0 {
            drain(mut sh, r)
        }
    }
}

/// Start `path` with `args` and the descriptor table as its map. A
/// descriptor that is an open capture goes, when the caller waits, to
/// one pipe read to its end here; when it does not (a pipeline stage),
/// the stage's own capture goes to the stage's pipe (`stage_w`) and any
/// other to a temporary file read back when the pipeline ends. Answers
/// the child's handle, or -1 and the status (the failure reported).
fn start_child(
    mut sh: Sh,
    cmd: str,
    path: str,
    args: List[str],
    nowait: bool,
    quiet_missing: bool,
) -> (int, int) {
    flush(mut sh)
    var map = List[int]()
    var cap_r = -1
    var cap_w = -1
    var temps = List[int]()
    var k = 0
    while k < sh.fds.len {
        let h = sh.fds[k]
        if is_cap(h) {
            let level = CAP_BASE - h
            var to = -1
            if nowait && sh.stage_w >= 0 && level == sh.stage_cap {
                to = sh.stage_w
            } else if nowait {
                let (w, p) = temp_create(sh)
                if w >= 0 {
                    let r = fs_open(p) else -1
                    fs_remove(p) else |_| {}
                    if r >= 0 {
                        (mut sh.pend_cap).push(r)
                        (mut sh.pend_level).push(level)
                    }
                    (mut temps).push(w)
                    to = w
                }
            } else {
                if cap_w < 0 {
                    let (r, w) = os_pipe() else (-1, -1)
                    cap_r = r
                    cap_w = w
                }
                to = cap_w
            }
            (mut map).push(k)
            (mut map).push(to)
        } else if h == FD_CLOSED {
            if k <= 2 {
                (mut map).push(k)
                (mut map).push(-1)
            }
        } else {
            (mut map).push(k)
            (mut map).push(h)
        }
        k += 1
    }
    var hd = spawn_fds(mut sh, path, args, map) else |e| match e {
        not_found => { -127 },
        denied => { -126 },
        invalid => { -126 },
        io => { -125 },
        unsupported => { -126 },
    }
    if hd == -125 {
        // the kernel would not run it: a script with no `#!` line is
        // the shell's to run (XCU 2.9.1.4)
        hd = -126
        if is_script(path) {
            let me = os_exe() else ""
            hd = spawn_fds(mut sh, me, script_args(path, args), map) else -126
        }
    }
    if cap_w >= 0 {
        fs_close(cap_w) else |_| {}
    }
    for w in temps {
        fs_close(w) else |_| {}
    }
    if hd < 0 {
        if cap_r >= 0 {
            fs_close(cap_r) else |_| {}
        }
        if hd == -127 {
            if !quiet_missing {
                diag(mut sh, "{cmd}: not found")
            }
        } else {
            diag(mut sh, "{cmd}: cannot be run")
        }
        return (-1, -hd)
    }
    if cap_r >= 0 {
        drain(mut sh, cap_r)
    }
    (hd, 0)
}

/// Run the program `fields[0]` with the command's own assignments
/// `names`/`values` exported to it. A name with no `/` is searched for
/// in `via` when it is not "" (`command -p`), else through the table
/// (`hash_find`), and a remembered path that is gone is searched for
/// again (XCU 2.9.1.4; dash, black-box). A name found nowhere is
/// `unfound`'s: `hook` when it is a simple command's own name (not
/// `command`'s operand, not `exec`'s), which may call
/// `command_not_found_handle` (pelt#42).
fn run_external(
    mut sh: Sh,
    fields: List[str],
    names: List[str],
    values: List[str],
    nowait: bool,
    via: str,
    hook: bool,
) -> int {
    let cmd = fields[0]
    var path = cmd
    var remembered = false
    let in_place = sh.exec_here && !nowait
    sh.exec_here = false
    sh.started = false
    if (cmd.find("/") else -1) < 0 {
        if via.len > 0 {
            path = find_in(mut sh, via, cmd)
        } else if own_path(names) {
            path = find_in(mut sh, search_path(sh, names, values), cmd)
        } else {
            remembered = hash_get(sh, cmd).len > 0
            path = hash_find(mut sh, cmd)
        }
        if path.len == 0 {
            let st = unfound(mut sh, fields, names, values, hook)
            sh.status = st
            return st
        }
    }
    flush(mut sh)
    sync_env(sh)
    // the command's own assignments, exported to it alone; put back
    // after
    var k = 0
    while k < names.len {
        env_set(names[k], values[k]) else |_| {}
        k += 1
    }
    if in_place && sh.caps.len == 0 && !names_cap(sh.fds) && !traps_act(sh) {
        // the program takes the forked child's place, as dash's last
        // command of a subshell does: the same process, its descriptor
        // table as the map; a refusal (a script the kernel will not run,
        // say) leaves it to the spawn below, which says why
        let _x = try_exec(path, fields, env_vars(), child_map(sh))
    }
    // with job control, a program the shell waits for at its top level
    // is a foreground job of its own (`sh.jobs`)
    var job = -1
    if !nowait && jc_here(sh) {
        job = jc_begin(mut sh, true, sh.jc_node)
    }
    let (h1, f1) = start_child(mut sh, cmd, path, fields[1..fields.len], nowait, remembered)
    var h = h1
    var failed = f1
    var missing = false
    if h < 0 && failed == 127 && remembered {
        // the remembered file is gone: search again
        hash_del(mut sh, cmd)
        path = hash_find(mut sh, cmd)
        if path.len == 0 {
            missing = true
        } else {
            let (h2, f2) = start_child(mut sh, cmd, path, fields[1..fields.len], nowait, false)
            h = h2
            failed = f2
        }
    }
    if job >= 0 {
        jc_end_build(mut sh)
    }
    var st = failed
    if h >= 0 {
        sh.started = true
        if nowait {
            sh.stage_child = h
            st = 0
        } else if job >= 0 {
            st = jc_fg_wait(mut sh, job, sh.jc_node)
            if jb_state_of(sh, job) == JB_DONE {
                jb_free(mut sh, job)
            }
        } else {
            st = reap(mut sh, h)
        }
    } else if job >= 0 {
        jc_take_tty(sh)
        jb_free(mut sh, job)
    }
    env_back(sh, names)
    if missing {
        // found nowhere now, as a name never found: once the job is
        // given back and the environment put back
        st = unfound(mut sh, fields, names, values, hook)
    }
    sh.status = st
    st
}

/// A simple command whose name (no `/`) command search found nowhere
/// (XCU 2.9.1.4). When `hook`, the shell is interactive (or a forked
/// subshell of one, `Sh.sub_of_i`), a function
/// `command_not_found_handle` is defined and this is not already inside
/// it, the function is called (`run_cnf`) and its status is the
/// command's; a 127 it returns is said as pelt's own not-found, unless
/// the shell is leaving (an `exit`, an interrupt). Otherwise the
/// not-found: said, 127. Inside the call every name not found is the
/// plain not-found, so the function is never re-entered.
fn unfound(mut sh: Sh, fields: List[str], names: List[str], values: List[str], hook: bool) -> int {
    if hook && (sh.interactive || sh.sub_of_i) && !sh.in_cnf {
        // bash's name for it, which fortsh shares (pelt#42)
        let fnode = sh.funcs["command_not_found_handle"] else -1
        if fnode >= 0 {
            let st = run_cnf(mut sh, fnode, fields, names, values)
            if st != 127 || sh.flow != F_NONE {
                return st
            }
        }
    }
    diag(mut sh, "{fields[0]}: not found")
    127
}

/// `command_not_found_handle` (body `fnode`) called for the command
/// `fields` in the current shell environment, as a function is
/// (`run_fields`): `$@` is every word, so `$1` is the name; the
/// command's assignments are made for the call and undone after (XCU
/// 2.9.1); its redirections are already in place around it.
fn run_cnf(mut sh: Sh, fnode: int, fields: List[str], names: List[str], values: List[str]) -> int {
    var old = List[str]()
    var had = List[bool]()
    var k = 0
    while k < names.len {
        (mut had).push(has_var(sh, names[k]))
        (mut old).push(value_of(sh, names[k]))
        if !set_var(mut sh, names[k], values[k]) {
            fatal(mut sh, "{names[k]}: is read-only", 2)
            return 2
        }
        k += 1
    }
    let was = sh.in_cnf
    sh.in_cnf = true
    let base = pos_push(mut sh)
    for f in fields {
        (mut sh.pos).push(f)
    }
    let st = call_body(mut sh, fnode, base)
    sh.in_cnf = was
    k = names.len - 1
    while k >= 0 {
        if had[k] {
            let _ok = set_var(mut sh, names[k], old[k])
        } else {
            let _ok = unset_var(mut sh, names[k])
        }
        k -= 1
    }
    st
}

/// Whether the file at `path` is one the shell runs itself when the
/// kernel will not: text with no `#!` line. A file that starts like a
/// program (a NUL in its first bytes) is not. A guess from the file,
/// because `os_exec`'s `io` does not say `ENOEXEC` (wolf-lang#682; and
/// `os_spawn_fds` at 0.2.27 hands such a file to `/bin/sh` itself
/// before pelt is asked).
fn is_script(path: str) -> bool {
    let h = fs_open(path) else -1
    if h < 0 {
        return false
    }
    let head = fs_read_chunk(h, 256) else |_| List[byte]()
    fs_close(h) else |_| {}
    if head.len >= 2 && head[0] as int == 35 && head[1] as int == 33 {
        return false
    }
    for b in head {
        if b as int == 0 {
            return false
        }
    }
    true
}

/// The operands for pelt run on script `path` with `args`.
fn script_args(path: str, args: List[str]) -> List[str] {
    var out = List[str]()
    (mut out).push(path)
    for a in args {
        (mut out).push(a)
    }
    out
}

// ------------------------------------------------------------------ exec

/// `os_exec`'s answer as a status: it returns only when it failed —
/// 127 when there is no such program, 125 when the kernel refused the
/// file's format, 126 for every other reason.
fn try_exec(path: str, argv: List[str], env: List[str], map: List[int]) -> int {
    os_exec(path, argv, env, map) else |e| match e {
        not_found => { return 127 },
        denied => { return 126 },
        invalid => { return 126 },
        io => { return 125 },
        unsupported => { return 126 },
    }
    126
}

/// `exec cmd arg…` (XCU `exec`): the assignments are made and the
/// redirections applied, and then the program replaces the shell — the
/// same process (`os_exec`), with the descriptor table as its
/// descriptors and the exported variables, plus the assignments, as its
/// environment. No `EXIT` trap runs. When the program cannot be run
/// the shell ends, interactive or not, with 127 (not found) or 126,
/// and that ending does run the `EXIT` trap (dash, black-box).
/// Inside a subshell pelt runs in-process, or with a capture open,
/// there is no process to replace: the program is started and waited
/// for, and the subshell ends with its status.
fn run_exec(
    mut sh: Sh,
    fields: List[str],
    names: List[str],
    values: List[str],
    rds: List[Rd],
) -> int {
    if !assign_all(mut sh, names, values) {
        return 2
    }
    if !apply_redirs(mut sh, rds) {
        end_redirs(mut sh)
        return special_redir_failed(mut sh)
    }
    let args = args_of(fields)
    var here = sh.sub > 0 || sh.caps.len > 0
    for h in sh.fds {
        if is_cap(h) {
            here = true
        }
    }
    var st = 0
    if here {
        st = run_external(mut sh, args, names, values, false, "", false)
        if sh.started {
            // the program ran in the subshell's place: no `EXIT` trap
            traps_clear(mut sh)
        }
    } else {
        st = replace_shell(mut sh, args, names)
    }
    end_redirs(mut sh)
    sh.status = st
    sh.flow = F_EXIT
    sh.abort = false
    st
}

/// Replace the shell with `args`; answers only when that failed, with
/// the status the shell ends with.
fn replace_shell(mut sh: Sh, args: List[str], names: List[str]) -> int {
    let cmd = args[0]
    var path = cmd
    if (cmd.find("/") else -1) < 0 {
        path = find_in_path(mut sh, cmd)
        if path.len == 0 {
            diag(mut sh, "exec: {cmd}: not found")
            return 127
        }
    }
    flush(mut sh)
    let env = exec_env(sh, names)
    let map = child_map(sh)
    // the terminal, the group and the three job-control signals go back
    // first: the program is the shell's process from here on
    jc_leave(mut sh)
    var st = try_exec(path, args, env, map)
    if st == 125 {
        st = 126
        if is_script(path) {
            let me = os_exe() else ""
            var argv = List[str]()
            (mut argv).push("pelt")
            for a in script_args(path, args[1..args.len]) {
                (mut argv).push(a)
            }
            st = try_exec(me, argv, env, map)
            if st == 125 {
                st = 126
            }
        }
    }
    if st == 127 {
        diag(mut sh, "exec: {cmd}: not found")
    } else {
        diag(mut sh, "exec: {cmd}: cannot be run")
    }
    st
}

// ------------------------------------------------- asynchronous lists

/// `list &` (XCU 2.9.3.1). A simple command that runs a program, or a
/// pipeline, becomes a background job (`sh.jobs`): its programs are
/// started and not waited for, with job control on in a group of their
/// own; anything else (a built-in, a compound command, a function) is a
/// forked process (`sh.fork`), the job's one. Where the host does not
/// fork, pelt runs such a list itself, to the end, as a subshell, and
/// records it as a finished job. `$!` is the last process's id, or for
/// a list pelt ran itself a number no process has.
/// With job control off standard input is the null device before the
/// list's own redirections, and the programs start with `SIGINT` and
/// `SIGQUIT` ignored (XCU 2.11): the two are ignored in pelt across the
/// spawn, which is what a child inherits, and put back after.
fn run_async(mut sh: Sh, node: int) -> int {
    flush(mut sh)
    let jc = sh.jc_on && sh.sub == 0 && sh.jc_build < 0 && sh.caps.len == 0
    let target = async_target(sh.ast, node)
    let tk = sh.ast.nodes[target].kind
    let as_job = sh.caps.len == 0 &&
        sh.jc_build < 0 &&
        (tk == K_SIMPLE || tk == K_PIPE && sh.ast.nodes[target].kids.len > 1)
    let saved_in = fd_get(sh, 0)
    var null = FD_CLOSED
    if !jc {
        null = fs_open("/dev/null") else FD_CLOSED
        fd_set(mut sh, 0, null)
    }
    var j = -1
    let forks = !as_job && fork_usable(sh) && sh.caps.len == 0 && sh.jc_build < 0
    if as_job || forks {
        j = jb_new(mut sh)
        set_slot_pgid(mut sh, j, if jc then 0 else -1)
        sh.jc_build = j
        sh.jc_give = -1
    }
    sh.stage_child = -1
    sh.nowait = as_job && tk == K_SIMPLE
    sh.bg_simple = sh.nowait
    if as_job && !jc {
        sig_boot(mut sh)
        let two = m_int() | m_quit()
        os_signal_ignore(two) else |_| {}
        sh.sig_listen = less(sh.sig_listen, two)
        sh.sig_ignore = sh.sig_ignore | two
        // and a stage the pipeline forks holds them ignored (`sh.fork`)
        sh.async_ign = two
    }
    var st = RUN_HERE
    if forks {
        st = fork_shape(mut sh, node, FK_BG, false, false, false, node)
        if st == RUN_HERE {
            jc_end_build(mut sh)
            jb_free(mut sh, j)
            j = -1
        }
    } else if as_job && tk == K_SIMPLE && fork_usable(sh) {
        sh.fk_mode = FK_BG
    }
    if st == RUN_HERE {
        st = run_subshell(mut sh, node)
    }
    sh.fk_mode = FK_NONE
    sh.async_ign = 0
    sh.nowait = false
    sh.bg_simple = false
    jc_end_build(mut sh)
    sh.stage_child = -1
    sig_apply(mut sh)
    fd_set(mut sh, 0, saved_in)
    if null >= 3 && !names_handle(sh.fds, null) {
        fs_close(null) else |_| {}
    }
    if j < 0 {
        j = jb_new(mut sh)
    }
    if jb_procs(sh, j) == 0 {
        // a list pelt ran itself has ended by now
        set_slot_state(mut sh, j, JB_DONE)
        set_slot_status(mut sh, j, st)
        set_slot_id(mut sh, j, NO_PID_BASE + sh.jb_seq)
        sh.jb_seq += 1
        set_slot_told(mut sh, j, !sh.jc_on)
        // told a line later at a prompt (`sh.jobs`'s `jc_notify`); in a
        // script with `set -m` with the others, after the complete
        // command (dash, black-box: jobsctl/c_monitor_loop_builtin,
        // pelt#41)
        set_slot_late(mut sh, j, sh.jc_on && sh.interactive)
    }
    if sh.jc_on {
        jb_fill_text(mut sh, j, node)
    }
    sh.last_bg = slot_id(sh, j)
    sh.status = 0
    0
}

/// The command `&` makes a job of: `node` without the and-or list and
/// the pipeline that hold it alone.
fn async_target(a: Ast, node: int) -> int {
    var n = node
    loop {
        let k = a.nodes[n].kind
        if k == K_ANDOR && a.nodes[n].kids.len == 1 {
            n = a.nodes[n].kids[0]
        } else if k == K_PIPE && a.nodes[n].kids.len == 1 && a.nodes[n].ints[0] == 0 {
            n = a.nodes[n].kids[0]
        } else {
            return n
        }
    }
    n
}

/// Job `j`'s status, waiting for it if it still runs (`wait`,
/// `sh.builtin`); an end by signal is said unless `quiet` (dash says
/// nothing for `wait` with no operand, black-box: s10).
fn wait_job(mut sh: Sh, j: int, quiet: bool) -> int {
    // an end a poll took before this `wait` asked is not said (pelt#47)
    let earlier = slot_flag(sh, j, SL_REAPED)
    if jb_procs(sh, j) == 0 {
        // a list pelt ran itself (its status), or a job whose one process
        // ended and was folded into its slot (`sh.jobs`'s `jb_fold`: the
        // poll's spelling, so an end by a signal is said as below)
        let (st0, sig0) = status_of(slot_status(sh, j))
        if !quiet && !earlier {
            report_signal(mut sh, sig0)
        }
        return st0
    }
    var now = false
    var k = 0
    while k < sh.pr_job.len {
        if sh.pr_job[k] == j && sh.pr_st[k] == PR_RUN {
            let kept = stash_take(mut sh, sh.pr_h[k])
            if kept != PR_RUN {
                sh.pr_st[k] = kept
            } else {
                sh.pr_st[k] = os_wait_status(sh.pr_h[k]) else 1
            }
            now = true
        }
        k += 1
    }
    let raw = jb_raw(sh, j)
    let (st, sig) = status_of(raw)
    if !quiet && (now || !earlier) {
        report_signal(mut sh, sig)
    }
    st
}

/// The status a child of the table answered, as `$?`; 0 for a handle no
/// job holds.
fn proc_status(sh: Sh, j: int, h: int) -> int {
    var k = 0
    while k < sh.pr_h.len {
        if sh.pr_job[k] == j && sh.pr_h[k] == h {
            return raw_status(sh.pr_st[k])
        }
        k += 1
    }
    0
}

// ------------------------------------------------------------ pipelines

/// `a | b | …` (XCU 2.9.2), stages left to right. A stage that is a
/// simple command running a program is started with its descriptor 1 a
/// pipe's write end and not waited for, so the programs of a pipeline
/// run together; so is a stage pelt runs itself (a function, a compound
/// command, a built-in the fast path does not finish), as a forked
/// process (`sh.fork`). A pure built-in's output is caught and becomes
/// the next stage's input (`sh.redir`'s `feed`); and where the host does
/// not fork, so is every stage pelt runs itself, run as a subshell to
/// its end, so pelt never blocks writing a pipe nobody drains.
/// The status is the last stage's, or under `pipefail` the rightmost
/// failing stage's.
fn run_pipeline(mut sh: Sh, n: int) -> int {
    let held = sh.jc_hold
    let st = run_pipeline_in(mut sh, n)
    sh.jc_hold = held
    st
}

fn run_pipeline_in(mut sh: Sh, n: int) -> int {
    flush(mut sh)
    // with job control, a pipeline at the top level is a foreground job:
    // its programs, the last one too, are started into one group and
    // waited for together (`sh.jobs`); a pipeline `&` builds a
    // background job the same way and is not waited for
    var job = -1
    if jc_here(sh) {
        if pipe_is_job(sh, n) {
            job = jc_begin(mut sh, true, n)
        } else {
            sh.jc_hold = true
        }
    }
    let building = sh.jc_build >= 0
    var last_child = -1
    let count = sh.ast.nodes[n].kids.len
    var input = fd_get(sh, 0)
    var own_in = false
    // the children started, on the state's own stack (pelt#19)
    let kbase = sh.istk.len
    var st = 0
    var i = 0
    while i < count {
        let node = sh.ast.nodes[n].kids[i]
        if i == count - 1 {
            sh.stage_child = -1
            // the job's last program is started and not waited for too;
            // a built-in there still runs the fast way (`jc_last`)
            sh.jc_last = building && sh.ast.nodes[node].kind == K_SIMPLE
            st = run_stage_kept(mut sh, node, input, false)
            sh.jc_last = false
            last_child = sh.stage_child
            sh.stage_child = -1
            if own_in {
                fs_close(input) else |_| {}
            }
            break
        }
        let (r, w) = os_pipe() else (-1, -1)
        if r < 0 {
            diag(mut sh, "cannot make a pipe")
            st = 2
            break
        }
        cap_begin(mut sh)
        sh.stage_w = w
        sh.stage_r = r
        sh.stage_cap = sh.caps.len
        sh.stage_child = -1
        sh.stage_in = -1
        let simple = sh.ast.nodes[node].kind == K_SIMPLE
        let _st = run_stage_kept(mut sh, node, input, simple)
        let child = sh.stage_child
        let given = sh.stage_in
        sh.stage_child = -1
        sh.stage_in = -1
        sh.stage_w = -1
        sh.stage_r = -1
        sh.stage_cap = 0
        var fed = given
        if child >= 0 || given >= 0 {
            let start = cap_close(mut sh)
            cap_cut(mut sh, start)
        } else {
            fed = cap_feed(mut sh)
        }
        fs_close(w) else |_| {}
        if own_in {
            fs_close(input) else |_| {}
        }
        // each earlier stage's child and status (-1 while a child
        // runs), for `pipefail`
        (mut sh.istk).push(child)
        (mut sh.istk).push(if child >= 0 then -1 else _st)
        if child >= 0 {
            input = r
        } else {
            fs_close(r) else |_| {}
            input = fed
        }
        own_in = true
        i += 1
    }
    var started = last_child >= 0
    var q = kbase
    while q + 1 < sh.istk.len {
        if sh.istk[q] >= 0 {
            started = true
        }
        q += 2
    }
    if building && job < 0 && started {
        // a background job's: the shell does not wait (`run_async`)
        cut_istk(mut sh, kbase)
        read_pending_caps(mut sh)
        return 0
    }
    if job >= 0 {
        jc_end_build(mut sh)
        if jb_procs(sh, job) > 0 {
            let fst = jc_fg_wait(mut sh, job, n)
            if jb_state_of(sh, job) == JB_STOP {
                cut_istk(mut sh, kbase)
                read_pending_caps(mut sh)
                return fst
            }
        }
        if last_child >= 0 {
            st = proc_status(sh, job, last_child)
        }
    }
    // with `set -o pipefail` (XCU 2.9.2) the status is the rightmost
    // stage's that failed, or 0; the option is read as the pipeline
    // ends, which no stage of it can have changed (each is a subshell)
    var failed = 0
    var k = kbase
    while k + 1 < sh.istk.len {
        let h = sh.istk[k]
        var s = sh.istk[k + 1]
        if h >= 0 {
            s = if job >= 0 then proc_status(sh, job, h) else reap(mut sh, h)
        }
        if s != 0 {
            failed = s
        }
        k += 2
    }
    if job >= 0 {
        jb_free(mut sh, job)
    }
    cut_istk(mut sh, kbase)
    read_pending_caps(mut sh)
    if sh.opt_pipefail && st == 0 {
        return failed
    }
    st
}

/// `run_stage`, a simple command's stage keeping what its own command
/// search finds (dash, black-box: `ls | cat; hash` lists both; what a
/// function or a compound command run as a stage finds is not kept).
fn run_stage_kept(mut sh: Sh, node: int, input: int, nowait: bool) -> int {
    let saved = sh.hash_keep
    let saved_depth = sh.hash_keep_depth
    // the frame `run_subshell` opens starts where the stack ends now;
    // a pipeline inside a subshell keeps nothing (dash's subshell is a
    // process)
    let own = sh.ast.nodes[node].kind == K_SIMPLE && sh.fr_top < 0
    sh.hash_keep = if own then sh.istk.len else -1
    sh.hash_keep_depth = sh.fdepth
    let st = run_stage(mut sh, node, input, nowait)
    sh.hash_keep = saved
    sh.hash_keep_depth = saved_depth
    st
}

/// One pipeline stage as a subshell, with descriptor 0 `input`: a
/// process (`sh.fork`) unless it is a simple command the fast path
/// finishes (a program started on the stage's pipe, a pure built-in whose
/// output is fed on). A stage's process is the pipeline's to wait for (or
/// the job's) but the last of a pipeline that is no job, which is waited
/// for here.
fn run_stage(mut sh: Sh, node: int, input: int, nowait: bool) -> int {
    let saved_in = fd_get(sh, 0)
    fd_set(mut sh, 0, input)
    var st = RUN_HERE
    if fork_usable(sh) {
        let last = sh.stage_w < 0
        let fk = if !last || sh.jc_build >= 0 then FK_STAGE else FK_WAIT
        if sh.ast.nodes[node].kind != K_SIMPLE {
            st = fork_shape(mut sh, node, fk, false, false, false, node)
        } else {
            sh.fk_mode = fk
        }
    }
    if st == RUN_HERE {
        sh.nowait = nowait
        st = run_subshell(mut sh, node)
        sh.nowait = false
        sh.fk_mode = FK_NONE
    }
    fd_set(mut sh, 0, saved_in)
    st
}
