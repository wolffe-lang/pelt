//! sh.interact — commands from standard input, and the prompt.
//!
//! References consulted: POSIX.1-2024 XCU `sh` (DESCRIPTION, OPTIONS
//! `-i` and `-s`, STDIN, ENVIRONMENT VARIABLES `ENV`, `PS1`, `PS2`),
//! XCU 2.5.3 (`ENV`, `PS1`, `PS2`) and 2.8.1 (the consequences of
//! shell errors, interactive column); black-box runs of `dash -i`
//! 0.5.13.4 through a pty. No shell's source.
//!
//! **Reading.** Commands are read one byte at a time from shell
//! descriptor 0 (since wolf 0.2.26 the process's descriptor 0 itself,
//! `[os.fs.std]`), so the shell never takes a byte past the newline it
//! needs: what follows is left for the `read` built-in and for any
//! program given the shell's standard input, which continue where the
//! shell stopped.
//!
//! **A complete command.** After each line the text so far is parsed in
//! a scratch region; when the only thing wrong with it is that it ended
//! (an open quote, an unclosed `if`, a here-document whose delimiter has
//! not come, a trailing `&&` or `\`), the parser says so in `P.more` and
//! the shell prompts with `PS2` for another line. Then the whole text is
//! parsed again into the shell's tree and run.
//!
//! **Interactive or not.** POSIX makes the shell interactive with `-i`,
//! or with no operands and no `-c` when standard input and standard
//! error are terminals: `os_isatty(0)` and `os_isatty(2)`
//! (`[os.fs.isatty]`), so a pipe or a file on standard input runs as a
//! script, with no prompt.
//!
//! **Errors.** XCU 2.8.1: a syntax error, a special built-in's error,
//! an expansion error and an assignment error end a non-interactive
//! shell and do not end an interactive one. `fatal` marks such an exit
//! (`Sh.abort`); here an interactive shell abandons the rest of the
//! command it was running, keeps the status (2), and prompts again.
//!
//! **Ctrl-C.** An interactive shell listens for `SIGINT` (`sh.signal`):
//! it lives, a program it is waiting for dies of the terminal's signal
//! and answers 128 plus the signal's number (130), a loop pelt is
//! running itself is abandoned at its next command, and the prompt
//! comes back. `SIGQUIT` and `SIGTERM` do
//! nothing to it, as to `dash -i`.

/// Whether descriptors 0 and 2 are both terminals (XCU `sh`).
fn on_terminal() -> bool {
    let i = os_isatty(0) else false
    let e = os_isatty(2) else false
    i && e
}

/// One line of shell descriptor 0, its newline kept, and how it ended:
/// 0 at a newline, 1 at the end of input after some bytes, 2 at the end
/// of input before any. The end of the process's own standard input is
/// remembered: a terminal's end of file (Ctrl-D) is one zero-byte read,
/// and the next read would wait for more typing. The bytes are gathered
/// inside a region and only the line is kept.
fn read_raw_line(mut sh: Sh) -> (str, int) {
    let fd = fd_get(sh, 0)
    if fd < 0 || fd == 0 && sh.eof0 {
        return ("", 2)
    }
    let (line, how) = copy region rl {
        line_of(fd)
    }
    if how != 0 && fd == 0 {
        sh.eof0 = true
    }
    (line, how)
}

fn line_of(fd: int) -> (str, int) {
    var o = buf()
    loop {
        let c = fs_read_chunk(fd, 1) else |_| List[byte]()
        if c.len == 0 {
            if o.b.len == 0 {
                return ("", 2)
            }
            return (text(o), 1)
        }
        let b = c[0] as int
        putb(mut o, b)
        if b == 10 {
            return (text(o), 0)
        }
    }
    ("", 2)
}

/// `read -d`'s input (`sh.builtin`'s `read_split`, inside its region):
/// the bytes of handle `fd` up to byte `d` (not kept), and how they
/// ended, as `line_of`. Unless `raw`, a backslash and the byte after it
/// are kept together, so an escaped delimiter does not end the read.
fn delim_of(fd: int, d: int, raw: bool) -> (str, int) {
    var o = buf()
    var escaped = false
    loop {
        let c = fs_read_chunk(fd, 1) else |_| List[byte]()
        if c.len == 0 {
            if o.b.len == 0 {
                return ("", 2)
            }
            return (text(o), 1)
        }
        let b = c[0] as int
        if b == d && !escaped {
            return (text(o), 0)
        }
        putb(mut o, b)
        escaped = !raw && !escaped && b == 92
    }
    ("", 2)
}

/// Whether `src` stops short of a complete command only because it
/// ended (`P.more`). Parsed in a scratch region: nothing it builds is
/// kept.
fn needs_more(src: str, aliases: Map[str, str]) -> bool {
    var more = false
    region scratch {
        var a = new_ast()
        if aliases.len > 0 {
            // an alias's value may open what the next line closes
            a.aliases = copy aliases
        }
        var p = new_parser(src, 1)
        loop {
            let n = parse_complete(mut p, mut a)
            if n < 0 {
                break
            }
        }
        more = p.more
    }
    more
}

/// The next line, prompted with `PS1` (`first`) or `PS2`, and how it
/// ended: 0 at a newline, 1 at the end of input after some bytes, 2 at
/// the end before any, `ED_INTR` when Ctrl-C (or a SIGINT) ended the
/// line being edited, `ED_VISUAL` when vi's `v` did (its count in
/// `sh.ed.vnum`). Through the line editor (`sh.edit`) when the terminal
/// is ours, the width learned before the prompt is written; else as
/// typed through the terminal's own line discipline. Before `PS1` the
/// history file is brought up to date (`hist_sync`).
fn next_line(mut sh: Sh, first: bool) -> (str, int) {
    let name = if first then "PS1" else "PS2"
    if first && sh.interactive {
        hist_sync(mut sh, true)
        mail_check(mut sh)
    }
    if !ed_active(sh) {
        if sh.interactive {
            let _shown = prompt(mut sh, name, false)
        }
        return read_raw_line(mut sh)
    }
    highlight_warning(mut sh)
    let cpr = sh.ed.cpr
    let q = copy region eq {
        ed_query(sh, cpr)
    }
    sh.ed.cpr = q.cpr
    let shown = prompt(mut sh, name, true)
    let r = copy region el {
        ed_line(sh, shown, q)
    }
    if r.mem_set {
        sh.ed.mem = txt_mem(r.mem)
    }
    sh.ed.resume = ""
    if r.how == ED_INTR {
        return ("", ED_INTR)
    }
    if r.how == ED_CHILD {
        sh.ed.resume = r.line
        sh.ed.resume_at = r.num
        return ("", ED_CHILD)
    }
    if r.how == ED_VISUAL {
        sh.ed.vnum = r.num
        return (r.line, ED_VISUAL)
    }
    if r.how != ED_OK {
        sh.eof0 = true
        return ("", 2)
    }
    (r.line, 0)
}

/// Write the prompt `var` (`PS1` or `PS2`) to standard error, expanded
/// as a double-quoted word is (XCU 2.5.3; dash also runs arithmetic and
/// command substitution there), and answer it as written (the line
/// editor redraws it; only when `keep`, so that a shell with no editor
/// copies nothing out of the prompt's region). The expansion leaves `$?`
/// alone, and an error in it does not end the shell.
fn prompt(mut sh: Sh, var_name: str, keep: bool) -> str {
    flush(mut sh)
    let raw = sh.vals[var_name] else ""
    if raw.len == 0 {
        return ""
    }
    // `PS1`'s `!` is the next command's number (XCU 2.5.3), replaced
    // before the other expansions (bash's order, as a user sees it)
    let num = if var_name == "PS1" && sh.interactive then sh.ed.h.next else -1
    if keep {
        let (done, fast_shown) = copy region pk {
            prompt_fast(sh, if num >= 0 then ps1_bang(raw, num) else raw, true)
        }
        if done {
            return fast_shown
        }
    } else {
        // a tuple holding a `str` copied out of the region costs the
        // root about 15 bytes a prompt, even for "" (sh11 measured it
        // over 20,000 commands); a `bool` costs nothing
        let done = copy region pr {
            prompt_fast(sh, if num >= 0 then ps1_bang(raw, num) else raw, false).0
        }
        if done {
            return ""
        }
    }
    let saved_status = sh.status
    let saved_cs = sh.cs_status
    let saved_ran = sh.cs_ran
    let shown = expand_one(mut sh, if num >= 0 then ps1_bang(raw, num) else raw, X_DQ)
    if sh.flow != F_NONE {
        sh.flow = F_NONE
        sh.abort = false
    }
    sh.status = saved_status
    sh.cs_status = saved_cs
    sh.cs_ran = saved_ran
    write_fd(mut sh, 2, shown)
    shown
}

/// The prompt expanded and written in the shadow state, inside the
/// region; false when its expansion would write the state (a command
/// substitution, an error), and `prompt` does it the ordinary way.
fn prompt_fast(sh: Sh, raw: str, keep: bool) -> (bool, str) {
    var t = shadow_of(sh)
    let shown = expand_one(mut t, raw, X_DQ)
    if t.bail || t.flow != F_NONE {
        return (false, "")
    }
    write_fd(mut t, 2, shown)
    (true, if keep then shown else "")
}

/// `MAIL`, `MAILPATH` and `MAILCHECK` (XCU 2.5.3), before a primary
/// prompt: when `MAILCHECK` seconds have passed since the last check
/// (600 when it is unset or not a number; 0, every prompt), each
/// mailbox — `MAILPATH`'s, colon-separated, else `MAIL`'s — whose
/// modification time is not the one the last check saw (it was made,
/// or written) is told on standard error: `MAILPATH`'s message after an
/// unescaped `%`, expanded as a prompt is, else dash's words, `you have
/// mail`. A mailbox the shell has not seen before (at the first check,
/// or one newly named) is only noted. dash's rule for what is new
/// (black-box: `notes/sh26-evidence/probe/p17`–`p19`); POSIX's interval,
/// which dash ignores, and POSIX's colon at the end of a message,
/// which dash reads past (R-sh26-5).
fn mail_check(mut sh: Sh) {
    let mp = sh.vals["MAILPATH"] else ""
    let mail = sh.vals["MAIL"] else ""
    if mp.len == 0 && mail.len == 0 {
        return
    }
    let now = time_unix_ms() / 1000
    let iv = to_int(sh.vals["MAILCHECK"] else "600") else 600
    if sh.mail_last >= 0 && iv > 0 && now - sh.mail_last < iv {
        return
    }
    sh.mail_last = now
    if mp.len > 0 {
        for entry in mp.split(":") {
            let (path, msg) = mail_entry(entry)
            if path.len > 0 {
                mail_one(mut sh, path, msg)
            }
        }
    } else {
        mail_one(mut sh, mail, "")
    }
}

/// One `MAILPATH` entry: the pathname (`\%` in it a `%`) and the
/// message after the first unescaped `%` ("" for none).
fn mail_entry(entry: str) -> (str, str) {
    var o = buf()
    var i = 0
    while i < entry.len {
        let c = ch(entry, i)
        if c == '\\' && i + 1 < entry.len && ch(entry, i + 1) == '%' {
            putc(mut o, '%')
            i += 2
            continue
        }
        if c == '%' {
            return (text(o), entry[i + 1..entry.len])
        }
        putb(mut o, byte_at(entry, i))
        i += 1
    }
    (text(o), "")
}

/// A mailbox's modification time in seconds, -1 when there is none.
fn mail_mtime(path: str) -> int {
    let rec = stat_of(path, false)
    if rec.len > 14 then rec[14] else -1
}

fn mail_one(mut sh: Sh, path: str, msg: str) {
    let t = copy region mt {
        mail_mtime(path)
    }
    let was = sh.mail_seen[path] else -2
    sh.mail_seen[path] = t
    if was == -2 || t < 0 || t == was {
        return
    }
    if msg.len == 0 {
        write_fd(mut sh, 2, "you have mail\n")
        return
    }
    let saved_status = sh.status
    let saved_cs = sh.cs_status
    let saved_ran = sh.cs_ran
    let shown = expand_one(mut sh, msg, X_DQ)
    if sh.flow != F_NONE {
        sh.flow = F_NONE
        sh.abort = false
    }
    sh.status = saved_status
    sh.cs_status = saved_cs
    sh.cs_ran = saved_ran
    write_fd(mut sh, 2, "{shown}\n")
}

/// `$ENV` (XCU 2.5.3): an interactive shell expands it and runs the
/// file it names before the first prompt. A file that cannot be read
/// is passed over without a word, as dash does.
fn run_env_file(mut sh: Sh) {
    let raw = sh.vals["ENV"] else ""
    if raw.len == 0 {
        return
    }
    let path = expand_one(mut sh, raw, X_DQ)
    if sh.flow != F_NONE {
        if sh.abort {
            sh.flow = F_NONE
            sh.abort = false
        }
        return
    }
    let src = fs_read_text(path) else |_| { return }
    let _st = eval_string(mut sh, src, path)
    if sh.flow == F_EXIT && sh.abort {
        sh.flow = F_NONE
        sh.abort = false
    }
}

fn count_lines(s: str) -> int {
    var n = 0
    for b in s.bytes() {
        if b as int == 10 {
            n += 1
        }
    }
    n
}

/// Read and run standard input, one complete command at a time: with
/// prompts and 2.8.1's interactive rules when `sh.interactive`, as a
/// script otherwise. Answers the status the shell leaves with. An
/// interactive shell reads its history file after the `ENV` file and
/// writes what is left to write when it ends (`sh.hist`).
fn run_stdin(mut sh: Sh) -> int {
    if sh.interactive {
        run_env_file(mut sh)
        if sh.flow == F_EXIT {
            return sh.status
        }
        hist_init(mut sh)
    }
    let st = run_lines(mut sh)
    if sh.interactive {
        hist_sync(mut sh, false)
    }
    st
}

fn run_lines(mut sh: Sh) -> int {
    var line = 1
    // one buffer and one parser for every line, emptied in place
    // (pelt#19)
    var o = buf()
    var lp = new_parser("", line)
    loop {
        // a one-line command is kept as read; only a continued one is
        // joined in a buffer
        var src = ""
        (mut o.b).clear()
        var joined = false
        var first = true
        var ended = false
        var intr = false
        var visual = false
        if sh.interactive && sh.jc_on {
            // XCU 2.11: what the jobs did since, before the prompt, as
            // far as the shell has looked (`sh.jobs`'s `jc_take`)
            jc_notify(mut sh, false)
        }
        sh.exit_warned_prev = sh.exit_warned
        sh.exit_warned = false
        loop {
            let (got, how) = next_line(mut sh, first)
            if how == ED_CHILD {
                // `set -b`: the notice now, then the line again
                jc_notify(mut sh, true)
                continue
            }
            if how == ED_INTR {
                intr = true
                break
            }
            if how == ED_VISUAL {
                // vi `v`: the command so far goes to vi (`hist_visual`)
                visual = true
                if first {
                    src = got
                } else {
                    if !joined {
                        put(mut o, src)
                        joined = true
                    }
                    put(mut o, got)
                }
                break
            }
            if sh.opt_v && got.len > 0 {
                write_fd(mut sh, 2, got)
            }
            if first {
                src = got
            } else {
                if !joined {
                    put(mut o, src)
                    joined = true
                }
                put(mut o, got)
            }
            if how != 0 {
                ended = true
                break
            }
            first = false
            if !needs_more(if joined then text(o) else src, sh.ast.aliases) {
                break
            }
        }
        if intr {
            // Ctrl-C (or a SIGINT) while a line was edited: the command
            // is abandoned, `$?` is 128 plus SIGINT's number, and a
            // trap on INT runs now
            sh.status = int_status()
            let action = sh.traps["INT"] else ""
            if action.len > 0 {
                run_trap_action(mut sh, action)
                flush(mut sh)
            }
            if sh.flow == F_EXIT && !sh.abort {
                return sh.status
            }
            sh.flow = F_NONE
            sh.abort = false
            continue
        }
        if joined {
            src = text(o)
        }
        if visual {
            let _vst = hist_visual(mut sh, src, sh.ed.vnum)
            flush(mut sh)
            if sh.flow == F_EXIT && !sh.abort {
                return sh.status
            }
            sh.flow = F_NONE
            sh.abort = false
            continue
        }
        if src.len == 0 {
            if sh.interactive && sh.opt_ignoreeof && sh.eof_count < 50 {
                // `set -o ignoreeof` (XCU `set`): the end of file is
                // refused with dash's words, fifty times in a row, as
                // dash counts them; the fifty-first ends the shell
                // (R-sh26-4: dash, black-box `probe/p16`, but at each
                // end of file, not fifty at once)
                sh.eof_count += 1
                sh.eof0 = false
                write_fd(mut sh, 2, "\nUse \"exit\" to leave shell.\n")
                continue
            }
            if sh.interactive {
                // leave the terminal's cursor off the prompt line
                write_fd(mut sh, 2, "\n")
            }
            break
        }
        sh.eof_count = 0
        if sh.interactive {
            // the command about to run is the history's newest entry
            hist_add(mut sh, src)
            // what the jobs did while it was typed (`sh.jobs`)
            jc_take(mut sh)
        }
        // a signal that came while the line was being typed: its trap
        // runs now, before the line does (dash, black-box); Ctrl-C with
        // no trap abandons nothing, there being no command yet
        sh.at_prompt = true
        poll_traps(mut sh)
        sh.at_prompt = false
        var fast = false
        if sh.flow != F_NONE {
            fast = true
        }
        // a typed simple command runs inside the region, its parse tree
        // included (`sh.exec`'s `run_turn_fast`); which lines are one is
        // asked first, in a region of its own whose answer is a `bool`,
        // so any other line costs nothing to ask about (pelt#19)
        var one = false
        // (a line whose first word may be an alias is parsed with the
        // aliases, in the shell's own tree)
        if !fast &&
            sh.interactive &&
            !sh.opt_n &&
            !sh.opt_v &&
            fast_ok(sh) &&
            sh.ast.aliases.len == 0 {
            one = copy region ask {
                turn_simple(src, line) >= 0
            }
        }
        if one {
            flush(mut sh)
            let r = copy region turn {
                run_turn_fast(sh, src, line)
            }
            if r.kind != R_SLOW {
                sh.line = line
                let st = commit_fast(mut sh, r)
                check_e(mut sh, st)
                poll_traps(mut sh)
                fast = true
            }
        }
        if !fast {
            // the line was written as read (`set -v`) above
            let _st = eval_top(mut sh, mut lp, src, line, false)
        }
        line += count_lines(src)
        sh.ed.h.cur = false
        if sh.flow == F_EXIT && sh.interactive && sh.abort {
            sh.flow = F_NONE
            sh.abort = false
            if sh.intr {
                // Ctrl-C abandoned the command: the terminal echoed
                // `^C` and left the cursor there
                sh.intr = false
                write_fd(mut sh, 2, "\n")
            }
        } else if sh.flow == F_EXIT {
            return sh.status
        } else if sh.flow != F_NONE {
            sh.flow = F_NONE
        }
        if ended && !sh.interactive {
            break
        }
    }
    sh.status
}
