//! sh.signal — `trap` for signals, and what a signal did to a child
//! (XCU 2.12 "Signals and Error Handling", the `trap`, `kill` and `wait`
//! pages).
//!
//! References consulted: POSIX.1-2024 XCU 2.12, `trap` and `kill`;
//! wolf's `spec/11-os.md` at v0.2.29 (`[os.signal.*]`,
//! `[os.proc.status]`); black-box runs of `dash` 0.5.13.4
//! (`notes/sh14-evidence/probe/`). No shell's source.
//!
//! **No handler runs wolf code.** wolf delivers a signal as a MEANING a
//! program listens for and later takes off a queue (`os_signal_listen`,
//! `os_signal_poll`); a disposition is default, ignore or listen. So a
//! trap's action runs where POSIX says it may: after the command that
//! was running when the signal came (`poll_traps`, called after every
//! simple command, pipeline and subshell, and after a line is read at
//! the prompt).
//!
//! **A meaning is named, never written.** wolf 0.2.29 has a meaning for
//! every signal POSIX names (`[os.signal.set]`): twenty a program may
//! hear and eight it may only send. pelt names each by `std.signal`'s
//! function and by its place in one table here (`sig_meaning`,
//! `sig_name`); it writes no bit, and no signal's number: the number a
//! host gives a meaning is asked for (`signal.number`), since `USR1` is
//! 10 on linux and 30 on macOS. So `trap … 13`, `kill -9`, `kill -l`
//! and the `128 + N` of a child a signal ended all go through
//! `sig_number` and `sig_by_number`.
//!
//! **Which conditions.** `trap` catches, ignores and resets the twenty.
//! The eight wolf can only send (`KILL`, `STOP`, and the six a real
//! fault raises: `SEGV`, `BUS`, `FPE`, `ILL`, `TRAP`, `SYS`) are
//! recorded and printed back and never caught: no process can catch the
//! first two, and wolf's runtime keeps the faults for itself. A signal
//! POSIX does not name (linux's `IO`, `PWR`, `STKFLT`, the real-time
//! ones) has no meaning and is refused.
//!
//! **Ignored at start.** A signal that was ignored when the shell
//! started cannot be trapped or reset (XCU `trap`): `sig_boot` reads
//! that set (`os_signal_ignored`) before pelt first changes any
//! disposition, and `sig_apply` leaves those signals ignored whatever
//! the trap table says. The table still records the action and `trap`
//! lists it, as dash, which holds the rule for an interactive shell too
//! (black-box); so does pelt. `SIGCHLD` is the exception: it is put
//! back to its default when the shell starts (`sig_start`), and `trap
//! '' CHLD` is recorded without ignoring it, because a process that
//! ignores it cannot read its children's statuses.
//!
//! **A forked subshell** (`sh.fork`) is a process of its own: it sets its
//! caught traps back to the default and its dispositions follow; one
//! pelt runs in process (where the host does not fork, or a `( cmd )`
//! the fast path finishes) shares one set of dispositions with the shell
//! and every subshell it is running. A subshell starts with
//! its traps reset (XCU 2.12) and polls only for what it has trapped
//! itself; a signal the enclosing shell traps stays queued until that
//! shell is running again, which is when dash's parent would run its
//! action too (it is waiting for the subshell). A program pelt starts,
//! or `exec`s, begins as XSH `exec` leaves it: what pelt listens for is
//! at its default there, what pelt ignores is ignored.
//!
//! **No barrier.** Until wolf 0.2.29 a poll could trail a delivery
//! (wolf-lang#691), so pelt raised one more signal on itself and waited
//! for it after every child (`settle`). `[os.signal.poll]` now says a
//! signal delivered, or pending, before the poll began is on the queue
//! when the poll looks, so the poll after a reap is enough
//! (`tools/signal-witness`).

use std.signal

/// How many meanings a program may hear (the first of the table), and
/// how many there are.
const SIG_HEARD: int = 20

const SIG_ALL: int = 28

/// The `k`th meaning of the table: 0 to 19 can be heard, 20 to 27 only
/// sent; 0 past the end. The order is `[os.signal.set]`'s, and nothing
/// depends on it but the two counts above.
fn sig_meaning(k: int) -> int {
    match k {
        0 => signal.reload(),
        1 => signal.terminate(),
        2 => signal.quit(),
        3 => signal.upgrade(),
        4 => signal.interrupt(),
        5 => signal.suspend(),
        6 => signal.bg_read(),
        7 => signal.bg_write(),
        8 => signal.child(),
        9 => signal.user(),
        10 => signal.alarm(),
        11 => signal.broken_pipe(),
        12 => signal.abort(),
        13 => signal.continued(),
        14 => signal.resize(),
        15 => signal.urgent(),
        16 => signal.virtual_alarm(),
        17 => signal.profile_alarm(),
        18 => signal.cpu_limit(),
        19 => signal.file_limit(),
        20 => signal.kill(),
        21 => signal.stop(),
        22 => signal.segment_fault(),
        23 => signal.bus_error(),
        24 => signal.arithmetic(),
        25 => signal.illegal(),
        26 => signal.breakpoint(),
        27 => signal.bad_syscall(),
        _ => 0,
    }
}

/// The `k`th meaning's name as XCU `kill` and `trap` spell it (XBD
/// `<signal.h>` without the `SIG`); "" past the end.
fn sig_name(k: int) -> str {
    match k {
        0 => "HUP",
        1 => "TERM",
        2 => "QUIT",
        3 => "USR2",
        4 => "INT",
        5 => "TSTP",
        6 => "TTIN",
        7 => "TTOU",
        8 => "CHLD",
        9 => "USR1",
        10 => "ALRM",
        11 => "PIPE",
        12 => "ABRT",
        13 => "CONT",
        14 => "WINCH",
        15 => "URG",
        16 => "VTALRM",
        17 => "PROF",
        18 => "XCPU",
        19 => "XFSZ",
        20 => "KILL",
        21 => "STOP",
        22 => "SEGV",
        23 => "BUS",
        24 => "FPE",
        25 => "ILL",
        26 => "TRAP",
        27 => "SYS",
        _ => "",
    }
}

/// Where `name` (upper case, no `SIG`) is in the table, or -1.
fn sig_index(name: str) -> int {
    var k = 0
    while k < SIG_ALL {
        if sig_name(k) == name {
            return k
        }
        k += 1
    }
    -1
}

/// The number this host gives the `k`th meaning, or 0 for none (a host
/// with no signal numbers; `k` past the table).
fn sig_number(k: int) -> int {
    let m = sig_meaning(k)
    if m == 0 {
        return 0
    }
    signal.number(m) else 0
}

/// Where the meaning this host numbers `n` is in the table, or -1.
fn sig_by_number(n: int) -> int {
    if n <= 0 {
        return -1
    }
    var k = 0
    while k < SIG_ALL {
        if sig_number(k) == n {
            return k
        }
        k += 1
    }
    -1
}

/// A signal as a script writes it, by name in any case or by this
/// host's number: its place in the table, or -1. No `SIG` prefix, as
/// dash (XCU `kill` and `trap` make the prefix an extension).
fn sig_parse(word: str) -> int {
    if word.len == 0 {
        return -1
    }
    if is_digits(word) {
        let n = to_int(word) else -1
        return sig_by_number(n)
    }
    sig_index(word.upper())
}

/// The name `trap` records a condition under: `EXIT` (also 0), or a
/// signal's name; "" for a word that names none.
fn cond_name(word: str) -> str {
    if word.len == 0 {
        return ""
    }
    if is_digits(word) {
        let n = to_int(word) else -1
        if n == 0 {
            return "EXIT"
        }
        return sig_name(sig_by_number(n))
    }
    let up = word.upper()
    if up == "EXIT" {
        return "EXIT"
    }
    sig_name(sig_index(up))
}

/// The meanings the rest of the shell names: a hangup, the terminal's
/// interrupt and quit characters, and a resize.
fn m_hup() -> int {
    signal.reload()
}

fn m_int() -> int {
    signal.interrupt()
}

fn m_quit() -> int {
    signal.quit()
}

/// A child changed (`SIGCHLD`): a job's wait, and `set -b` at the prompt.
fn m_child() -> int {
    signal.child()
}

/// A window resized (`SIGWINCH`): the line editor draws its line again.
fn m_resize() -> int {
    signal.resize()
}

/// Whether `SIGPIPE` is ignored (by `trap '' PIPE`, or from the
/// start): a write to a pipe nobody reads then answers an error instead
/// of ending the shell, and a built-in reports it (`sh.builtin`).
fn pipe_ignored(sh: Sh) -> bool {
    sh.sig_ignore & signal.broken_pipe() != 0
}

/// `set` without the meanings in `gone`.
fn less(set: int, gone: int) -> int {
    set - (set & gone)
}

/// The first thing a shell does: `SIGCHLD` at its default. A process
/// started ignoring it never learns how its children ended (XSH
/// `wait`: the host takes their statuses), and every command would
/// answer 1; dash puts it back too (black-box), so it is the one signal
/// whose start disposition is not kept.
fn sig_start() {
    signal.reset(signal.child()) else |_| {}
}

/// The set of signals ignored when the shell started, read once, before
/// pelt first changes a disposition (`[os.signal.ignored]`: read then,
/// it is the set the process was started with); they count as ignored
/// from then on. A host that cannot say starts with none.
fn sig_boot(mut sh: Sh) {
    if sh.sig_ign0 >= 0 {
        return
    }
    sh.sig_ign0 = signal.ignored() else 0
    sh.sig_ignore = sh.sig_ignore | sh.sig_ign0
}

/// What an interactive shell does with no trap set (XCU 2.12; dash -i,
/// black-box): `SIGINT` abandons the command and prompts again, and
/// `SIGQUIT` and `SIGTERM` do nothing. pelt LISTENS for the three rather
/// than ignoring them, so its children start with the default, as
/// dash's do. One it was started ignoring stays ignored.
fn interactive_set(sh: Sh) -> int {
    if !sh.interactive {
        return 0
    }
    let three = m_int() | m_quit() | signal.terminate()
    if sh.sig_ign0 > 0 {
        return less(three, sh.sig_ign0)
    }
    three
}

/// Make the process's dispositions what the trap table says, changing
/// only what differs from what was last applied. Inside a subshell
/// nothing an enclosing shell listens for or ignores is put back to the
/// default (module doc). A signal ignored at the start is left alone.
fn sig_apply(mut sh: Sh) {
    sig_boot(mut sh)
    var listen = interactive_set(sh)
    var ignore = 0
    var mine = listen
    if sh.traps.len > 0 {
        var k = 0
        while k < SIG_HEARD {
            let c = sig_name(k)
            if has_trap(sh, c) {
                let m = sig_meaning(k)
                // a trap of a forked child's own ends what it held
                // ignored for that meaning (`sh.fork`)
                sh.hold_ign = less(sh.hold_ign, m)
                let action = sh.traps[c] else ""
                if action.len == 0 {
                    // `trap '' CHLD` is recorded and no more: the
                    // default already does nothing to the shell, and a
                    // host that is told to ignore it keeps the
                    // children's statuses from `wait` (dash leaves it
                    // alone too, black-box)
                    if m != signal.child() {
                        ignore = ignore | m
                    }
                    listen = less(listen, m)
                    mine = less(mine, m)
                } else {
                    listen = listen | m
                    mine = mine | m
                }
            }
            k += 1
        }
    }
    // job control (`sh.jobs`): `CHILD` heard for the waits, and the
    // three stop signals ignored for the shell itself unless trapped
    if sh.jc_child {
        listen = listen | signal.child()
    }
    if sh.jc_ign != 0 {
        ignore = ignore | less(sh.jc_ign, listen)
    }
    // what a forked child holds ignored (`sh.fork`): INT and QUIT after
    // `&` with job control off, TSTP and TTOU in a command substitution
    // under job control (dash, black-box)
    if sh.hold_ign != 0 {
        ignore = ignore | less(sh.hold_ign, listen)
    }
    if sh.sub > 0 {
        listen = listen | less(sh.sig_listen, ignore)
        ignore = ignore | less(sh.sig_ignore, listen)
    }
    listen = less(listen, sh.sig_ign0)
    mine = less(mine, sh.sig_ign0)
    ignore = ignore | sh.sig_ign0
    let quiet = less(sh.sig_listen, listen)
    let to_default = less(sh.sig_listen | sh.sig_ignore, listen | ignore)
    let to_ignore = less(ignore, sh.sig_ignore)
    let to_listen = less(listen, sh.sig_listen)
    if to_default != 0 {
        signal.reset(to_default) else |_| {}
    }
    if to_ignore != 0 {
        signal.ignore(to_ignore) else |_| {}
    }
    if to_listen != 0 {
        signal.listen(to_listen) else |_| {}
    }
    // a delivery taken before the listen ended is nobody's now
    if quiet != 0 {
        loop {
            let got = signal.poll(quiet) else 0
            if got == 0 {
                break
            }
        }
    }
    sh.sig_listen = listen
    sh.sig_ignore = ignore
    sh.sig_mine = mine
}

fn has_trap(sh: Sh, cond: str) -> bool {
    let _a = sh.traps[cond] else {
        return false
    }
    true
}

/// Take every delivered signal this shell handles off the queue and run
/// its action: `$?` is the same after the action as before it (XCU
/// `trap`), unless the action leaves by `exit`, `return`, `break` or
/// `continue`. With no action (an interactive shell's own three),
/// `SIGINT` abandons the command being run and the others do nothing.
///
/// Signals that are waiting together run in the order of their
/// numbers, as dash runs them (black-box: `HUP USR1 USR2 ALRM TERM
/// WINCH` whatever order they were sent in), not in the order their
/// deliveries happened to land. So everything waiting is taken first,
/// then served lowest number first; one that comes while an action
/// runs is served by the action's own commands (dash runs it there
/// too) or by the next turn of the loop. An action that leaves by
/// `break`, `continue` or `return` does not stop the others that were
/// waiting with it: they run, and then the loop or function is left
/// (dash, black-box: `signal/trap_break_keeps_pending`). One that
/// leaves by `exit` ends the serving, and what was taken and not
/// served goes back on the queue (an enclosing shell may be the one
/// listening).
fn poll_traps(mut sh: Sh) {
    if sh.sig_mine == 0 || sh.shadow {
        return
    }
    loop {
        if sh.flow != F_NONE {
            return
        }
        var taken = take_waiting(sh.sig_mine)
        if sh.chld_owed {
            // a `CHILD` a job's wait took (`sh.jobs`'s `jc_wait`)
            taken = taken | signal.child()
            sh.chld_owed = false
        }
        if taken == 0 {
            return
        }
        var held = F_NONE
        var held_n = 0
        while taken != 0 {
            let k = lowest_numbered(taken)
            if k < 0 {
                break
            }
            let m = sig_meaning(k)
            taken = less(taken, m)
            let action = sh.traps[sig_name(k)] else ""
            if action.len == 0 {
                // at the prompt there is no command to abandon
                if m == m_int() && sh.interactive && !sh.at_prompt {
                    interrupt(mut sh)
                    give_back(sh, taken)
                    return
                }
                continue
            }
            run_trap_action(mut sh, action)
            if sh.flow == F_EXIT {
                give_back(sh, taken)
                return
            }
            if sh.flow != F_NONE {
                held = sh.flow
                held_n = sh.flow_n
                sh.flow = F_NONE
            }
        }
        if held != F_NONE {
            sh.flow = held
            sh.flow_n = held_n
            return
        }
    }
}

/// Every delivered meaning in `set`, taken off the queue.
fn take_waiting(set: int) -> int {
    var taken = 0
    loop {
        let got = signal.poll(set) else 0
        if got == 0 {
            break
        }
        taken = taken | got
    }
    taken
}

/// The place in the table of the meaning in `set` with the lowest
/// signal number, or -1 for an empty set.
fn lowest_numbered(set: int) -> int {
    var best = -1
    var best_n = 0
    var k = 0
    while k < SIG_HEARD {
        if set & sig_meaning(k) != 0 {
            let n = sig_number(k)
            if best < 0 || n < best_n {
                best = k
                best_n = n
            }
        }
        k += 1
    }
    best
}

/// Signals taken off the queue and not served (the action before them
/// left by `exit`, `break`, …) go back on it, each one the shell still
/// listens for.
fn give_back(sh: Sh, taken: int) {
    if taken == 0 {
        return
    }
    var k = 0
    while k < SIG_HEARD {
        let m = sig_meaning(k)
        if taken & m != 0 && sh.sig_listen & m != 0 {
            signal.raise(m) else |_| {}
        }
        k += 1
    }
}

/// Run a trap's action as XCU `trap` says: `$?` is the same after it as
/// before, unless the action leaves by `exit`, `return`, `break` or
/// `continue` (then `sh.flow` says so). An action may itself be
/// interrupted by another trapped signal, whose action then runs
/// inside it (dash, black-box).
fn run_trap_action(mut sh: Sh, action: str) {
    let saved = sh.status
    let line = sh.line
    let was_in = sh.in_trap
    let was_status = sh.trap_status
    sh.in_trap = true
    sh.trap_status = saved
    let _st = eval_string(mut sh, action, "trap")
    sh.in_trap = was_in
    sh.trap_status = was_status
    sh.line = line
    if sh.flow != F_NONE {
        return
    }
    sh.status = saved
}

/// Ctrl-C with no trap, in an interactive shell: the command is
/// abandoned with `SIGINT`'s status, through every in-process subshell,
/// back to the prompt (`sh.interact`).
fn interrupt(mut sh: Sh) {
    sh.status = int_status()
    sh.flow = F_EXIT
    sh.flow_n = 0
    sh.abort = true
    sh.intr = true
}

/// `$?` after an interrupt: 128 plus `SIGINT`'s number on this host.
fn int_status() -> int {
    128 + (signal.number(m_int()) else 0)
}

/// A subshell or a command substitution ends: an interrupt goes on
/// unwinding through it.
fn pass_interrupt(mut sh: Sh) {
    if sh.intr {
        sh.status = int_status()
        sh.flow = F_EXIT
        sh.flow_n = 0
        sh.abort = true
    }
}

// ------------------------------------------------------ a child's ending

/// A child's status from `os_wait_status` (`[os.proc.status]`): its exit
/// code, or `128 + N` when signal N ended it (XCU 2.8.2), and N (0 when
/// it exited).
fn status_of(raw: int) -> (int, int) {
    if raw < 0 {
        return (128 - raw, 0 - raw)
    }
    (raw, 0)
}

/// Whether the shell says anything about a child signal `n` ended.
/// Nothing for `SIGINT` (the user did it) or `SIGPIPE` (the reader
/// left), as dash, black-box.
fn signal_spoken(n: int) -> bool {
    if n <= 0 {
        return false
    }
    let int_n = signal.number(m_int()) else 0
    let pipe_n = signal.number(signal.broken_pipe()) else 0
    n != int_n && n != pipe_n
}

/// pelt's own words for a death by signal `n`: the number, and the
/// signal's name when wolf has one for it.
fn signal_words(n: int) -> str {
    let name = sig_name(sig_by_number(n))
    if name.len > 0 {
        return "ended by signal {n} ({name})"
    }
    "ended by signal {n}"
}

/// Say that signal `n` ended a child, on descriptor 2, without the
/// script's name and line: it is about the child, not a line of the
/// script.
fn report_signal(mut sh: Sh, n: int) {
    if signal_spoken(n) {
        write_fd(mut sh, 2, "pelt: {signal_words(n)}\n")
    }
}
