//! sh.text — byte-level helpers every other file leans on.
//!
//! References consulted: none beyond the wolf guide; nothing here is
//! shell behaviour.
//!
//! A `str` is read a byte at a time through `s.bytes()[i]`, a zero-copy
//! view when consumed on the spot, and turned into a `char` so that the
//! lexer can `match` on literals. Every byte pelt cares about is ASCII,
//! so a byte above 127 is just "some other character" to every caller.
//! Strings are BUILT in a `Buf` (a `List[byte]`), never by `+=`, which
//! copies the whole accumulator each time.

/// The byte at `i` as a `char`, or `'\0'` past either end.
fn ch(s: str, i: int) -> char {
    if i < 0 || i >= s.len {
        return '\0'
    }
    s.bytes()[i] as int as char
}

/// The byte at `i` as an `int`, or -1 past either end.
fn byte_at(s: str, i: int) -> int {
    if i < 0 || i >= s.len {
        return -1
    }
    s.bytes()[i] as int
}

struct Buf {
    b: List[byte],
}

fn buf() -> Buf {
    Buf { b: List[byte]() }
}

fn put(mut o: Buf, s: str) {
    for x in s.bytes() {
        (mut o.b).push(x)
    }
}

/// Append one ASCII character.
fn putc(mut o: Buf, c: char) {
    (mut o.b).push(c as int as byte)
}

/// Append one byte given as an int in 0..=255.
fn putb(mut o: Buf, n: int) {
    (mut o.b).push(n as byte)
}

/// Append the bytes of `s` in `a..b`.
fn put_range(mut o: Buf, s: str, a: int, b: int) {
    var i = a
    while i < b {
        (mut o.b).push(s.bytes()[i])
        i += 1
    }
}

/// The buffer as a `str`. Every byte pelt writes came from a `str` or
/// is ASCII, and every cut is at an ASCII byte, so the bytes are UTF-8;
/// if they are not, each byte above 127 becomes `?` rather than the
/// whole text vanishing.
fn text(o: Buf) -> str {
    let s = str_from_utf8(o.b) else |_| {
        var fixed = List[byte]()
        for x in o.b {
            if x as int > 127 {
                (mut fixed).push(63 as byte)
            } else {
                (mut fixed).push(x)
            }
        }
        return str_from_utf8(fixed) else ""
    }
    s
}

fn is_digit(c: char) -> bool {
    c >= '0' && c <= '9'
}

fn is_alpha(c: char) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

fn is_alnum(c: char) -> bool {
    is_alpha(c) || is_digit(c)
}

/// A NAME in the sense of XBD 3.216: a letter or underscore, then
/// letters, digits and underscores.
fn is_name(s: str) -> bool {
    if s.len == 0 || !is_alpha(ch(s, 0)) {
        return false
    }
    var i = 1
    while i < s.len {
        if !is_alnum(ch(s, i)) {
            return false
        }
        i += 1
    }
    true
}

/// A string of decimal digits, at least one.
fn is_digits(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    var i = 0
    while i < s.len {
        if !is_digit(ch(s, i)) {
            return false
        }
        i += 1
    }
    true
}

/// `s` with every `\n` written as the two characters `\n` (and the
/// same for tab and backslash), for the `--parse` dump.
fn escaped(s: str) -> str {
    var o = buf()
    var i = 0
    while i < s.len {
        let c = ch(s, i)
        if c == '\n' {
            put(mut o, "\\n")
        } else if c == '\t' {
            put(mut o, "\\t")
        } else if c == '\\' {
            put(mut o, "\\\\")
        } else if c == '"' {
            put(mut o, "\\\"")
        } else if c as int < 32 {
            put(mut o, "\\x{hex2(c as int)}")
        } else {
            putb(mut o, byte_at(s, i))
        }
        i += 1
    }
    text(o)
}

fn hex2(n: int) -> str {
    let digits = "0123456789abcdef"
    "{digits[n / 16..n / 16 + 1]}{digits[n % 16..n % 16 + 1]}"
}

/// A decimal integer from `s`, optional leading `-` or `+`; the
/// `parse` row when there is anything else, or when it overflows.
fn to_int(s: str) -> int ! {parse} {
    if s.len == 0 {
        return parse
    }
    var i = 0
    var neg = false
    if ch(s, 0) == '-' || ch(s, 0) == '+' {
        neg = ch(s, 0) == '-'
        i = 1
    }
    if i >= s.len {
        return parse
    }
    var n: int = 0
    while i < s.len {
        let c = ch(s, i)
        if !is_digit(c) {
            return parse
        }
        let d: int = c as int - 48
        if n > (9223372036854775807 - d) / 10 {
            if neg && n == 922337203685477580 && d == 8 && i == s.len - 1 {
                return -9223372036854775807 - 1
            }
            return parse
        }
        n = n * 10 + d
        i += 1
    }
    if neg {
        return -n
    }
    n
}
