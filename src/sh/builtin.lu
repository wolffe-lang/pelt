//! sh.builtin — the special built-ins (XCU 2.15 of 2024, "Special
//! Built-In Utilities") and the regular built-ins pelt carries.
//!
//! References consulted: POSIX.1-2024 XCU 2.15 and the utility pages of
//! `cd`, `command`, `echo`, `false`, `getopts`, `pwd`, `read`, `test`,
//! `true`, `wait`; the `dash(1)` manual for `echo` (dash's echo interprets
//! backslash escapes, the XSI form) and `local`; black-box runs of
//! `dash` 0.5.13.4 for statuses and what each prints. The messages are
//! pelt's own.
//!
//! An error in a special built-in ends a non-interactive shell (XCU
//! 2.8.1); in a regular one it is only a status.

fn args_of(fields: List[str]) -> List[str] {
    var out = List[str]()
    var i = 1
    while i < fields.len {
        (mut out).push(fields[i])
        i += 1
    }
    out
}

fn builtin(mut sh: Sh, fields: List[str]) -> int {
    builtin_args(mut sh, fields[0], args_of(fields))
}

/// `builtin` with the name and the arguments apart: the ordinary path's
/// lean call (`sh.exec`'s `run_builtin_enc`) hands its arguments in a
/// list from the state's pool, so no `args_of` copy is made (pelt#33).
fn builtin_args(mut sh: Sh, name: str, args: List[str]) -> int {
    var st = 0
    if name == ":" || name == "true" {
        st = 0
    } else if name == "false" {
        st = 1
    } else if name == "echo" {
        st = bi_echo(mut sh, args)
    } else if name == "printf" {
        st = bi_printf(mut sh, args)
    } else if name == "test" {
        st = bi_test(mut sh, args)
    } else if name == "[" {
        if args.len == 0 || args[args.len - 1] != "]" {
            diag(mut sh, "[: missing ]")
            st = 2
        } else {
            st = bi_test(mut sh, args[0..args.len - 1])
        }
    } else if name == "exit" {
        st = bi_exit(mut sh, args)
    } else if name == "return" {
        st = bi_return(mut sh, args)
    } else if name == "break" || name == "continue" {
        st = bi_break(mut sh, name, args)
    } else if name == "set" {
        st = bi_set(mut sh, args)
        jc_sync(mut sh)
    } else if name == "shift" {
        st = bi_shift(mut sh, args)
    } else if name == "export" || name == "readonly" {
        st = bi_export(mut sh, name, args)
    } else if name == "unset" {
        st = bi_unset(mut sh, args)
    } else if name == "eval" {
        st = bi_eval(mut sh, args)
    } else if name == "." {
        st = bi_dot(mut sh, args)
    } else if name == "exec" {
        st = bi_exec(mut sh, args)
    } else if name == "trap" {
        st = bi_trap(mut sh, args)
    } else if name == "times" {
        emit(mut sh, "0m0.000s 0m0.000s\n0m0.000s 0m0.000s\n")
    } else if name == "pwd" {
        st = bi_pwd(mut sh, args)
    } else if name == "cd" {
        st = bi_cd(mut sh, args)
    } else if name == "command" {
        st = bi_command(mut sh, args)
    } else if name == "read" {
        st = bi_read(mut sh, args)
    } else if name == "local" {
        st = bi_local(mut sh, args)
    } else if name == "getopts" {
        st = bi_getopts(mut sh, args)
    } else if name == "wait" {
        st = bi_wait(mut sh, args)
    } else if name == "umask" {
        st = bi_umask(mut sh, args)
    } else if name == "kill" {
        st = bi_kill(mut sh, args)
    } else if name == "fc" {
        st = bi_fc(mut sh, args)
    } else if name == "type" {
        st = bi_type(mut sh, args)
    } else if name == "hash" {
        st = bi_hash(mut sh, args)
    } else if name == "alias" {
        st = bi_alias(mut sh, args)
    } else if name == "unalias" {
        st = bi_unalias(mut sh, args)
    } else if name == "jobs" {
        st = bi_jobs(mut sh, args)
    } else if name == "fg" {
        st = bi_fg(mut sh, args)
    } else if name == "bg" {
        st = bi_bg(mut sh, args)
    }
    if sh.out.len > 0 && fd_get(sh, 1) == FD_CLOSED {
        // output to a closed descriptor is a write error (dash: status 1)
        (mut sh.out).clear()
        diag(mut sh, "{name}: write error: bad file descriptor")
        st = 1
    } else if sh.out.len > 0 && pipe_ignored(sh) && !flush_checked(mut sh) {
        // with `trap '' PIPE` a write to a pipe nobody reads is this
        // command's error, where the default would have ended the
        // shell (XSH `write`: EPIPE; dash: status 1)
        diag(mut sh, "{name}: write error")
        st = 1
    }
    if sh.flow == F_NONE || sh.flow == F_EXIT {
        if sh.flow == F_NONE {
            sh.status = st
        }
    }
    st
}

fn bi_exit(mut sh: Sh, args: List[str]) -> int {
    var code = sh.status
    if sh.in_trap {
        // in a trap action, `exit` with no operand leaves with the
        // status the action began with (XCU `exit`)
        code = sh.trap_status
    }
    if args.len > 0 {
        code = to_int(args[0]) else |_| {
            fatal(mut sh, "exit: {args[0]}: not a number", 2)
            return 2
        }
    }
    if sh.jc_on && sh.interactive && sh.sub == 0 && !sh.exit_warned_prev && jobs_stopped(sh) {
        // XCU 2.11: a stopped job keeps an interactive shell for one
        // more `exit`; the next line's `exit` leaves (dash, black-box:
        // p07, p08). The table is read as it stands, not polled first,
        // as dash reads it (c_jc_ctrl_z)
        write_fd(mut sh, 2, "pelt: there are stopped jobs\n")
        sh.exit_warned = true
        return sh.status
    }
    sh.status = code & 255
    sh.flow = F_EXIT
    sh.abort = false
    sh.status
}

fn bi_return(mut sh: Sh, args: List[str]) -> int {
    var code = sh.status
    if args.len > 0 {
        code = to_int(args[0]) else |_| {
            fatal(mut sh, "return: {args[0]}: not a number", 2)
            return 2
        }
    }
    sh.status = code & 255
    if sh.fdepth == 0 && sh.dots == 0 {
        // outside a function or a dot script: dash ends the shell
        sh.flow = F_EXIT
        sh.abort = false
        return sh.status
    }
    sh.flow = F_RETURN
    sh.status
}

fn bi_break(mut sh: Sh, name: str, args: List[str]) -> int {
    var n = 1
    if args.len > 0 {
        n = to_int(args[0]) else |_| {
            fatal(mut sh, "{name}: {args[0]}: not a number", 2)
            return 2
        }
        if n < 1 {
            fatal(mut sh, "{name}: {args[0]}: out of range", 2)
            return 2
        }
    }
    if sh.loops == 0 {
        return 0
    }
    if n > sh.loops {
        n = sh.loops
    }
    sh.flow = if name == "break" then F_BREAK else F_CONTINUE
    sh.flow_n = n
    0
}

fn bi_shift(mut sh: Sh, args: List[str]) -> int {
    var n = 1
    if args.len > 0 {
        n = to_int(args[0]) else |_| {
            fatal(mut sh, "shift: {args[0]}: not a number", 2)
            return 2
        }
    }
    if n < 0 || n > sh.pos.len {
        fatal(mut sh, "shift: {n}: more than the {sh.pos.len} positional parameters", 2)
        return 2
    }
    shift_pos(mut sh, n)
    0
}

/// `$@` loses its first `n`, in place: the list the state keeps, not a
/// fresh one.
fn shift_pos(mut sh: Sh, n: int) {
    var k = 0
    while k + n < sh.pos.len {
        sh.pos[k] = sh.pos[k + n]
        k += 1
    }
    k = 0
    while k < n {
        let _p = (mut sh.pos).pop() else ""
        k += 1
    }
}

/// `set` with no operands: every variable, sorted, quoted for reinput.
fn print_vars(mut sh: Sh) {
    for k in sort_strs(sh.vals.keys()) {
        emit(mut sh, "{k}={squote(sh.vals[k] else "")}\n")
    }
}

fn option_letter(mut sh: Sh, c: char, on: bool) -> bool {
    if c == 'e' {
        sh.opt_e = on
    } else if c == 'u' {
        sh.opt_u = on
    } else if c == 'x' {
        sh.opt_x = on
    } else if c == 'f' {
        sh.opt_f = on
    } else if c == 'n' {
        sh.opt_n = on
    } else if c == 'v' {
        sh.opt_v = on
    } else if c == 'a' {
        sh.opt_a = on
    } else if c == 'C' {
        sh.opt_bigc = on
    } else if c == 'm' {
        // job control (`sh.jobs`): takes effect when `set` is done
        sh.opt_m = on
    } else if c == 'b' {
        sh.opt_b = on
    } else if c == 'h' {
        // hashing: the command search always remembers (`hash`)
    } else {
        return false
    }
    true
}

fn option_name(mut sh: Sh, name: str, on: bool) -> bool {
    if name == "errexit" {
        return option_letter(mut sh, 'e', on)
    }
    if name == "nounset" {
        return option_letter(mut sh, 'u', on)
    }
    if name == "xtrace" {
        return option_letter(mut sh, 'x', on)
    }
    if name == "noglob" {
        return option_letter(mut sh, 'f', on)
    }
    if name == "noexec" {
        return option_letter(mut sh, 'n', on)
    }
    if name == "verbose" {
        return option_letter(mut sh, 'v', on)
    }
    if name == "allexport" {
        return option_letter(mut sh, 'a', on)
    }
    if name == "noclobber" {
        return option_letter(mut sh, 'C', on)
    }
    // the editing modes (XCU `sh`: `set -o vi` turns any other off)
    if name == "vi" {
        sh.opt_vi = on
        if on {
            sh.opt_emacs = false
        }
        return true
    }
    if name == "emacs" {
        sh.opt_emacs = on
        if on {
            sh.opt_vi = false
        }
        return true
    }
    if name == "pipefail" {
        sh.opt_pipefail = on
        return true
    }
    // pelt's own (ruling #113): bash's `shopt -s autocd`, zsh's AUTO_CD
    // (`run_autocd`)
    if name == "autocd" {
        sh.opt_autocd = on
        return true
    }
    if name == "monitor" {
        return option_letter(mut sh, 'm', on)
    }
    if name == "notify" {
        return option_letter(mut sh, 'b', on)
    }
    name == "ignoreeof" || name == "nolog"
}

fn print_options(mut sh: Sh, reinput: bool) {
    let names = [
        "allexport",
        "autocd",
        "emacs",
        "errexit",
        "noclobber",
        "noexec",
        "noglob",
        "nounset",
        "pipefail",
        "verbose",
        "vi",
        "xtrace",
    ]
    // a letter for the options `$-` shows; '-' for the editing modes
    let letters = ['a', '-', '-', 'e', 'C', 'n', 'f', 'u', '-', 'v', '-', 'x']
    let flags = dash_flags(sh)
    var i = 0
    while i < names.len {
        var on = (flags.find("{letters[i]}") else -1) >= 0
        if names[i] == "emacs" {
            on = sh.opt_emacs
        } else if names[i] == "vi" {
            on = sh.opt_vi
        } else if names[i] == "pipefail" {
            on = sh.opt_pipefail
        } else if names[i] == "autocd" {
            on = sh.opt_autocd
        }
        if reinput {
            emit(mut sh, "set {if on then "-o" else "+o"} {names[i]}\n")
        } else {
            emit(mut sh, "{names[i]}\t{if on then "on" else "off"}\n")
        }
        i += 1
    }
}

/// `set` (XCU 2.15): options and the positional parameters.
fn bi_set(mut sh: Sh, args: List[str]) -> int {
    if args.len == 0 {
        print_vars(mut sh)
        return 0
    }
    var i = 0
    while i < args.len {
        let a = args[i]
        if a == "--" {
            i += 1
            set_pos(mut sh, args, i)
            return 0
        }
        if a == "-" {
            sh.opt_x = false
            sh.opt_v = false
            i += 1
            break
        }
        let c0 = ch(a, 0)
        if (c0 == '-' || c0 == '+') && a.len > 1 {
            let on = c0 == '-'
            if a.len == 2 && ch(a, 1) == 'o' {
                if i + 1 >= args.len {
                    print_options(mut sh, !on)
                    i += 1
                    continue
                }
                if !option_name(mut sh, args[i + 1], on) {
                    fatal(mut sh, "set: {args[i + 1]}: no such option", 2)
                    return 2
                }
                i += 2
                continue
            }
            // letters in one cluster; an `o` among them takes the next
            // operand as an option's name (`set -euo pipefail`, as dash)
            var taken = 0
            var k = 1
            while k < a.len {
                if ch(a, k) == 'o' {
                    if i + 1 + taken >= args.len {
                        print_options(mut sh, !on)
                    } else {
                        let oname = args[i + 1 + taken]
                        if !option_name(mut sh, oname, on) {
                            fatal(mut sh, "set: {oname}: no such option", 2)
                            return 2
                        }
                        taken += 1
                    }
                } else if !option_letter(mut sh, ch(a, k), on) {
                    fatal(mut sh, "set: -{ch(a, k)}: no such option", 2)
                    return 2
                }
                k += 1
            }
            i += 1 + taken
            continue
        }
        break
    }
    if i < args.len {
        set_pos(mut sh, args, i)
    }
    0
}

/// `$@` becomes `args[from..]`, written into the list the state keeps.
fn set_pos(mut sh: Sh, args: List[str], from: int) {
    (mut sh.pos).clear()
    var k = from
    while k < args.len {
        (mut sh.pos).push(args[k])
        k += 1
    }
}

/// `export` and `readonly`, including `-p`.
fn bi_export(mut sh: Sh, name: str, args: List[str]) -> int {
    let ro = name == "readonly"
    if args.len == 0 || args.len == 1 && args[0] == "-p" {
        for k in sort_strs(sh.vals.keys()) {
            let marked = if ro then is_ronly(sh, k) else is_exported(sh, k)
            if marked {
                emit(mut sh, "{name} {k}={squote(sh.vals[k] else "")}\n")
            }
        }
        if !ro {
            for k in sort_strs(sh.exported.keys()) {
                if !has_var(sh, k) && (sh.exported[k] else false) {
                    emit(mut sh, "{name} {k}\n")
                }
            }
        }
        return 0
    }
    for a in args {
        let eq = a.find("=") else -1
        let vname = if eq >= 0 then a[0..eq] else a
        if !is_name(vname) {
            fatal(mut sh, "{name}: {vname}: not a valid name", 2)
            return 2
        }
        if eq >= 0 {
            if !set_var(mut sh, vname, a[eq + 1..a.len]) {
                fatal(mut sh, "{vname}: is read-only", 2)
                return 2
            }
        }
        if ro {
            rset(mut sh, vname)
        } else {
            xset(mut sh, vname, true)
        }
    }
    0
}

fn bi_unset(mut sh: Sh, args: List[str]) -> int {
    var funcs = false
    var i = 0
    while i < args.len && ch(args[i], 0) == '-' {
        if args[i] == "-f" {
            funcs = true
        } else if args[i] == "-v" {
            funcs = false
        } else if args[i] == "--" {
            i += 1
            break
        } else {
            fatal(mut sh, "unset: {args[i]}: no such option", 2)
            return 2
        }
        i += 1
    }
    while i < args.len {
        let n = args[i]
        if funcs {
            fndel(mut sh, n)
        } else if !unset_var(mut sh, n) {
            fatal(mut sh, "unset: {n}: is read-only", 2)
            return 2
        }
        i += 1
    }
    0
}

fn join_args(args: List[str]) -> str {
    if args.len == 1 {
        // one operand is its own text: nothing built (pelt#39)
        return args[0]
    }
    var o = buf()
    var k = 0
    for a in args {
        if k > 0 {
            putc(mut o, ' ')
        }
        put(mut o, a)
        k += 1
    }
    text(o)
}

fn bi_eval(mut sh: Sh, args: List[str]) -> int {
    if args.len == 0 {
        return 0
    }
    let line = sh.line
    let st = eval_string(mut sh, join_args(args), "eval")
    sh.line = line
    st
}

/// Everything a file holds, read to its end through one handle: a
/// regular file, `/dev/null` (nothing), a FIFO (whatever its writer
/// sends until it closes; the open waits for a writer, as dash's does),
/// a terminal. The `utf8` row for a file that is not UTF-8 (W06).
fn read_all(path: str) -> str ! {io, utf8} {
    let h = fs_open(path) else |_| { return io }
    var bytes = List[byte]()
    loop {
        let c = fs_read_chunk(h, 65536) else |e| match e {
            eof => { break },
            io => {
                fs_close(h) else |_| {}
                return io
            },
        }
        for x in c {
            (mut bytes).push(x)
        }
    }
    fs_close(h) else |_| {}
    str_from_utf8(bytes) else |_| { return utf8 }
}

/// `.` (XCU 2.15): a name without `/` is looked for in `PATH`. Any file
/// that is not a directory is read: `. /dev/null` is an empty script
/// (pfetch writes `. "${PF_SOURCE:-/dev/null}"`), and a FIFO is read
/// until its writer closes it.
fn bi_dot(mut sh: Sh, args: List[str]) -> int {
    if args.len == 0 {
        fatal(mut sh, ".: a file name is required", 2)
        return 2
    }
    var path = args[0]
    if (path.find("/") else -1) < 0 {
        path = find_readable_in_path(sh, path)
    }
    let st = stat_of(path, false)
    if st.len == 0 {
        fatal(mut sh, ".: {args[0]}: not found", 2)
        return 2
    }
    if st[0] == K_DIR {
        fatal(mut sh, ".: {args[0]}: is a directory", 2)
        return 2
    }
    let src = read_all(path) else |_| {
        fatal(mut sh, ".: {args[0]}: cannot read", 2)
        return 2
    }
    let line = sh.line
    sh.dots += 1
    var st = eval_string(mut sh, src, path)
    sh.dots -= 1
    if sh.flow == F_RETURN {
        sh.flow = F_NONE
        st = sh.status
    }
    sh.line = line
    st
}

/// `exec` reached through `command`: the simple-command path
/// (`sh.exec`'s `run_slow`) takes `exec` itself before it gets here,
/// with its redirections and assignments.
fn bi_exec(mut sh: Sh, args: List[str]) -> int {
    if args.len == 0 {
        return 0
    }
    var fields = List[str]()
    (mut fields).push("exec")
    for a in args {
        (mut fields).push(a)
    }
    run_exec(mut sh, fields, List[str](), List[str](), List[Rd]())
}

/// `trap` (XCU `trap`): a condition is `EXIT` (or 0) or a signal, by
/// its name in any case or by this host's number (`sh.signal`'s
/// `cond_name`). The twenty signals wolf can hear are caught, ignored
/// or put back to the default; the eight it can only send are recorded
/// and printed back and that is all. With no operand the traps are
/// printed, `EXIT` first and then in the order of the signals'
/// numbers, as dash prints them. A lone operand that names a condition
/// resets it, and so does a first operand that is a number (`trap 1
/// 2`), as dash.
fn bi_trap(mut sh: Sh, args: List[str]) -> int {
    if args.len == 0 {
        print_traps(mut sh)
        return 0
    }
    var i = 0
    if args[0] == "--" {
        i = 1
    }
    if i >= args.len {
        return 0
    }
    var action = args[i]
    var reset = action == "-"
    var conds = args[i + 1..args.len]
    if is_digits(action) && cond_name(action).len > 0 {
        reset = true
        conds = args[i..args.len]
    } else if conds.len == 0 && cond_name(action).len > 0 {
        reset = true
        conds = args[i..args.len]
    }
    var st = 0
    for c in conds {
        let n = cond_name(c)
        if n.len == 0 {
            diag(mut sh, "trap: {c}: no such condition")
            st = 1
            continue
        }
        if reset {
            tdel(mut sh, n)
        } else {
            tset(mut sh, n, action)
        }
    }
    sig_apply(mut sh)
    st
}

/// Every trap as a `trap` command that sets it again: `EXIT`, then the
/// signals lowest number first.
fn print_traps(mut sh: Sh) {
    if sh.traps.len == 0 {
        return
    }
    if has_trap(sh, "EXIT") {
        emit(mut sh, "trap -- {squote(sh.traps["EXIT"] else "")} EXIT\n")
    }
    var last = 0
    loop {
        var best = -1
        var best_n = 0
        var k = 0
        while k < SIG_ALL {
            if has_trap(sh, sig_name(k)) {
                let n = sig_number(k)
                if n > last && (best < 0 || n < best_n) {
                    best = k
                    best_n = n
                }
            }
            k += 1
        }
        if best < 0 {
            break
        }
        let c = sig_name(best)
        emit(mut sh, "trap -- {squote(sh.traps[c] else "")} {c}\n")
        last = best_n
    }
}

fn bi_pwd(mut sh: Sh, args: List[str]) -> int {
    var physical = false
    for a in args {
        if a == "-P" {
            physical = true
        } else if a == "-L" {
            physical = false
        }
    }
    var dir = value_of(sh, "PWD")
    if physical || dir.len == 0 || ch(dir, 0) != '/' {
        dir = os_cwd() else |_| {
            diag(mut sh, "pwd: cannot read the working directory")
            return 1
        }
    }
    emit(mut sh, "{dir}\n")
    0
}

/// `command [-p] [-v|-V] name [arg…]` (XCU `command`): `-v` writes
/// how the name would be run, `-V` says it as `type` does, `-p` searches
/// a default `PATH` that finds the standard utilities (and remembers
/// nothing: dash, black-box). Only the first name is answered, as dash.
fn bi_command(mut sh: Sh, args: List[str]) -> int {
    var i = 0
    var show = false
    var say = false
    var std_path = false
    while i < args.len && ch(args[i], 0) == '-' && args[i].len > 1 {
        let a = args[i]
        if a == "--" {
            i += 1
            break
        }
        var k = 1
        while k < a.len {
            let c = ch(a, k)
            if c == 'v' {
                show = true
            } else if c == 'V' {
                say = true
            } else if c == 'p' {
                std_path = true
            } else {
                diag(mut sh, "command: -{c}: no such option")
                return 2
            }
            k += 1
        }
        i += 1
    }
    if i >= args.len {
        return 0
    }
    let name = args[i]
    let via = if std_path then default_path() else ""
    if say {
        return type_one(mut sh, name, via)
    }
    if show {
        return show_one(mut sh, name, via)
    }
    if is_special_builtin(name) || is_regular_builtin(name) {
        // the built-in's operands in a list from the state's pool, given
        // back cleared: no slice, no `args_of` copy (pelt#39)
        var sub = (mut sh.argpool).pop() else List[str]()
        (mut sub).clear()
        var k = i + 1
        while k < args.len {
            (mut sub).push(args[k])
            k += 1
        }
        let st = builtin_args(mut sh, name, sub)
        (mut sub).clear()
        (mut sh.argpool).push(take sub)
        return st
    }
    // the utility, never a function: no `command_not_found_handle`
    let rest = args[i..args.len]
    run_external(mut sh, rest, List[str](), List[str](), false, via, false)
}

/// Where a name the command search reaches would be found: through the
/// table, or (`via` not "") in `via` alone.
fn search_for(mut sh: Sh, name: str, via: str) -> str {
    if via.len > 0 {
        return find_in(mut sh, via, name)
    }
    hash_find(mut sh, name)
}

/// Whether `path` names a regular file this shell may execute.
fn may_run(mut sh: Sh, path: str) -> bool {
    let st = stat_of(path, false)
    st.len > 0 && st[0] == K_FILE && may(mut sh, st, 1)
}

/// `command -v name`: the name of a reserved word, a built-in or a
/// function, an alias as the `alias` command that makes it, or the
/// path of a program; 127 for none (a file with a `/` must be one this
/// shell may execute).
fn show_one(mut sh: Sh, name: str, via: str) -> int {
    if !is_reserved(name) && alias_set(sh, name) {
        emit(mut sh, "alias {squote("{name}={sh.ast.aliases[name] else ""}")}\n")
        return 0
    }
    if sh.funcs.has(name) ||
        is_special_builtin(name) ||
        is_regular_builtin(name) ||
        is_reserved(name) {
        emit(mut sh, "{name}\n")
        return 0
    }
    if (name.find("/") else -1) >= 0 {
        if may_run(mut sh, name) {
            emit(mut sh, "{name}\n")
            return 0
        }
        return 127
    }
    let p = search_for(mut sh, name, via)
    if p.len == 0 {
        return 127
    }
    emit(mut sh, "{p}\n")
    0
}

/// `type name` and `command -V name` (XCU `type`): one line on standard
/// output saying how the name would be interpreted as a command, in
/// pelt's words; a name that is none is said there too (dash), with
/// 127.
fn type_one(mut sh: Sh, name: str, via: str) -> int {
    if is_reserved(name) {
        emit(mut sh, "{name} is a reserved word\n")
        return 0
    }
    if alias_set(sh, name) {
        emit(mut sh, "{name} is an alias for {sh.ast.aliases[name] else ""}\n")
        return 0
    }
    if is_special_builtin(name) {
        emit(mut sh, "{name} is a special built-in\n")
        return 0
    }
    if sh.funcs.has(name) {
        emit(mut sh, "{name} is a function\n")
        return 0
    }
    if is_regular_builtin(name) {
        emit(mut sh, "{name} is a built-in\n")
        return 0
    }
    if (name.find("/") else -1) >= 0 {
        if may_run(mut sh, name) {
            emit(mut sh, "{name} is {name}\n")
            return 0
        }
        emit(mut sh, "{name}: no such command\n")
        return 127
    }
    let before = via.len == 0 && hash_get(sh, name).len > 0
    let p = search_for(mut sh, name, via)
    if p.len == 0 {
        emit(mut sh, "{name}: no such command\n")
        return 127
    }
    if before {
        emit(mut sh, "{name} is {p} (remembered)\n")
    } else {
        emit(mut sh, "{name} is {p}\n")
    }
    0
}

/// `type name…`: every name answered; 127 when one was not found.
fn bi_type(mut sh: Sh, args: List[str]) -> int {
    var i = 0
    if i < args.len && args[i] == "--" {
        i += 1
    } else if i < args.len && args[i].len > 1 && ch(args[i], 0) == '-' {
        diag(mut sh, "type: {args[i]}: no such option")
        return 2
    }
    var st = 0
    while i < args.len {
        if type_one(mut sh, args[i], "") != 0 {
            st = 127
        }
        i += 1
    }
    st
}

/// `hash [utility…]`, `hash -r` (XCU `hash`): with no operand the table
/// is listed, one path a line, by name; `-r` forgets it (operands after
/// it are ignored, dash); a name is searched for again and remembered, a
/// built-in, a function or a path with `/` is left alone (0), and a name
/// not found fails with 1, the others still searched.
fn bi_hash(mut sh: Sh, args: List[str]) -> int {
    var i = 0
    if i < args.len && args[i] == "-r" {
        hash_clear(mut sh)
        return 0
    }
    if i < args.len && args[i] == "--" {
        i += 1
    } else if i < args.len && args[i].len > 1 && ch(args[i], 0) == '-' {
        diag(mut sh, "hash: {args[i]}: no such option")
        return 2
    }
    if i >= args.len {
        hash_valid(mut sh)
        for k in sort_strs(sh.hash.keys()) {
            emit(mut sh, "{sh.hash[k] else ""}\n")
        }
        return 0
    }
    var st = 0
    while i < args.len {
        let n = args[i]
        i += 1
        if (n.find("/") else -1) >= 0 ||
            sh.funcs.has(n) ||
            is_special_builtin(n) ||
            is_regular_builtin(n) {
            continue
        }
        hash_del(mut sh, n)
        if hash_find(mut sh, n).len == 0 {
            diag(mut sh, "hash: {n}: not found")
            st = 1
        }
    }
    st
}

/// Whether `name` may be an alias's (XCU `alias`: the portable
/// characters and `! % , @`, and as an extension what dash takes: every
/// printable byte but a blank, `}` and the ones the lexer gives a
/// meaning, `& ; | < > ( ) \ " ' $` and backquote).
fn alias_name_ok(name: str) -> bool {
    if name.len == 0 {
        return false
    }
    for b in name.bytes() {
        let c = b as int
        if c <= 32 ||
            c == 125 ||
            c == 38 ||
            c == 59 ||
            c == 124 ||
            c == 60 ||
            c == 62 ||
            c == 40 ||
            c == 41 ||
            c == 92 ||
            c == 34 ||
            c == 39 ||
            c == 36 ||
            c == 96 {
            return false
        }
    }
    true
}

/// `alias [name[=value]…]` (XCU `alias`): defines each `name=value`;
/// writes each `name` as the `alias` operand that makes it again, quoted
/// whole as dash quotes it (`'q=echo x'`), and with no operand writes
/// every alias, by name. A name with no alias fails with 1, one that
/// cannot be an alias's with 2; the other operands are still done. The
/// new alias is in effect from the next complete command the shell
/// parses (the parser substitutes, `sh.parse`'s `alias_at`).
fn bi_alias(mut sh: Sh, args: List[str]) -> int {
    var i = 0
    if i < args.len && args[i] == "--" {
        // no options; `--` is still taken (XCU 1.4)
        i += 1
    }
    if i >= args.len {
        for k in sort_strs(sh.ast.aliases.keys()) {
            emit(mut sh, "{squote("{k}={sh.ast.aliases[k] else ""}")}\n")
        }
        return 0
    }
    var st = 0
    while i < args.len {
        let a = args[i]
        i += 1
        let eq = a.find("=") else -1
        if eq > 0 {
            let name = a[0..eq]
            if !alias_name_ok(name) {
                diag(mut sh, "alias: {name}: not a valid alias name")
                st = 2
                continue
            }
            aset(mut sh, name, a[eq + 1..a.len])
            continue
        }
        if !alias_set(sh, a) {
            diag(mut sh, "alias: {a}: no such alias")
            if st == 0 {
                st = 1
            }
            continue
        }
        emit(mut sh, "{squote("{a}={sh.ast.aliases[a] else ""}")}\n")
    }
    st
}

/// `unalias name…`, `unalias -a` (XCU `unalias`): a name with no alias
/// fails with 1, the others still removed; no operand is 0 (dash).
fn bi_unalias(mut sh: Sh, args: List[str]) -> int {
    var i = 0
    if i < args.len && args[i] == "-a" {
        for k in sh.ast.aliases.keys() {
            adel(mut sh, k)
        }
        return 0
    }
    if i < args.len && args[i] == "--" {
        i += 1
    } else if i < args.len && args[i].len > 1 && ch(args[i], 0) == '-' {
        diag(mut sh, "unalias: {args[i]}: no such option")
        return 2
    }
    var st = 0
    while i < args.len {
        let n = args[i]
        i += 1
        if !alias_set(sh, n) {
            diag(mut sh, "unalias: {n}: no such alias")
            st = 1
            continue
        }
        adel(mut sh, n)
    }
    st
}

fn is_reserved(w: str) -> bool {
    w == "if" ||
        w == "then" ||
        w == "else" ||
        w == "elif" ||
        w == "fi" ||
        w == "do" ||
        w == "done" ||
        w == "case" ||
        w == "esac" ||
        w == "while" ||
        w == "until" ||
        w == "for" ||
        w == "in" ||
        w == "{{" ||
        w == "}}" ||
        w == "!"
}

/// `local name`: what `name` is now goes on the function's stack, to
/// come back when the function returns (`sh.exec`'s `pop_locals`).
fn local_push(mut sh: Sh, name: str) {
    (mut sh.lnames).push(name)
    (mut sh.lvals).push(value_of(sh, name))
    (mut sh.lset).push(has_var(sh, name))
    (mut sh.lexp).push(is_exported(sh, name))
}

fn bi_local(mut sh: Sh, args: List[str]) -> int {
    if sh.fdepth == 0 {
        diag(mut sh, "local: not in a function")
        return 2
    }
    for a in args {
        let eq = a.find("=") else -1
        let name = if eq >= 0 then a[0..eq] else a
        if !is_name(name) {
            diag(mut sh, "local: {name}: not a valid name")
            return 2
        }
        local_push(mut sh, name)
        if eq >= 0 {
            if !set_var(mut sh, name, a[eq + 1..a.len]) {
                diag(mut sh, "{name}: is read-only")
                return 2
            }
        }
    }
    0
}

/// `read [-r] [-d delim] var…` (XCU `read`): one line of standard
/// input — or, with `-d`, the bytes up to the delimiter (its first byte;
/// `-d ''` a NUL) — split on `IFS` into the variables, the last taking
/// the rest. The line is read byte by byte through the handle the shell
/// reads its own commands from (`sh.interact`), so a `read` at the
/// prompt takes the next line typed and nothing more. A final line with
/// no newline is assigned and answers 1, as the utility's end-of-file
/// status says. Without `-r` a backslash quotes the next byte and
/// backslash-newline continues the line, the delimiter's included. A
/// variable that cannot be assigned (read-only, or not a name) fails
/// the command with 2 there, the ones before it assigned (dash).
fn bi_read(mut sh: Sh, args: List[str]) -> int {
    var raw = false
    var delim = 10
    var i = 0
    while i < args.len && ch(args[i], 0) == '-' && args[i].len > 1 {
        let a = args[i]
        if a == "--" {
            i += 1
            break
        }
        // letters in one cluster (`-rd ''`); `d` takes the rest of the
        // argument, or the next one
        var k = 1
        var next = false
        while k < a.len {
            let c = ch(a, k)
            if c == 'r' {
                raw = true
                k += 1
                continue
            }
            if c == 'd' {
                var d = a[k + 1..a.len]
                if d.len == 0 {
                    if i + 1 >= args.len {
                        diag(mut sh, "read: -d needs a delimiter")
                        return 2
                    }
                    d = args[i + 1]
                    next = true
                }
                delim = if d.len == 0 then 0 else byte_at(d, 0)
                break
            }
            diag(mut sh, "read: -{c}: no such option")
            return 2
        }
        i += if next then 2 else 1
    }
    if i >= args.len {
        // POSIX names at least one variable; dash refuses none
        diag(mut sh, "read: a variable name is needed")
        return 2
    }
    flush(mut sh)
    // the line read and split inside a region: only the values are kept,
    // and the variables are set from views of them (pelt#39: `read`
    // kept ~1,700 B a turn in the root)
    let fd = fd_get(sh, 0)
    let (how, enc) = copy region rr {
        read_split(sh, delim, raw, args.len - i)
    }
    if how != 0 && fd == 0 {
        sh.eof0 = true
    }
    if how == R_EOF_EMPTY {
        var k = i
        while k < args.len {
            if !read_target(mut sh, args[k], "") {
                return 2
            }
            k += 1
        }
        return 1
    }
    if !assign_enc(mut sh, args, i, enc) {
        return 2
    }
    if how != 0 then 1 else 0
}

/// `read_split`'s answer for end of input before any byte.
const R_EOF_EMPTY: int = 3

/// What `read` reads (`bi_read`), from shell descriptor 0 up to the
/// delimiter `delim` (a newline: lines joined at a backslash-newline
/// unless `raw`), split for `n` variables: (0, the values) for a whole
/// line, (1, the values) for one that end of input cut short, or
/// (`R_EOF_EMPTY`, "") for end of input before any byte. The values are
/// `n` pieces, each its length in decimal, a colon and its bytes
/// (`enc_take`). Writes nothing to the state, so it runs inside a
/// region.
fn read_split(sh: Sh, delim: int, raw: bool, n: int) -> (int, str) {
    let fd = fd_get(sh, 0)
    let shut = fd < 0 || fd == 0 && sh.eof0
    var line = buf()
    var eof = false
    if shut {
        eof = true
    } else if delim != 10 {
        let (got, how) = delim_of(fd, delim, raw)
        put(mut line, got)
        eof = how != 0
    } else {
        loop {
            let (got, how) = line_of(fd)
            var piece = got
            if how == 0 {
                piece = got[0..got.len - 1]
            } else {
                eof = true
            }
            if eof {
                put(mut line, piece)
                break
            }
            if !raw && piece.len > 0 && ch(piece, piece.len - 1) == '\\' {
                put_range(mut line, piece, 0, piece.len - 1)
                continue
            }
            put(mut line, piece)
            break
        }
    }
    let s = text(line)
    if eof && s.len == 0 {
        return (R_EOF_EMPTY, "")
    }
    // the line as a marked string: escaped bytes are literal, and a
    // backslash-newline (kept by the delimiter reader) is removed
    var m = buf()
    putb(mut m, RB)
    var k = 0
    while k < s.len {
        let b = byte_at(s, k)
        if !raw && b == 92 && k + 1 < s.len {
            if byte_at(s, k + 1) != 10 {
                qlit(mut m, byte_at(s, k + 1))
            }
            k += 2
            continue
        }
        lit(mut m, b)
        k += 1
    }
    putb(mut m, RE)
    (if eof then 1 else 0, split_fields(sh, n, text(m)))
}

/// Set `args[from..]` from `enc` (`read_split`'s values), each a view of
/// it; false, said, when one could not be set.
fn assign_enc(mut sh: Sh, args: List[str], from: int, enc: str) -> bool {
    var at = 0
    var k = from
    while k < args.len {
        let (v, next) = enc_take(enc, at)
        if !read_target(mut sh, args[k], v) {
            return false
        }
        at = next
        k += 1
    }
    true
}

/// The piece of `enc` at `at` (its length in decimal, a colon, its
/// bytes) and where the next begins.
fn enc_take(enc: str, at: int) -> (str, int) {
    var n = 0
    var i = at
    while i < enc.len && ch(enc, i) != ':' {
        n = n * 10 + byte_at(enc, i) - 48
        i += 1
    }
    let b = i + 1
    (enc[b..b + n], b + n)
}

fn enc_put(mut o: Buf, v: str) {
    put(mut o, "{v.len}")
    putc(mut o, ':')
    put(mut o, v)
}

/// Assign `value` to `read`'s variable `name`; false, said, when it is
/// not a name or is read-only.
fn read_target(mut sh: Sh, name: str, value: str) -> bool {
    if !is_name(name) {
        diag(mut sh, "read: {name}: not a valid name")
        return false
    }
    if !set_var(mut sh, name, value) {
        diag(mut sh, "read: {name}: is read-only")
        return false
    }
    true
}

/// Whether the marked byte at `i` is an unquoted `IFS` character.
fn ifs_at(marked: str, i: int, f: str) -> bool {
    let b = byte_at(marked, i)
    b != Q && b != RB && b != RE && in_ifs(f, b)
}

/// Where the rest of a marked line from `i` holds exactly one field
/// followed only by its delimiter, the end of that field; else -1. The
/// last variable of `read` takes such a field without its delimiter
/// (POSIX.1-2024 `read`; dash: `a:b:c:` gives `c`, `c::` stays `c::`).
fn lone_field_end(marked: str, from: int, f: str) -> int {
    var i = from
    while i < marked.len {
        let b = byte_at(marked, i)
        if b == Q {
            i += 2
            continue
        }
        if ifs_at(marked, i, f) {
            break
        }
        i += 1
    }
    let end = i
    if end >= marked.len {
        return -1
    }
    // the delimiter: white space, at most one other IFS character, and
    // white space again
    while i < marked.len && ifs_at(marked, i, f) && is_ifs_ws(byte_at(marked, i)) {
        i += 1
    }
    if i < marked.len && ifs_at(marked, i, f) && !is_ifs_ws(byte_at(marked, i)) {
        i += 1
    }
    while i < marked.len && ifs_at(marked, i, f) && is_ifs_ws(byte_at(marked, i)) {
        i += 1
    }
    while i < marked.len && (byte_at(marked, i) == RB || byte_at(marked, i) == RE) {
        i += 1
    }
    if i < marked.len {
        return -1
    }
    end
}

/// Split a marked line for `read`'s `count` variables: each but the last
/// takes one field; the last takes the rest of the line with surrounding
/// `IFS` white space removed, or one field alone without the delimiter
/// after it. The values as `read_split` answers them (`enc_take`).
fn split_fields(sh: Sh, count: int, marked: str) -> str {
    let f = ifs(sh)
    var o = buf()
    var i = 0
    var n = 0
    while n < count {
        // skip leading IFS white space
        while i < marked.len {
            let b = byte_at(marked, i)
            if b == RB || b == RE {
                i += 1
                continue
            }
            if in_ifs(f, b) && is_ifs_ws(b) {
                i += 1
                continue
            }
            break
        }
        if n == count - 1 {
            var end = lone_field_end(marked, i, f)
            if end < 0 {
                // the rest, trailing IFS white space trimmed
                end = marked.len
                loop {
                    if end <= i {
                        break
                    }
                    let b = byte_at(marked, end - 1)
                    if b == RE {
                        end -= 1
                        continue
                    }
                    if in_ifs(f, b) &&
                        is_ifs_ws(b) &&
                        !(end >= 2 && byte_at(marked, end - 2) == Q) {
                        end -= 1
                        continue
                    }
                    break
                }
            }
            enc_put(mut o, unmark(marked[i..end]))
            return text(o)
        }
        var cur = buf()
        while i < marked.len {
            let b = byte_at(marked, i)
            if b == Q {
                putb(mut cur, Q)
                putb(mut cur, byte_at(marked, i + 1))
                i += 2
                continue
            }
            if b == RB || b == RE {
                i += 1
                continue
            }
            if in_ifs(f, b) {
                if !is_ifs_ws(b) {
                    i += 1
                } else {
                    // white space, then at most one other IFS character
                    while i < marked.len &&
                        in_ifs(f, byte_at(marked, i)) &&
                        is_ifs_ws(byte_at(marked, i)) {
                        i += 1
                    }
                    if i < marked.len &&
                        in_ifs(f, byte_at(marked, i)) &&
                        !is_ifs_ws(byte_at(marked, i)) {
                        i += 1
                    }
                }
                break
            }
            putb(mut cur, b)
            i += 1
        }
        enc_put(mut o, unmark(text(cur)))
        n += 1
    }
    text(o)
}

/// `split_fields` with its values assigned to `names`; false, said, when
/// a variable could not be assigned (the selftest's way in).
fn assign_fields(mut sh: Sh, names: List[str], marked: str) -> bool {
    let enc = split_fields(sh, names.len, marked)
    var at = 0
    for name in names {
        let (v, next) = enc_take(enc, at)
        if !read_target(mut sh, name, v) {
            return false
        }
        at = next
    }
    true
}

/// `getopts optstring name [arg…]` (XCU `getopts`).
fn bi_getopts(mut sh: Sh, args: List[str]) -> int {
    if args.len < 2 {
        diag(mut sh, "getopts: usage: getopts optstring name [arg ...]")
        return 2
    }
    let spec = args[0]
    let var_name = args[1]
    if !is_name(var_name) {
        diag(mut sh, "getopts: {var_name}: not a valid name")
        return 2
    }
    let params = if args.len > 2 then args[2..args.len] else copy sh.pos
    // a read-only name is not changed (XCU `readonly`) and fails the
    // command with 2, `OPTIND` moved on all the same (dash, black-box)
    let ro = is_ronly(sh, var_name)
    let st = getopts_step(mut sh, spec, var_name, params)
    if ro {
        diag(mut sh, "getopts: {var_name}: is read-only")
        return 2
    }
    st
}

/// One step of `getopts` over `params`: the option found goes to
/// `var_name`, `OPTIND` and `OPTARG` are moved on.
fn getopts_step(mut sh: Sh, spec: str, var_name: str, params: List[str]) -> int {
    let silent = spec.len > 0 && ch(spec, 0) == ':'
    var ind = to_int(value_of(sh, "OPTIND")) else 1
    if ind < 1 {
        ind = 1
    }
    // where inside a clustered argument we are, forgotten whenever
    // OPTIND moves under it
    var sub = sh.gopt_sub
    if sh.gopt_ind != ind {
        sub = 1
    }
    if ind > params.len {
        let _a = set_var(mut sh, var_name, "?")
        return 1
    }
    let arg = params[ind - 1]
    if sub == 1 && (arg.len < 2 || ch(arg, 0) != '-' || arg == "-") {
        let _a = set_var(mut sh, var_name, "?")
        return 1
    }
    if sub == 1 && arg == "--" {
        let _a = set_var(mut sh, "OPTIND", "{ind + 1}")
        let _b = set_var(mut sh, var_name, "?")
        return 1
    }
    let c = arg[sub..sub + 1]
    var next_sub = sub + 1
    var next_ind = ind
    if next_sub >= arg.len {
        next_sub = 1
        next_ind = ind + 1
    }
    let at = spec.find(c) else -1
    if at < 0 || c == ":" {
        if silent {
            let _a = set_var(mut sh, "OPTARG", c)
        } else {
            let _u = unset_var(mut sh, "OPTARG")
            diag(mut sh, "getopts: -{c}: no such option")
        }
        let _b = set_var(mut sh, var_name, "?")
    } else if at + 1 < spec.len && ch(spec, at + 1) == ':' {
        if next_sub != 1 {
            let _a = set_var(mut sh, "OPTARG", arg[sub + 1..arg.len])
            next_sub = 1
            next_ind = ind + 1
            let _b = set_var(mut sh, var_name, c)
        } else if next_ind <= params.len {
            let _a = set_var(mut sh, "OPTARG", params[next_ind - 1])
            next_ind += 1
            let _b = set_var(mut sh, var_name, c)
        } else if silent {
            let _a = set_var(mut sh, "OPTARG", c)
            let _b = set_var(mut sh, var_name, ":")
        } else {
            let _u = unset_var(mut sh, "OPTARG")
            diag(mut sh, "getopts: -{c}: needs an argument")
            let _b = set_var(mut sh, var_name, "?")
        }
    } else {
        let _u = unset_var(mut sh, "OPTARG")
        let _b = set_var(mut sh, var_name, c)
    }
    let _i = set_var(mut sh, "OPTIND", "{next_ind}")
    sh.gopt_sub = next_sub
    sh.gopt_ind = next_ind
    0
}

// ------------------------------------------------------------------ cd

/// The logical path `p` (absolute) with `.` and `..` components removed
/// textually and runs of `/` folded, as XCU `cd` step 8 does for `-L`.
/// A leading `//` is kept (implementation-defined; dash keeps it).
fn canon(p: str) -> str {
    var parts = List[str]()
    for c in p.split("/") {
        if c.len == 0 || c == "." {
            continue
        }
        if c == ".." {
            let _x = (mut parts).pop() else ""
            continue
        }
        (mut parts).push(c)
    }
    var o = buf()
    if p.len >= 2 && ch(p, 0) == '/' && ch(p, 1) == '/' && (p.len == 2 || ch(p, 2) != '/') {
        putc(mut o, '/')
    }
    if parts.len == 0 {
        putc(mut o, '/')
    }
    for c in parts {
        putc(mut o, '/')
        put(mut o, c)
    }
    text(o)
}

/// `cd [-L|-P] [directory]` and `cd -` (XCU `cd`): `CDPATH` searched
/// for a relative name not starting with `.` or `..`, the new directory
/// printed when `CDPATH` (a non-empty entry) or `-` chose it, `PWD` and
/// `OLDPWD` set. Failure is status 2 with a message, as dash, and does
/// not end the shell.
fn bi_cd(mut sh: Sh, args: List[str]) -> int {
    var physical = false
    var i = 0
    while i < args.len && args[i].len > 1 && ch(args[i], 0) == '-' {
        let a = args[i]
        if a == "--" {
            i += 1
            break
        }
        if a == "-L" {
            physical = false
        } else if a == "-P" {
            physical = true
        } else {
            diag(mut sh, "cd: {a}: no such option")
            return 2
        }
        i += 1
    }
    var dir = ""
    var show = false
    if i >= args.len {
        dir = value_of(sh, "HOME")
        if dir.len == 0 {
            return 0
        }
    } else {
        dir = args[i]
        if dir == "-" {
            dir = value_of(sh, "OLDPWD")
            if dir.len == 0 {
                diag(mut sh, "cd: OLDPWD not set")
                return 2
            }
            show = true
        }
    }
    // a `cd` that leaves the shell where it is changes nothing it keeps:
    // found (and the directory changed to) inside a region, so it keeps
    // nothing (pelt#39: `cd .` kept ~560 B a turn)
    let stays = copy region cs {
        cd_stays(sh, dir, physical, show)
    }
    if stays {
        return 0
    }
    var cur = dir
    let first = ch(dir, 0)
    let dotted = dir == "." || dir == ".." || dir.starts_with("./") || dir.starts_with("../")
    if first != '/' && !dotted {
        let cdpath = sh.vals["CDPATH"] else ""
        if cdpath.len > 0 {
            for entry in cdpath.split(":") {
                let base = if entry.len == 0 then "." else entry
                let cand = "{base}/{dir}"
                if fs_is_dir(cand) {
                    cur = cand
                    if entry.len > 0 {
                        show = true
                    }
                    break
                }
            }
        }
    }
    let old = value_of(sh, "PWD")
    var target = cur
    if !physical {
        if ch(cur, 0) != '/' {
            let base = if old.len > 0 && ch(old, 0) == '/' then old else (os_cwd() else "/")
            // a slash between them only when the base does not end in
            // one, so `cd bin` from `/` is `/bin` and from `//` is
            // `//bin`, as dash and bash (pelt#37); `canon` keeps an
            // explicit leading `//`
            let sep = if base.len > 0 && ch(base, base.len - 1) == '/' then "" else "/"
            target = canon("{base}{sep}{cur}")
        } else {
            target = canon(cur)
        }
    }
    os_chdir(target) else |_| {
        diag(mut sh, "cd: {dir}: cannot change directory: {why_failed()}")
        return 2
    }
    sh.phys = os_cwd() else copy target
    let now = if physical then sh.phys else target
    if old.len > 0 {
        let _o = set_var(mut sh, "OLDPWD", old)
        xset(mut sh, "OLDPWD", true)
    }
    let _p = set_var(mut sh, "PWD", now)
    if show {
        emit(mut sh, "{now}\n")
    }
    0
}

/// `set -o autocd` (ruling #113, pelt#49): whether the simple command
/// named `cmd`, which `sh.exec`'s `run_external` found nowhere (`path` is
/// "") or did not search because it has a `/`, is a `cd` instead: the
/// option is on, the shell is interactive (bash ignores the option in a
/// script, in `-c` and on standard input; black-box, sh23), and `cmd`
/// names a directory as it stands, from here (so `CDPATH` is `cd`'s to
/// take after, as in bash). A name with no `/` that the search found is
/// a program, and is never a `cd`.
fn autocd_dir(sh: Sh, cmd: str, path: str) -> bool {
    if !sh.opt_autocd || !sh.interactive {
        return false
    }
    if path.len > 0 && (cmd.find("/") else -1) < 0 {
        return false
    }
    fs_is_dir(cmd)
}

/// The command `fields`, whose name names a directory (`autocd_dir`), run
/// as `cd -- NAME WORD…` would be, as bash 5 runs it (black-box, sh23):
/// the command's other words are `cd`'s further operands; a function
/// named `cd` runs when one is defined (lope's records the visit), else
/// the built-in; the command's assignments are made for the call and
/// undone after, as for any function or built-in (XCU 2.9.1), and its
/// redirections are already in place around it. Nothing is said but what
/// `cd` says (bash writes `cd -- NAME` first; zsh, like pelt, nothing).
fn run_autocd(mut sh: Sh, fields: List[str], names: List[str], values: List[str]) -> int {
    var words = List[str]()
    (mut words).push("cd")
    (mut words).push("--")
    for f in fields {
        (mut words).push(f)
    }
    var old = List[str]()
    var had = List[bool]()
    var k = 0
    while k < names.len {
        (mut had).push(has_var(sh, names[k]))
        (mut old).push(value_of(sh, names[k]))
        if !set_var(mut sh, names[k], values[k]) {
            fatal(mut sh, "{names[k]}: is read-only", 2)
            return 2
        }
        k += 1
    }
    var st = 0
    let fnode = sh.funcs["cd"] else -1
    if fnode >= 0 {
        st = call_function(mut sh, fnode, words)
    } else {
        st = builtin(mut sh, words)
    }
    k = names.len - 1
    while k >= 0 {
        if had[k] {
            let _ok = set_var(mut sh, names[k], old[k])
        } else {
            let _ok = unset_var(mut sh, names[k])
        }
        k -= 1
    }
    st
}

/// Whether `cd` to `dir` (`bi_cd`, after its options and `-`) leaves the
/// shell exactly as it is: `CDPATH` does not choose the directory and
/// nothing is to be printed, the change of directory succeeds, and
/// `PWD`, `OLDPWD` (exported) and the physical directory would each be
/// set to the value it has; `set -a` would export nothing new. Writes
/// nothing to the state, so it runs inside a region. It changes the
/// directory only to an absolute path (to where the shell already is,
/// unless that fails), so when it answers false `bi_cd`, which changes
/// the directory again the ordinary way, goes to the same place.
fn cd_stays(sh: Sh, dir: str, physical: bool, show: bool) -> bool {
    if show {
        return false
    }
    let first = ch(dir, 0)
    let dotted = dir == "." || dir == ".." || dir.starts_with("./") || dir.starts_with("../")
    if first != '/' && !dotted {
        let cdpath = sh.vals["CDPATH"] else ""
        if cdpath.len > 0 {
            return false
        }
    }
    let old = value_of(sh, "PWD")
    if old.len == 0 || !has_var(sh, "PWD") || sh.opt_a && !is_exported(sh, "PWD") {
        return false
    }
    if !(value_of(sh, "OLDPWD") == old && is_exported(sh, "OLDPWD") && has_var(sh, "OLDPWD")) {
        return false
    }
    var target = dir
    if physical {
        if first != '/' {
            return false
        }
    } else if first != '/' {
        if ch(old, 0) != '/' {
            return false
        }
        let sep = if ch(old, old.len - 1) == '/' then "" else "/"
        target = canon("{old}{sep}{dir}")
    } else {
        target = canon(dir)
    }
    if !physical && target != old {
        return false
    }
    os_chdir(target) else |_| {
        return false
    }
    if !physical && old == sh.phys {
        // the logical and the physical directory were one path at the
        // last look and the shell stays on it: `os_cwd()` is not asked,
        // since its answer outlives the region it is asked in (48 B a
        // call, `notes/sh22-evidence/witness/cwdregion`)
        return true
    }
    let phys = os_cwd() else target
    let now = if physical then phys else target
    now == old && phys == sh.phys
}

// ---------------------------------------------------------------- wait

/// `wait [pid…]` (XCU `wait`): with no operand, wait for every job
/// that runs and answer 0; otherwise each operand's status, 127 for a
/// process id pelt does not know. A job is named by the number `$!`
/// gave it, any of its processes' ids, or a job id (`sh.jobs`'s
/// `job_index`); a job id no job has is an error (status 2, dash). A
/// stopped job is not waited for: its status is `128 + N` (dash,
/// black-box: p12). With job control on, or a trap set, the wait is a
/// poll and a park on `CHILD` and the trapped signals (`sh.jobs`'s
/// `jc_wait`), so a trapped signal cuts it short: `wait` answers
/// `128 + N` and the action runs after it (XCU 2.11, `wait`). With job
/// control off `wait` with no operand forgets the jobs that ended
/// (dash, black-box: s10).
fn bi_wait(mut sh: Sh, args: List[str]) -> int {
    // what a poll takes while `wait` runs is `wait`'s own to say
    // (`sh.jobs`'s `SL_REAPED`, pelt#47)
    let was = sh.in_wait
    sh.in_wait = true
    let st = wait_ops(mut sh, args)
    sh.in_wait = was
    st
}

fn wait_ops(mut sh: Sh, args: List[str]) -> int {
    flush(mut sh)
    let cut = sh.sig_mine
    let polled = sh.jc_on || cut != 0
    if args.len == 0 {
        if polled {
            let got = jc_wait(mut sh, -1, cut)
            if got != 0 {
                return wait_cut(sh, got)
            }
        } else {
            var j = 0
            while j < slot_count(sh) {
                if slot_state(sh, j) != JB_FREE {
                    let _st = wait_job(mut sh, j, true)
                }
                j += 1
            }
        }
        if !sh.jc_on {
            var j = 0
            while j < slot_count(sh) {
                if slot_state(sh, j) != JB_FREE && jb_state_of(sh, j) == JB_DONE {
                    jb_free(mut sh, j)
                    continue
                }
                j += 1
            }
        }
        return 0
    }
    var st = 0
    for a in args {
        var j = -1
        if a.len > 0 && ch(a, 0) == '%' {
            j = job_index(sh, a)
            if j < 0 {
                diag(mut sh, "wait: {job_word(a, j)}")
                st = 2
                continue
            }
        } else {
            let id = to_int(a) else -1
            j = job_of(sh, id)
            if j < 0 {
                st = 127
                continue
            }
        }
        if polled {
            let got = jc_wait(mut sh, j, cut)
            if got != 0 {
                return wait_cut(sh, got)
            }
        }
        let s = jb_state_of(sh, j)
        if s == JB_STOP || sh.jc_on {
            st = raw_status(jb_raw(sh, j))
        } else {
            st = wait_job(mut sh, j, false)
            if jb_state_of(sh, j) == JB_DONE {
                // its status is answered: forgotten when the next job
                // starts (`jb_new`)
                set_slot_waited(mut sh, j, true)
            }
        }
    }
    st
}
