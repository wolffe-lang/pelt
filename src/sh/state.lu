//! sh.state — the shell's execution environment (XCU 2.13 of 2024,
//! "Shell Execution Environment"): variables, functions, positional
//! parameters, options, traps, and where output goes.
//!
//! References consulted: POSIX.1-2024 XCU 2.5 (parameters and
//! variables), 2.12 (the execution environment), the `set`, `export`,
//! `readonly` and `trap` pages; black-box runs of `dash` 0.5.13.4.
//!
//! **Descriptors.** wolf has no `dup2` for a program's own
//! descriptors, so pelt keeps its own table, `fds`: shell descriptor
//! `n` is a wolf handle (0..2 the process's standard streams, 3 and up
//! a handle pelt opened), `FD_CLOSED`, or a capture marker (below).
//! Everything pelt writes or reads goes through it, and a child gets
//! the whole table as its descriptor map (`os_spawn_fds`), so a
//! redirection means the same to a built-in and to a program.
//!
//! **Output.** Everything pelt itself writes to standard output goes
//! through `out`, a byte buffer for whatever descriptor 1 is now,
//! flushed in 64 KiB pieces, before any child runs, before any
//! diagnostic, before descriptor 1 changes, and at exit — so pelt's
//! bytes and a child's interleave in program order. A command
//! substitution is a CAPTURE: descriptor 1 becomes the marker
//! `cap_mark(level)`, what is flushed there lands in `cap_data` after
//! the position the capture began at, and its result is cut back out.
//!
//! **Subshells run in-process.** wolf has no fork, so `( … )`, `$( … )`
//! and an in-process pipeline stage copy the environment, run, and put
//! it back (`snap` and `restore`): variables, functions, positional
//! parameters, options, traps, the `local` stack, the descriptor table
//! and the working directory. What it cannot isolate: the process
//! environment a child sees (wolf-lang#534).

const F_NONE: int = 0

const F_BREAK: int = 1

const F_CONTINUE: int = 2

const F_RETURN: int = 3

const F_EXIT: int = 4

/// A shell descriptor that is not open.
const FD_CLOSED: int = -1

/// Capture markers are `CAP_BASE - level` (level 1 is the outermost
/// open capture).
const CAP_BASE: int = -10

fn cap_mark(level: int) -> int {
    CAP_BASE - level
}

fn is_cap(h: int) -> bool {
    h <= CAP_BASE
}

struct Sh {
    ast: Ast,
    vals: Map[str, str],
    exported: Map[str, bool],
    ronly: Map[str, bool],
    funcs: Map[str, int],
    pos: List[str],
    arg0: str,
    status: int,
    flow: int,
    flow_n: int,
    opt_e: bool,
    opt_u: bool,
    opt_x: bool,
    opt_f: bool,
    opt_n: bool,
    opt_v: bool,
    opt_a: bool,
    opt_bigc: bool,
    no_e: int,
    loops: int,
    fdepth: int,
    dots: int,
    traps: Map[str, str],
    out: List[byte],
    /// The descriptor table: shell descriptor → handle (module doc).
    fds: List[int],
    /// Where each open capture began in `cap_data`, and what
    /// descriptor 1 was before it.
    caps: List[int],
    cap_was: List[int],
    cap_data: List[byte],
    /// Redirection frames: (descriptor, what it was) pairs to put back,
    /// and the handles the frame opened, each frame's start in `rs_fd`
    /// and `rs_open`.
    rs_fd: List[int],
    rs_was: List[int],
    rs_open: List[int],
    rs_frames: List[int],
    rs_oframes: List[int],
    /// Asynchronous lists (`&`): a child handle, or -1 for a list pelt
    /// ran itself; its status once known, or -1.
    jobs: List[int],
    job_st: List[int],
    /// `$!`: the last asynchronous list's job number, or 0 for none.
    last_bg: int,
    /// A pipeline stage's external command is started, not waited for
    /// (`nowait`); its handle lands in `stage_child`, and `stage_w` is
    /// the pipe its descriptor 1 goes to (the stage's capture level is
    /// `stage_cap`).
    nowait: bool,
    stage_child: int,
    stage_w: int,
    stage_cap: int,
    /// Temporary-file captures of children still running: the read
    /// handle and the capture level each belongs to.
    pend_cap: List[int],
    pend_level: List[int],
    /// The working directory as `os_cwd` last answered it ("" until
    /// asked): what a subshell puts back.
    phys: str,
    /// A copy of the state that runs a simple command inside
    /// `copy region` (`sh.fast`): it must not write anything the real
    /// state keeps, so whatever would (an assignment, a diagnostic, a
    /// command substitution) sets `bail` and the command is run again
    /// the ordinary way.
    shadow: bool,
    bail: bool,
    /// End of file seen on descriptor 0 (a terminal's Ctrl-D is one
    /// zero-byte read; the next read would wait for more typing).
    eof0: bool,
    name: str,
    line: int,
    cs_status: int,
    cs_ran: bool,
    cs_node: Map[str, int],
    cs_end: Map[str, int],
    bq_node: Map[str, int],
    sub: int,
    lnames: List[str],
    lvals: List[str],
    lset: List[bool],
    lexp: List[bool],
    lframes: List[int],
    exiting: bool,
    gopt_sub: int,
    gopt_ind: int,
    interactive: bool,
    from_stdin: bool,
    abort: bool,
    /// Directories pathname expansion has listed: the count the
    /// table checks read (pelt#3: a word that is not a pattern reads
    /// none).
    dir_reads: int,
}

struct Snap {
    vals: Map[str, str],
    exported: Map[str, bool],
    ronly: Map[str, bool],
    funcs: Map[str, int],
    pos: List[str],
    arg0: str,
    opts: List[bool],
    traps: Map[str, str],
    loops: int,
    fdepth: int,
    dots: int,
    lnames: List[str],
    lvals: List[str],
    lset: List[bool],
    lexp: List[bool],
    lframes: List[int],
    fds: List[int],
    phys: str,
}

fn new_sh(name: str) -> Sh {
    Sh {
        ast: new_ast(),
        vals: Map[str, str](),
        exported: Map[str, bool](),
        ronly: Map[str, bool](),
        funcs: Map[str, int](),
        pos: List[str](),
        arg0: name,
        status: 0,
        flow: F_NONE,
        flow_n: 0,
        opt_e: false,
        opt_u: false,
        opt_x: false,
        opt_f: false,
        opt_n: false,
        opt_v: false,
        opt_a: false,
        opt_bigc: false,
        no_e: 0,
        loops: 0,
        fdepth: 0,
        dots: 0,
        traps: Map[str, str](),
        out: List[byte](),
        fds: std_fds(),
        caps: List[int](),
        cap_was: List[int](),
        cap_data: List[byte](),
        rs_fd: List[int](),
        rs_was: List[int](),
        rs_open: List[int](),
        rs_frames: List[int](),
        rs_oframes: List[int](),
        jobs: List[int](),
        job_st: List[int](),
        last_bg: 0,
        nowait: false,
        stage_child: -1,
        stage_w: -1,
        stage_cap: 0,
        pend_cap: List[int](),
        pend_level: List[int](),
        phys: "",
        shadow: false,
        bail: false,
        eof0: false,
        name: name,
        line: 0,
        cs_status: 0,
        cs_ran: false,
        cs_node: Map[str, int](),
        cs_end: Map[str, int](),
        bq_node: Map[str, int](),
        sub: 0,
        lnames: List[str](),
        lvals: List[str](),
        lset: List[bool](),
        lexp: List[bool](),
        lframes: List[int](),
        exiting: false,
        gopt_sub: 1,
        gopt_ind: 0,
        interactive: false,
        from_stdin: false,
        abort: false,
        dir_reads: 0,
    }
}

/// The table a shell starts with: 0, 1 and 2 its own standard streams.
fn std_fds() -> List[int] {
    var f = List[int]()
    (mut f).push(0)
    (mut f).push(1)
    (mut f).push(2)
    f
}

fn opts_list(sh: Sh) -> List[bool] {
    var o = List[bool]()
    (mut o).push(sh.opt_e)
    (mut o).push(sh.opt_u)
    (mut o).push(sh.opt_x)
    (mut o).push(sh.opt_f)
    (mut o).push(sh.opt_n)
    (mut o).push(sh.opt_v)
    (mut o).push(sh.opt_a)
    (mut o).push(sh.opt_bigc)
    o
}

fn snap(sh: Sh) -> Snap {
    Snap {
        vals: copy sh.vals,
        exported: copy sh.exported,
        ronly: copy sh.ronly,
        funcs: copy sh.funcs,
        pos: copy sh.pos,
        arg0: sh.arg0,
        opts: opts_list(sh),
        traps: copy sh.traps,
        loops: sh.loops,
        fdepth: sh.fdepth,
        dots: sh.dots,
        lnames: copy sh.lnames,
        lvals: copy sh.lvals,
        lset: copy sh.lset,
        lexp: copy sh.lexp,
        lframes: copy sh.lframes,
        fds: copy sh.fds,
        phys: sh.phys,
    }
}

fn restore(mut sh: Sh, s: Snap) {
    sh.vals = copy s.vals
    sh.exported = copy s.exported
    sh.ronly = copy s.ronly
    sh.funcs = copy s.funcs
    sh.pos = copy s.pos
    sh.arg0 = s.arg0
    sh.opt_e = s.opts[0]
    sh.opt_u = s.opts[1]
    sh.opt_x = s.opts[2]
    sh.opt_f = s.opts[3]
    sh.opt_n = s.opts[4]
    sh.opt_v = s.opts[5]
    sh.opt_a = s.opts[6]
    sh.opt_bigc = s.opts[7]
    sh.traps = copy s.traps
    sh.loops = s.loops
    sh.fdepth = s.fdepth
    sh.dots = s.dots
    sh.lnames = copy s.lnames
    sh.lvals = copy s.lvals
    sh.lset = copy s.lset
    sh.lexp = copy s.lexp
    sh.lframes = copy s.lframes
    restore_fds(mut sh, s.fds)
    if s.phys.len > 0 && s.phys != sh.phys {
        os_chdir(s.phys) else |_| {}
        sh.phys = s.phys
    }
}

/// Put the descriptor table back to `was`, closing every handle pelt
/// opened that the table no longer names.
fn restore_fds(mut sh: Sh, was: List[int]) {
    flush(mut sh)
    for h in sh.fds {
        if h >= 3 && !names_handle(was, h) {
            fs_close(h) else |_| {}
        }
    }
    sh.fds = copy was
}

fn names_handle(fds: List[int], h: int) -> bool {
    for x in fds {
        if x == h {
            return true
        }
    }
    false
}

/// The handle behind shell descriptor `fd`, or `FD_CLOSED`.
fn fd_get(sh: Sh, fd: int) -> int {
    if fd < 0 || fd >= sh.fds.len {
        return FD_CLOSED
    }
    sh.fds[fd]
}

fn fd_set(mut sh: Sh, fd: int, h: int) {
    if fd == 1 {
        flush(mut sh)
    }
    while sh.fds.len <= fd {
        (mut sh.fds).push(FD_CLOSED)
    }
    sh.fds[fd] = h
}

// ------------------------------------------------------------ variables

fn has_var(sh: Sh, name: str) -> bool {
    // the map's own lookup: `std.map`'s `has` builds a list of the
    // pairs per call (s216 measured it)
    let _v = sh.vals[name] else {
        return false
    }
    true
}

fn value_of(sh: Sh, name: str) -> str {
    sh.vals[name] else ""
}

fn is_ronly(sh: Sh, name: str) -> bool {
    sh.ronly[name] else false
}

fn is_exported(sh: Sh, name: str) -> bool {
    sh.exported[name] else false
}

/// Assign, honouring `readonly` and `set -a`. False (and nothing set)
/// when the variable is read-only; the caller reports it.
fn set_var(mut sh: Sh, name: str, value: str) -> bool {
    if sh.shadow {
        sh.bail = true
        sh.flow = F_EXIT
    }
    if is_ronly(sh, name) {
        return false
    }
    sh.vals[name] = value
    if sh.opt_a {
        sh.exported[name] = true
    }
    true
}

fn unset_var(mut sh: Sh, name: str) -> bool {
    if sh.shadow {
        sh.bail = true
        sh.flow = F_EXIT
    }
    if is_ronly(sh, name) {
        return false
    }
    let _v = (mut sh.vals).remove(name) else ""
    let _e = (mut sh.exported).remove(name) else false
    true
}

fn ifs(sh: Sh) -> str {
    sh.vals["IFS"] else " \t\n"
}

/// `$-`: the single-letter options that are on, in the order dash
/// prints them (black-box: `set -a -C -e -f -u -v -x` shows `uaCvxfe`,
/// and an interactive shell reading standard input puts `si` before
/// `f`).
fn dash_flags(sh: Sh) -> str {
    var o = buf()
    if sh.opt_u {
        putc(mut o, 'u')
    }
    if sh.opt_a {
        putc(mut o, 'a')
    }
    if sh.opt_bigc {
        putc(mut o, 'C')
    }
    if sh.opt_v {
        putc(mut o, 'v')
    }
    if sh.opt_x {
        putc(mut o, 'x')
    }
    if sh.from_stdin {
        putc(mut o, 's')
    }
    if sh.interactive {
        putc(mut o, 'i')
    }
    if sh.opt_f {
        putc(mut o, 'f')
    }
    if sh.opt_e {
        putc(mut o, 'e')
    }
    if sh.opt_n {
        putc(mut o, 'n')
    }
    text(o)
}

// --------------------------------------------------------------- output

fn emit(mut sh: Sh, s: str) {
    for x in s.bytes() {
        (mut sh.out).push(x)
    }
    if sh.out.len >= 65536 {
        flush(mut sh)
    }
}

fn emitc(mut sh: Sh, c: char) {
    (mut sh.out).push(c as int as byte)
}

fn emitb(mut sh: Sh, n: int) {
    (mut sh.out).push(n as byte)
}

/// Write what is buffered to wherever descriptor 1 now is: a handle, the
/// open capture, or nowhere (closed).
fn flush(mut sh: Sh) {
    if sh.out.len == 0 {
        return
    }
    let h = fd_get(sh, 1)
    if is_cap(h) {
        for x in sh.out {
            (mut sh.cap_data).push(x)
        }
    } else if h >= 0 {
        fs_write_chunk(h, sh.out) else |_| {}
    }
    sh.out = List[byte]()
}

/// Bytes for shell descriptor `fd` other than 1 (a diagnostic, a prompt,
/// a trace line), after whatever descriptor 1 has pending.
fn write_fd(mut sh: Sh, fd: int, s: str) {
    flush(mut sh)
    let h = fd_get(sh, fd)
    if is_cap(h) {
        for x in s.bytes() {
            (mut sh.cap_data).push(x)
        }
        return
    }
    if h == 2 {
        eprint_raw(s)
        return
    }
    if h >= 0 {
        var b = List[byte]()
        for x in s.bytes() {
            (mut b).push(x)
        }
        fs_write_chunk(h, b) else |_| {}
    }
}

/// Open a capture: descriptor 1 becomes its marker until `cap_end`.
fn cap_begin(mut sh: Sh) {
    flush(mut sh)
    (mut sh.caps).push(sh.cap_data.len)
    (mut sh.cap_was).push(fd_get(sh, 1))
    fd_set(mut sh, 1, cap_mark(sh.caps.len))
}

/// Close the innermost capture and answer what it caught, as bytes.
fn cap_end_bytes(mut sh: Sh) -> List[byte] {
    flush(mut sh)
    let start = (mut sh.caps).pop() else 0
    let was = (mut sh.cap_was).pop() else 1
    let part = sh.cap_data[start..sh.cap_data.len]
    sh.cap_data = sh.cap_data[0..start]
    fd_set(mut sh, 1, was)
    part
}

fn cap_end(mut sh: Sh) -> str {
    let part = cap_end_bytes(mut sh)
    text(Buf { b: part })
}

/// A diagnostic: pelt's own words, on descriptor 2, after whatever
/// standard output is pending. In the shadow state (`sh.fast`) nothing
/// is written: the command is run again the ordinary way, which says it.
fn diag(mut sh: Sh, msg: str) {
    if sh.shadow {
        sh.bail = true
        sh.flow = F_EXIT
        return
    }
    if sh.from_stdin {
        // no script to name: the line counts from the session's start
        if sh.line > 0 {
            write_fd(mut sh, 2, "pelt: line {sh.line}: {msg}\n")
        } else {
            write_fd(mut sh, 2, "pelt: {msg}\n")
        }
        return
    }
    if sh.line > 0 {
        write_fd(mut sh, 2, "pelt: {sh.name}: line {sh.line}: {msg}\n")
    } else {
        write_fd(mut sh, 2, "pelt: {sh.name}: {msg}\n")
    }
}

/// A shell error that ends a non-interactive shell (XCU 2.8.1): the
/// message, status `code`, and the exit flow. Inside a subshell or a
/// command substitution it ends only that. `abort` marks the exit as an
/// error's, which an interactive shell turns into "abandon this command
/// and prompt again" (`sh.interact`); every other way to `F_EXIT`
/// (`exit`, `return` outside a function, `exec`, `set -e`) clears it.
fn fatal(mut sh: Sh, msg: str, code: int) {
    diag(mut sh, msg)
    sh.status = code
    sh.flow = F_EXIT
    sh.flow_n = 0
    sh.abort = true
}

// ---------------------------------------------------------------- quoting

/// `s` in single quotes, a quote inside it written `'"'"'`: the form
/// `set`, `export -p`, `readonly -p` and `trap` print, which a shell
/// reads back as `s`.
fn squote(s: str) -> str {
    var o = buf()
    putc(mut o, '\'')
    var i = 0
    while i < s.len {
        if ch(s, i) == '\'' {
            put(mut o, "'\"'\"'")
        } else {
            putb(mut o, byte_at(s, i))
        }
        i += 1
    }
    putc(mut o, '\'')
    text(o)
}
