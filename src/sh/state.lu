//! sh.state — the shell's execution environment (XCU 2.13 of 2024,
//! "Shell Execution Environment"): variables, functions, positional
//! parameters, options, traps, and where output goes.
//!
//! References consulted: POSIX.1-2024 XCU 2.5 (parameters and
//! variables), 2.12 (the execution environment), the `set`, `export`,
//! `readonly` and `trap` pages; black-box runs of `dash` 0.5.13.4.
//!
//! **Descriptors.** wolf has no `dup2` for a program's own
//! descriptors, so pelt keeps its own table, `fds`: shell descriptor
//! `n` is a wolf handle (0..2 the process's standard streams, 3 and up
//! a handle pelt opened), `FD_CLOSED`, or a capture marker (below).
//! Everything pelt writes or reads goes through it, and a child gets
//! the whole table as its descriptor map (`os_spawn_fds`), so a
//! redirection means the same to a built-in and to a program.
//!
//! **Output.** Everything pelt itself writes to standard output goes
//! through `out`, a byte buffer for whatever descriptor 1 is now,
//! flushed in 64 KiB pieces, before any child runs, before any
//! diagnostic, before descriptor 1 changes, and at exit — so pelt's
//! bytes and a child's interleave in program order. A command
//! substitution is a CAPTURE: descriptor 1 becomes the marker
//! `cap_mark(level)`, what is flushed there lands in `cap_data` after
//! the position the capture began at, and its result is cut back out.
//!
//! **Subshells run in-process.** wolf has no fork, so `( … )`, `$( … )`
//! and an in-process pipeline stage run in the shell's own state, inside
//! a FRAME (`frame_open`, `frame_close`) that puts it back after:
//! variables, functions, positional parameters, options, traps, the
//! `local` stack, the descriptor table, the working directory and the
//! file mode creation mask. The process environment a child sees is
//! made to match the variables before every spawn (`sh.exec`'s
//! `sync_env`), so a subshell's `export` or `unset` ends with it too.
//!
//! **Memory (pelt#19).** The root region frees nothing, so a frame
//! copies nothing: every write to the variables, the export and
//! read-only marks, the functions and the traps goes through one helper
//! per table (`vset`, `xset`, `rset`, `fnset`, `tset` and their `…del`)
//! that, inside a frame, first records the value it replaces — once per
//! name and frame — on the JOURNAL; closing the frame plays the journal
//! back. The frame's scalars, the descriptor table and `$@` go on two
//! stacks. All of these are lists the state keeps and reuses, so a
//! subshell that writes nothing allocates nothing, and one that writes
//! keeps only what it wrote (before sh08, `snap` and `restore` copied
//! the whole state twice per subshell: 10 KB a pipeline).

const F_NONE: int = 0

const F_BREAK: int = 1

const F_CONTINUE: int = 2

const F_RETURN: int = 3

const F_EXIT: int = 4

/// `$!` for an asynchronous list pelt ran itself: above any process id
/// a host hands out (linux's ceiling is 2^22, macOS's 99,998).
const NO_PID_BASE: int = 1073741824

/// A shell descriptor that is not open.
const FD_CLOSED: int = -1

/// Capture markers are `CAP_BASE - level` (level 1 is the outermost
/// open capture).
const CAP_BASE: int = -10

fn cap_mark(level: int) -> int {
    CAP_BASE - level
}

fn is_cap(h: int) -> bool {
    h <= CAP_BASE
}

struct Sh {
    ast: Ast,
    vals: Map[str, str],
    exported: Map[str, bool],
    ronly: Map[str, bool],
    funcs: Map[str, int],
    pos: List[str],
    arg0: str,
    status: int,
    flow: int,
    flow_n: int,
    opt_e: bool,
    opt_u: bool,
    opt_x: bool,
    opt_f: bool,
    opt_n: bool,
    opt_v: bool,
    opt_a: bool,
    opt_bigc: bool,
    /// The editing modes (`sh.edit`): at most one is on.
    opt_vi: bool,
    opt_emacs: bool,
    /// The line editor's history and what outlives a line.
    ed: EdKeep,
    no_e: int,
    loops: int,
    fdepth: int,
    dots: int,
    traps: Map[str, str],
    out: List[byte],
    /// The descriptor table: shell descriptor → handle (module doc).
    fds: List[int],
    /// Where each open capture began in `cap_data`, and what
    /// descriptor 1 was before it.
    caps: List[int],
    cap_was: List[int],
    cap_data: List[byte],
    /// Redirection frames: (descriptor, what it was) pairs to put back,
    /// and the handles the frame opened, each frame's start in `rs_fd`
    /// and `rs_open`.
    rs_fd: List[int],
    rs_was: List[int],
    rs_open: List[int],
    rs_frames: List[int],
    rs_oframes: List[int],
    /// Asynchronous lists (`&`): a child handle, or -1 for a list pelt
    /// ran itself; its status once known, or -1; and the number `$!`
    /// gave it — the child's process id (`os_proc_pid`), or for a list
    /// pelt ran itself a number no process has (`NO_PID_BASE` and up).
    jobs: List[int],
    job_st: List[int],
    job_id: List[int],
    /// `$!`: the last asynchronous list's id, or 0 for none.
    last_bg: int,
    /// Signals (`sh.signal`): the meanings the process now listens for
    /// and ignores, the ones this shell (not an enclosing one) polls,
    /// whether the barrier's meaning is listened for (`settle`),
    /// whether a trap action is running and `$?` when it began, and an
    /// interactive Ctrl-C on its way back to the prompt.
    sig_listen: int,
    sig_ignore: int,
    sig_mine: int,
    sig_sync: bool,
    in_trap: bool,
    trap_status: int,
    intr: bool,
    at_prompt: bool,
    /// Whether the last `run_external` started its program.
    started: bool,
    /// A pipeline stage's external command is started, not waited for
    /// (`nowait`); its handle lands in `stage_child`, and `stage_w` is
    /// the pipe its descriptor 1 goes to (the stage's capture level is
    /// `stage_cap`).
    nowait: bool,
    stage_child: int,
    stage_w: int,
    stage_cap: int,
    /// Temporary-file captures of children still running: the read
    /// handle and the capture level each belongs to.
    pend_cap: List[int],
    pend_level: List[int],
    /// The working directory as `os_cwd` last answered it ("" until
    /// asked): what a subshell puts back.
    phys: str,
    /// A copy of the state that runs a simple command inside
    /// `copy region` (`sh.fast`): it must not write anything the real
    /// state keeps, so whatever would (an assignment, a diagnostic, a
    /// command substitution) sets `bail` and the command is run again
    /// the ordinary way.
    shadow: bool,
    bail: bool,
    /// End of file seen on descriptor 0 (a terminal's Ctrl-D is one
    /// zero-byte read; the next read would wait for more typing).
    eof0: bool,
    name: str,
    line: int,
    cs_status: int,
    cs_ran: bool,
    cs_node: Map[str, int],
    cs_end: Map[str, int],
    bq_node: Map[str, int],
    sub: int,
    lnames: List[str],
    lvals: List[str],
    lset: List[bool],
    lexp: List[bool],
    lframes: List[int],
    exiting: bool,
    gopt_sub: int,
    gopt_ind: int,
    interactive: bool,
    from_stdin: bool,
    abort: bool,
    /// Directories pathname expansion has listed: the count the
    /// table checks read (pelt#3: a word that is not a pattern reads
    /// none).
    dir_reads: int,
    /// Who the shell runs as (`sh.util`'s `load_ident`): whether that is
    /// known yet, the effective user and group ids, the supplementary
    /// groups as decimal numbers between spaces (a `str`, so the copy
    /// every fast-path command makes of the state allocates nothing).
    id_state: int,
    euid: int,
    egid: int,
    groups: str,
    /// The file mode creation mask (`sh.umask`): the process's as pelt
    /// last set or read it, and the one the shell started with; -1
    /// until a `umask` has run.
    mask: int,
    mask0: int,
    /// The journal (module doc): per entry, the table (`J_VAL` …), the
    /// name, the value it replaced (a `str` for variables and traps, an
    /// `int` for functions and marks) and whether there was one.
    jtab: List[int],
    jname: List[str],
    jstr: List[str],
    jint: List[int],
    jhad: List[bool],
    /// A name's latest journal entry: a write finds it here and records
    /// nothing when it is in the open frame already.
    jseen: Map[str, int],
    /// Per open frame: where its journal starts, and where its record
    /// starts on `fr_int` and `fr_str`.
    jframes: List[int],
    fr_ibase: List[int],
    fr_sbase: List[int],
    fr_int: List[int],
    fr_str: List[str],
}

fn new_sh(name: str) -> Sh {
    Sh {
        ast: new_ast(),
        vals: Map[str, str](),
        exported: Map[str, bool](),
        ronly: Map[str, bool](),
        funcs: Map[str, int](),
        pos: List[str](),
        arg0: name,
        status: 0,
        flow: F_NONE,
        flow_n: 0,
        opt_e: false,
        opt_u: false,
        opt_x: false,
        opt_f: false,
        opt_n: false,
        opt_v: false,
        opt_a: false,
        opt_bigc: false,
        opt_vi: false,
        opt_emacs: false,
        ed: new_edkeep(),
        no_e: 0,
        loops: 0,
        fdepth: 0,
        dots: 0,
        traps: Map[str, str](),
        out: List[byte](),
        fds: std_fds(),
        caps: List[int](),
        cap_was: List[int](),
        cap_data: List[byte](),
        rs_fd: List[int](),
        rs_was: List[int](),
        rs_open: List[int](),
        rs_frames: List[int](),
        rs_oframes: List[int](),
        jobs: List[int](),
        job_st: List[int](),
        job_id: List[int](),
        last_bg: 0,
        sig_listen: 0,
        sig_ignore: 0,
        sig_mine: 0,
        sig_sync: false,
        in_trap: false,
        trap_status: 0,
        intr: false,
        at_prompt: false,
        started: false,
        nowait: false,
        stage_child: -1,
        stage_w: -1,
        stage_cap: 0,
        pend_cap: List[int](),
        pend_level: List[int](),
        phys: "",
        shadow: false,
        bail: false,
        eof0: false,
        name: name,
        line: 0,
        cs_status: 0,
        cs_ran: false,
        cs_node: Map[str, int](),
        cs_end: Map[str, int](),
        bq_node: Map[str, int](),
        sub: 0,
        lnames: List[str](),
        lvals: List[str](),
        lset: List[bool](),
        lexp: List[bool](),
        lframes: List[int](),
        exiting: false,
        gopt_sub: 1,
        gopt_ind: 0,
        interactive: false,
        from_stdin: false,
        abort: false,
        dir_reads: 0,
        id_state: 0,
        euid: -1,
        egid: -1,
        groups: "",
        mask: -1,
        mask0: -1,
        jtab: List[int](),
        jname: List[str](),
        jstr: List[str](),
        jint: List[int](),
        jhad: List[bool](),
        jseen: Map[str, int](),
        jframes: List[int](),
        fr_ibase: List[int](),
        fr_sbase: List[int](),
        fr_int: List[int](),
        fr_str: List[str](),
    }
}

/// The table a shell starts with: 0, 1 and 2 its own standard streams.
fn std_fds() -> List[int] {
    var f = List[int]()
    (mut f).push(0)
    (mut f).push(1)
    (mut f).push(2)
    f
}

// ------------------------------------------------------------- frames

const J_VAL: int = 1

const J_EXP: int = 2

const J_RO: int = 3

const J_FN: int = 4

const J_TRAP: int = 5

/// The options as one number: what a frame keeps of them.
fn opts_bits(sh: Sh) -> int {
    var b = 0
    if sh.opt_e {
        b = b | 1
    }
    if sh.opt_u {
        b = b | 2
    }
    if sh.opt_x {
        b = b | 4
    }
    if sh.opt_f {
        b = b | 8
    }
    if sh.opt_n {
        b = b | 16
    }
    if sh.opt_v {
        b = b | 32
    }
    if sh.opt_a {
        b = b | 64
    }
    if sh.opt_bigc {
        b = b | 128
    }
    if sh.opt_vi {
        b = b | 256
    }
    if sh.opt_emacs {
        b = b | 512
    }
    b
}

fn set_opts_bits(mut sh: Sh, b: int) {
    sh.opt_e = b & 1 != 0
    sh.opt_u = b & 2 != 0
    sh.opt_x = b & 4 != 0
    sh.opt_f = b & 8 != 0
    sh.opt_n = b & 16 != 0
    sh.opt_v = b & 32 != 0
    sh.opt_a = b & 64 != 0
    sh.opt_bigc = b & 128 != 0
    sh.opt_vi = b & 256 != 0
    sh.opt_emacs = b & 512 != 0
}

/// Where a frame's record keeps its fixed fields on `fr_int`.
const FR_OPTS: int = 0

const FR_LOOPS: int = 1

const FR_FDEPTH: int = 2

const FR_DOTS: int = 3

const FR_MASK: int = 4

const FR_LOCALS: int = 5

const FR_LFRAMES: int = 6

const FR_NPOS: int = 7

const FR_NFDS: int = 8

/// The descriptor table follows the fixed fields.
const FR_FDS: int = 9

/// Start a subshell's frame: everything `frame_close` puts back.
fn frame_open(mut sh: Sh) {
    (mut sh.jframes).push(sh.jtab.len)
    (mut sh.fr_ibase).push(sh.fr_int.len)
    (mut sh.fr_sbase).push(sh.fr_str.len)
    (mut sh.fr_int).push(opts_bits(sh))
    (mut sh.fr_int).push(sh.loops)
    (mut sh.fr_int).push(sh.fdepth)
    (mut sh.fr_int).push(sh.dots)
    (mut sh.fr_int).push(sh.mask)
    (mut sh.fr_int).push(sh.lnames.len)
    (mut sh.fr_int).push(sh.lframes.len)
    (mut sh.fr_int).push(sh.pos.len)
    (mut sh.fr_int).push(sh.fds.len)
    var k = 0
    while k < sh.fds.len {
        (mut sh.fr_int).push(sh.fds[k])
        k += 1
    }
    (mut sh.fr_str).push(sh.arg0)
    (mut sh.fr_str).push(sh.phys)
    k = 0
    while k < sh.pos.len {
        (mut sh.fr_str).push(sh.pos[k])
        k += 1
    }
}

/// End the innermost frame: the journal played back, the record put
/// back, the stacks cut to where the frame began.
fn frame_close(mut sh: Sh) {
    let jb = (mut sh.jframes).pop() else 0
    journal_back(mut sh, jb)
    let ib = (mut sh.fr_ibase).pop() else 0
    let sb = (mut sh.fr_sbase).pop() else 0
    set_opts_bits(mut sh, sh.fr_int[ib + FR_OPTS])
    sh.loops = sh.fr_int[ib + FR_LOOPS]
    sh.fdepth = sh.fr_int[ib + FR_FDEPTH]
    sh.dots = sh.fr_int[ib + FR_DOTS]
    let nl = sh.fr_int[ib + FR_LOCALS]
    while sh.lnames.len > nl {
        let _n = (mut sh.lnames).pop() else ""
        let _v = (mut sh.lvals).pop() else ""
        let _s = (mut sh.lset).pop() else false
        let _e = (mut sh.lexp).pop() else false
    }
    let nf = sh.fr_int[ib + FR_LFRAMES]
    while sh.lframes.len > nf {
        let _f = (mut sh.lframes).pop() else 0
    }
    sh.arg0 = sh.fr_str[sb]
    let np = sh.fr_int[ib + FR_NPOS]
    (mut sh.pos).clear()
    var k = 0
    while k < np {
        (mut sh.pos).push(sh.fr_str[sb + 2 + k])
        k += 1
    }
    restore_fds(mut sh, ib + FR_FDS, sh.fr_int[ib + FR_NFDS])
    let phys = sh.fr_str[sb + 1]
    if phys.len > 0 && phys != sh.phys {
        os_chdir(phys) else |_| {}
        sh.phys = phys
    }
    restore_mask(mut sh, sh.fr_int[ib + FR_MASK])
    while sh.fr_int.len > ib {
        let _i = (mut sh.fr_int).pop() else 0
    }
    while sh.fr_str.len > sb {
        let _s = (mut sh.fr_str).pop() else ""
    }
}

/// Put the descriptor table back to the `n` handles a frame recorded at
/// `fr_int[at..]`, closing every handle pelt opened that the table no
/// longer names. Written in place.
fn restore_fds(mut sh: Sh, at: int, n: int) {
    flush(mut sh)
    for h in sh.fds {
        if h >= 3 && !frame_names(sh, at, n, h) {
            fs_close(h) else |_| {}
        }
    }
    while sh.fds.len > n {
        let _h = (mut sh.fds).pop() else 0
    }
    var k = 0
    while k < n {
        if k < sh.fds.len {
            sh.fds[k] = sh.fr_int[at + k]
        } else {
            (mut sh.fds).push(sh.fr_int[at + k])
        }
        k += 1
    }
}

fn frame_names(sh: Sh, at: int, n: int, h: int) -> bool {
    var k = 0
    while k < n {
        if sh.fr_int[at + k] == h {
            return true
        }
        k += 1
    }
    false
}

/// Before a write to table `tab` at `name` inside a frame: record what
/// is there, unless this frame recorded it already.
fn jot(mut sh: Sh, tab: int, name: str) {
    if sh.jframes.len == 0 {
        return
    }
    let base = sh.jframes[sh.jframes.len - 1]
    let at = sh.jseen[name] else -1
    if at >= base && at < sh.jtab.len && sh.jtab[at] == tab && sh.jname[at] == name {
        return
    }
    var had = false
    var s = ""
    var i = 0
    if tab == J_VAL {
        had = has_var(sh, name)
        s = sh.vals[name] else ""
    } else if tab == J_TRAP {
        let a = sh.traps[name] else ""
        had = trap_set(sh, name)
        s = a
    } else if tab == J_FN {
        i = sh.funcs[name] else -1
        had = i >= 0
    } else if tab == J_EXP {
        had = marked(sh.exported, name)
        let e = sh.exported[name] else false
        i = if e then 1 else 0
    } else {
        had = marked(sh.ronly, name)
        let r = sh.ronly[name] else false
        i = if r then 1 else 0
    }
    (mut sh.jtab).push(tab)
    (mut sh.jname).push(name)
    (mut sh.jstr).push(s)
    (mut sh.jint).push(i)
    (mut sh.jhad).push(had)
    sh.jseen[name] = sh.jtab.len - 1
}

/// Whether the mark map `m` has an entry for `name` (true or false).
fn marked(m: Map[str, bool], name: str) -> bool {
    let _b = m[name] else {
        return false
    }
    true
}

fn trap_set(sh: Sh, name: str) -> bool {
    let _a = sh.traps[name] else {
        return false
    }
    true
}

/// Play the journal back to entry `base`, newest first.
fn journal_back(mut sh: Sh, base: int) {
    while sh.jtab.len > base {
        let tab = (mut sh.jtab).pop() else 0
        let name = (mut sh.jname).pop() else ""
        let s = (mut sh.jstr).pop() else ""
        let i = (mut sh.jint).pop() else 0
        let had = (mut sh.jhad).pop() else false
        if tab == J_VAL {
            if had {
                sh.vals[name] = s
            } else {
                let _v = (mut sh.vals).remove(name) else ""
            }
        } else if tab == J_TRAP {
            if had {
                sh.traps[name] = s
            } else {
                let _t = (mut sh.traps).remove(name) else ""
            }
        } else if tab == J_FN {
            if had {
                sh.funcs[name] = i
            } else {
                let _f = (mut sh.funcs).remove(name) else 0
            }
        } else if tab == J_EXP {
            if had {
                sh.exported[name] = i == 1
            } else {
                let _e = (mut sh.exported).remove(name) else false
            }
        } else if had {
            sh.ronly[name] = i == 1
        } else {
            let _r = (mut sh.ronly).remove(name) else false
        }
    }
}

// The writers: every write to the five tables goes through one of these.

fn vset(mut sh: Sh, name: str, v: str) {
    jot(mut sh, J_VAL, name)
    sh.vals[name] = v
}

fn vdel(mut sh: Sh, name: str) {
    jot(mut sh, J_VAL, name)
    let _v = (mut sh.vals).remove(name) else ""
}

fn xset(mut sh: Sh, name: str, on: bool) {
    jot(mut sh, J_EXP, name)
    sh.exported[name] = on
}

fn xdel(mut sh: Sh, name: str) {
    jot(mut sh, J_EXP, name)
    let _e = (mut sh.exported).remove(name) else false
}

fn rset(mut sh: Sh, name: str) {
    jot(mut sh, J_RO, name)
    sh.ronly[name] = true
}

fn rdel(mut sh: Sh, name: str) {
    jot(mut sh, J_RO, name)
    let _r = (mut sh.ronly).remove(name) else false
}

fn fnset(mut sh: Sh, name: str, body: int) {
    jot(mut sh, J_FN, name)
    sh.funcs[name] = body
}

fn fndel(mut sh: Sh, name: str) {
    jot(mut sh, J_FN, name)
    let _f = (mut sh.funcs).remove(name) else 0
}

fn tset(mut sh: Sh, name: str, action: str) {
    jot(mut sh, J_TRAP, name)
    sh.traps[name] = action
}

fn tdel(mut sh: Sh, name: str) {
    jot(mut sh, J_TRAP, name)
    let _t = (mut sh.traps).remove(name) else ""
}

/// Every name `trap` can record a condition under (`sh.builtin`'s
/// `trap_name`), in a fixed order; "" past the end. A literal each, so
/// walking them allocates nothing.
fn trap_cond(i: int) -> str {
    match i {
        0 => "EXIT",
        1 => "HUP",
        2 => "INT",
        3 => "QUIT",
        4 => "ILL",
        5 => "TRAP",
        6 => "ABRT",
        7 => "FPE",
        8 => "KILL",
        9 => "SEGV",
        10 => "PIPE",
        11 => "ALRM",
        12 => "TERM",
        13 => "USR1",
        14 => "USR2",
        15 => "CHLD",
        16 => "CONT",
        17 => "TSTP",
        _ => "",
    }
}

/// A subshell starts with its traps reset (XCU 2.12): a trap with an
/// action is removed; an ignored one (`trap '' …`) stays ignored. In
/// place, through the journal, so the frame puts them back.
fn traps_reset(mut sh: Sh) {
    if sh.traps.len == 0 {
        return
    }
    var i = 0
    loop {
        let c = trap_cond(i)
        if c.len == 0 {
            break
        }
        let a = sh.traps[c] else ""
        if a.len > 0 {
            tdel(mut sh, c)
        }
        i += 1
    }
}

/// Every trap removed (a program run in a subshell's place by `exec`
/// leaves no `EXIT` trap to run), through the journal.
fn traps_clear(mut sh: Sh) {
    var i = 0
    loop {
        let c = trap_cond(i)
        if c.len == 0 {
            break
        }
        if trap_set(sh, c) {
            tdel(mut sh, c)
        }
        i += 1
    }
}

fn names_handle(fds: List[int], h: int) -> bool {
    for x in fds {
        if x == h {
            return true
        }
    }
    false
}

/// The handle behind shell descriptor `fd`, or `FD_CLOSED`.
fn fd_get(sh: Sh, fd: int) -> int {
    if fd < 0 || fd >= sh.fds.len {
        return FD_CLOSED
    }
    sh.fds[fd]
}

fn fd_set(mut sh: Sh, fd: int, h: int) {
    if fd == 1 {
        flush(mut sh)
    }
    while sh.fds.len <= fd {
        (mut sh.fds).push(FD_CLOSED)
    }
    sh.fds[fd] = h
}

// ------------------------------------------------------------ variables

fn has_var(sh: Sh, name: str) -> bool {
    // the map's own lookup: `std.map`'s `has` builds a list of the
    // pairs per call (s216 measured it)
    let _v = sh.vals[name] else {
        return false
    }
    true
}

fn value_of(sh: Sh, name: str) -> str {
    sh.vals[name] else ""
}

fn is_ronly(sh: Sh, name: str) -> bool {
    sh.ronly[name] else false
}

fn is_exported(sh: Sh, name: str) -> bool {
    sh.exported[name] else false
}

/// Assign, honouring `readonly` and `set -a`. False (and nothing set)
/// when the variable is read-only; the caller reports it.
fn set_var(mut sh: Sh, name: str, value: str) -> bool {
    if sh.shadow {
        sh.bail = true
        sh.flow = F_EXIT
    }
    if is_ronly(sh, name) {
        return false
    }
    vset(mut sh, name, value)
    if sh.opt_a {
        xset(mut sh, name, true)
    }
    true
}

fn unset_var(mut sh: Sh, name: str) -> bool {
    if sh.shadow {
        sh.bail = true
        sh.flow = F_EXIT
    }
    if is_ronly(sh, name) {
        return false
    }
    vdel(mut sh, name)
    xdel(mut sh, name)
    true
}

fn ifs(sh: Sh) -> str {
    sh.vals["IFS"] else " \t\n"
}

/// `$-`: the single-letter options that are on, in the order dash
/// prints them (black-box: `set -a -C -e -f -u -v -x` shows `uaCvxfe`,
/// and an interactive shell reading standard input puts `si` before
/// `f`).
fn dash_flags(sh: Sh) -> str {
    var o = buf()
    if sh.opt_u {
        putc(mut o, 'u')
    }
    if sh.opt_a {
        putc(mut o, 'a')
    }
    if sh.opt_bigc {
        putc(mut o, 'C')
    }
    if sh.opt_v {
        putc(mut o, 'v')
    }
    if sh.opt_x {
        putc(mut o, 'x')
    }
    if sh.from_stdin {
        putc(mut o, 's')
    }
    if sh.interactive {
        putc(mut o, 'i')
    }
    if sh.opt_f {
        putc(mut o, 'f')
    }
    if sh.opt_e {
        putc(mut o, 'e')
    }
    if sh.opt_n {
        putc(mut o, 'n')
    }
    text(o)
}

// --------------------------------------------------------------- output

fn emit(mut sh: Sh, s: str) {
    for x in s.bytes() {
        (mut sh.out).push(x)
    }
    if sh.out.len >= 65536 {
        flush(mut sh)
    }
}

fn emitc(mut sh: Sh, c: char) {
    (mut sh.out).push(c as int as byte)
}

fn emitb(mut sh: Sh, n: int) {
    (mut sh.out).push(n as byte)
}

/// Write what is buffered to wherever descriptor 1 now is: a handle, the
/// open capture, or nowhere (closed).
fn flush(mut sh: Sh) {
    if sh.out.len == 0 {
        return
    }
    let h = fd_get(sh, 1)
    if is_cap(h) {
        for x in sh.out {
            (mut sh.cap_data).push(x)
        }
    } else if h >= 0 {
        fs_write_chunk(h, sh.out) else |_| {}
    }
    sh.out = List[byte]()
}

/// Bytes for shell descriptor `fd` other than 1 (a diagnostic, a prompt,
/// a trace line), after whatever descriptor 1 has pending.
fn write_fd(mut sh: Sh, fd: int, s: str) {
    flush(mut sh)
    let h = fd_get(sh, fd)
    if is_cap(h) {
        for x in s.bytes() {
            (mut sh.cap_data).push(x)
        }
        return
    }
    if h == 2 {
        eprint_raw(s)
        return
    }
    if h >= 0 {
        var b = List[byte]()
        for x in s.bytes() {
            (mut b).push(x)
        }
        fs_write_chunk(h, b) else |_| {}
    }
}

/// Open a capture: descriptor 1 becomes its marker until `cap_end`.
fn cap_begin(mut sh: Sh) {
    flush(mut sh)
    (mut sh.caps).push(sh.cap_data.len)
    (mut sh.cap_was).push(fd_get(sh, 1))
    fd_set(mut sh, 1, cap_mark(sh.caps.len))
}

/// Close the innermost capture and answer what it caught, as bytes.
fn cap_end_bytes(mut sh: Sh) -> List[byte] {
    flush(mut sh)
    let start = (mut sh.caps).pop() else 0
    let was = (mut sh.cap_was).pop() else 1
    let part = sh.cap_data[start..sh.cap_data.len]
    sh.cap_data = sh.cap_data[0..start]
    fd_set(mut sh, 1, was)
    part
}

fn cap_end(mut sh: Sh) -> str {
    let part = cap_end_bytes(mut sh)
    text(Buf { b: part })
}

/// A diagnostic: pelt's own words, on descriptor 2, after whatever
/// standard output is pending. In the shadow state (`sh.fast`) nothing
/// is written: the command is run again the ordinary way, which says it.
fn diag(mut sh: Sh, msg: str) {
    if sh.shadow {
        sh.bail = true
        sh.flow = F_EXIT
        return
    }
    if sh.from_stdin {
        // no script to name: the line counts from the session's start
        if sh.line > 0 {
            write_fd(mut sh, 2, "pelt: line {sh.line}: {msg}\n")
        } else {
            write_fd(mut sh, 2, "pelt: {msg}\n")
        }
        return
    }
    if sh.line > 0 {
        write_fd(mut sh, 2, "pelt: {sh.name}: line {sh.line}: {msg}\n")
    } else {
        write_fd(mut sh, 2, "pelt: {sh.name}: {msg}\n")
    }
}

/// A shell error that ends a non-interactive shell (XCU 2.8.1): the
/// message, status `code`, and the exit flow. Inside a subshell or a
/// command substitution it ends only that. `abort` marks the exit as an
/// error's, which an interactive shell turns into "abandon this command
/// and prompt again" (`sh.interact`); every other way to `F_EXIT`
/// (`exit`, `return` outside a function, `exec`, `set -e`) clears it.
fn fatal(mut sh: Sh, msg: str, code: int) {
    diag(mut sh, msg)
    sh.status = code
    sh.flow = F_EXIT
    sh.flow_n = 0
    sh.abort = true
}

// ---------------------------------------------------------------- quoting

/// `s` in single quotes, a quote inside it written `'"'"'`: the form
/// `set`, `export -p`, `readonly -p` and `trap` print, which a shell
/// reads back as `s`.
fn squote(s: str) -> str {
    var o = buf()
    putc(mut o, '\'')
    var i = 0
    while i < s.len {
        if ch(s, i) == '\'' {
            put(mut o, "'\"'\"'")
        } else {
            putb(mut o, byte_at(s, i))
        }
        i += 1
    }
    putc(mut o, '\'')
    text(o)
}
