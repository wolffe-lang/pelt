//! sh.state — the shell's execution environment (XCU 2.13 of 2024,
//! "Shell Execution Environment"): variables, functions, positional
//! parameters, options, traps, and where output goes.
//!
//! References consulted: POSIX.1-2024 XCU 2.5 (parameters and
//! variables), 2.12 (the execution environment), the `set`, `export`,
//! `readonly` and `trap` pages; black-box runs of `dash` 0.5.13.4.
//!
//! **Descriptors.** wolf has no `dup2` for a program's own
//! descriptors, so pelt keeps its own table, `fds`: shell descriptor
//! `n` is a wolf handle (0..2 the process's standard streams, 3 and up
//! a handle pelt opened), `FD_CLOSED`, or a capture marker (below).
//! Everything pelt writes or reads goes through it, and a child gets
//! the whole table as its descriptor map (`os_spawn_fds`), so a
//! redirection means the same to a built-in and to a program.
//!
//! **Output.** Everything pelt itself writes to standard output goes
//! through `out`, a byte buffer for whatever descriptor 1 is now,
//! flushed in 64 KiB pieces, before any child runs, before any
//! diagnostic, before descriptor 1 changes, and at exit — so pelt's
//! bytes and a child's interleave in program order. A command
//! substitution is a CAPTURE: descriptor 1 becomes the marker
//! `cap_mark(level)`, what is flushed there lands in `cap_data` after
//! the position the capture began at, and its result is cut back out.
//!
//! **Subshells in process.** Since wolf 0.2.34 most subshells are
//! processes (`sh.fork`); the ones that are not — a `( cmd )` or
//! `$( cmd )` the fast path finishes, a pipeline stage that is a program
//! or a pure built-in, and every subshell on a host that does not fork
//! (the checked machine) — run in the shell's own state, inside
//! a FRAME (`frame_open`, `frame_close`) that puts it back after:
//! variables, functions, positional parameters, options, traps, the
//! `local` stack, the descriptor table, the working directory and the
//! file mode creation mask. The process environment a child sees is
//! made to match the variables before every spawn (`sh.exec`'s
//! `sync_env`), so a subshell's `export` or `unset` ends with it too.
//!
//! **Memory (pelt#19).** The root region frees nothing, so a frame
//! copies nothing: every write to the variables, the export and
//! read-only marks, the functions and the traps goes through one helper
//! per table (`vset`, `xset`, `rset`, `fnset`, `tset` and their `…del`)
//! that, inside a frame, first records the value it replaces — once per
//! name and frame — on the JOURNAL; closing the frame plays the journal
//! back. The frame's scalars, the descriptor table and `$@` go on two
//! stacks. All of these are lists the state keeps and reuses, so a
//! subshell that writes nothing allocates nothing, and one that writes
//! keeps only what it wrote (before sh08, `snap` and `restore` copied
//! the whole state twice per subshell: 10 KB a pipeline).

const F_NONE: int = 0

const F_BREAK: int = 1

const F_CONTINUE: int = 2

const F_RETURN: int = 3

const F_EXIT: int = 4

/// `$!` for an asynchronous list pelt ran itself: above any process id
/// a host hands out (linux's ceiling is 2^22, macOS's 99,998).
const NO_PID_BASE: int = 1073741824

/// A shell descriptor that is not open.
const FD_CLOSED: int = -1

/// Capture markers are `CAP_BASE - level` (level 1 is the outermost
/// open capture).
const CAP_BASE: int = -10

fn cap_mark(level: int) -> int {
    CAP_BASE - level
}

fn is_cap(h: int) -> bool {
    h <= CAP_BASE
}

struct Sh {
    ast: Ast,
    vals: Map[str, str],
    exported: Map[str, bool],
    ronly: Map[str, bool],
    funcs: Map[str, int],
    /// The utilities the command search found (XCU 2.9.1.4, `hash`):
    /// name → path, for the value of `PATH` in `hash_path` (`sh.exec`'s
    /// `hash_find`).
    hash: Map[str, str],
    hash_path: str,
    /// The frame of a pipeline stage that is a simple command of the
    /// shell itself (no enclosing frame), and the function depth it runs
    /// at: what that command's search finds outlives the stage (dash
    /// looks such a command up before it forks); every other frame's
    /// finds are journaled and end with it.
    hash_keep: int,
    hash_keep_depth: int,
    pos: List[str],
    arg0: str,
    status: int,
    flow: int,
    flow_n: int,
    opt_e: bool,
    opt_u: bool,
    opt_x: bool,
    opt_f: bool,
    opt_n: bool,
    opt_v: bool,
    opt_a: bool,
    opt_bigc: bool,
    /// `set -o pipefail` (XCU 2.9.2): a pipeline answers its rightmost
    /// failing stage's status.
    opt_pipefail: bool,
    /// The editing modes (`sh.edit`): at most one is on.
    opt_vi: bool,
    opt_emacs: bool,
    /// `set -o autocd` (ruling #113, pelt#49): an interactive shell runs
    /// a command that names a directory as `cd` (`sh.builtin`'s
    /// `run_autocd`). Off by default.
    opt_autocd: bool,
    /// Friendly keys remain opt-in until the pin exposes argv[0] (#904).
    opt_friendly: bool,
    opt_friendly_keys: bool,
    opt_suggest: bool,
    opt_histsearch: bool,
    opt_highlight: bool,
    opt_abbr: bool,
    opt_histexpand: bool,
    opt_complete: bool,
    opt_prompt_friendly: bool,
    ps1_explicit: bool,
    right_prompt: str,
    prompt_host: str,
    prompt_vcs: PromptVcs,
    posix_mode: bool,
    /// `set -o ignoreeof`: an interactive shell's end of file is not its
    /// end (`sh.interact`'s `run_lines`)
    opt_ignoreeof: bool,
    /// End-of-files in a row at the prompt with `ignoreeof` on
    eof_count: int,
    /// `MAIL`/`MAILPATH` (`sh.interact`'s `mail_check`): when the last
    /// check was, in seconds (-1: none yet), and each mailbox's
    /// modification time then (-1: none there)
    mail_last: int,
    mail_seen: Map[str, int],
    /// The line editor's history and what outlives a line.
    ed: EdKeep,
    no_e: int,
    loops: int,
    fdepth: int,
    dots: int,
    traps: Map[str, str],
    out: List[byte],
    /// The descriptor table: shell descriptor → handle (module doc).
    fds: List[int],
    /// Where each open capture began in `cap_data`, and what
    /// descriptor 1 was before it.
    caps: List[int],
    cap_was: List[int],
    cap_data: List[byte],
    /// Reused read staging, so per-read scratch never escapes its region.
    cap_read: List[byte],
    /// Redirection frames: (descriptor, what it was) pairs to put back,
    /// and the handles the frame opened, each frame's start in `rs_fd`
    /// and `rs_open`.
    rs_fd: List[int],
    rs_was: List[int],
    rs_open: List[int],
    rs_frames: List[int],
    rs_oframes: List[int],
    /// `set -m` and `set -b` (XCU 2.11): job control, and a job's
    /// notice written as soon as it changes.
    opt_m: bool,
    opt_b: bool,
    /// Job control in force (`sh.jobs`): the terminal it hands to a
    /// foreground job (a handle, -1 for none), the shell's own group,
    /// the group it was started in when it moved out of it (-1 if it
    /// did not), and the meanings it ignores for itself and gives back
    /// to its children (`SUSPEND`, `BG_WRITE`).
    jc_on: bool,
    jc_tty: int,
    jc_pgid: int,
    jc_orig: int,
    jc_ign: int,
    /// `CHILD` is listened for (a wait for a job, `sh.jobs`); a `CHILD`
    /// a wait took that a trap on `CHLD` is owed.
    jc_child: bool,
    chld_owed: bool,
    /// `exit` with stopped jobs warned at this line, and at the line
    /// before (the second `exit` in a row leaves).
    exit_warned: bool,
    exit_warned_prev: bool,
    /// The job a spawn joins (a slot, -1 for none), the terminal handed
    /// to its group (-1 for none), and the node a new job's command
    /// text is read from.
    jc_build: int,
    jc_give: int,
    /// The next simple command is a job's last stage: a program there is
    /// started and not waited for (`run_pipeline`).
    jc_last: bool,
    /// Inside a pipeline that is no job (`sh.jobs`'s `pipe_is_job`).
    jc_hold: bool,
    jc_node: int,
    /// The job table (`sh.jobs`): slot k is job number k + 1. A slot is
    /// two `int`s (pelt#39: nine parallel lists kept ~140 B a job in the
    /// root, `notes/sh22-evidence/witness/jobcost`), read and written only
    /// through `sh.jobs`'s `slot_*` accessors: `jb_a` packs its state
    /// (`JB_FREE` or a job's), the status of a list pelt ran itself (or
    /// of a job whose one process ended, with job control off), and the
    /// flags told, late, waited and held; `jb_b` packs the number `$!`
    /// gave it (a process id, or for a list pelt ran itself a number no
    /// process has, `NO_PID_BASE` and up) and its last use (a stamp of
    /// `jb_clock`, 0 for none: `+` is the most recent, `-` the one
    /// before). The group is packed above the status in `jb_a`. Command
    /// text references grow only with job control; repeated texts share
    /// one reusable pool entry, returned after the last job releases it.
    jobs_pick: List[int],
    jb_a: List[int],
    jb_b: List[int],
    jb_text: List[int],
    jb_texts: List[str],
    jb_text_uses: List[int],
    /// How many slots `wait` marked (the waited flag), and the lowest slot
    /// that may be free: so starting a job is not a walk of the table.
    jb_nwaited: int,
    jb_free_lo: int,
    /// When the next job's start polls the children (`sh.jobs`'s
    /// `jb_reap`): after `jb_reap_at` more starts.
    jb_reap_since: int,
    jb_reap_at: int,
    jb_seq: int,
    jb_clock: int,
    /// The processes of the jobs: the slot, the child's handle and
    /// process id, its status (`PR_RUN`, or as `os_wait_poll` answered
    /// it: an exit code, `-N`, `256 + N` for a stop), its command text.
    pr_job: List[int],
    pr_h: List[int],
    pr_pid: List[int],
    pr_st: List[int],
    pr_text: List[str],
    /// What a poll answered for a child no job holds (a pipeline stage
    /// a blocking wait is still owed): its handle and status.
    stash_h: List[int],
    stash_st: List[int],
    /// The poll taken as a line was read (`sh.jobs`'s `jc_take`).
    def_h: List[int],
    def_st: List[int],
    /// `$!`: the last asynchronous list's id, or 0 for none.
    last_bg: int,
    /// Signals (`sh.signal`): the meanings the process now listens for
    /// and ignores, the ones this shell (not an enclosing one) polls,
    /// whether a trap action is running and `$?` when it began, and an
    /// interactive Ctrl-C on its way back to the prompt.
    sig_listen: int,
    sig_ignore: int,
    sig_mine: int,
    /// The meanings ignored when the shell started (`sig_boot`): never
    /// trapped, never reset. -1 until read.
    sig_ign0: int,
    in_trap: bool,
    trap_status: int,
    intr: bool,
    at_prompt: bool,
    /// Whether the last `run_external` started its program.
    started: bool,
    /// Whether `command_not_found_handle` is running (pelt#42): a name
    /// not found inside it is the plain not-found, so it is never called
    /// again from within itself (`sh.exec`'s `unfound`).
    in_cnf: bool,
    /// A pipeline stage's external command is started, not waited for
    /// (`nowait`); its handle lands in `stage_child`, and `stage_w` is
    /// the pipe its descriptor 1 goes to (the stage's capture level is
    /// `stage_cap`).
    nowait: bool,
    /// The simple command `run_async` starts after `&`: started, not
    /// waited for, on the fast path as a stage is (`run_simple`).
    bg_simple: bool,
    /// Argument lists for the built-ins the ordinary path runs from
    /// their fields' text (`sh.exec`'s `run_builtin_enc`): each taken,
    /// filled and given back cleared, so a turn makes no list in the
    /// root (pelt#33).
    argpool: List[List[str]],
    /// Parsers for the text `eval`, `.` and a trap's action run
    /// (`sh.exec`'s `eval_from`): each taken, reset and given back, so a
    /// turn makes no parser in the root (pelt#39: a fresh one is
    /// thirteen lists, ~700 B an `eval`).
    ppool: List[P],
    stage_child: int,
    /// A stage's built-in run on the fast path: the read end its output
    /// waits behind for the next stage, or -1.
    stage_in: int,
    stage_w: int,
    stage_cap: int,
    /// Temporary-file captures of children still running: the read
    /// handle and the capture level each belongs to.
    pend_cap: List[int],
    pend_level: List[int],
    /// The working directory as `os_cwd` last answered it ("" until
    /// asked): what a subshell puts back.
    phys: str,
    /// A copy of the state that runs a simple command inside
    /// `copy region` (`sh.fast`): it must not write anything the real
    /// state keeps, so whatever would (an assignment, a diagnostic, a
    /// command substitution) sets `bail` and the command is run again
    /// the ordinary way.
    shadow: bool,
    bail: bool,
    /// In the shadow: an assignment an expansion makes is kept in the
    /// shadow and recorded on its `sstk` (name, value, …) for the real
    /// state, instead of bailing (`sh.exec`'s `take_deferred`).
    defer_ok: bool,
    /// End of file seen on descriptor 0 (a terminal's Ctrl-D is one
    /// zero-byte read; the next read would wait for more typing).
    eof0: bool,
    name: str,
    line: int,
    cs_status: int,
    cs_ran: bool,
    /// The command substitutions parsed so far (`sh.expand`'s
    /// `cmdsub_at`): a word → its latest entry `e`; `cs[4e..4e+4]` is
    /// the offset of the `$(` in the word, the body, the index past the
    /// `)`, and the word's previous entry. Keyed by the word itself, a
    /// view of the tree, so a lookup builds nothing.
    cs_word: Map[str, int],
    cs: List[int],
    /// Backquoted command substitutions share it: keyed by the text
    /// between the backquotes, at offset -1 (outside double quotes) or
    /// -2 (inside).
    sub: int,
    lnames: List[str],
    lvals: List[str],
    lset: List[bool],
    lexp: List[bool],
    lframes: List[int],
    exiting: bool,
    gopt_sub: int,
    gopt_ind: int,
    interactive: bool,
    from_stdin: bool,
    abort: bool,
    /// Directories pathname expansion has listed: the count the
    /// table checks read (pelt#3: a word that is not a pattern reads
    /// none).
    dir_reads: int,
    /// Who the shell runs as (`sh.util`'s `load_ident`): whether that is
    /// known yet, the effective user and group ids, the supplementary
    /// groups as decimal numbers between spaces (a `str`, so the copy
    /// every fast-path command makes of the state allocates nothing).
    id_state: int,
    euid: int,
    egid: int,
    groups: str,
    /// The file mode creation mask (`sh.umask`): the process's as pelt
    /// last set or read it, and the one the shell started with; -1
    /// until a `umask` has run.
    mask: int,
    mask0: int,
    /// `$$`: the shell's process id, read once at start (`sh.main`), so a
    /// subshell's process answers the shell's, as XCU 2.5.2 asks (0 until
    /// read: `os_pid()` then).
    pid: int,
    /// Subshells as processes (`sh.fork`): whether the host forks (-1 not
    /// asked yet, 0 no: the checked machine and windows answer
    /// `unsupported`, 1 yes); the process kind the next simple command
    /// forks as when the fast path does not finish it, and whether it
    /// keeps the shell's traps
    /// (`$(trap)`); in a forked child, the simple command that may replace
    /// the child (`exec`'s way) as its last; the read end of the pipeline
    /// stage's pipe, which the stage's child closes; the meanings a child
    /// holds ignored until a trap of its own names them, and the two an
    /// asynchronous list's children start ignoring with job control off.
    fork_ok: int,
    fk_mode: int,
    fk_keep: bool,
    exec_last: int,
    exec_here: bool,
    stage_r: int,
    hold_ign: int,
    async_ign: int,
    /// A forked subshell of an interactive shell (`sh.fork`): it behaves as
    /// a non-interactive shell (XCU 2.13), but `$-` still shows `i`, as
    /// dash's does, and a name not found still calls
    /// `command_not_found_handle` (`sh.exec`'s `unfound`, pelt#42).
    sub_of_i: bool,
    /// The `wait` built-in is running (`sh.jobs`'s `SL_REAPED`, pelt#47).
    in_wait: bool,
    /// The journal (module doc, `jot`).
    ji: List[int],
    jn: List[str],
    /// Where the innermost frame's record starts on `istk`, or -1.
    fr_top: int,
    /// Two stacks the state keeps and reuses (`cut_istk`): frames'
    /// records and pipelines' children; frames' records, calls' saved
    /// `$@` and `for` loops' items.
    istk: List[int],
    sstk: List[str],
}

fn new_sh(name: str) -> Sh {
    Sh {
        ast: new_ast(),
        vals: Map[str, str](),
        exported: Map[str, bool](),
        ronly: Map[str, bool](),
        funcs: Map[str, int](),
        hash: Map[str, str](),
        hash_path: "",
        hash_keep: -1,
        hash_keep_depth: 0,
        pos: List[str](),
        arg0: name,
        status: 0,
        flow: F_NONE,
        flow_n: 0,
        opt_e: false,
        opt_u: false,
        opt_x: false,
        opt_f: false,
        opt_n: false,
        opt_v: false,
        opt_a: false,
        opt_bigc: false,
        opt_pipefail: false,
        opt_vi: false,
        opt_emacs: false,
        opt_autocd: false,
        opt_friendly: false,
        opt_friendly_keys: true,
        opt_suggest: false,
        opt_histsearch: false,
        opt_highlight: false,
        opt_abbr: false,
        opt_histexpand: false,
        opt_complete: false,
        opt_prompt_friendly: false,
        ps1_explicit: false,
        right_prompt: "",
        prompt_host: "",
        prompt_vcs: empty_prompt_vcs(),
        posix_mode: false,
        opt_ignoreeof: false,
        eof_count: 0,
        mail_last: -1,
        mail_seen: Map[str, int](),
        ed: new_edkeep(),
        no_e: 0,
        loops: 0,
        fdepth: 0,
        dots: 0,
        traps: Map[str, str](),
        out: List[byte](),
        fds: std_fds(),
        caps: List[int](),
        cap_was: List[int](),
        cap_data: List[byte](),
        cap_read: List[byte](),
        rs_fd: List[int](),
        rs_was: List[int](),
        rs_open: List[int](),
        rs_frames: List[int](),
        rs_oframes: List[int](),
        opt_m: false,
        opt_b: false,
        jc_on: false,
        jc_tty: -1,
        jc_pgid: 0,
        jc_orig: -1,
        jc_ign: 0,
        jc_child: false,
        chld_owed: false,
        exit_warned: false,
        exit_warned_prev: false,
        jc_build: -1,
        jc_give: -1,
        jc_last: false,
        jc_hold: false,
        jc_node: -1,
        jobs_pick: List[int](),
        jb_a: List[int](),
        jb_b: List[int](),
        jb_text: List[int](),
        jb_texts: List[str](),
        jb_text_uses: List[int](),
        jb_nwaited: 0,
        jb_free_lo: 0,
        jb_reap_since: 0,
        jb_reap_at: 0,
        jb_seq: 0,
        jb_clock: 0,
        pr_job: List[int](),
        pr_h: List[int](),
        pr_pid: List[int](),
        pr_st: List[int](),
        pr_text: List[str](),
        stash_h: List[int](),
        stash_st: List[int](),
        def_h: List[int](),
        def_st: List[int](),
        last_bg: 0,
        sig_listen: 0,
        sig_ignore: 0,
        sig_mine: 0,
        sig_ign0: -1,
        in_trap: false,
        trap_status: 0,
        intr: false,
        at_prompt: false,
        started: false,
        in_cnf: false,
        nowait: false,
        bg_simple: false,
        argpool: List[List[str]](),
        ppool: List[P](),
        stage_child: -1,
        stage_in: -1,
        stage_w: -1,
        stage_cap: 0,
        pend_cap: List[int](),
        pend_level: List[int](),
        phys: "",
        shadow: false,
        bail: false,
        defer_ok: false,
        eof0: false,
        name: name,
        line: 0,
        cs_status: 0,
        cs_ran: false,
        cs_word: Map[str, int](),
        cs: List[int](),
        sub: 0,
        lnames: List[str](),
        lvals: List[str](),
        lset: List[bool](),
        lexp: List[bool](),
        lframes: List[int](),
        exiting: false,
        gopt_sub: 1,
        gopt_ind: 0,
        interactive: false,
        from_stdin: false,
        abort: false,
        dir_reads: 0,
        id_state: 0,
        euid: -1,
        egid: -1,
        groups: "",
        mask: -1,
        mask0: -1,
        pid: 0,
        fork_ok: -1,
        fk_mode: 0,
        fk_keep: false,
        exec_last: -1,
        exec_here: false,
        stage_r: -1,
        hold_ign: 0,
        async_ign: 0,
        sub_of_i: false,
        in_wait: false,
        ji: List[int](),
        jn: List[str](),
        fr_top: -1,
        istk: List[int](),
        sstk: List[str](),
    }
}

/// The table a shell starts with: 0, 1 and 2 its own standard streams.
fn std_fds() -> List[int] {
    var f = List[int]()
    (mut f).push(0)
    (mut f).push(1)
    (mut f).push(2)
    f
}

// ------------------------------------------------------------- frames

const J_VAL: int = 1

const J_EXP: int = 2

const J_RO: int = 3

const J_FN: int = 4

const J_TRAP: int = 5

const J_HASH: int = 6

const J_ALIAS: int = 7

/// The options as one number: what a frame keeps of them.
fn opts_bits(sh: Sh) -> int {
    var b = 0
    if sh.opt_e {
        b = b | 1
    }
    if sh.opt_u {
        b = b | 2
    }
    if sh.opt_x {
        b = b | 4
    }
    if sh.opt_f {
        b = b | 8
    }
    if sh.opt_n {
        b = b | 16
    }
    if sh.opt_v {
        b = b | 32
    }
    if sh.opt_a {
        b = b | 64
    }
    if sh.opt_bigc {
        b = b | 128
    }
    if sh.opt_vi {
        b = b | 256
    }
    if sh.opt_emacs {
        b = b | 512
    }
    if sh.opt_pipefail {
        b = b | 1024
    }
    if sh.opt_m {
        b = b | 2048
    }
    if sh.opt_b {
        b = b | 4096
    }
    if sh.opt_autocd {
        b = b | 8192
    }
    if sh.opt_friendly {
        b = b | 16384
    }
    if sh.opt_friendly_keys {
        b = b | 32768
    }
    if sh.posix_mode {
        b = b | 65536
    }
    if sh.opt_ignoreeof {
        b = b | 131072
    }
    if sh.opt_suggest { b = b | 262144 }
    if sh.opt_histsearch { b = b | 524288 }
    if sh.opt_highlight { b = b | 1048576 }
    if sh.opt_abbr { b = b | 2097152 }
    if sh.opt_histexpand { b = b | 4194304 }
    if sh.opt_complete { b = b | 8388608 }
    if sh.opt_prompt_friendly { b = b | 16777216 }
    b
}

fn set_opts_bits(mut sh: Sh, b: int) {
    sh.opt_e = b & 1 != 0
    sh.opt_u = b & 2 != 0
    sh.opt_x = b & 4 != 0
    sh.opt_f = b & 8 != 0
    sh.opt_n = b & 16 != 0
    sh.opt_v = b & 32 != 0
    sh.opt_a = b & 64 != 0
    sh.opt_bigc = b & 128 != 0
    sh.opt_vi = b & 256 != 0
    sh.opt_emacs = b & 512 != 0
    sh.opt_pipefail = b & 1024 != 0
    sh.opt_m = b & 2048 != 0
    sh.opt_b = b & 4096 != 0
    sh.opt_autocd = b & 8192 != 0
    sh.opt_friendly = b & 16384 != 0
    sh.opt_friendly_keys = b & 32768 != 0
    sh.posix_mode = b & 65536 != 0
    sh.opt_ignoreeof = b & 131072 != 0
    sh.opt_suggest = b & 262144 != 0
    sh.opt_histsearch = b & 524288 != 0
    sh.opt_highlight = b & 1048576 != 0
    sh.opt_abbr = b & 2097152 != 0
    sh.opt_histexpand = b & 4194304 != 0
    sh.opt_complete = b & 8388608 != 0
    sh.opt_prompt_friendly = b & 16777216 != 0
}

/// Where a frame's record keeps its fields on `istk`, from the record's
/// start (`fr_top`): the enclosing frame's start, where its journal and
/// its part of `sstk` begin, then what it puts back.
const FR_PREV: int = 0

const FR_JBASE: int = 1

const FR_SBASE: int = 2

const FR_OPTS: int = 3

const FR_LOOPS: int = 4

const FR_FDEPTH: int = 5

const FR_DOTS: int = 6

const FR_MASK: int = 7

const FR_LOCALS: int = 8

const FR_LFRAMES: int = 9

const FR_NPOS: int = 10

const FR_NFDS: int = 11

/// The descriptor table follows the fixed fields.
const FR_FDS: int = 12

/// Start a subshell's frame: everything `frame_close` puts back. On
/// `sstk`: `$0`, the working directory, then `$@`.
fn frame_open(mut sh: Sh) {
    let b = sh.istk.len
    (mut sh.istk).push(sh.fr_top)
    (mut sh.istk).push(sh.ji.len / 3)
    (mut sh.istk).push(sh.sstk.len)
    (mut sh.istk).push(opts_bits(sh))
    (mut sh.istk).push(sh.loops)
    (mut sh.istk).push(sh.fdepth)
    (mut sh.istk).push(sh.dots)
    (mut sh.istk).push(sh.mask)
    (mut sh.istk).push(sh.lnames.len)
    (mut sh.istk).push(sh.lframes.len)
    (mut sh.istk).push(sh.pos.len)
    (mut sh.istk).push(sh.fds.len)
    var k = 0
    while k < sh.fds.len {
        (mut sh.istk).push(sh.fds[k])
        k += 1
    }
    (mut sh.sstk).push(sh.arg0)
    (mut sh.sstk).push(sh.phys)
    k = 0
    while k < sh.pos.len {
        (mut sh.sstk).push(sh.pos[k])
        k += 1
    }
    sh.fr_top = b
}

/// End the innermost frame: the journal played back, the record put
/// back, the stacks cut to where the frame began.
fn frame_close(mut sh: Sh) {
    let b = sh.fr_top
    journal_back(mut sh, sh.istk[b + FR_JBASE])
    let sb = sh.istk[b + FR_SBASE]
    set_opts_bits(mut sh, sh.istk[b + FR_OPTS])
    sh.loops = sh.istk[b + FR_LOOPS]
    sh.fdepth = sh.istk[b + FR_FDEPTH]
    sh.dots = sh.istk[b + FR_DOTS]
    let nl = sh.istk[b + FR_LOCALS]
    while sh.lnames.len > nl {
        let _n = (mut sh.lnames).pop() else ""
        let _v = (mut sh.lvals).pop() else ""
        let _s = (mut sh.lset).pop() else false
        let _e = (mut sh.lexp).pop() else false
    }
    let nf = sh.istk[b + FR_LFRAMES]
    while sh.lframes.len > nf {
        let _f = (mut sh.lframes).pop() else 0
    }
    sh.arg0 = sh.sstk[sb]
    let np = sh.istk[b + FR_NPOS]
    (mut sh.pos).clear()
    var k = 0
    while k < np {
        (mut sh.pos).push(sh.sstk[sb + 2 + k])
        k += 1
    }
    restore_fds(mut sh, b + FR_FDS, sh.istk[b + FR_NFDS])
    let phys = sh.sstk[sb + 1]
    if phys.len > 0 && phys != sh.phys {
        os_chdir(phys) else |_| {}
        sh.phys = phys
    }
    restore_mask(mut sh, sh.istk[b + FR_MASK])
    sh.fr_top = sh.istk[b + FR_PREV]
    cut_istk(mut sh, b)
    cut_sstk(mut sh, sb)
}

/// The two stacks back to `n` entries, in place. Everything on them is
/// pushed and taken off in nested order: a frame's record, a pipeline's
/// children (`istk`); a frame's record, a call's saved `$@`, a `for`
/// loop's items (`sstk`).
fn cut_istk(mut sh: Sh, n: int) {
    if n == 0 {
        // the commonest cut, a frame or a call at the top: one store
        (mut sh.istk).clear()
        return
    }
    while sh.istk.len > n {
        let _i = (mut sh.istk).pop() else 0
    }
}

fn cut_sstk(mut sh: Sh, n: int) {
    if n == 0 {
        (mut sh.sstk).clear()
        return
    }
    while sh.sstk.len > n {
        let _s = (mut sh.sstk).pop() else ""
    }
}

/// Put the descriptor table back to the `n` handles a frame recorded at
/// `istk[at..]`, closing every handle pelt opened that the table no
/// longer names. Written in place.
fn restore_fds(mut sh: Sh, at: int, n: int) {
    flush(mut sh)
    for h in sh.fds {
        if h >= 3 && !frame_names(sh, at, n, h) {
            fs_close(h) else |_| {}
        }
    }
    while sh.fds.len > n {
        let _h = (mut sh.fds).pop() else 0
    }
    var k = 0
    while k < n {
        if k < sh.fds.len {
            sh.fds[k] = sh.istk[at + k]
        } else {
            (mut sh.fds).push(sh.istk[at + k])
        }
        k += 1
    }
}

fn frame_names(sh: Sh, at: int, n: int, h: int) -> bool {
    var k = 0
    while k < n {
        if sh.istk[at + k] == h {
            return true
        }
        k += 1
    }
    false
}

/// A function call begins: `$@` moves onto `sstk` and is emptied, in
/// place. Answers where it begins there, for `pos_pop`.
fn pos_push(mut sh: Sh) -> int {
    let base = sh.sstk.len
    var k = 0
    while k < sh.pos.len {
        (mut sh.sstk).push(sh.pos[k])
        k += 1
    }
    (mut sh.pos).clear()
    base
}

/// A function call ends: `$@` is the caller's again.
fn pos_pop(mut sh: Sh, base: int) {
    (mut sh.pos).clear()
    var k = base
    while k < sh.sstk.len {
        (mut sh.pos).push(sh.sstk[k])
        k += 1
    }
    cut_sstk(mut sh, base)
}

/// Before a write to table `tab` at `name` inside a frame: record what
/// is there, unless this frame recorded it already. Entry `e` is
/// `ji[3e..3e+3]` (the table, the int it replaced, whether there was
/// one) and `jn[2e..2e+2]` (the name, the `str` it replaced).
fn jot(mut sh: Sh, tab: int, name: str) {
    if sh.fr_top < 0 {
        return
    }
    // recorded once per frame: a frame's writes are few names, most
    // often the same one again, so the newest entries are looked at
    // first
    let base = sh.istk[sh.fr_top + FR_JBASE]
    let count = sh.ji.len / 3
    var e = count - 1
    while e >= base {
        if sh.ji[3 * e] == tab && sh.jn[2 * e] == name {
            return
        }
        e -= 1
    }
    var had = false
    var s = ""
    var i = 0
    if tab == J_VAL {
        had = has_var(sh, name)
        s = sh.vals[name] else ""
    } else if tab == J_TRAP {
        let a = sh.traps[name] else ""
        had = trap_set(sh, name)
        s = a
    } else if tab == J_FN {
        i = sh.funcs[name] else -1
        had = i >= 0
    } else if tab == J_HASH {
        s = sh.hash[name] else ""
        had = s.len > 0
    } else if tab == J_ALIAS {
        s = sh.ast.aliases[name] else ""
        had = alias_set(sh, name)
    } else if tab == J_EXP {
        had = marked(sh.exported, name)
        let e = sh.exported[name] else false
        i = if e then 1 else 0
    } else {
        had = marked(sh.ronly, name)
        let r = sh.ronly[name] else false
        i = if r then 1 else 0
    }
    (mut sh.ji).push(tab)
    (mut sh.ji).push(i)
    (mut sh.ji).push(if had then 1 else 0)
    (mut sh.jn).push(name)
    (mut sh.jn).push(s)
}

/// Whether the mark map `m` has an entry for `name` (true or false).
fn marked(m: Map[str, bool], name: str) -> bool {
    let _b = m[name] else {
        return false
    }
    true
}

/// Whether `name` is an alias (its value may be empty).
fn alias_set(sh: Sh, name: str) -> bool {
    let _a = sh.ast.aliases[name] else {
        return false
    }
    true
}

fn trap_set(sh: Sh, name: str) -> bool {
    let _a = sh.traps[name] else {
        return false
    }
    true
}

/// Play the journal back to entry `base`, newest first.
fn journal_back(mut sh: Sh, base: int) {
    while sh.ji.len > 3 * base {
        let had = (mut sh.ji).pop() else 0
        let i = (mut sh.ji).pop() else 0
        let tab = (mut sh.ji).pop() else 0
        let s = (mut sh.jn).pop() else ""
        let name = (mut sh.jn).pop() else ""
        if tab == J_VAL {
            if had == 1 {
                sh.vals[name] = s
            } else {
                let _v = (mut sh.vals).remove(name) else ""
            }
        } else if tab == J_TRAP {
            if had == 1 {
                sh.traps[name] = s
            } else {
                let _t = (mut sh.traps).remove(name) else ""
            }
        } else if tab == J_FN {
            if had == 1 {
                sh.funcs[name] = i
            } else {
                let _f = (mut sh.funcs).remove(name) else 0
            }
        } else if tab == J_HASH {
            if had == 1 {
                sh.hash[name] = s
            } else {
                let _h = (mut sh.hash).remove(name) else ""
            }
        } else if tab == J_ALIAS {
            if had == 1 {
                sh.ast.aliases[name] = s
            } else {
                let _a = (mut sh.ast.aliases).remove(name) else ""
            }
        } else if tab == J_EXP {
            if had == 1 {
                sh.exported[name] = i == 1
            } else {
                let _e = (mut sh.exported).remove(name) else false
            }
        } else if had == 1 {
            sh.ronly[name] = i == 1
        } else {
            let _r = (mut sh.ronly).remove(name) else false
        }
    }
}

// The writers: every write to the tables goes through one of these.

fn vset(mut sh: Sh, name: str, v: str) {
    if name == "PS1" { sh.ps1_explicit = true }
    jot(mut sh, J_VAL, name)
    sh.vals[name] = v
}

fn vdel(mut sh: Sh, name: str) {
    if name == "PS1" { sh.ps1_explicit = true }
    jot(mut sh, J_VAL, name)
    let _v = (mut sh.vals).remove(name) else ""
}

fn xset(mut sh: Sh, name: str, on: bool) {
    jot(mut sh, J_EXP, name)
    sh.exported[name] = on
}

fn xdel(mut sh: Sh, name: str) {
    jot(mut sh, J_EXP, name)
    let _e = (mut sh.exported).remove(name) else false
}

fn rset(mut sh: Sh, name: str) {
    jot(mut sh, J_RO, name)
    sh.ronly[name] = true
}

fn rdel(mut sh: Sh, name: str) {
    jot(mut sh, J_RO, name)
    let _r = (mut sh.ronly).remove(name) else false
}

fn fnset(mut sh: Sh, name: str, body: int) {
    jot(mut sh, J_FN, name)
    sh.funcs[name] = body
}

fn fndel(mut sh: Sh, name: str) {
    jot(mut sh, J_FN, name)
    let _f = (mut sh.funcs).remove(name) else 0
}

fn aset(mut sh: Sh, name: str, value: str) {
    jot(mut sh, J_ALIAS, name)
    sh.ast.aliases[name] = value
}

fn adel(mut sh: Sh, name: str) {
    jot(mut sh, J_ALIAS, name)
    let _a = (mut sh.ast.aliases).remove(name) else ""
}

fn tset(mut sh: Sh, name: str, action: str) {
    jot(mut sh, J_TRAP, name)
    sh.traps[name] = action
}

fn tdel(mut sh: Sh, name: str) {
    jot(mut sh, J_TRAP, name)
    let _t = (mut sh.traps).remove(name) else ""
}

/// Every name `trap` can record a condition under, in a fixed order:
/// `EXIT`, then the signals of `sh.signal`'s table; "" past the end. A
/// literal each, so walking them allocates nothing.
fn trap_cond(i: int) -> str {
    if i == 0 {
        return "EXIT"
    }
    sig_name(i - 1)
}

/// A subshell starts with its traps reset (XCU 2.12): a trap with an
/// action is removed; an ignored one (`trap '' …`) stays ignored. In
/// place, through the journal, so the frame puts them back.
fn traps_reset(mut sh: Sh) {
    if sh.traps.len == 0 {
        return
    }
    var i = 0
    loop {
        let c = trap_cond(i)
        if c.len == 0 {
            break
        }
        let a = sh.traps[c] else ""
        if a.len > 0 {
            tdel(mut sh, c)
        }
        i += 1
    }
}

/// Every trap removed (a program run in a subshell's place by `exec`
/// leaves no `EXIT` trap to run), through the journal.
fn traps_clear(mut sh: Sh) {
    var i = 0
    loop {
        let c = trap_cond(i)
        if c.len == 0 {
            break
        }
        if trap_set(sh, c) {
            tdel(mut sh, c)
        }
        i += 1
    }
}

fn names_handle(fds: List[int], h: int) -> bool {
    for x in fds {
        if x == h {
            return true
        }
    }
    false
}

/// The handle behind shell descriptor `fd`, or `FD_CLOSED`.
fn fd_get(sh: Sh, fd: int) -> int {
    if fd < 0 || fd >= sh.fds.len {
        return FD_CLOSED
    }
    sh.fds[fd]
}

fn fd_set(mut sh: Sh, fd: int, h: int) {
    if fd == 1 {
        flush(mut sh)
    }
    while sh.fds.len <= fd {
        (mut sh.fds).push(FD_CLOSED)
    }
    sh.fds[fd] = h
}

// ------------------------------------------------------------ variables

fn has_var(sh: Sh, name: str) -> bool {
    // the map's own lookup: `std.map`'s `has` builds a list of the
    // pairs per call (s216 measured it)
    let _v = sh.vals[name] else {
        return false
    }
    true
}

fn value_of(sh: Sh, name: str) -> str {
    sh.vals[name] else ""
}

fn is_ronly(sh: Sh, name: str) -> bool {
    sh.ronly[name] else false
}

fn is_exported(sh: Sh, name: str) -> bool {
    sh.exported[name] else false
}

/// Assign, honouring `readonly` and `set -a`. False (and nothing set)
/// when the variable is read-only; the caller reports it.
fn set_var(mut sh: Sh, name: str, value: str) -> bool {
    if sh.shadow && !sh.defer_ok {
        sh.bail = true
        sh.flow = F_EXIT
    }
    if is_ronly(sh, name) {
        return false
    }
    if name == "PATH" {
        // a new `PATH`, even the same value, forgets what was found
        // (dash, black-box: `PATH=$PATH; hash` lists nothing)
        hash_clear(mut sh)
    }
    vset(mut sh, name, value)
    if sh.opt_a {
        xset(mut sh, name, true)
    }
    if sh.shadow && sh.defer_ok {
        (mut sh.sstk).push(name)
        (mut sh.sstk).push(value)
    }
    true
}

fn unset_var(mut sh: Sh, name: str) -> bool {
    if sh.shadow {
        sh.bail = true
        sh.flow = F_EXIT
    }
    if is_ronly(sh, name) {
        return false
    }
    if name == "PATH" {
        hash_clear(mut sh)
    }
    vdel(mut sh, name)
    xdel(mut sh, name)
    true
}

fn ifs(sh: Sh) -> str {
    sh.vals["IFS"] else " \t\n"
}

/// `$-`: the single-letter options that are on, in the order dash
/// prints them (black-box: `set -a -C -e -f -u -v -x` shows `uaCvxfe`,
/// and an interactive shell reading standard input puts `si` before
/// `f`).
fn dash_flags(sh: Sh) -> str {
    // dash's order (black-box: sh26 `notes/sh26-evidence/probe/p25`,
    // `b` second and `ignoreeof`'s `I` after `i`)
    var o = buf()
    if sh.opt_u {
        putc(mut o, 'u')
    }
    if sh.opt_b {
        putc(mut o, 'b')
    }
    if sh.opt_a {
        putc(mut o, 'a')
    }
    if sh.opt_bigc {
        putc(mut o, 'C')
    }
    if sh.opt_v {
        putc(mut o, 'v')
    }
    if sh.opt_x {
        putc(mut o, 'x')
    }
    if sh.from_stdin {
        putc(mut o, 's')
    }
    if sh.opt_m {
        putc(mut o, 'm')
    }
    if sh.interactive || sh.sub_of_i {
        putc(mut o, 'i')
    }
    if sh.opt_ignoreeof {
        putc(mut o, 'I')
    }
    if sh.opt_f {
        putc(mut o, 'f')
    }
    if sh.opt_e {
        putc(mut o, 'e')
    }
    if sh.opt_n {
        putc(mut o, 'n')
    }
    text(o)
}

// --------------------------------------------------------------- output

fn emit(mut sh: Sh, s: str) {
    for x in s.bytes() {
        (mut sh.out).push(x)
    }
    if sh.out.len >= 65536 {
        flush(mut sh)
    }
}

fn emitc(mut sh: Sh, c: char) {
    (mut sh.out).push(c as int as byte)
}

fn emitb(mut sh: Sh, n: int) {
    (mut sh.out).push(n as byte)
}

/// Write what is buffered to wherever descriptor 1 now is: a handle, the
/// open capture, or nowhere (closed).
fn flush(mut sh: Sh) {
    if sh.out.len == 0 {
        return
    }
    let h = fd_get(sh, 1)
    if is_cap(h) {
        for x in sh.out {
            (mut sh.cap_data).push(x)
        }
    } else if h >= 0 {
        fs_write_chunk(h, sh.out) else |_| {}
    }
    // emptied in place: the state's own list, not a fresh one (pelt#19)
    (mut sh.out).clear()
}

/// `flush`, answering whether the bytes went out: false when the host
/// refused the write (a pipe nobody reads, with `SIGPIPE` ignored).
fn flush_checked(mut sh: Sh) -> bool {
    if sh.out.len == 0 {
        return true
    }
    let h = fd_get(sh, 1)
    if is_cap(h) || h < 0 {
        flush(mut sh)
        return true
    }
    var went = true
    fs_write_chunk(h, sh.out) else |_| {
        went = false
    }
    (mut sh.out).clear()
    went
}

/// Bytes for shell descriptor `fd` other than 1 (a diagnostic, a prompt,
/// a trace line), after whatever descriptor 1 has pending.
fn write_fd(mut sh: Sh, fd: int, s: str) {
    flush(mut sh)
    let h = fd_get(sh, fd)
    if is_cap(h) {
        for x in s.bytes() {
            (mut sh.cap_data).push(x)
        }
        return
    }
    write_handle(h, s)
}

/// `s` to handle `h` (not a capture): the process's standard error, a
/// handle pelt opened, or nothing when the descriptor is closed. Writes
/// nothing to the state, so it can run inside a region.
fn write_handle(h: int, s: str) {
    if h == 2 {
        eprint_raw(s)
        return
    }
    if h >= 0 {
        var b = List[byte]()
        for x in s.bytes() {
            (mut b).push(x)
        }
        fs_write_chunk(h, b) else |_| {}
    }
}

/// Open a capture: descriptor 1 becomes its marker until `cap_end`.
fn cap_begin(mut sh: Sh) {
    flush(mut sh)
    (mut sh.caps).push(sh.cap_data.len)
    (mut sh.cap_was).push(fd_get(sh, 1))
    fd_set(mut sh, 1, cap_mark(sh.caps.len))
}

/// Close the innermost capture: descriptor 1 is what it was before.
/// Answers where its bytes begin in `cap_data`; they stay there until
/// `cap_cut`.
fn cap_close(mut sh: Sh) -> int {
    flush(mut sh)
    let start = (mut sh.caps).pop() else 0
    let was = (mut sh.cap_was).pop() else 1
    fd_set(mut sh, 1, was)
    start
}

/// Drop `cap_data` from `start` on, in place (pelt#19: cutting by a
/// slice made a fresh list in the root each time).
fn cap_cut(mut sh: Sh, start: int) {
    let zero = 0 as byte
    while sh.cap_data.len > start {
        let _b = (mut sh.cap_data).pop() else zero
    }
}

/// Close the innermost capture and answer what it caught as text, the
/// trailing newlines cut when `trim` (a command substitution, XCU
/// 2.6.3). The text is made inside a region, so only it is kept.
fn cap_end(mut sh: Sh, trim: bool) -> str {
    let start = cap_close(mut sh)
    let s = copy region ct {
        cap_text(sh, start, trim)
    }
    cap_cut(mut sh, start)
    s
}

fn cap_text(sh: Sh, start: int, trim: bool) -> str {
    var end = sh.cap_data.len
    if trim {
        while end > start && sh.cap_data[end - 1] as int == 10 {
            end -= 1
        }
    }
    text(Buf { b: sh.cap_data[start..end] })
}

/// Close the innermost capture and hand what it caught to a reader
/// (`sh.redir`'s `feed`), made inside a region: the read handle, or
/// `FD_CLOSED` when no pipe or file could be made (said).
fn cap_feed(mut sh: Sh) -> int {
    let start = cap_close(mut sh)
    let h = copy region cf {
        feed(sh, sh.cap_data[start..sh.cap_data.len])
    }
    cap_cut(mut sh, start)
    feed_said(mut sh, h)
}

/// A diagnostic: pelt's own words, on descriptor 2, after whatever
/// standard output is pending. In the shadow state (`sh.fast`) nothing
/// is written: the command is run again the ordinary way, which says it.
fn diag(mut sh: Sh, msg: str) {
    if sh.shadow {
        sh.bail = true
        sh.flow = F_EXIT
        return
    }
    if sh.from_stdin {
        // no script to name: the line counts from the session's start
        if sh.line > 0 {
            write_fd(mut sh, 2, "pelt: line {sh.line}: {msg}\n")
        } else {
            write_fd(mut sh, 2, "pelt: {msg}\n")
        }
        return
    }
    if sh.line > 0 {
        write_fd(mut sh, 2, "pelt: {sh.name}: line {sh.line}: {msg}\n")
    } else {
        write_fd(mut sh, 2, "pelt: {sh.name}: {msg}\n")
    }
}

/// A shell error that ends a non-interactive shell (XCU 2.8.1): the
/// message, status `code`, and the exit flow. Inside a subshell or a
/// command substitution it ends only that. `abort` marks the exit as an
/// error's, which an interactive shell turns into "abandon this command
/// and prompt again" (`sh.interact`); every other way to `F_EXIT`
/// (`exit`, `return` outside a function, `exec`, `set -e`) clears it.
fn fatal(mut sh: Sh, msg: str, code: int) {
    diag(mut sh, msg)
    sh.status = code
    sh.flow = F_EXIT
    sh.flow_n = 0
    sh.abort = true
}

// ---------------------------------------------------------------- quoting

/// `s` in single quotes, a quote inside it written `'"'"'`: the form
/// `set`, `export -p`, `readonly -p` and `trap` print, which a shell
/// reads back as `s`.
fn squote(s: str) -> str {
    var o = buf()
    putc(mut o, '\'')
    var i = 0
    while i < s.len {
        if ch(s, i) == '\'' {
            put(mut o, "'\"'\"'")
        } else {
            putb(mut o, byte_at(s, i))
        }
        i += 1
    }
    putc(mut o, '\'')
    text(o)
}
