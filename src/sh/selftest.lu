//! sh.selftest — table checks of the pieces under the differential
//! corpus: the pattern matcher, the arithmetic evaluator, field
//! splitting, prefix and suffix trimming, unsigned digits, the parser's
//! tree, the descriptor table's redirection frames, `cd`'s logical
//! path, which simple commands run inside the region (`sh.exec`'s
//! fast path), `umask`'s operand reader, and the history (`sh.hist`):
//! `fc`'s operands, its list format and the history file's lines. `src/sh_test.lu` runs
//! them under `wolf test`.
//!
//! References consulted: POSIX.1-2024 XCU 2.6.4, 2.6.5, 2.14; every
//! expected value here was read off a black-box run of `dash` 0.5.13.4
//! (the corpus rows that cover the same shapes cite the same runs).

fn want_match(mut bad: List[str], pat: str, s: str, want: bool) {
    if pmatch(pat, s) != want {
        (mut bad).push("pmatch({pat}, {s}) is not {want}")
    }
}

/// A pattern whose `*` was quoted: the `Q` mark, then the byte.
fn quoted_star() -> str {
    var o = buf()
    putb(mut o, Q)
    putc(mut o, '*')
    text(o)
}

fn want_arith(mut bad: List[str], expr: str, want: int) {
    var sh = new_sh("selftest")
    let (v, err) = arith(mut sh, expr)
    if err.len > 0 || v != want {
        (mut bad).push("arith({expr}) = {v} err={err}, want {want}")
    }
}

fn want_arith_error(mut bad: List[str], expr: str) {
    var sh = new_sh("selftest")
    let (_v, err) = arith(mut sh, expr)
    if err.len == 0 {
        (mut bad).push("arith({expr}) should be an error")
    }
}

fn joined(xs: List[str]) -> str {
    var o = buf()
    for x in xs {
        put(mut o, "[{unmark(x)}]")
    }
    text(o)
}

fn want_split(mut bad: List[str], ifs_value: str, value: str, want: str) {
    var sh = new_sh("selftest")
    sh.vals["IFS"] = ifs_value
    var m = buf()
    ustr(mut m, value)
    let got = joined(split_marked(sh, text(m)))
    if got != want {
        (mut bad).push("split({value}) on IFS {escaped(ifs_value)} = {got}, want {want}")
    }
}

fn want_trim(mut bad: List[str], v: str, pat: str, prefix: bool, longest: bool, want: str) {
    let got = trim_pattern(v, pat, prefix, longest)
    if got != want {
        (mut bad).push("trim({v}, {pat}) = {got}, want {want}")
    }
}

fn want_tree(mut bad: List[str], src: str, want: str) {
    var a = new_ast()
    var p = new_parser(src, 1)
    var o = buf()
    loop {
        let n = parse_complete(mut p, mut a)
        if n < 0 {
            break
        }
        dump(a, n, 0, mut o)
    }
    let got = text(o)
    if got != want || p.err.len > 0 {
        (mut bad).push("tree of {escaped(src)}:\n{got}err={p.err}\nwant:\n{want}")
    }
}

/// pelt#3: how many directories pathname expansion lists for one
/// word, as the shell's source spells it. A word that is not a pattern
/// (XCU: a `[` that opens no bracket expression matches itself) lists
/// none, whatever the working directory holds.
fn want_reads(mut bad: List[str], word: str, noglob: bool, want: int) {
    var sh = new_sh("selftest")
    sh.opt_f = noglob
    var words = List[str]()
    (mut words).push(word)
    let _fields = expand_words(mut sh, words)
    if sh.dir_reads != want {
        (mut bad).push("expanding {escaped(word)} listed {sh.dir_reads} directories, want {want}")
    }
}

/// A redirection as the parser would have read it.
fn rd(op: str, word: str, fd: int) -> Rd {
    Rd { op: op, word: word, fd: fd, body: "", has_doc: false, quoted: false, line: 1 }
}

fn table(sh: Sh) -> str {
    var o = buf()
    var k = 0
    while k < sh.fds.len {
        put(mut o, "{sh.fds[k]} ")
        k += 1
    }
    text(o)
}

/// A frame changes the table and its end puts the table back; `exec`'s
/// permanent form does not; a here-document is a handle that reads the
/// body and is closed with its frame; a duplicate of a closed
/// descriptor fails.
fn want_frames(mut bad: List[str]) {
    var sh = new_sh("selftest")
    var rds = List[Rd]()
    (mut rds).push(rd(">&", "1", 3))
    (mut rds).push(rd(">&", "-", 1))
    (mut rds).push(rd("<&", "2", 0))
    if !apply_redirs(mut sh, rds) {
        (mut bad).push("frame: 3>&1 1>&- 0<&2 refused")
    }
    if table(sh) != "2 -1 2 1 " {
        (mut bad).push("frame: inside, the table is {table(sh)}, want 2 -1 2 1")
    }
    end_redirs(mut sh)
    if table(sh) != "0 1 2 -1 " {
        (mut bad).push("frame: after, the table is {table(sh)}, want 0 1 2 -1")
    }
    var p = List[Rd]()
    (mut p).push(rd(">&", "2", 4))
    if !apply_permanent(mut sh, p) || fd_get(sh, 4) != 2 {
        (mut bad).push("exec 4>&2: the table is {table(sh)}")
    }
    var docs = List[Rd]()
    (mut docs).push(Rd {
        op: "<<",
        word: "E",
        fd: -1,
        body: "a $x\n",
        has_doc: true,
        quoted: true,
        line: 1,
    })
    if !apply_redirs(mut sh, docs) {
        (mut bad).push("here-document refused")
    }
    let h = fd_get(sh, 0)
    let got = fs_read_chunk(h, 64) else List[byte]()
    let body = text(Buf { b: got })
    if h < 3 || body != "a $x\n" {
        (mut bad).push("here-document: handle {h} read {escaped(body)}")
    }
    end_redirs(mut sh)
    var still_open = true
    fs_close(h) else |_| {
        still_open = false
    }
    if fd_get(sh, 0) != 0 || still_open {
        (mut bad).push(
            "here-document: after its frame fd 0 is {fd_get(sh, 0)}, handle {h} still open",
        )
    }
    // a duplicate of a closed descriptor fails (the shadow: no message)
    var q = new_sh("selftest")
    q.shadow = true
    var bad_dup = List[Rd]()
    (mut bad_dup).push(rd(">&", "7", 1))
    if apply_redirs(mut q, bad_dup) {
        (mut bad).push("1>&7 with 7 closed was accepted")
    }
}

fn want_canon(mut bad: List[str], p: str, want: str) {
    if canon(p) != want {
        (mut bad).push("canon({p}) = {canon(p)}, want {want}")
    }
}

/// Which typed lines `run_turn_fast` finishes inside the region (and
/// with what), and which it hands to the ordinary path.
fn want_route(mut bad: List[str], src: str, nounset: bool, want: int, want_enc: str) {
    var sh = new_sh("selftest")
    sh.vals["i"] = "1"
    sh.opt_u = nounset
    let r = copy region t {
        run_turn_fast(sh, src, 1)
    }
    if r.kind != want || r.enc != want_enc {
        (mut bad).push(
            "route {escaped(src)}: kind {r.kind} enc {escaped(r.enc)}, want {want} {escaped(want_enc)}",
        )
    }
}

/// `name` NUL `value` NUL, as the fast path encodes an assignment.
fn enc1(name: str, value: str) -> str {
    var o = buf()
    put(mut o, name)
    putb(mut o, 0)
    put(mut o, value)
    putb(mut o, 0)
    text(o)
}

/// A child's raw `os_wait_status` answer as a shell status, and
/// whether the shell says anything about it.
fn want_status(mut bad: List[str], raw: int, want: int, want_sig: int, spoken: bool) {
    let (st, sig) = status_of(raw)
    if st != want || sig != want_sig || signal_spoken(sig) != spoken {
        (mut bad).push(
            "status_of({raw}) = {st} sig {sig} spoken {signal_spoken(sig)}, want {want} sig {want_sig} spoken {spoken}",
        )
    }
}

fn joined_env(xs: List[str]) -> str {
    var o = buf()
    for x in xs {
        putc(mut o, '[')
        put(mut o, x)
        putc(mut o, ']')
    }
    text(o)
}

/// What a program that replaces the shell is handed: the exported
/// variables that are set, and the `exec` command's own assignments.
fn want_exec_env(mut bad: List[str]) {
    var sh = new_sh("selftest")
    sh.vals["KEPT"] = "1"
    sh.exported["KEPT"] = true
    sh.vals["PLAIN"] = "2"
    sh.vals["MINE"] = "a=b c"
    sh.exported["NOVALUE"] = true
    var extra = List[str]()
    (mut extra).push("MINE")
    let got = joined_env(exec_env(sh, extra))
    if got != "[KEPT=1][MINE=a=b c]" {
        (mut bad).push("exec_env = {got}")
    }
    if env_wants(sh, "PLAIN") || env_wants(sh, "NOVALUE") || !env_wants(sh, "KEPT") {
        (mut bad).push("env_wants: PLAIN, NOVALUE or KEPT is wrong")
    }
}

/// The trap table to dispositions: what the shell polls for itself,
/// with nothing applied to the host (the masks are read back only when
/// the table is empty, so no signal's disposition moves in the test).
fn want_conditions(mut bad: List[str]) {
    for c in ["HUP", "INT", "QUIT", "TERM", "USR2"] {
        let m = meaning_of(c)
        if m == 0 || cond_of(m) != c {
            (mut bad).push("meaning_of({c}) = {m}, cond_of = {cond_of(m)}")
        }
    }
    for c in ["USR1", "ALRM", "PIPE", "EXIT", "KILL", ""] {
        if meaning_of(c) != 0 {
            (mut bad).push("meaning_of({c}) = {meaning_of(c)}, want 0")
        }
    }
    var sh = new_sh("selftest")
    if interactive_set(sh) != 0 {
        (mut bad).push("a script listens for nothing by itself")
    }
    sh.interactive = true
    if interactive_set(sh) != M_INT | M_QUIT | M_TERM {
        (mut bad).push("interactive_set = {interactive_set(sh)}")
    }
    var order = buf()
    for m in by_number() {
        put(mut order, cond_of(m))
        putc(mut order, ' ')
    }
    if text(order) != "HUP INT QUIT TERM USR2 " {
        (mut bad).push("by_number = {text(order)}")
    }
}

/// `$!` and `wait`: a job is found by the id it was given, the newest
/// first, and an id no job has is -1.
fn want_jobs(mut bad: List[str]) {
    var sh = new_sh("selftest")
    for id in [4242, NO_PID_BASE + 1, 4242] {
        (mut sh.jobs).push(-1)
        (mut sh.job_st).push(0)
        (mut sh.job_id).push(id)
    }
    if job_of(sh, 4242) != 2 || job_of(sh, NO_PID_BASE + 1) != 1 || job_of(sh, 7) != -1 {
        (mut bad).push(
            "job_of: {job_of(sh, 4242)} {job_of(sh, NO_PID_BASE + 1)} {job_of(sh, 7)}, want 2 1 -1",
        )
    }
}

/// `umask`'s operand reader and its two answers (`sh.umask`); -1 for a
/// refused operand. Each expected mask was read off dash 0.5.13.4.
fn want_mask(mut bad: List[str], cur: int, operand: str, want: int) {
    let got = mask_from(cur, operand) else -1
    if got != want {
        (mut bad).push("mask_from({mask_octal(cur)}, {operand}) = {got}, want {want}")
    }
}

/// The table check that a subshell's mask is put back is the corpus's
/// (`umask/subshells`): it needs the process's own mask.
fn want_mask_texts(mut bad: List[str]) {
    let pairs = [
        (0o022, "0022 u=rwx,g=rx,o=rx"),
        (0o777, "0777 u=,g=,o="),
        (0, "0000 u=rwx,g=rwx,o=rwx"),
        (0o137, "0137 u=rw,g=r,o="),
    ]
    for (m, want) in pairs {
        let got = "{mask_octal(m)} {mask_symbolic(m)}"
        if got != want {
            (mut bad).push("mask texts of {m}: {got}, want {want}")
        }
    }
}

/// Run every table check; answers one line per check that failed,
/// empty when all pass.
pub fn self_test() -> List[str] {
    var bad = List[str]()
    want_match(mut bad, "*", "", true)
    want_match(mut bad, "a*c", "abbbc", true)
    want_match(mut bad, "a*c", "abbb", false)
    want_match(mut bad, "?", "", false)
    want_match(mut bad, "[a-c]x", "bx", true)
    want_match(mut bad, "[!a-c]x", "bx", false)
    want_match(mut bad, "[]]", "]", true)
    want_match(mut bad, "[[:digit:]]*", "7up", true)
    want_match(mut bad, "\\*", "*", true)
    want_match(mut bad, "\\*", "a", false)
    want_match(mut bad, "[ab", "[ab", true)
    want_match(mut bad, quoted_star(), "*", true)
    want_match(mut bad, quoted_star(), "x", false)
    want_match(mut bad, "*.tar.gz", "a.tar.gz", true)
    want_arith(mut bad, "1+2*3", 7)
    want_arith(mut bad, "(1+2)*3", 9)
    want_arith(mut bad, "-7/2", -3)
    want_arith(mut bad, "-7%2", -1)
    want_arith(mut bad, "1<<62<<1", -9223372036854775807 - 1)
    want_arith(mut bad, "9223372036854775807+1", -9223372036854775807 - 1)
    want_arith(mut bad, "0x1f + 010", 39)
    want_arith(mut bad, "1 ? 2 ? 3 : 4 : 5", 3)
    want_arith(mut bad, "0 && 1/0", 0)
    want_arith(mut bad, "1 || 1/0", 1)
    want_arith(mut bad, "~0", -1)
    want_arith(mut bad, "!5 == 0", 1)
    want_arith_error(mut bad, "x = 3, 1")
    want_arith_error(mut bad, "1/0")
    want_arith_error(mut bad, "1 +")
    want_arith_error(mut bad, "09")
    want_split(mut bad, " \t\n", "  a  b ", "[a][b]")
    want_split(mut bad, ":", "::a::", "[][][a][]")
    want_split(mut bad, " :", " :a : b: ", "[][a][b]")
    want_split(mut bad, "", "a b", "[a b]")
    want_split(mut bad, "1", "a1b11c", "[a][b][][c]")
    want_trim(mut bad, "a/b/c", "*/", true, false, "b/c")
    want_trim(mut bad, "a/b/c", "*/", true, true, "c")
    want_trim(mut bad, "f.tar.gz", ".*", false, false, "f.tar")
    want_trim(mut bad, "f.tar.gz", ".*", false, true, "f")
    want_trim(mut bad, "abc", "z", true, true, "abc")
    if udigits(-1, 10, false) != "18446744073709551615" {
        (mut bad).push("udigits(-1, 10) = {udigits(-1, 10, false)}")
    }
    if udigits(-1, 16, false) != "ffffffffffffffff" {
        (mut bad).push("udigits(-1, 16) = {udigits(-1, 16, false)}")
    }
    if udigits(255, 8, false) != "377" {
        (mut bad).push("udigits(255, 8) = {udigits(255, 8, false)}")
    }
    let n = to_int("-9223372036854775808") else 0
    if n != -9223372036854775807 - 1 {
        (mut bad).push("to_int(min) = {n}")
    }
    want_tree(
        mut bad,
        "a && b || ! c\n",
        "list ;\n  andor && ||\n    simple word\"a\"\n    simple word\"b\"\n    pipe !\n      simple word\"c\"\n",
    )
    want_tree(
        mut bad,
        "f() {{ :; }}\n",
        "list ;\n  func f\n    brace\n      list ;\n        simple word\":\"\n",
    )
    want_tree(
        mut bad,
        "for i in a; do :; done\n",
        "list ;\n  for i in \"a\"\n    list ;\n      simple word\":\"\n",
    )
    // not patterns: no directory is read
    for w in [
        "[",
        "]",
        "-f",
        "[a",
        "a]",
        "x[a",
        "\"[\"a]",
        "[a\"]\"",
        "\\[a]",
        "'['a]",
        "[]",
        "[!]",
        "[a/b]",
        "\"*\"",
        "'?'",
    ] {
        want_reads(mut bad, w, false, 0)
    }
    // patterns: one read each (one magic component in the cwd)
    for w in [
        "*",
        "?",
        "x*[",
        "[!x]",
        "[]]",
        "[!]]",
        "[a-]",
        "[\"a\"]",
        "[\\a]",
        "[[:alpha:]]",
        "[[:alpha:]",
    ] {
        want_reads(mut bad, w, false, 1)
    }
    // `[a/*`: the `[a` component is a literal, only `*` lists `[a/`
    want_reads(mut bad, "[a/*", false, 1)
    // `set -f`: nothing is a pattern
    want_reads(mut bad, "*", true, 0)
    want_frames(mut bad)
    want_canon(mut bad, "/a/./b/../c", "/a/c")
    want_canon(mut bad, "/..", "/")
    want_canon(mut bad, "//usr", "//usr")
    want_canon(mut bad, "///usr//", "/usr")
    want_canon(mut bad, "/a/b/../../..", "/")
    // inside the region: a test, an assignment, output to a file
    want_route(mut bad, "[ 1 -lt 2 ]\n", false, R_DONE, "")
    want_route(mut bad, "true\n", false, R_DONE, "")
    want_route(mut bad, "i=$((i+1))\n", false, R_ASSIGN, enc1("i", "2"))
    want_route(mut bad, "echo hi >/dev/null\n", false, R_DONE, "")
    // the ordinary path: anything that writes the state while it runs
    want_route(mut bad, "x=$(true)\n", false, R_SLOW, "")
    want_route(mut bad, ": ${{y:=1}}\n", false, R_SLOW, "")
    want_route(mut bad, "echo $((z=1))\n", false, R_SLOW, "")
    want_route(mut bad, "cd /\n", false, R_SLOW, "")
    want_route(mut bad, "read x\n", false, R_SLOW, "")
    want_route(mut bad, "echo $nope\n", true, R_SLOW, "")
    want_route(mut bad, "true; true\n", false, R_SLOW, "")
    want_route(mut bad, "true | true\n", false, R_SLOW, "")
    // a child's ending: an exit code, or 128 + N for signal N; the
    // shell is silent about SIGINT and SIGPIPE
    want_status(mut bad, 0, 0, 0, false)
    want_status(mut bad, 7, 7, 0, false)
    want_status(mut bad, 255, 255, 0, false)
    want_status(mut bad, -15, 143, 15, true)
    want_status(mut bad, -9, 137, 9, true)
    want_status(mut bad, -1, 129, 1, true)
    want_status(mut bad, -2, 130, 2, false)
    want_status(mut bad, -13, 141, 13, false)
    if signal_words(15) != "ended by signal 15 (TERM)" || signal_words(31) != "ended by signal 31" {
        (mut bad).push("signal_words: {signal_words(15)} / {signal_words(31)}")
    }
    want_exec_env(mut bad)
    want_conditions(mut bad)
    want_jobs(mut bad)
    want_mask(mut bad, 0o027, "022", 0o022)
    want_mask(mut bad, 0o027, "7777", 0o777)
    want_mask(mut bad, 0o027, "", 0o027)
    want_mask(mut bad, 0o027, "8", -1)
    want_mask(mut bad, 0o027, "+w", 0o005)
    want_mask(mut bad, 0o027, "=r", 0o333)
    want_mask(mut bad, 0o027, "u=g", 0o227)
    want_mask(mut bad, 0o027, "g=u-w", 0o027)
    want_mask(mut bad, 0o777, "u+x,o+X", 0o677)
    want_mask(mut bad, 0o077, "g=rwx,o=g", 0o007)
    want_mask(mut bad, 0o027, "u=rwx,", 0o027)
    want_mask(mut bad, 0o027, "u=rwx,,o=r", -1)
    want_mask(mut bad, 0o027, ",", -1)
    want_mask(mut bad, 0o027, "u", -1)
    want_mask(mut bad, 0o027, "u+t", -1)
    want_mask(mut bad, 0o027, "u+s", 0o027)
    want_mask(mut bad, 0o027, "-", 0o027)
    want_mask_texts(mut bad)
    want_hist(mut bad)
    bad
}

// --------------------------------------------------------- the history

/// An interactive shell whose history holds `lines`, the last one the
/// command being run (as when `fc` is typed); no file.
fn hist_sh(lines: List[str]) -> Sh {
    var sh = new_sh("selftest")
    sh.interactive = true
    sh.ed.h.state = H_MEM
    for l in lines {
        ring_push(mut sh.ed.h, 128, l)
    }
    sh.ed.h.cur = true
    sh
}

fn want_fc_number(mut bad: List[str], h: Hist, op: str, first: bool, want: int) {
    let got = fc_number(h, op, first)
    if got != want {
        (mut bad).push("fc_number({op}, first={first}) = {got}, want {want}")
    }
}

/// `fc args` in `hist_sh(lines)`: what it writes to standard output.
fn want_fc_out(mut bad: List[str], lines: List[str], args: List[str], want: str) {
    var sh = hist_sh(lines)
    let st = bi_fc(mut sh, args)
    let got = text(Buf { b: sh.out })
    if st != 0 || got != want {
        (mut bad).push("fc {args}: status {st}, {escaped(got)}, want {escaped(want)}")
    }
}

/// Every expected value here is XCU `fc`'s words, or a black-box run
/// of bash --posix 5.3 or dash 0.5.13.4 (`notes/sh12-evidence/probe/`).
fn want_hist(mut bad: List[str]) {
    var five = List[str]()
    (mut five).push("echo a")
    (mut five).push("echo b")
    (mut five).push("printf x")
    (mut five).push("echo c")
    (mut five).push("fc -l")
    let sh = hist_sh(five)
    let h = copy sh.ed.h
    // -1 is the command before the fc line; [+]n is n (POSIX; bash
    // refuses +n); 0 the previous and -0 the fc line (bash)
    want_fc_number(mut bad, h, "-1", true, 4)
    want_fc_number(mut bad, h, "1", true, 1)
    want_fc_number(mut bad, h, "+2", true, 2)
    want_fc_number(mut bad, h, "0", true, 4)
    want_fc_number(mut bad, h, "-0", true, 5)
    // beyond either end: a first is the oldest (bash and dash); a last
    // beyond the newest is the previous command
    want_fc_number(mut bad, h, "99", true, 1)
    want_fc_number(mut bad, h, "-99", true, 1)
    want_fc_number(mut bad, h, "99", false, 4)
    want_fc_number(mut bad, h, "-99", false, 1)
    want_fc_number(mut bad, h, "9999999999999", false, 4)
    // a string: the newest before the fc line that starts with it
    want_fc_number(mut bad, h, "ec", true, 4)
    want_fc_number(mut bad, h, "pri", true, 3)
    want_fc_number(mut bad, h, "fc", true, -1)
    want_fc_number(mut bad, h, "zz", false, -1)
    // the list: %d\t%s\n; -n \t%s\n
    want_fc_out(mut bad, five, ["-l"], "1\techo a\n2\techo b\n3\tprintf x\n4\techo c\n")
    want_fc_out(mut bad, five, ["-ln", "-2", "-1"], "\tprintf x\n\techo c\n")
    want_fc_out(mut bad, five, ["-l", "3", "1"], "3\tprintf x\n2\techo b\n1\techo a\n")
    // -r with first newer than last: the two cancel (XCU fc's example,
    // `fc -r 40 30` is `fc 30 40`; dash does; bash does not)
    want_fc_out(mut bad, five, ["-lr", "3", "1"], "1\techo a\n2\techo b\n3\tprintf x\n")
    want_fc_out(mut bad, five, ["-lr", "1", "2"], "2\techo b\n1\techo a\n")
    // -0 alone: from the fc line back to the previous (dash; bash
    // lists only the fc line)
    want_fc_out(mut bad, five, ["-l", "-0"], "5\tfc -l\n4\techo c\n")
    // a multi-line entry keeps its lines: continuation lines \t%s
    var multi = List[str]()
    (mut multi).push("for i in 1 2\ndo echo $i\ndone")
    (mut multi).push("fc -l")
    want_fc_out(mut bad, multi, ["-l"], "1\tfor i in 1 2\n\tdo echo $i\n\tdone\n")
    want_fc_out(mut bad, multi, ["-ln"], "\tfor i in 1 2\n\tdo echo $i\n\tdone\n")
    // only the fc line: -l lists it (bash and dash)
    var lone = List[str]()
    (mut lone).push("fc -l")
    want_fc_out(mut bad, lone, ["-l"], "1\tfc -l\n")
    // the file's lines: a backslash doubled, a newline as \n; plain
    // lines from elsewhere read as written
    var o = buf()
    encode_entry(mut o, "a\\b\nc")
    if text(o) != "a\\\\b\\nc\n" {
        (mut bad).push("encode_entry = {escaped(text(o))}")
    }
    if decode_entry("a\\\\b\\nc") != "a\\b\nc" || decode_entry("x\\y") != "x\\y" {
        (mut bad).push("decode_entry: {escaped(decode_entry("a\\\\b\\nc"))}")
    }
    var bs = List[byte]()
    for b in "one\ntwo\nthree".bytes() {
        (mut bs).push(b)
    }
    let r = hist_parse(bs, 0, 2)
    if !r.ok || r.count != 3 || r.entries.len != 2 || r.entries[0] != "two" || !r.need_nl {
        (mut bad).push("hist_parse: ok {r.ok} count {r.count} {r.entries} need_nl {r.need_nl}")
    }
    (mut bs).push(0 as byte)
    if hist_parse(bs, 0, 2).ok {
        (mut bad).push("hist_parse took a file with a NUL byte")
    }
    // PS1: each ! the next number, !! one ! (XCU 2.5.3)
    if ps1_bang("a!b!!c!", 7) != "a7b!c7" || ps1_bang("$ ", 7) != "$ " {
        (mut bad).push("ps1_bang: {ps1_bang("a!b!!c!", 7)}")
    }
}
