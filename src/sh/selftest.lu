//! sh.selftest — table checks of the pieces under the differential
//! corpus: the pattern matcher, the arithmetic evaluator, field
//! splitting, prefix and suffix trimming, unsigned digits, the parser's
//! tree, the descriptor table's redirection frames, `cd`'s logical
//! path, which simple commands run inside the region (`sh.exec`'s
//! fast path), `umask`'s operand reader, the history (`sh.hist`):
//! `fc`'s operands, its list format and the history file's lines, Tab's
//! reading of a line, its quoting and its list's shape (`sh.complete`),
//! `read`'s split of a line into its variables, `$'…'`'s escapes,
//! and what pelt#19's memory work keeps in place: a subshell's frame and
//! journal, the tree's recycled slots and a word's text as a view.
//! `src/sh_test.lu` runs them under `wolf test`.
//!
//! References consulted: POSIX.1-2024 XCU 2.6.4, 2.6.5, 2.14; every
//! expected value here was read off a black-box run of `dash` 0.5.13.4
//! (the corpus rows that cover the same shapes cite the same runs).

fn want_match(mut bad: List[str], pat: str, s: str, want: bool) {
    if pmatch(pat, s) != want {
        (mut bad).push("pmatch({pat}, {s}) is not {want}")
    }
}

/// A pattern whose `*` was quoted: the `Q` mark, then the byte.
fn quoted_star() -> str {
    var o = buf()
    putb(mut o, Q)
    putc(mut o, '*')
    text(o)
}

fn want_arith(mut bad: List[str], expr: str, want: int) {
    var sh = new_sh("selftest")
    let (v, err) = arith(mut sh, expr)
    if err.len > 0 || v != want {
        (mut bad).push("arith({expr}) = {v} err={err}, want {want}")
    }
}

fn want_arith_error(mut bad: List[str], expr: str) {
    var sh = new_sh("selftest")
    let (_v, err) = arith(mut sh, expr)
    if err.len == 0 {
        (mut bad).push("arith({expr}) should be an error")
    }
}

fn joined(xs: List[str]) -> str {
    var o = buf()
    for x in xs {
        put(mut o, "[{unmark(x)}]")
    }
    text(o)
}

fn want_split(mut bad: List[str], ifs_value: str, value: str, want: str) {
    var sh = new_sh("selftest")
    sh.vals["IFS"] = ifs_value
    var m = buf()
    ustr(mut m, value)
    let got = joined(split_marked(sh, text(m)))
    if got != want {
        (mut bad).push("split({value}) on IFS {escaped(ifs_value)} = {got}, want {want}")
    }
}

fn want_trim(mut bad: List[str], v: str, pat: str, prefix: bool, longest: bool, want: str) {
    let got = trim_pattern(v, pat, prefix, longest)
    if got != want {
        (mut bad).push("trim({v}, {pat}) = {got}, want {want}")
    }
}

fn want_tree(mut bad: List[str], src: str, want: str) {
    var a = new_ast()
    var p = new_parser(src, 1)
    var o = buf()
    loop {
        let n = parse_complete(mut p, mut a)
        if n < 0 {
            break
        }
        dump(a, n, 0, mut o)
    }
    let got = text(o)
    if got != want || p.err.len > 0 {
        (mut bad).push("tree of {escaped(src)}:\n{got}err={p.err}\nwant:\n{want}")
    }
}

/// The state a frame must put back, as one line: variables, export and
/// read-only marks, functions, traps, `$@`, the options and the local
/// stack's depth.
fn state_line(sh: Sh) -> str {
    var o = buf()
    for k in sort_strs(sh.vals.keys()) {
        put(mut o, "{k}={sh.vals[k] else ""} ")
    }
    put(mut o, "| x:")
    for k in sort_strs(sh.exported.keys()) {
        let on = sh.exported[k] else false
        put(mut o, " {k}={on}")
    }
    put(mut o, " | r:")
    for k in sort_strs(sh.ronly.keys()) {
        put(mut o, " {k}")
    }
    put(mut o, " | f:")
    for k in sort_strs(sh.funcs.keys()) {
        put(mut o, " {k}={sh.funcs[k] else -1}")
    }
    put(mut o, " | t:")
    for k in sort_strs(sh.traps.keys()) {
        put(mut o, " {k}=[{sh.traps[k] else ""}]")
    }
    put(mut o, " | @:")
    for x in sh.pos {
        put(mut o, " {x}")
    }
    put(mut o, " | -{dash_flags(sh)} | locals {sh.lnames.len}")
    text(o)
}

/// A subshell's frame (`sh.state`): every write inside it, nested
/// frames included, is put back when it closes, through the journal,
/// and the journal and stacks end as they began.
fn want_journal(mut bad: List[str]) {
    var sh = new_sh("selftest")
    sh.vals["a"] = "1"
    sh.vals["keep"] = "k"
    sh.exported["a"] = true
    sh.ronly["keep"] = true
    sh.funcs["f"] = 3
    sh.traps["EXIT"] = "echo bye"
    sh.traps["INT"] = ""
    (mut sh.pos).push("p1")
    (mut sh.pos).push("p2")
    let before = state_line(sh)
    frame_open(mut sh)
    traps_reset(mut sh)
    if trap_set(sh, "EXIT") || !trap_set(sh, "INT") {
        (mut bad).push("frame: traps_reset left {state_line(sh)}")
    }
    let _a = set_var(mut sh, "a", "2")
    let _b = set_var(mut sh, "b", "new")
    let _c = unset_var(mut sh, "a")
    let _d = set_var(mut sh, "a", "3")
    xset(mut sh, "b", true)
    xdel(mut sh, "a")
    rset(mut sh, "b")
    fnset(mut sh, "g", 7)
    fndel(mut sh, "f")
    tset(mut sh, "HUP", "echo hup")
    tset(mut sh, "INT", "echo int")
    var args = List[str]()
    (mut args).push("z1")
    (mut args).push("z2")
    (mut args).push("z3")
    set_pos(mut sh, args, 0)
    shift_pos(mut sh, 1)
    sh.opt_e = true
    sh.fdepth = 1
    local_push(mut sh, "a")
    frame_open(mut sh)
    let _e = set_var(mut sh, "a", "inner")
    let _f = set_var(mut sh, "c", "inner")
    set_pos(mut sh, args, 2)
    frame_close(mut sh)
    let _g = set_var(mut sh, "a", "4")
    frame_close(mut sh)
    let after = state_line(sh)
    if after != before {
        (mut bad).push("frame: before {before}\n       after  {after}")
    }
    let left = sh.ji.len + sh.jn.len + sh.istk.len + sh.sstk.len + sh.fdepth
    if left != 0 || sh.fr_top != -1 {
        (mut bad).push(
            "frame: left journal {sh.ji.len} {sh.jn.len} stacks {sh.istk.len} {sh.sstk.len} top {sh.fr_top} fdepth {sh.fdepth}",
        )
    }
    // outside any frame nothing is journaled
    let _h = set_var(mut sh, "a", "5")
    if sh.ji.len != 0 {
        (mut bad).push("frame: a write outside a frame was journaled")
    }
}

/// The tree's slots (`sh.ast`): a complete command's nodes are reused by
/// the next once it is recycled, and kept when something names them.
fn want_recycle(mut bad: List[str]) {
    var a = new_ast()
    var p = new_parser("true | true\nfalse | false\nx() {{ :; }}\ntrue\n", 1)
    let n1 = parse_complete(mut p, mut a)
    let used = a.top
    recycle(mut a, 0, 0)
    let n2 = parse_complete(mut p, mut a)
    if n2 != n1 || a.nodes.len != used || a.nodes[n2 + 1].text != "" {
        (mut bad).push(
            "recycle: second command at {n2} (first {n1}), {a.nodes.len} slots for {used}",
        )
    }
    if dump_of(a, n2) != dump_of_src("false | false\n") {
        (mut bad).push("recycle: the reused slots read {escaped(dump_of(a, n2))}")
    }
    recycle(mut a, 0, 0)
    let f = parse_complete(mut p, mut a)
    keep(mut a)
    let kept = a.top
    recycle(mut a, 0, 0)
    if a.top != kept || f < 0 {
        (mut bad).push("recycle: a kept tree was taken back ({a.top} of {kept})")
    }
    let t = parse_complete(mut p, mut a)
    if t < kept {
        (mut bad).push("recycle: a node was reused under the pin ({t} < {kept})")
    }
}

fn dump_of(a: Ast, n: int) -> str {
    var o = buf()
    dump(a, n, 0, mut o)
    text(o)
}

fn dump_of_src(src: str) -> str {
    var a = new_ast()
    var p = new_parser(src, 1)
    let n = parse_complete(mut p, mut a)
    dump_of(a, n)
}

/// A word's text (`sh.parse`'s `word_text`): the source itself, with a
/// `\`-newline cut out where the word or a double-quoted part of it
/// has one, and kept inside single quotes, `$(…)`, `${…}` and
/// backquotes, which are read later.
fn want_word(mut bad: List[str], src: str, want: str) {
    var a = new_ast()
    var p = new_parser(src, 1)
    let n = parse_complete(mut p, mut a)
    var got = ""
    if n >= 0 {
        var k = n
        while a.nodes[k].kind != K_SIMPLE && a.nodes[k].kids.len > 0 {
            k = a.nodes[k].kids[0]
        }
        for w in a.nodes[k].words {
            got = got + "[" + w + "]"
        }
    }
    if got != want || p.err.len > 0 {
        (mut bad).push("words of {escaped(src)} = {escaped(got)}, want {escaped(want)} err={p.err}")
    }
}

/// pelt#3: how many directories pathname expansion lists for one
/// word, as the shell's source spells it. A word that is not a pattern
/// (XCU: a `[` that opens no bracket expression matches itself) lists
/// none, whatever the working directory holds.
fn want_reads(mut bad: List[str], word: str, noglob: bool, want: int) {
    var sh = new_sh("selftest")
    sh.opt_f = noglob
    var words = List[str]()
    (mut words).push(word)
    let _fields = expand_words(mut sh, words)
    if sh.dir_reads != want {
        (mut bad).push("expanding {escaped(word)} listed {sh.dir_reads} directories, want {want}")
    }
}

/// A redirection as the parser would have read it.
fn rd(op: str, word: str, fd: int) -> Rd {
    Rd { op: op, word: word, fd: fd, body: "", has_doc: false, quoted: false, line: 1 }
}

fn table(sh: Sh) -> str {
    var o = buf()
    var k = 0
    while k < sh.fds.len {
        put(mut o, "{sh.fds[k]} ")
        k += 1
    }
    text(o)
}

/// A frame changes the table and its end puts the table back; `exec`'s
/// permanent form does not; a here-document is a handle that reads the
/// body and is closed with its frame; a duplicate of a closed
/// descriptor fails.
fn want_frames(mut bad: List[str]) {
    var sh = new_sh("selftest")
    var rds = List[Rd]()
    (mut rds).push(rd(">&", "1", 3))
    (mut rds).push(rd(">&", "-", 1))
    (mut rds).push(rd("<&", "2", 0))
    if !apply_redirs(mut sh, rds) {
        (mut bad).push("frame: 3>&1 1>&- 0<&2 refused")
    }
    if table(sh) != "2 -1 2 1 " {
        (mut bad).push("frame: inside, the table is {table(sh)}, want 2 -1 2 1")
    }
    end_redirs(mut sh)
    if table(sh) != "0 1 2 -1 " {
        (mut bad).push("frame: after, the table is {table(sh)}, want 0 1 2 -1")
    }
    var p = List[Rd]()
    (mut p).push(rd(">&", "2", 4))
    if !apply_permanent(mut sh, p) || fd_get(sh, 4) != 2 {
        (mut bad).push("exec 4>&2: the table is {table(sh)}")
    }
    var docs = List[Rd]()
    (mut docs).push(Rd {
        op: "<<",
        word: "E",
        fd: -1,
        body: "a $x\n",
        has_doc: true,
        quoted: true,
        line: 1,
    })
    if !apply_redirs(mut sh, docs) {
        (mut bad).push("here-document refused")
    }
    let h = fd_get(sh, 0)
    let got = fs_read_chunk(h, 64) else List[byte]()
    let body = text(Buf { b: got })
    if h < 3 || body != "a $x\n" {
        (mut bad).push("here-document: handle {h} read {escaped(body)}")
    }
    end_redirs(mut sh)
    var still_open = true
    fs_close(h) else |_| {
        still_open = false
    }
    if fd_get(sh, 0) != 0 || still_open {
        (mut bad).push(
            "here-document: after its frame fd 0 is {fd_get(sh, 0)}, handle {h} still open",
        )
    }
    // a duplicate of a closed descriptor fails (the shadow: no message)
    var q = new_sh("selftest")
    q.shadow = true
    var bad_dup = List[Rd]()
    (mut bad_dup).push(rd(">&", "7", 1))
    if apply_redirs(mut q, bad_dup) {
        (mut bad).push("1>&7 with 7 closed was accepted")
    }
}

fn want_canon(mut bad: List[str], p: str, want: str) {
    if canon(p) != want {
        (mut bad).push("canon({p}) = {canon(p)}, want {want}")
    }
}

/// Which typed lines `run_turn_fast` finishes inside the region (and
/// with what), and which it hands to the ordinary path.
fn want_route(mut bad: List[str], src: str, nounset: bool, want: int, want_enc: str) {
    var sh = new_sh("selftest")
    sh.vals["i"] = "1"
    sh.opt_u = nounset
    let r = copy region t {
        run_turn_fast(sh, src, 1)
    }
    if r.kind != want || r.enc != want_enc {
        (mut bad).push(
            "route {escaped(src)}: kind {r.kind} enc {escaped(r.enc)}, want {want} {escaped(want_enc)}",
        )
    }
}

/// `=` `name` NUL `value` NUL, as the fast path encodes an assignment.
fn enc1(name: str, value: str) -> str {
    var o = buf()
    putc(mut o, '=')
    put(mut o, name)
    putb(mut o, 0)
    put(mut o, value)
    putb(mut o, 0)
    text(o)
}

/// A child's raw `os_wait_status` answer as a shell status, and
/// whether the shell says anything about it.
fn want_status(mut bad: List[str], raw: int, want: int, want_sig: int, spoken: bool) {
    let (st, sig) = status_of(raw)
    if st != want || sig != want_sig || signal_spoken(sig) != spoken {
        (mut bad).push(
            "status_of({raw}) = {st} sig {sig} spoken {signal_spoken(sig)}, want {want} sig {want_sig} spoken {spoken}",
        )
    }
}

fn joined_env(xs: List[str]) -> str {
    var o = buf()
    for x in xs {
        putc(mut o, '[')
        put(mut o, x)
        putc(mut o, ']')
    }
    text(o)
}

/// What a program that replaces the shell is handed: the exported
/// variables that are set, and the `exec` command's own assignments.
fn want_exec_env(mut bad: List[str]) {
    var sh = new_sh("selftest")
    sh.vals["KEPT"] = "1"
    sh.exported["KEPT"] = true
    sh.vals["PLAIN"] = "2"
    sh.vals["MINE"] = "a=b c"
    sh.exported["NOVALUE"] = true
    var extra = List[str]()
    (mut extra).push("MINE")
    let got = joined_env(exec_env(sh, extra))
    if got != "[KEPT=1][MINE=a=b c]" {
        (mut bad).push("exec_env = {got}")
    }
    if env_wants(sh, "PLAIN") || env_wants(sh, "NOVALUE") || !env_wants(sh, "KEPT") {
        (mut bad).push("env_wants: PLAIN, NOVALUE or KEPT is wrong")
    }
}

/// A child the signal named `name` ended: `128 + N` for this host's N.
fn want_signal_status(mut bad: List[str], name: str, spoken: bool) {
    let n = sig_number(sig_index(name))
    if n <= 0 {
        (mut bad).push("no number for {name}")
        return
    }
    want_status(mut bad, 0 - n, 128 + n, n, spoken)
}

/// `sh.signal`'s table: every meaning has a name, a number on this
/// host and one place, a condition is read by name in any case and by
/// number, and the twenty a program may hear are exactly the ones the
/// host takes in a set (the eight send-only are refused there,
/// `[os.signal.set]`). Nothing is applied to the host: no signal's
/// disposition moves in the test.
fn want_conditions(mut bad: List[str]) {
    var seen = 0
    var k = 0
    while k < SIG_ALL {
        let name = sig_name(k)
        let m = sig_meaning(k)
        let n = sig_number(k)
        if name.len == 0 || m == 0 || n <= 0 {
            (mut bad).push("table row {k}: name [{name}] meaning {m} number {n}")
        }
        if seen & m != 0 {
            (mut bad).push("table row {k}: {name} shares a meaning with an earlier row")
        }
        seen = seen | m
        if sig_index(name) != k || sig_by_number(n) != k {
            (mut bad).push(
                "{name}: sig_index {sig_index(name)}, sig_by_number({n}) {sig_by_number(n)}, want {k}",
            )
        }
        if cond_name(name) != name || cond_name(name.lower()) != name || cond_name("{n}") != name {
            (mut bad).push(
                "cond_name({name}) = [{cond_name(name)}] [{cond_name(name.lower())}] [{cond_name("{n}")}]",
            )
        }
        if sig_parse(name) != k || sig_parse("{n}") != k {
            (mut bad).push("sig_parse({name}) = {sig_parse(name)}, by number {sig_parse("{n}")}")
        }
        k += 1
    }
    if sig_meaning(SIG_ALL) != 0 || sig_name(SIG_ALL).len != 0 || sig_number(SIG_ALL) != 0 {
        (mut bad).push("the table does not end at {SIG_ALL}")
    }
    for c in ["0", "EXIT", "exit", "00"] {
        if cond_name(c) != "EXIT" {
            (mut bad).push("cond_name({c}) = [{cond_name(c)}], want EXIT")
        }
    }
    for c in ["", "SIGHUP", "NOSUCH", "-1", "1x", " 1", "+1", "999999"] {
        if cond_name(c).len != 0 || sig_parse(c) >= 0 {
            (mut bad).push("cond_name({c}) = [{cond_name(c)}], sig_parse {sig_parse(c)}: want none")
        }
    }
    if sig_parse("0") >= 0 || sig_parse("EXIT") >= 0 {
        (mut bad).push("sig_parse takes 0 or EXIT for a signal")
    }
    // the heard set is a set the host takes; one more meaning is not
    var heard = 0
    k = 0
    while k < SIG_HEARD {
        heard = heard | sig_meaning(k)
        k += 1
    }
    let quiet = os_signal_poll(heard) else |_| 0 - 1
    if quiet != 0 {
        (mut bad).push("a poll of the {SIG_HEARD} heard meanings answered {quiet}, want 0")
    }
    let refused = os_signal_poll(heard | sig_meaning(SIG_HEARD)) else |_| 0 - 1
    if refused != 0 - 1 {
        (mut bad).push("a poll of {SIG_HEARD + 1} meanings answered {refused}, want the io row")
    }
    // waiting signals are served lowest number first
    var set = heard
    var last = 0
    var served = 0
    loop {
        let j = lowest_numbered(set)
        if j < 0 {
            break
        }
        if sig_number(j) <= last {
            (mut bad).push("lowest_numbered: {sig_name(j)} ({sig_number(j)}) after {last}")
        }
        last = sig_number(j)
        set = less(set, sig_meaning(j))
        served += 1
    }
    if served != SIG_HEARD || set != 0 {
        (mut bad).push("lowest_numbered served {served} of {SIG_HEARD}")
    }
    if less(m_hup() | m_int(), m_int()) != m_hup() || less(m_hup(), m_int()) != m_hup() {
        (mut bad).push("less: a set without a meaning")
    }
    var sh = new_sh("selftest")
    if interactive_set(sh) != 0 {
        (mut bad).push("a script listens for nothing by itself")
    }
    sh.interactive = true
    if interactive_set(sh) != m_int() | m_quit() | sig_meaning(sig_index("TERM")) {
        (mut bad).push("interactive_set = {interactive_set(sh)}")
    }
    // one of the three ignored when the shell started is not listened for
    sh.sig_ign0 = m_quit()
    if interactive_set(sh) != m_int() | sig_meaning(sig_index("TERM")) {
        (mut bad).push("interactive_set with QUIT ignored at start = {interactive_set(sh)}")
    }
}

/// `$!` and `wait`: a job is found by the id it was given, the newest
/// first, and an id no job has is -1.
fn want_jobs(mut bad: List[str]) {
    var sh = new_sh("selftest")
    for id in [4242, NO_PID_BASE + 1, 4242] {
        (mut sh.jobs).push(-1)
        (mut sh.job_st).push(0)
        (mut sh.job_id).push(id)
    }
    if job_of(sh, 4242) != 2 || job_of(sh, NO_PID_BASE + 1) != 1 || job_of(sh, 7) != -1 {
        (mut bad).push(
            "job_of: {job_of(sh, 4242)} {job_of(sh, NO_PID_BASE + 1)} {job_of(sh, 7)}, want 2 1 -1",
        )
    }
}

/// `umask`'s operand reader and its two answers (`sh.umask`); -1 for a
/// refused operand. Each expected mask was read off dash 0.5.13.4.
fn want_mask(mut bad: List[str], cur: int, operand: str, want: int) {
    let got = mask_from(cur, operand) else -1
    if got != want {
        (mut bad).push("mask_from({mask_octal(cur)}, {operand}) = {got}, want {want}")
    }
}

/// The table check that a subshell's mask is put back is the corpus's
/// (`umask/subshells`): it needs the process's own mask.
fn want_mask_texts(mut bad: List[str]) {
    let pairs = [
        (0o022, "0022 u=rwx,g=rx,o=rx"),
        (0o777, "0777 u=,g=,o="),
        (0, "0000 u=rwx,g=rwx,o=rwx"),
        (0o137, "0137 u=rw,g=r,o="),
    ]
    for (m, want) in pairs {
        let got = "{mask_octal(m)} {mask_symbolic(m)}"
        if got != want {
            (mut bad).push("mask texts of {m}: {got}, want {want}")
        }
    }
}

/// Run every table check; answers one line per check that failed,
/// empty when all pass.
pub fn self_test() -> List[str] {
    var bad = List[str]()
    want_match(mut bad, "*", "", true)
    want_match(mut bad, "a*c", "abbbc", true)
    want_match(mut bad, "a*c", "abbb", false)
    want_match(mut bad, "?", "", false)
    want_match(mut bad, "[a-c]x", "bx", true)
    want_match(mut bad, "[!a-c]x", "bx", false)
    want_match(mut bad, "[]]", "]", true)
    want_match(mut bad, "[[:digit:]]*", "7up", true)
    want_match(mut bad, "\\*", "*", true)
    want_match(mut bad, "\\*", "a", false)
    want_match(mut bad, "[ab", "[ab", true)
    want_match(mut bad, quoted_star(), "*", true)
    want_match(mut bad, quoted_star(), "x", false)
    want_match(mut bad, "*.tar.gz", "a.tar.gz", true)
    want_arith(mut bad, "1+2*3", 7)
    want_arith(mut bad, "(1+2)*3", 9)
    want_arith(mut bad, "-7/2", -3)
    want_arith(mut bad, "-7%2", -1)
    want_arith(mut bad, "1<<62<<1", -9223372036854775807 - 1)
    want_arith(mut bad, "9223372036854775807+1", -9223372036854775807 - 1)
    want_arith(mut bad, "0x1f + 010", 39)
    want_arith(mut bad, "1 ? 2 ? 3 : 4 : 5", 3)
    want_arith(mut bad, "0 && 1/0", 0)
    want_arith(mut bad, "1 || 1/0", 1)
    want_arith(mut bad, "~0", -1)
    want_arith(mut bad, "!5 == 0", 1)
    want_arith_error(mut bad, "x = 3, 1")
    want_arith_error(mut bad, "1/0")
    want_arith_error(mut bad, "1 +")
    want_arith_error(mut bad, "09")
    want_split(mut bad, " \t\n", "  a  b ", "[a][b]")
    want_split(mut bad, ":", "::a::", "[][][a][]")
    want_split(mut bad, " :", " :a : b: ", "[][a][b]")
    want_split(mut bad, "", "a b", "[a b]")
    want_split(mut bad, "1", "a1b11c", "[a][b][][c]")
    want_trim(mut bad, "a/b/c", "*/", true, false, "b/c")
    want_trim(mut bad, "a/b/c", "*/", true, true, "c")
    want_trim(mut bad, "f.tar.gz", ".*", false, false, "f.tar")
    want_trim(mut bad, "f.tar.gz", ".*", false, true, "f")
    want_trim(mut bad, "abc", "z", true, true, "abc")
    if udigits(-1, 10, false) != "18446744073709551615" {
        (mut bad).push("udigits(-1, 10) = {udigits(-1, 10, false)}")
    }
    if udigits(-1, 16, false) != "ffffffffffffffff" {
        (mut bad).push("udigits(-1, 16) = {udigits(-1, 16, false)}")
    }
    if udigits(255, 8, false) != "377" {
        (mut bad).push("udigits(255, 8) = {udigits(255, 8, false)}")
    }
    let n = to_int("-9223372036854775808") else 0
    if n != -9223372036854775807 - 1 {
        (mut bad).push("to_int(min) = {n}")
    }
    want_tree(
        mut bad,
        "a && b || ! c\n",
        "list ;\n  andor && ||\n    simple word\"a\"\n    simple word\"b\"\n    pipe !\n      simple word\"c\"\n",
    )
    want_tree(
        mut bad,
        "f() {{ :; }}\n",
        "list ;\n  func f\n    brace\n      list ;\n        simple word\":\"\n",
    )
    want_tree(
        mut bad,
        "for i in a; do :; done\n",
        "list ;\n  for i in \"a\"\n    list ;\n      simple word\":\"\n",
    )
    // not patterns: no directory is read
    for w in [
        "[",
        "]",
        "-f",
        "[a",
        "a]",
        "x[a",
        "\"[\"a]",
        "[a\"]\"",
        "\\[a]",
        "'['a]",
        "[]",
        "[!]",
        "[a/b]",
        "\"*\"",
        "'?'",
    ] {
        want_reads(mut bad, w, false, 0)
    }
    // patterns: one read each (one magic component in the cwd)
    for w in [
        "*",
        "?",
        "x*[",
        "[!x]",
        "[]]",
        "[!]]",
        "[a-]",
        "[\"a\"]",
        "[\\a]",
        "[[:alpha:]]",
        "[[:alpha:]",
    ] {
        want_reads(mut bad, w, false, 1)
    }
    // `[a/*`: the `[a` component is a literal, only `*` lists `[a/`
    want_reads(mut bad, "[a/*", false, 1)
    // `set -f`: nothing is a pattern
    want_reads(mut bad, "*", true, 0)
    want_frames(mut bad)
    want_journal(mut bad)
    want_recycle(mut bad)
    want_word(mut bad, "echo a b\n", "[echo][a][b]")
    want_word(mut bad, "ec\\\nho a\\\nb\n", "[echo][ab]")
    want_word(mut bad, "echo \"a\\\nb\"c\n", "[echo][\"ab\"c]")
    want_word(mut bad, "echo 'a\\\nb'\n", "[echo]['a\\\nb']")
    want_word(mut bad, "echo $(a\\\nb) ${{x:-a\\\nb}}\n", "[echo][$(a\\\nb)][${{x:-a\\\nb}}]")
    want_word(mut bad, "echo `a\\\nb`\n", "[echo][`a\\\nb`]")
    want_canon(mut bad, "/a/./b/../c", "/a/c")
    want_canon(mut bad, "/..", "/")
    want_canon(mut bad, "//usr", "//usr")
    want_canon(mut bad, "///usr//", "/usr")
    want_canon(mut bad, "/a/b/../../..", "/")
    // inside the region: a test, an assignment, output to a file
    want_route(mut bad, "[ 1 -lt 2 ]\n", false, R_DONE, "")
    want_route(mut bad, "true\n", false, R_DONE, "")
    want_route(mut bad, "i=$((i+1))\n", false, R_DONE, enc1("i", "2"))
    want_route(mut bad, "echo hi >/dev/null\n", false, R_DONE, "")
    // an expansion's assignment is recorded, in order (sh08)
    want_route(mut bad, ": ${{y:=1}}\n", false, R_DONE, enc1("y", "1"))
    want_route(mut bad, "echo $((z=1)) >/dev/null\n", false, R_DONE, enc1("z", "1"))
    want_route(mut bad, "j=$((k=3))\n", false, R_DONE, enc1("k", "3") + enc1("j", "3"))
    // the ordinary path: anything that writes the state while it runs
    want_route(mut bad, "x=$(true)\n", false, R_SLOW, "")
    want_route(mut bad, "unset i\n", false, R_SLOW, "")
    want_route(mut bad, "cd /\n", false, R_SLOW, "")
    want_route(mut bad, "read x\n", false, R_SLOW, "")
    want_route(mut bad, "echo $nope\n", true, R_SLOW, "")
    want_route(mut bad, "true; true\n", false, R_SLOW, "")
    want_route(mut bad, "true | true\n", false, R_SLOW, "")
    // a child's ending: an exit code, or 128 + N for signal N; the
    // shell is silent about SIGINT and SIGPIPE
    want_status(mut bad, 0, 0, 0, false)
    want_status(mut bad, 7, 7, 0, false)
    want_status(mut bad, 255, 255, 0, false)
    want_signal_status(mut bad, "TERM", true)
    want_signal_status(mut bad, "KILL", true)
    want_signal_status(mut bad, "HUP", true)
    want_signal_status(mut bad, "USR1", true)
    want_signal_status(mut bad, "INT", false)
    want_signal_status(mut bad, "PIPE", false)
    let term_n = sig_number(sig_index("TERM"))
    if signal_words(term_n) != "ended by signal {term_n} (TERM)" {
        (mut bad).push("signal_words: {signal_words(term_n)}")
    }
    if signal_words(999999) != "ended by signal 999999" {
        (mut bad).push("signal_words: {signal_words(999999)}")
    }
    want_exec_env(mut bad)
    want_conditions(mut bad)
    want_jobs(mut bad)
    want_mask(mut bad, 0o027, "022", 0o022)
    want_mask(mut bad, 0o027, "7777", 0o777)
    want_mask(mut bad, 0o027, "", 0o027)
    want_mask(mut bad, 0o027, "8", -1)
    want_mask(mut bad, 0o027, "+w", 0o005)
    want_mask(mut bad, 0o027, "=r", 0o333)
    want_mask(mut bad, 0o027, "u=g", 0o227)
    want_mask(mut bad, 0o027, "g=u-w", 0o027)
    want_mask(mut bad, 0o777, "u+x,o+X", 0o677)
    want_mask(mut bad, 0o077, "g=rwx,o=g", 0o007)
    want_mask(mut bad, 0o027, "u=rwx,", 0o027)
    want_mask(mut bad, 0o027, "u=rwx,,o=r", -1)
    want_mask(mut bad, 0o027, ",", -1)
    want_mask(mut bad, 0o027, "u", -1)
    want_mask(mut bad, 0o027, "u+t", -1)
    want_mask(mut bad, 0o027, "u+s", 0o027)
    want_mask(mut bad, 0o027, "-", 0o027)
    want_mask_texts(mut bad)
    want_hist(mut bad)
    want_complete(mut bad)
    want_read(mut bad, ":", "a:b:c:", 3, "[a][b][c]")
    want_read(mut bad, ":", "a:b:c::", 3, "[a][b][c::]")
    want_read(mut bad, ": ", "a:b:c :", 3, "[a][b][c]")
    want_read(mut bad, ":", "a:", 1, "[a]")
    want_read(mut bad, ":", "a::", 1, "[a::]")
    want_read(mut bad, ":", ":", 1, "[]")
    want_read(mut bad, ",", "a,b,,", 2, "[a][b,,]")
    want_read(mut bad, " \t\n", " c d  ", 1, "[c d]")
    want_read(mut bad, " \t\n", "c  ", 1, "[c]")
    want_ds(mut bad, "$'a\\tb'", "a\tb", 7)
    want_ds(mut bad, "$'it\\'s'x", "it's", 8)
    want_ds(mut bad, "$'\\x41\\1012'", "AA2", 12)
    want_ds(mut bad, "$'ab\\0cd'", "ab", 9)
    want_ds(mut bad, "$'\\q'", "\\q", 5)
    want_ds(mut bad, "$'\\u00e9'", "é", 9)
    want_ds(mut bad, "$''", "", 3)
    bad
}

/// The `$'…'` at the start of `w` decoded (`sh.dsquote`): its text with
/// the quoting removed, and where it ends.
fn want_ds(mut bad: List[str], w: str, want: str, want_end: int) {
    var o = buf()
    let e = ds_put(w, 0, mut o)
    let got = unmark(text(o))
    if got != want || e != want_end {
        (mut bad).push(
            "ds({escaped(w)}) = {escaped(got)} end {e}, want {escaped(want)} end {want_end}",
        )
    }
}

/// `read`'s split of `line` (no backslashes) into the first `n` of the
/// variables `a`, `b`, `c` under `IFS` `ifs_value` (`sh.builtin`'s
/// `assign_fields`), as `[a][b]…`.
fn want_read(mut bad: List[str], ifs_value: str, line: str, n: int, want: str) {
    var sh = new_sh("selftest")
    sh.vals["IFS"] = ifs_value
    var m = buf()
    putb(mut m, RB)
    for b in line.bytes() {
        lit(mut m, b as int)
    }
    putb(mut m, RE)
    let all = ["a", "b", "c"]
    let names = all[0..n]
    let ok = assign_fields(mut sh, names, text(m))
    var o = buf()
    for name in names {
        put(mut o, "[{sh.vals[name] else "?"}]")
    }
    let got = text(o)
    if !ok || got != want {
        (mut bad).push("read {escaped(line)} on IFS {escaped(ifs_value)} = {got}, want {want}")
    }
}

// --------------------------------------------------------- the history

/// An interactive shell whose history holds `lines`, the last one the
/// command being run (as when `fc` is typed); no file.
fn hist_sh(lines: List[str]) -> Sh {
    var sh = new_sh("selftest")
    sh.interactive = true
    sh.ed.h.state = H_MEM
    for l in lines {
        ring_push(mut sh.ed.h, 128, l)
    }
    sh.ed.h.cur = true
    sh
}

fn want_fc_number(mut bad: List[str], h: Hist, op: str, first: bool, want: int) {
    let got = fc_number(h, op, first)
    if got != want {
        (mut bad).push("fc_number({op}, first={first}) = {got}, want {want}")
    }
}

/// `fc args` in `hist_sh(lines)`: what it writes to standard output.
fn want_fc_out(mut bad: List[str], lines: List[str], args: List[str], want: str) {
    var sh = hist_sh(lines)
    let st = bi_fc(mut sh, args)
    let got = text(Buf { b: sh.out })
    if st != 0 || got != want {
        (mut bad).push("fc {args}: status {st}, {escaped(got)}, want {escaped(want)}")
    }
}

/// Every expected value here is XCU `fc`'s words, or a black-box run
/// of bash --posix 5.3 or dash 0.5.13.4 (`notes/sh12-evidence/probe/`).
fn want_hist(mut bad: List[str]) {
    var five = List[str]()
    (mut five).push("echo a")
    (mut five).push("echo b")
    (mut five).push("printf x")
    (mut five).push("echo c")
    (mut five).push("fc -l")
    let sh = hist_sh(five)
    let h = copy sh.ed.h
    // -1 is the command before the fc line; [+]n is n (POSIX; bash
    // refuses +n); 0 the previous and -0 the fc line (bash)
    want_fc_number(mut bad, h, "-1", true, 4)
    want_fc_number(mut bad, h, "1", true, 1)
    want_fc_number(mut bad, h, "+2", true, 2)
    want_fc_number(mut bad, h, "0", true, 4)
    want_fc_number(mut bad, h, "-0", true, 5)
    // beyond either end: a first is the oldest (bash and dash); a last
    // beyond the newest is the previous command
    want_fc_number(mut bad, h, "99", true, 1)
    want_fc_number(mut bad, h, "-99", true, 1)
    want_fc_number(mut bad, h, "99", false, 4)
    want_fc_number(mut bad, h, "-99", false, 1)
    want_fc_number(mut bad, h, "9999999999999", false, 4)
    // a string: the newest before the fc line that starts with it
    want_fc_number(mut bad, h, "ec", true, 4)
    want_fc_number(mut bad, h, "pri", true, 3)
    want_fc_number(mut bad, h, "fc", true, -1)
    want_fc_number(mut bad, h, "zz", false, -1)
    // the list: %d\t%s\n; -n \t%s\n
    want_fc_out(mut bad, five, ["-l"], "1\techo a\n2\techo b\n3\tprintf x\n4\techo c\n")
    want_fc_out(mut bad, five, ["-ln", "-2", "-1"], "\tprintf x\n\techo c\n")
    want_fc_out(mut bad, five, ["-l", "3", "1"], "3\tprintf x\n2\techo b\n1\techo a\n")
    // -r with first newer than last: the two cancel (XCU fc's example,
    // `fc -r 40 30` is `fc 30 40`; dash does; bash does not)
    want_fc_out(mut bad, five, ["-lr", "3", "1"], "1\techo a\n2\techo b\n3\tprintf x\n")
    want_fc_out(mut bad, five, ["-lr", "1", "2"], "2\techo b\n1\techo a\n")
    // -0 alone: from the fc line back to the previous (dash; bash
    // lists only the fc line)
    want_fc_out(mut bad, five, ["-l", "-0"], "5\tfc -l\n4\techo c\n")
    // a multi-line entry keeps its lines: continuation lines \t%s
    var multi = List[str]()
    (mut multi).push("for i in 1 2\ndo echo $i\ndone")
    (mut multi).push("fc -l")
    want_fc_out(mut bad, multi, ["-l"], "1\tfor i in 1 2\n\tdo echo $i\n\tdone\n")
    want_fc_out(mut bad, multi, ["-ln"], "\tfor i in 1 2\n\tdo echo $i\n\tdone\n")
    // only the fc line: -l lists it (bash and dash)
    var lone = List[str]()
    (mut lone).push("fc -l")
    want_fc_out(mut bad, lone, ["-l"], "1\tfc -l\n")
    // the file's lines: a backslash doubled, a newline as \n; plain
    // lines from elsewhere read as written
    var o = buf()
    encode_entry(mut o, "a\\b\nc")
    if text(o) != "a\\\\b\\nc\n" {
        (mut bad).push("encode_entry = {escaped(text(o))}")
    }
    if decode_entry("a\\\\b\\nc") != "a\\b\nc" || decode_entry("x\\y") != "x\\y" {
        (mut bad).push("decode_entry: {escaped(decode_entry("a\\\\b\\nc"))}")
    }
    var bs = List[byte]()
    for b in "one\ntwo\nthree".bytes() {
        (mut bs).push(b)
    }
    let r = hist_parse(bs, 0, 2)
    if !r.ok || r.count != 3 || r.entries.len != 2 || r.entries[0] != "two" || !r.need_nl {
        (mut bad).push("hist_parse: ok {r.ok} count {r.count} {r.entries} need_nl {r.need_nl}")
    }
    (mut bs).push(0 as byte)
    if hist_parse(bs, 0, 2).ok {
        (mut bad).push("hist_parse took a file with a NUL byte")
    }
    // PS1: each ! the next number, !! one ! (XCU 2.5.3)
    if ps1_bang("a!b!!c!", 7) != "a7b!c7" || ps1_bang("$ ", 7) != "$ " {
        (mut bad).push("ps1_bang: {ps1_bang("a!b!!c!", 7)}")
    }
}

/// What `comp_ctx` says of `line` (the text up to the cursor), as
/// `kind lit q brace exec_only lead`.
fn ctx_line(line: str) -> str {
    let c = comp_ctx(cps_of(line))
    "{c.kind} [{c.lit}] {c.q} {c.brace} {c.exec_only} {c.lead}"
}

fn want_ctx(mut bad: List[str], line: str, want: str) {
    let got = ctx_line(line)
    if got != want {
        (mut bad).push("comp_ctx({escaped(line)}) = {escaped(got)}, want {escaped(want)}")
    }
}

fn want_quote(mut bad: List[str], s: str, q: int, lead: bool, want: str) {
    let got = comp_quote(s, q, lead)
    if got != want {
        (mut bad).push(
            "comp_quote({escaped(s)}, {q}, {lead}) = {escaped(got)}, want {escaped(want)}",
        )
    }
}

fn want_layout(mut bad: List[str], n: int, widest: int, cols: int, want: str) {
    let (r, c, w) = comp_layout(n, widest, cols)
    let got = "{r} {c} {w}"
    if got != want {
        (mut bad).push("comp_layout({n}, {widest}, {cols}) = {got}, want {want}")
    }
}

/// Tab's pieces (`sh.complete`): which word is completed as what, the
/// quoting of what is inserted, and the list's columns. Each row is a
/// shape a black-box session of bash or mksh decided
/// (`notes/sh16-evidence/probe/`) or pelt chose (`notes/sh16-…` §3.1).
fn want_complete(mut bad: List[str]) {
    // command position: the line's start, after operators, `$(`, a
    // backquote, an assignment and the reserved words a command follows
    want_ctx(mut bad, "unam", "1 [unam] 0 false false false")
    want_ctx(mut bad, "", "1 [] 0 false false true")
    want_ctx(mut bad, "echo hi | unam", "1 [unam] 0 false false false")
    want_ctx(mut bad, "true && un", "1 [un] 0 false false false")
    want_ctx(mut bad, "true;un", "1 [un] 0 false false false")
    want_ctx(mut bad, "echo $(unam", "1 [unam] 0 false false false")
    want_ctx(mut bad, "echo `unam", "1 [unam] 0 false false false")
    want_ctx(mut bad, "(cd", "1 [cd] 0 false false false")
    want_ctx(mut bad, "FOO=1 unam", "1 [unam] 0 false false false")
    want_ctx(mut bad, "if unam", "1 [unam] 0 false false false")
    want_ctx(mut bad, "! un", "1 [un] 0 false false false")
    want_ctx(mut bad, "'if' un", "2 [un] 0 false false false")
    // a file: an argument, after a redirection, a value, a word with `/`
    want_ctx(mut bad, "echo uniq", "2 [uniq] 0 false false false")
    want_ctx(mut bad, "echo ", "2 [] 0 false false true")
    want_ctx(mut bad, "cat <uni", "2 [uni] 0 false false false")
    want_ctx(mut bad, "echo x >", "2 [] 0 false false true")
    want_ctx(mut bad, ">out un", "1 [un] 0 false false false")
    want_ctx(mut bad, "FOO=uni", "2 [uni] 0 false false false")
    want_ctx(mut bad, "./sc", "2 [./sc] 0 false true false")
    want_ctx(mut bad, "ls ~/d", "2 [~/d] 0 false false false")
    // quotes: taken off the text, and the one open at the cursor kept
    want_ctx(mut bad, "echo \"my", "2 [my] 34 false false false")
    want_ctx(mut bad, "echo 'my", "2 [my] 39 false false false")
    want_ctx(mut bad, "echo my\\ f", "2 [my f] 0 false false false")
    want_ctx(mut bad, "echo \"a\\$b", "2 [a$b] 34 false false false")
    want_ctx(mut bad, "echo foo\\", "0 [] 0 false false false")
    // variables: `$name`, `${name`, inside "…", inside a word; not
    // quoted ones and not positional parameters
    want_ctx(mut bad, "echo $HO", "3 [HO] 0 false false false")
    want_ctx(mut bad, "echo ${{HO", "3 [HO] 0 true false false")
    want_ctx(mut bad, "echo \"$HO", "3 [HO] 34 false false false")
    want_ctx(mut bad, "echo a$HO", "3 [HO] 0 false false false")
    want_ctx(mut bad, "echo $", "3 [] 0 false false false")
    want_ctx(mut bad, "echo '$HO", "2 [$HO] 39 false false false")
    want_ctx(mut bad, "echo \\$HO", "2 [$HO] 0 false false false")
    want_ctx(mut bad, "echo $1", "2 [$1] 0 false false false")
    want_ctx(mut bad, "echo ${{HO}}", "2 [${{HO}}] 0 false false false")
    // quoting what is inserted (bash's backslashes; a newline as mksh)
    want_quote(mut bad, "my file", 0, false, "my\\ file")
    want_quote(mut bad, "a$b&c;d(e)", 0, false, "a\\$b\\&c\\;d\\(e\\)")
    want_quote(mut bad, "q'u\"o", 0, false, "q\\'u\\\"o")
    want_quote(mut bad, "st*a?[b", 0, false, "st\\*a\\?\\[b")
    want_quote(mut bad, "nl\nname", 0, false, "nl'\n'name")
    want_quote(mut bad, "~x#", 0, true, "\\~x#")
    want_quote(mut bad, "#x~", 0, true, "\\#x~")
    want_quote(mut bad, "~x", 0, false, "~x")
    want_quote(mut bad, "a\"b$c d", 34, false, "a\\\"b\\$c d")
    want_quote(mut bad, "it's me", 39, false, "it'\\''s me")
    want_quote(mut bad, "été", 0, false, "été")
    // what a single match adds
    let v = Ctx { kind: CK_VAR, lit: "ZQV_O", q: 34, brace: true, exec_only: false, lead: false }
    if comp_unique(v, "ZQV_O", "ZQV_ONE", false, true) != "NE}}\" " {
        (mut bad).push("comp_unique(var) = {comp_unique(v, "ZQV_O", "ZQV_ONE", false, true)}")
    }
    let f = Ctx { kind: CK_FILE, lit: "su", q: 0, brace: false, exec_only: false, lead: false }
    if comp_unique(f, "su", "sub", true, true) != "b/" ||
        comp_unique(f, "su", "sum", false, false) != "m" {
        (mut bad).push(
            "comp_unique(file) = {comp_unique(f, "su", "sub", true, true)} {comp_unique(f, "su", "sum", false, false)}",
        )
    }
    // the list: rows, columns, column width (bash's counts)
    want_layout(mut bad, 15, 13, 40, "8 2 15")
    want_layout(mut bad, 60, 3, 40, "9 7 5")
    want_layout(mut bad, 2, 3, 80, "1 2 5")
    want_layout(mut bad, 3, 100, 40, "3 1 102")
    want_layout(mut bad, 120, 4, 80, "10 12 6")
    let three = "zqxa1 zqxa2 zqxbb".split(" ")
    if common_prefix(three) != "zqx" {
        (mut bad).push("common_prefix: {common_prefix(three)}")
    }
    // every name Tab offers as a built-in is one
    for w in builtin_names() {
        if !is_special_builtin(w) && !is_regular_builtin(w) {
            (mut bad).push("builtin_names: {w} is not a built-in")
        }
    }
}
