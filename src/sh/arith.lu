//! sh.arith — arithmetic expansion, `$((expression))` (XCU 2.6.4).
//!
//! References consulted: POSIX.1-2024 XCU 2.6.4 and the C operator
//! table it defers to (signed long arithmetic, here 64-bit); black-box
//! runs of `dash` 0.5.13.4 for overflow (it wraps), octal and hex
//! constants, and what a variable's value may be (an integer constant,
//! or the expansion is an error). No shell's source.
//!
//! The text has already had its parameters, command substitutions and
//! quotes expanded. It is parsed and evaluated in one pass by
//! precedence climbing over tokens: `ar_scan` reads the token at the
//! current position once, by its first byte and at most two more,
//! taking the longest operator, and names it by an integer kind; a
//! binary operator's level comes from one table (`ar_level`). `skip`
//! counts the unevaluated sides of `&&`, `||` and `?:`, under which an
//! assignment changes nothing and an error is not raised — the
//! short-circuit is about side effects, not only the value. Overflow
//! wraps at 64 bits (the arithmetic is `wrapping[i64]`) and division by
//! zero is an error.

struct Ar {
    s: str,
    i: int,
    err: str,
    skip: int,
    /// The token at `pk_at`, once read: its kind and where it ends.
    pk_at: int,
    pk: int,
    pk_end: int,
}

fn ar_err(mut r: Ar, msg: str) {
    if r.err.len == 0 {
        r.err = msg
    }
    r.i = r.s.len
}

fn ws(mut r: Ar) {
    while r.i < r.s.len {
        let c = ch(r.s, r.i)
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            r.i += 1
        } else {
            break
        }
    }
}

// Token kinds. A binary operator's kind is 10 + its level-ordered
// place; an assignment operator's is 40 + the binary kind it applies.
const AT_END: int = 0

const AT_NUM: int = 1

const AT_NAME: int = 2

const AT_LP: int = 3

const AT_RP: int = 4

const AT_QUEST: int = 5

const AT_COLON: int = 6

const AT_NOT: int = 7

const AT_TILDE: int = 8

const AT_BAD: int = 9

const AT_OROR: int = 10

const AT_ANDAND: int = 11

const AT_OR: int = 12

const AT_XOR: int = 13

const AT_AND: int = 14

const AT_EQ: int = 15

const AT_NE: int = 16

const AT_LE: int = 17

const AT_GE: int = 18

const AT_LT: int = 19

const AT_GT: int = 20

const AT_SHL: int = 21

const AT_SHR: int = 22

const AT_ADD: int = 23

const AT_SUB: int = 24

const AT_MUL: int = 25

const AT_DIV: int = 26

const AT_MOD: int = 27

const AT_ASSIGN: int = 40

/// `AT_SET + k` is the assignment that applies binary kind `k`
/// (`+=` is `AT_SET + AT_ADD`).
const AT_SET: int = 40

/// Read the token that starts at `p` (blanks already skipped): its kind,
/// in `r.pk`, and its end, in `r.pk_end`. An operator is the longest one
/// its bytes spell: `<<=` before `<<` before `<=` before `<`. A `<` or a
/// `>` that the other one follows is no operator, as `<>` is none.
fn ar_scan(mut r: Ar, p: int) {
    r.pk_at = p
    r.pk_end = p + 1
    if p >= r.s.len {
        r.pk = AT_END
        r.pk_end = p
        return
    }
    let c = ch(r.s, p)
    let c1 = ch(r.s, p + 1)
    if is_digit(c) || is_alpha(c) {
        var e = p + 1
        while e < r.s.len && is_alnum(ch(r.s, e)) {
            e += 1
        }
        r.pk = if is_digit(c) then AT_NUM else AT_NAME
        r.pk_end = e
        return
    }
    var k = AT_BAD
    var n = 1
    if c == '(' {
        k = AT_LP
    } else if c == ')' {
        k = AT_RP
    } else if c == '?' {
        k = AT_QUEST
    } else if c == ':' {
        k = AT_COLON
    } else if c == '~' {
        k = AT_TILDE
    } else if c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '^' {
        k = AT_XOR
        if c == '+' {
            k = AT_ADD
        } else if c == '-' {
            k = AT_SUB
        } else if c == '*' {
            k = AT_MUL
        } else if c == '/' {
            k = AT_DIV
        } else if c == '%' {
            k = AT_MOD
        }
        if c1 == '=' {
            k = AT_SET + k
            n = 2
        }
    } else if c == '|' || c == '&' {
        let single = if c == '|' then AT_OR else AT_AND
        if c1 == c {
            k = if c == '|' then AT_OROR else AT_ANDAND
            n = 2
        } else if c1 == '=' {
            k = AT_SET + single
            n = 2
        } else {
            k = single
        }
    } else if c == '=' {
        if c1 == '=' {
            k = AT_EQ
            n = 2
        } else {
            k = AT_ASSIGN
        }
    } else if c == '!' {
        if c1 == '=' {
            k = AT_NE
            n = 2
        } else {
            k = AT_NOT
        }
    } else if c == '<' || c == '>' {
        let shift = if c == '<' then AT_SHL else AT_SHR
        if c1 == c {
            if ch(r.s, p + 2) == '=' {
                k = AT_SET + shift
                n = 3
            } else {
                k = shift
                n = 2
            }
        } else if c1 == '=' {
            k = if c == '<' then AT_LE else AT_GE
            n = 2
        } else if c1 == '<' || c1 == '>' {
            k = AT_BAD
        } else {
            k = if c == '<' then AT_LT else AT_GT
        }
    }
    r.pk = k
    r.pk_end = p + n
}

/// The kind of the next token, after blanks; read once per position.
fn ar_peek(mut r: Ar) -> int {
    ws(mut r)
    if r.pk_at != r.i {
        ar_scan(mut r, r.i)
    }
    r.pk
}

/// Consume the token `ar_peek` named.
fn ar_take(mut r: Ar) {
    r.i = r.pk_end
}

/// A binary operator's level, loosest first (`||` 0 through `*` `/` `%`
/// 9), or -1 for any other kind.
fn ar_level(k: int) -> int {
    if k < AT_OROR || k > AT_MOD {
        return -1
    }
    if k == AT_OROR {
        return 0
    }
    if k == AT_ANDAND {
        return 1
    }
    if k == AT_OR {
        return 2
    }
    if k == AT_XOR {
        return 3
    }
    if k == AT_AND {
        return 4
    }
    if k <= AT_NE {
        return 5
    }
    if k <= AT_GT {
        return 6
    }
    if k <= AT_SHR {
        return 8
    }
    if k <= AT_SUB {
        return 8
    }
    9
}

fn wadd(a: int, b: int) -> int {
    (a as wrapping[i64] + b as wrapping[i64]) as int
}

fn wsub(a: int, b: int) -> int {
    (a as wrapping[i64] - b as wrapping[i64]) as int
}

fn wmul(a: int, b: int) -> int {
    (a as wrapping[i64] * b as wrapping[i64]) as int
}

fn wshl(a: int, b: int) -> int {
    (a as wrapping[i64] << b as wrapping[i64]) as int
}

fn wshr(a: int, b: int) -> int {
    (a as wrapping[i64] >> b as wrapping[i64]) as int
}

fn wneg(a: int) -> int {
    wsub(0, a)
}

fn band(a: int, b: int) -> int {
    (a as wrapping[i64] & b as wrapping[i64]) as int
}

fn bor(a: int, b: int) -> int {
    (a as wrapping[i64] | b as wrapping[i64]) as int
}

fn bxor(a: int, b: int) -> int {
    (a as wrapping[i64] ^ b as wrapping[i64]) as int
}

fn bnot(a: int) -> int {
    bxor(a, -1)
}

/// An integer constant in C's spelling (decimal, `0x` hex, `0` octal),
/// with an optional sign: the form both a literal in an expression and
/// a variable's value must take.
fn parse_const(s: str) -> int ! {parse} {
    var t = s.trim()
    var neg = false
    if t.len > 0 && (ch(t, 0) == '-' || ch(t, 0) == '+') {
        neg = ch(t, 0) == '-'
        t = t[1..t.len]
    }
    if t.len == 0 {
        return parse
    }
    var base: int = 10
    var i = 0
    if t.len > 1 && ch(t, 0) == '0' && (ch(t, 1) == 'x' || ch(t, 1) == 'X') {
        base = 16
        i = 2
        if t.len == 2 {
            return parse
        }
    } else if t.len > 1 && ch(t, 0) == '0' {
        base = 8
        i = 1
    }
    var n: int = 0
    while i < t.len {
        let c = ch(t, i)
        var d: int = -1
        if is_digit(c) {
            d = c as int - 48
        } else if c >= 'a' && c <= 'f' {
            d = c as int - 87
        } else if c >= 'A' && c <= 'F' {
            d = c as int - 55
        }
        if d < 0 || d >= base {
            return parse
        }
        n = wadd(wmul(n, base), d)
        i += 1
    }
    if neg {
        return wneg(n)
    }
    n
}

fn var_value(sh: Sh, mut r: Ar, name: str) -> int {
    if !has_var(sh, name) {
        if sh.opt_u && r.skip == 0 {
            ar_err(mut r, "{name}: parameter not set")
        }
        return 0
    }
    let v = value_of(sh, name)
    if v.len == 0 {
        return 0
    }
    let n = parse_const(v) else |_| {
        if r.skip == 0 {
            ar_err(mut r, "{v}: not a number")
        }
        return 0
    }
    n
}

/// Evaluate `s`. The error, when there is one, is in the second field.
fn arith(mut sh: Sh, s: str) -> (int, str) {
    var r = Ar { s: s, i: 0, err: "", skip: 0, pk_at: -1, pk: AT_END, pk_end: 0 }
    ws(mut r)
    if r.i >= r.s.len {
        return (0, "")
    }
    let v = assign_expr(mut sh, mut r)
    ws(mut r)
    if r.err.len == 0 && r.i < r.s.len {
        ar_err(mut r, "syntax error in \"{s}\"")
    }
    (v, r.err)
}

fn read_name(mut r: Ar) -> str {
    let start = r.i
    while r.i < r.s.len && is_alnum(ch(r.s, r.i)) {
        r.i += 1
    }
    r.s[start..r.i]
}

fn assign_expr(mut sh: Sh, mut r: Ar) -> int {
    ws(mut r)
    let save = r.i
    if ar_peek(mut r) == AT_NAME {
        let name = read_name(mut r)
        let k = ar_peek(mut r)
        if k == AT_ASSIGN || k > AT_SET && ar_level(k - AT_SET) >= 2 {
            ar_take(mut r)
            let rhs = assign_expr(mut sh, mut r)
            if r.err.len > 0 {
                return 0
            }
            var v = rhs
            if k != AT_ASSIGN {
                let cur = var_value(sh, mut r, name)
                v = binop(mut r, k - AT_SET, cur, rhs)
            }
            if r.skip == 0 && r.err.len == 0 {
                if !set_var(mut sh, name, "{v}") {
                    ar_err(mut r, "{name}: is read-only")
                }
            }
            return v
        }
        r.i = save
    }
    cond_expr(mut sh, mut r)
}

fn cond_expr(mut sh: Sh, mut r: Ar) -> int {
    let c = binary(mut sh, mut r, 0)
    if ar_peek(mut r) != AT_QUEST {
        return c
    }
    ar_take(mut r)
    if c != 0 {
        let a = assign_expr(mut sh, mut r)
        if ar_peek(mut r) != AT_COLON {
            ar_err(mut r, "expecting ':' in \"{r.s}\"")
            return 0
        }
        ar_take(mut r)
        r.skip += 1
        let _b = assign_expr(mut sh, mut r)
        r.skip -= 1
        return a
    }
    r.skip += 1
    let _a = assign_expr(mut sh, mut r)
    r.skip -= 1
    if ar_peek(mut r) != AT_COLON {
        ar_err(mut r, "expecting ':' in \"{r.s}\"")
        return 0
    }
    ar_take(mut r)
    assign_expr(mut sh, mut r)
}

/// The operators at `least` and tighter, left to right: each right side
/// takes only the operators tighter than its own.
fn binary(mut sh: Sh, mut r: Ar, least: int) -> int {
    var a = unary(mut sh, mut r)
    loop {
        if r.err.len > 0 {
            return 0
        }
        let k = ar_peek(mut r)
        let level = ar_level(k)
        if level < least {
            return a
        }
        ar_take(mut r)
        if k == AT_ANDAND {
            if a == 0 {
                r.skip += 1
                let _b = binary(mut sh, mut r, level + 1)
                r.skip -= 1
                a = 0
            } else {
                let b = binary(mut sh, mut r, level + 1)
                a = if b != 0 then 1 else 0
            }
            continue
        }
        if k == AT_OROR {
            if a != 0 {
                r.skip += 1
                let _b = binary(mut sh, mut r, level + 1)
                r.skip -= 1
                a = 1
            } else {
                let b = binary(mut sh, mut r, level + 1)
                a = if b != 0 then 1 else 0
            }
            continue
        }
        let b = binary(mut sh, mut r, level + 1)
        a = binop(mut r, k, a, b)
    }
    a
}

fn binop(mut r: Ar, k: int, a: int, b: int) -> int {
    if k == AT_ADD {
        return wadd(a, b)
    }
    if k == AT_SUB {
        return wsub(a, b)
    }
    if k == AT_MUL {
        return wmul(a, b)
    }
    if k == AT_DIV || k == AT_MOD {
        if b == 0 {
            if r.skip == 0 {
                ar_err(mut r, "division by zero")
            }
            return 0
        }
        if b == -1 {
            return if k == AT_DIV then wneg(a) else 0
        }
        return if k == AT_DIV then a / b else a % b
    }
    if k == AT_SHL {
        return wshl(a, b)
    }
    if k == AT_SHR {
        return wshr(a, b)
    }
    if k == AT_LT {
        return if a < b then 1 else 0
    }
    if k == AT_LE {
        return if a <= b then 1 else 0
    }
    if k == AT_GT {
        return if a > b then 1 else 0
    }
    if k == AT_GE {
        return if a >= b then 1 else 0
    }
    if k == AT_EQ {
        return if a == b then 1 else 0
    }
    if k == AT_NE {
        return if a != b then 1 else 0
    }
    if k == AT_AND {
        return band(a, b)
    }
    if k == AT_OR {
        return bor(a, b)
    }
    if k == AT_XOR {
        return bxor(a, b)
    }
    0
}

/// `!` `~` `-` `+` before an operand. A `-` that another `-` follows, or
/// a `+` that another `+` follows, is not a sign (`--` and `++` are not
/// operators here), and neither is `!=`.
fn unary(mut sh: Sh, mut r: Ar) -> int {
    let k = ar_peek(mut r)
    if k == AT_NOT {
        ar_take(mut r)
        let v = unary(mut sh, mut r)
        return if v == 0 then 1 else 0
    }
    if k == AT_TILDE {
        ar_take(mut r)
        return bnot(unary(mut sh, mut r))
    }
    if (k == AT_SUB || k == AT_ADD) && ch(r.s, r.pk_end) != ch(r.s, r.i) {
        ar_take(mut r)
        let v = unary(mut sh, mut r)
        return if k == AT_SUB then wneg(v) else v
    }
    primary(mut sh, mut r)
}

fn primary(mut sh: Sh, mut r: Ar) -> int {
    let k = ar_peek(mut r)
    if k == AT_END {
        ar_err(mut r, "missing operand in \"{r.s}\"")
        return 0
    }
    if k == AT_LP {
        ar_take(mut r)
        let v = assign_expr(mut sh, mut r)
        if ar_peek(mut r) != AT_RP {
            ar_err(mut r, "missing ')' in \"{r.s}\"")
            return 0
        }
        ar_take(mut r)
        return v
    }
    if k == AT_NUM {
        let lit = r.s[r.i..r.pk_end]
        ar_take(mut r)
        let n = parse_const(lit) else |_| {
            ar_err(mut r, "{lit}: not a number")
            return 0
        }
        return n
    }
    if k == AT_NAME {
        let name = read_name(mut r)
        return var_value(sh, mut r, name)
    }
    let c = ch(r.s, r.i)
    ar_err(mut r, "unexpected '{c}' in \"{r.s}\"")
    0
}
