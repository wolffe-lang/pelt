//! member: false
//!
//! selfcheck — the table checks of module `sh` (`sh/selftest.lu`) on a
//! compiled tier, which `wolf test` (`src/sh_test.lu`) runs on the
//! checked machine; and `busy`'s row, which only a compiled tier can
//! answer: a fork asked while a task is live is answered `busy` before
//! the host is asked (`[os.proc.fork]`), and pelt runs the shape in
//! process (`sh.fork`). The task lives here, not in pelt: a scope named
//! in pelt's own program makes a native pelt start 1.2 to 1.4 MB larger.
//! Built and run by `tools/self-check`.

use sh

fn main() -> int {
    var bad = sh.self_test()
    let ch = channel[int](1)
    var line = ""
    scope s {
        s.spawn(fn() {
            let _v = ch.recv() else 0
        })
        let (got, ok) = sh.fork_now()
        line = sh.fork_now_line(got, ok, -1)
        ch.send(1) else |_| {}
    }
    if line.len > 0 {
        (mut bad).push(line)
    }
    for l in bad {
        eprint(l)
    }
    if bad.len > 0 {
        eprint("selfcheck: {bad.len} table checks failed")
        return 1
    }
    print(
        "selfcheck: every table check passed; a fork with a task live is busy and runs in process",
    )
    0
}
