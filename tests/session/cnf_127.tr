step 0
err no
prompt "$ "
step 1 "command_not_found_handle() { echo \"handled $1\"; return \"$want\"; }"
err no
prompt "$ "
step 2 "want=0; nosuch; echo \"st=$?\""
out "handled nosuch\nst=0\n"
err no
prompt "$ "
step 3 "want=127; nosuch; echo \"st=$?\""
out "handled nosuch\nst=127\n"
err yes
prompt "$ "
step 4 "want=127; nosuch 2>/dev/null; echo \"st=$?\""
out "handled nosuch\nst=127\n"
err no
prompt "$ "
step 5 "exit"
err no
prompt ""
exit 0 at step 5
