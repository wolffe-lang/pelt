step 0
err no
prompt "bash-5.3$ "
step 1 "PS1='$ '"
err yes
prompt "$ "
step 2 "echo one"
out "one\n"
err yes
prompt "$ "
step 3 "echo two"
out "two\n"
err yes
prompt "$ "
step 4 "\\k \\e[A\\e[A\\e[B\\x7f\\x7f\\x7fTWO\\r"
out "TWO\n"
err yes
prompt "$ "
step 5 "exit"
err yes
prompt ""
exit 0 at step 5
