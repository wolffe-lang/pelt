step 0
err no
prompt "$ "
step 1 "sleep 30"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "kill %1"
err no
prompt "$ "
step 4 "sleep 0.3"
err no
prompt "$ "
step 5 "jobs"
out "[1] + Stopped                    sleep 30\n"
err no
prompt "$ "
step 6 "kill -CONT %1"
err no
prompt "$ "
step 7 "sleep 0.3"
err yes
prompt "$ "
step 8 "jobs"
err no
prompt "$ "
step 9 "exit"
err no
prompt ""
exit 0 at step 9
