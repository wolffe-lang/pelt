step 0
err no
prompt "$ "
step 1 "exec 2>&0"
err no
prompt ""
step 2 "abbr add zz 'echo NO'"
err no
prompt ""
step 3 "\\k zz "
err no
prompt ""
step 4 "\\k \\x03"
err no
prompt ""
step 5 "echo CANCELED"
out "CANCELED\n"
err no
prompt ""
step 6 "\\k \\x07\\x05\\x15"
err no
prompt ""
step 7 "exit 0"
err no
prompt ""
exit 0 at step 7
