step 0
err no
prompt "$ "
step 1 "exec 2>&0"
err no
prompt ""
step 2 "\"$PELT\" -c 'bindings >/dev/null; echo c=$?'"
out "c=127\n"
err no
prompt ""
step 3 "printf 'bindings >/dev/null; echo script=$?\\n' >s.sh; \"$PELT\" s.sh"
out "script=127\n"
err no
prompt ""
step 4 "echo 'bindings >/dev/null; echo pipe=$?' | \"$PELT\" -i +m"
out "pipe=127\n"
err no
prompt ""
step 5 "bindings >/dev/null; echo \"here=$?\""
out "here=0\n"
err no
prompt ""
step 6 "exit 0"
err no
prompt ""
exit 0 at step 6
