step 0
err no
prompt "$ "
step 1 "exec 2>&0"
err no
prompt ""
step 2 "set +o friendly_keys"
err no
prompt ""
step 3 "bindings -l"
out "accept-line\ninterrupt\ndiscard-pending-line\ndelete-or-eof\nbackward-delete-char\nunix-line-discard\nunix-word-rubout\nquoted-insert\ncomplete\nclear-screen\nbackward-char\nforward-char\nbeginning-of-line\nend-of-line\nprevious-history\nnext-history\nbackward-word\nforward-word\nkill-word\nbackward-kill-word\nkill-line\nyank\ndelete-char\nreverse-search-history\n"
err no
prompt ""
step 4 "exit"
err no
prompt ""
exit 0 at step 4
