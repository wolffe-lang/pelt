step 0
err no
prompt "$ "
step 1 "PS1='$ '"
err yes
prompt "$ "
step 2 "echo findme 1"
out "findme 1\n"
err yes
prompt "$ "
step 3 "echo findme 2"
out "findme 2\n"
err yes
prompt "$ "
step 4 "echo other"
out "other\n"
err yes
