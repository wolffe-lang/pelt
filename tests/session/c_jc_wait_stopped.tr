step 0
err no
prompt "$ "
step 1 "sleep 30"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "wait"
err no
prompt "$ "
step 4 "echo st=$?"
out "st=0\n"
err no
prompt "$ "
step 5 "wait %1"
err no
prompt "$ "
step 6 "echo st=$(kill -l $?)"
out "st=TSTP\n"
err no
prompt "$ "
step 7 "sleep 1 &"
err no
prompt "$ "
step 8 "wait %2"
err yes
prompt "$ "
step 9 "echo st=$?"
out "st=0\n"
err no
prompt "$ "
step 10 "kill -9 %1"
err no
prompt "$ "
step 11 "sleep 0.2"
err yes
prompt "$ "
step 12 "exit"
err no
prompt ""
exit 0 at step 12
