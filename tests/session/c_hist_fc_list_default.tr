step 0
err no
prompt "$ "
step 1 "echo a"
out "a\n"
err yes
prompt "$ "
step 2 "echo b"
out "b\n"
err yes
prompt "$ "
step 3 "echo c"
out "c\n"
err yes
prompt "$ "
step 4 "fc -l"
out "1\techo a\n2\techo b\n3\techo c\n"
err yes
prompt "$ "
step 5 "fc -ln"
out "\techo a\n\techo b\n\techo c\n\tfc -l\n"
err yes
prompt "$ "
step 6 "exit"
err yes
prompt ""
exit 0 at step 6
