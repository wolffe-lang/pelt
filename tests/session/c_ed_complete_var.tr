step 0
err no
prompt "$ "
step 1 "ZQV_ONE=1 ZQV_TWO=2"
err yes
prompt "$ "
step 2 "\\k echo $ZQV_O\\tX\\r"
out "1 X\n"
err yes
prompt "$ "
step 3 "\\k echo ${ZQV_O\\tX\\r"
out "1 X\n"
err yes
prompt "$ "
step 4 "\\k echo \"$ZQV_O\\tX\\r"
out "1 X\n"
err yes
prompt "$ "
step 5 "\\k echo $ZQV\\t\\tO\\tX\\r"
out "1 X\n"
err yes
prompt "$ "
step 6 "exit"
err yes
prompt ""
exit 0 at step 6
