step 0
err no
prompt "$ "
step 1 "sleep 1"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "bg"
out "[1] sleep 1\n"
err no
prompt "$ "
step 4 "wait"
err yes
prompt "$ "
step 5 "echo st=$?"
out "st=0\n"
err no
prompt "$ "
step 6 "jobs"
err no
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
