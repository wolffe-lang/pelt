step 0
err no
prompt "$ "
step 1 "sleep 30"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "exit"
err yes
prompt "$ "
step 4 "jobs"
out "[1] + Stopped                    sleep 30\n"
err no
prompt "$ "
step 5 "exit"
err yes
prompt "$ "
step 6 "kill -9 %1"
err no
prompt "$ "
step 7 "sleep 0.2"
err yes
prompt "$ "
step 8 "exit"
err no
prompt ""
exit 0 at step 8
