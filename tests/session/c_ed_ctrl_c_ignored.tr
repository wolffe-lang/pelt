step 0
err no
prompt "\u001b[?2004h$ "
step 1 "PS1='$ '"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 2 "trap '' INT"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 3 "\\k echo abc"
err no
prompt "echo abc"
step 4 "^C"
err no
prompt ""
step 5 "\\k \\r"
out "abc\n"
err no
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 6 "exit"
err yes
prompt ""
exit 0 at step 6
