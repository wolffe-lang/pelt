step 0
err no
prompt "$ "
step 1 "sh -c 'read x && echo \"$x\"'"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "fg"
out "sh -c \"read x && echo \\\"\\$x\\\"\"\n"
err no
prompt ""
step 4 "typed after fg"
out "typed after fg\n"
err no
prompt "$ "
step 5 "echo st=$?"
out "st=0\n"
err no
prompt "$ "
step 6 "exit"
err no
prompt ""
exit 0 at step 6
