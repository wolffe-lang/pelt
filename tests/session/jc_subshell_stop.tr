step 0
err no
prompt "$ "
step 1 "( sleep 1; echo back )"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "jobs"
out "[1] + Stopped                    sleep 1; echo back\n"
err no
prompt "$ "
step 4 "fg"
out "sleep 1; echo back\nback\n"
err no
prompt "$ "
step 5 "echo st=$?"
out "st=0\n"
err no
prompt "$ "
step 6 "exit"
err no
prompt ""
exit 0 at step 6
