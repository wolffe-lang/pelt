step 0
err no
prompt "$ "
step 1 "command_not_found_handle() { printf '[%s]' \"$#\" \"$@\"; echo; }"
err no
prompt "$ "
step 2 "x='two words'; set -- p q"
err no
prompt "$ "
step 3 "nosuch \"$x\" $x \"$@\" '*' ${unset-dflt}"
out "[8][nosuch][two words][two][words][p][q][*][dflt]\n"
err no
prompt "$ "
step 4 "\"no such\" a"
out "[2][no such][a]\n"
err no
prompt "$ "
step 5 "exec true"
err no
prompt ""
exit 0 at step 5
