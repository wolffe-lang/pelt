step 0
err no
prompt "$ "
step 1 "PATH=$HOME/bin:$PATH"
err no
prompt "$ "
step 2 "\\k FOO=1 zqcm\\tX\\r"
out "zq:X\n"
err no
prompt "$ "
step 3 "\\k if zqcm\\tX; then :; fi\\r"
out "zq:X\n"
err no
prompt "$ "
step 4 "\\k ! zqcm\\tX\\r"
out "zq:X\n"
err no
prompt "$ "
step 5 "\\k echo `zqcm\\tX`\\r"
out "zq:X\n"
err no
prompt "$ "
step 6 "exit"
err no
prompt ""
exit 0 at step 6
