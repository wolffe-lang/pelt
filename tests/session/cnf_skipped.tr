step 0
err no
prompt "$ "
step 1 "command_not_found_handle() { echo \"handler: $1\"; return 5; }"
err no
prompt "$ "
step 2 "command nosuch1; echo \"command st=$?\""
out "command st=127\n"
err yes
prompt "$ "
step 3 "./nosuch2; echo \"slash st=$?\""
out "slash st=127\n"
err yes
prompt "$ "
step 4 "unset -f command_not_found_handle"
err no
prompt "$ "
step 5 "nosuch3; echo \"unset st=$?\""
out "unset st=127\n"
err yes
prompt "$ "
step 6 "exit"
err no
prompt ""
exit 0 at step 6
