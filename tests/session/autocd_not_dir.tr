step 0
err no
prompt "$ "
step 1 "set -o autocd"
err no
prompt "$ "
step 2 "W=$PWD; echo 'echo ran' > f"
err no
prompt "$ "
step 3 "./f; echo \"file-slash st=$? ${PWD#\"$W\"}\""
out "file-slash st=126 \n"
err yes
prompt "$ "
step 4 "f; echo \"file-bare st=$? ${PWD#\"$W\"}\""
out "file-bare st=127 \n"
err yes
prompt "$ "
step 5 "./nope/; echo \"nope-slash st=$? ${PWD#\"$W\"}\""
out "nope-slash st=127 \n"
err yes
prompt "$ "
step 6 "nope; echo \"nope-bare st=$? ${PWD#\"$W\"}\""
out "nope-bare st=127 \n"
err yes
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
