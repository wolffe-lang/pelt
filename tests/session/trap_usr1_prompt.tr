step 0
err no
prompt "$ "
step 1 "trap 'echo caught' USR1"
err no
prompt "$ "
step 2 "kill -USR1 $$"
out "caught\n"
err no
prompt "$ "
step 3 "echo after=$?"
out "after=0\n"
err no
prompt "$ "
step 4 "kill -l 15"
out "TERM\n"
err no
prompt "$ "
step 5 "trap"
out "trap -- 'echo caught' USR1\n"
err no
prompt "$ "
step 6 "exit"
err no
prompt ""
exit 0 at step 6
