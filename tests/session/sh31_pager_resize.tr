step 0
err no
prompt "$ "
step 1 "exec 2>&0"
err no
prompt ""
step 2 "\\k echo "
err no
prompt ""
step 3 "\\k \\t"
err no
prompt ""
step 4 "\\k \\t"
err no
prompt ""
step 5 "\\size 16 24"
err no
prompt ""
step 6 "\\size 80 24"
err no
prompt ""
step 7 "\\k \\r"
err no
prompt ""
step 8 "\\k \\r"
out "alpha\n"
err no
prompt ""
step 9 "\\k \\x07\\x05\\x15"
err no
prompt ""
step 10 "exit 0"
err no
prompt ""
exit 0 at step 10
