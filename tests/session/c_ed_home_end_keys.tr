step 0
err no
prompt "\u001b[?2004h$ "
step 1 "PS1='$ '"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 2 "\\k ho b\\e[Hc\\e[1~e\\e[4~c\\e[F"
err no
prompt "ho b\r$ \u001b[1@c\b\u001b[1@echo bc"
step 3 "\\k \\r"
out "bc\n"
err no
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 4 "exit"
err yes
prompt ""
exit 0 at step 4
