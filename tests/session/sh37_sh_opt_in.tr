step 0
err no
prompt "$ "
step 1 "exec 2>&0"
err no
prompt ""
step 2 "bindings >/dev/null; echo \"default=$?\""
out "default=127\n"
err no
prompt ""
step 3 "set -o friendly -o suggest -o histsearch"
err no
prompt ""
step 4 "echo prefix_suffix"
out "prefix_suffix\n"
err no
prompt ""
step 5 "\\k echo prefix"
err no
prompt ""
step 6 "\\k \\e[C\\r"
out "prefix_suffix\n"
err no
prompt ""
step 7 "bindings >/dev/null; echo \"asked=$?\""
out "asked=0\n"
err no
prompt ""
step 8 "exit"
err no
prompt ""
exit 0 at step 8
