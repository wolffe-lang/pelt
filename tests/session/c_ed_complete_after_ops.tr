step 0
err no
prompt "$ "
step 1 "PATH=$HOME/bin:$PATH"
err yes
prompt "$ "
step 2 "\\k echo hi | zqcm\\tX\\r"
out "zq:X\n"
err yes
prompt "$ "
step 3 "\\k true; zqcm\\tX\\r"
out "zq:X\n"
err yes
prompt "$ "
step 4 "\\k true && zqcm\\tX\\r"
out "zq:X\n"
err yes
prompt "$ "
step 5 "\\k echo $(zqcm\\tX)\\r"
out "zq:X\n"
err yes
prompt "$ "
step 6 "\\k (zqcm\\tX)\\r"
out "zq:X\n"
err yes
prompt "$ "
step 7 "exit"
err yes
prompt ""
exit 0 at step 7
