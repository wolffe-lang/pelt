step 0
err no
prompt "$ "
step 1 "set -o autocd"
err no
prompt "$ "
step 2 "W=$PWD; mkdir basename echo fn"
err no
prompt "$ "
step 3 "basename /a/b; echo \"path st=$? ${PWD#\"$W\"}\""
out "b\npath st=0 \n"
err no
prompt "$ "
step 4 "echo builtin; echo \"builtin st=$? ${PWD#\"$W\"}\""
out "builtin\nbuiltin st=0 \n"
err no
prompt "$ "
step 5 "fn() { echo \"fn ran $#\"; }"
err no
prompt "$ "
step 6 "fn a b; echo \"function st=$? ${PWD#\"$W\"}\""
out "fn ran 2\nfunction st=0 \n"
err no
prompt "$ "
step 7 "./fn; echo \"slashed st=$? ${PWD#\"$W\"}\""
out "slashed st=0 /fn\n"
err no
prompt "$ "
step 8 "exit"
err no
prompt ""
exit 0 at step 8
