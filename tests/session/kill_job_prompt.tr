step 0
err no
prompt "$ "
step 1 "sleep 5 &"
err no
prompt "$ "
step 2 "kill -0 $! && echo there"
out "there\n"
err no
prompt "$ "
step 3 "kill $!"
err no
prompt "$ "
step 4 "wait $!"
err yes
prompt "$ "
step 5 "echo st=$?"
out "st=143\n"
err no
prompt "$ "
step 6 "kill -0 $! 2>/dev/null; echo gone=$?"
out "gone=1\n"
err no
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
