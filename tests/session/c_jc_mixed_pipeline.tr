step 0
err no
prompt "$ "
step 1 "sleep 1 | while read x; do :; done"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "echo after"
out "after\n"
err no
prompt "$ "
step 4 "jobs"
out "[1] + Stopped                    sleep 1 | while read x; do :; done\n"
err no
prompt "$ "
step 5 "exit"
err yes
prompt "$ "
alive at step 5
