step 0
err no
prompt "$ "
step 1 "mkdir sub"
err no
prompt "$ "
step 2 "sub; echo \"st=$? ${PWD##*/}\""
out "st=0 sub\n"
err no
prompt "$ "
step 3 "set +o | grep autocd"
out "set -o autocd\n"
err no
prompt "$ "
step 4 "cd .."
err no
prompt "$ "
step 5 "\"$0\" -o autocd -c 'sub; echo \"c st=$? ${PWD##*/}\"'"
out "c st=127 w\n"
err yes
prompt "$ "
step 6 "\"$0\" -o autocd -c './sub; echo \"slash st=$? ${PWD##*/}\"'"
out "slash st=126 w\n"
err yes
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
