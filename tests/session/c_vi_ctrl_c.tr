step 0
err no
prompt "\u001b[?2004h$ "
step 1 "PS1='$ '"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 2 "set -o vi"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 3 "\\k echo abc\\e"
err no
prompt "echo abc\b"
step 4 "^C"
err yes
prompt "\u001b[?2004h$ "
step 5 "echo st=$?"
out "st=130\n"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 6 "exit"
err yes
prompt ""
exit 0 at step 6
