step 0
err no
prompt "$ "
step 1 "kill -TERM $$"
err no
prompt "$ "
step 2 "echo alive=$?"
out "alive=0\n"
err no
prompt "$ "
step 3 "kill -QUIT $$"
err no
prompt "$ "
step 4 "echo still=$?"
out "still=0\n"
err no
prompt "$ "
step 5 "trap 'echo term-trapped' TERM"
err no
prompt "$ "
step 6 "kill -TERM $$"
out "term-trapped\n"
err no
prompt "$ "
step 7 "trap - TERM"
err no
prompt "$ "
step 8 "kill -s TERM $$"
err no
prompt "$ "
step 9 "echo reset-and-alive"
out "reset-and-alive\n"
err no
prompt "$ "
step 10 "exit"
err no
prompt ""
exit 0 at step 10
