step 0
err no
prompt "\u001b[?2004h$ "
step 1 "PS1='$ '"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 2 "echo one"
out "one\n"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 3 "\\k \\e[A\\e[A"
err no
prompt "echo one\r$ PS1='$ '"
step 4 "\\k \\e[B\\x7f\\x7f\\x7fTWO\\e[A"
err no
prompt "\r$ echo one\b \b\b \b\b \bTWO\r$ PS1='$ '"
step 5 "\\k \\r"
err no
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 6 "exit"
err yes
prompt ""
exit 0 at step 6
