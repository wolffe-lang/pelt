step 0
err no
prompt "$ "
step 1 "sleep 30 &"
err no
prompt "$ "
step 2 "sleep 31 &"
err no
prompt "$ "
step 3 "jobs"
out "[2] + Running                    sleep 31\n[1] - Running                    sleep 30\n"
err no
prompt "$ "
step 4 "jobs -l | wc -l | tr -d \" \""
out "2\n"
err no
prompt "$ "
step 5 "jobs -p | wc -l | tr -d \" \""
out "2\n"
err no
prompt "$ "
step 6 "kill %1 %2"
err no
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
