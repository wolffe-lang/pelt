step 0
err no
prompt "$ "
step 1 "echo content > unique_file_name"
err yes
prompt "$ "
step 2 "\\k cat <uniq\\t\\r"
out "content\n"
err yes
prompt "$ "
step 3 "\\k echo hi >uniq\\t\\r"
err yes
prompt "$ "
step 4 "cat unique_file_name"
out "hi\n"
err yes
prompt "$ "
step 5 "\\k FOO=uniq\\t\\x01echo \\r"
out "FOO=unique_file_name\n"
err yes
prompt "$ "
step 6 "exit"
err yes
prompt ""
exit 0 at step 6
