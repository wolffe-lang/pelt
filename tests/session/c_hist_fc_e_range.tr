step 0
err no
prompt "$ "
step 1 "echo one"
out "one\n"
err yes
prompt "$ "
step 2 "echo two"
out "two\n"
err yes
prompt "$ "
step 3 "fc -e true 1 2"
out "one\ntwo\n"
err yes
prompt "$ "
step 4 "fc -l"
out "1\techo one\n2\techo two\n3\techo one\n4\techo two\n"
err yes
prompt "$ "
step 5 "exit"
err yes
prompt ""
exit 0 at step 5
