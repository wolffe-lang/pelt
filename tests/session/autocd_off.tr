step 0
err no
prompt "$ "
step 1 "mkdir -p d/e child \"my dir\""
err no
prompt "$ "
step 2 "d/e; echo \"slash st=$? ${PWD##*/}\""
out "slash st=126 w\n"
err yes
prompt "$ "
step 3 "\"$PWD/d/\"; echo \"abs st=$? ${PWD##*/}\""
out "abs st=126 w\n"
err yes
prompt "$ "
step 4 "child; echo \"bare st=$? ${PWD##*/}\""
out "bare st=127 w\n"
err yes
prompt "$ "
step 5 "..; echo \"dotdot st=$? ${PWD##*/}\""
out "dotdot st=127 w\n"
err yes
prompt "$ "
step 6 "\"my dir\"; echo \"space st=$? ${PWD##*/}\""
out "space st=127 w\n"
err yes
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
