step 0
err no
prompt "$ "
step 1 "sleep 30 &"
err no
prompt "$ "
step 2 "jobs"
out "[1] + Running                    sleep 30\n"
err no
prompt "$ "
step 3 "kill %1"
err no
prompt "$ "
step 4 "wait"
err yes
prompt "$ "
step 5 "echo st=$?"
out "st=0\n"
err no
prompt "$ "
step 6 "jobs"
err no
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
