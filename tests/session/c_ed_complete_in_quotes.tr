step 0
err no
prompt "$ "
step 1 "touch 'my file'"
err yes
prompt "$ "
step 2 "\\k echo \"my\\tX\\r"
out "my file X\n"
err yes
prompt "$ "
step 3 "\\k echo 'my\\tX\\r"
out "my file X\n"
err yes
prompt "$ "
step 4 "\\k echo my\\\\ \\tX\\r"
out "my file X\n"
err yes
prompt "$ "
step 5 "exit"
err yes
prompt ""
exit 0 at step 5
