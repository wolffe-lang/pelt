step 0
err no
prompt "$ "
step 1 "sleep 30"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "echo st=$?"
out "st=148\n"
err no
prompt "$ "
step 4 "jobs"
out "[1] + Stopped                    sleep 30\n"
err no
prompt "$ "
step 5 "kill -9 %1"
err no
prompt "$ "
step 6 "exit"
err yes
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
