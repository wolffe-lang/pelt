step 0
err no
prompt "$ "
step 1 "sleep 30 | cat &"
err no
prompt "$ "
step 2 "jobs -l | sed 's/[0-9][0-9]*/N/g; s/  */ /g'"
out "[N] + N Running sleep N |\n N cat\n"
err no
prompt "$ "
step 3 "jobs"
out "[1] + Running                    sleep 30 | cat\n"
err no
prompt "$ "
step 4 "kill %1"
err no
prompt "$ "
step 5 "sleep 0.3"
err yes
prompt "$ "
step 6 "exit"
err no
prompt ""
exit 0 at step 6
