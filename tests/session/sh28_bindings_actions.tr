step 0
err no
prompt "$ "
step 1 "exec 2>&0"
err no
prompt ""
step 2 "bindings -l"
out "accept-line\ninterrupt\ndiscard-pending-line\ndelete-or-eof\nbackward-delete-char\nunix-line-discard\nunix-word-rubout\nquoted-insert\ncomplete\nclear-screen\nbackward-char\nforward-char\nbeginning-of-line\nend-of-line\nprevious-history\nnext-history\nbackward-word\nforward-word\nkill-word\nbackward-kill-word\nkill-line\nyank\ndelete-char\nreverse-search-history\nyank-last-arg\nyank-pop\ntranspose-chars\ntranspose-words\nupcase-word\ndowncase-word\ncapitalize-word\nundo\nrevert-line\nbeginning-of-history\nend-of-history\ninsert-comment\ndelete-horizontal-space\ncharacter-search\ncharacter-search-backward\ndigit-argument\nabort\nset-mark\nexchange-point-and-mark\n"
err no
prompt ""
step 3 "exit"
err no
prompt ""
exit 0 at step 3
