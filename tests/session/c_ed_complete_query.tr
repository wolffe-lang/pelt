step 0
err no
prompt "$ "
step 1 "i=0; while [ $i -lt 80 ]; do : > q$i; i=$((i+1)); done"
err no
prompt "$ "
step 2 "\\k echo q\\t\\t"
err no
prompt ""
step 3 "\\k n"
err no
prompt ""
step 4 "\\k \\t"
err no
prompt ""
step 5 "\\k y"
err no
prompt ""
step 6 "\\k \\x15echo done\\r"
out "done\n"
err no
prompt "$ "
step 7 "exit"
err no
prompt ""
exit 0 at step 7
