step 0
err no
prompt "$ "
step 1 "sleep 30 | cat"
err no
prompt ""
step 2 "^Z"
err yes
prompt "$ "
step 3 "jobs"
out "[1] + Stopped                    sleep 30 | cat\n"
err no
prompt "$ "
step 4 "fg"
out "sleep 30 | cat\n"
err no
prompt ""
step 5 "^C"
err no
prompt "$ "
step 6 "echo st=$?"
out "st=130\n"
err no
prompt "$ "
step 7 "jobs"
err no
prompt "$ "
step 8 "exit"
err no
prompt ""
exit 0 at step 8
