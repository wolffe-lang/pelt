step 0
err no
prompt "$ "
step 1 "echo a"
out "a\n"
err yes
prompt "$ "
step 2 "echo b"
out "b\n"
err yes
prompt "$ "
step 3 "fc -l 99"
out "1\techo a\n2\techo b\n"
err yes
prompt "$ "
step 4 "fc -l -99"
out "1\techo a\n2\techo b\n3\tfc -l 99\n"
err yes
prompt "$ "
step 5 "fc -l 1 99"
out "1\techo a\n2\techo b\n3\tfc -l 99\n4\tfc -l -99\n"
err yes
prompt "$ "
step 6 "fc -l 0"
out "5\tfc -l 1 99\n"
err yes
prompt "$ "
step 7 "fc -l -0"
out "7\tfc -l -0\n"
err yes
prompt "$ "
step 8 "exit"
err yes
prompt ""
exit 0 at step 8
