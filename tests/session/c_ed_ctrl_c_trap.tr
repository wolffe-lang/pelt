step 0
err no
prompt "\u001b[?2004h$ "
step 1 "PS1='$ '"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 2 "trap 'echo caught' INT"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 3 "\\k ech"
err no
prompt "ech"
step 4 "^C"
out "caught\n"
err yes
prompt "\u001b[?2004h$ "
step 5 "echo next"
out "next\n"
err yes
prompt "\u001b[?2004l\r\u001b[?2004h$ "
step 6 "exit"
err yes
prompt ""
exit 0 at step 6
